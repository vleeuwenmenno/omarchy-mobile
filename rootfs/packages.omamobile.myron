# SPDX-License-Identifier: MIT
# Omarchy Mobile packages for the non-bootable Myron stage. Device metadata
# and the kernel contract come from PACKAGE/ROOTFS_PACKAGES in device.conf.
# Unqualified Pixel camera, fingerprint, NFC and Panfrost packages stay out.
omamobile-keyring
omamobile-firstboot
omamobile-omarchy
strata
omamobile-apps-myron
omamobile-shell
omamobile-location-usage
omamobile-mirror
mesa-myron-zink-turnip
omamobile-myron-gpu-profile
hyprland
# Qualcomm service foundations. They install userspace only; the temporary
# hardware-test image keeps modem/radio/audio activation disabled by default.
qrtr
rmtfs
tqftpserv
tinyalsa
audioreach-graphservices
audioreach-conf
audioreach-graphmgr
fastrpc
hexagonrpc
