#!/bin/bash
# SPDX-License-Identifier: MIT
# Runs inside the Arch Linux ARM build container (privileged, for pacstrap's
# mounts), started by tools/build-rootfs. Mounts:
#   /src      this repository (read-only): rootfs/
#   /repo     out/repo (read-only): the signed [omamobile] repository
#   /modules  the kernel modules tarball (read-only)
#   /target   an empty volume: the root file system is assembled here
#   /out      where the raw image and the MANIFEST go
# Environment: VERSION, DEVICE, DEVICE_PACKAGE, ROOTFS_PACKAGES,
# ROOTFS_PACKAGE_PROFILE and
# ALLOW_MISSING (both space-separated), KERNEL_RELEASE, MODULES_SHA256,
# GIT_COMMIT, ALARM_SHA256, OMARCHY_CHANNEL, OUT_UID, OUT_GID,
# ROOTFS_INTEGRATION (kernel-modules or external-contract) and STAGE_ONLY (0/1).
# ROOTFS_DEV_UNSIGNED (0/1), REPO_STANZA_SED, DEV_MARKER_NAME, DEV_MARKER_TEXT,
# DEV_MANIFEST_LINE and SIGNED_MANIFEST_LINE come from tools/build-rootfs: with
# ROOTFS_DEV_UNSIGNED=1 /repo is the unsigned development repository (Myron
# stage only) and only the per-run [omamobile] stanza trusts it unsigned.
# STAGE_ONLY=1 needs external-contract: no /modules, no image, the tree goes to
# /out/stage and the MANIFEST says it is a non-bootable stage.
set -euo pipefail

T=/target
say() { printf '==> %s\n' "$*"; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }
list() { sed -e 's/#.*//' -e 's/[[:space:]]//g' "$1" | grep -v '^$'; }
STAGE_ONLY=${STAGE_ONLY:-0} ROOTFS_INTEGRATION=${ROOTFS_INTEGRATION:-kernel-modules}
ROOTFS_PACKAGE_PROFILE=${ROOTFS_PACKAGE_PROFILE:-default}
[[ $STAGE_ONLY == 0 || $STAGE_ONLY == 1 ]] || die "bad STAGE_ONLY '$STAGE_ONLY'"
[[ $ROOTFS_PACKAGE_PROFILE =~ ^[a-z0-9][a-z0-9-]*$ ]] ||
  die "bad ROOTFS_PACKAGE_PROFILE '$ROOTFS_PACKAGE_PROFILE'"
case $ROOTFS_INTEGRATION in kernel-modules|external-contract) ;; *) die "bad ROOTFS_INTEGRATION '$ROOTFS_INTEGRATION'" ;; esac
if [[ $ROOTFS_PACKAGE_PROFILE == myron ]]; then
  [[ ${DEVICE:-} == myron && $STAGE_ONLY == 1 && $ROOTFS_INTEGRATION == external-contract ]] ||
    die "ROOTFS_PACKAGE_PROFILE=myron needs DEVICE=myron, STAGE_ONLY=1 and ROOTFS_INTEGRATION=external-contract"
elif [[ ${DEVICE:-} == myron && $STAGE_ONLY == 1 ]]; then
  die "a myron stage needs ROOTFS_PACKAGE_PROFILE=myron, not $ROOTFS_PACKAGE_PROFILE"
fi
if [[ $STAGE_ONLY == 1 ]]; then
  [[ $ROOTFS_INTEGRATION == external-contract ]] || die "STAGE_ONLY needs ROOTFS_INTEGRATION=external-contract"
else
  [[ $ROOTFS_INTEGRATION == kernel-modules ]] || die "ROOTFS_INTEGRATION=$ROOTFS_INTEGRATION needs STAGE_ONLY=1"
fi
trap 'chown -R "$OUT_UID:$OUT_GID" /var/cache/pacman/pkg /out 2>/dev/null || true' EXIT

# Signed or development repository: the mode, the marker and the stanza agree
DEV_UNSIGNED=${ROOTFS_DEV_UNSIGNED:-0}
[[ $DEV_UNSIGNED == 0 || $DEV_UNSIGNED == 1 ]] || die "bad ROOTFS_DEV_UNSIGNED '$DEV_UNSIGNED'"
marker=/repo/aarch64/${DEV_MARKER_NAME:-.omamobile-dev-unsigned}
if [[ $DEV_UNSIGNED == 1 ]]; then
  [[ ${DEVICE:-} == myron && $STAGE_ONLY == 1 && $ROOTFS_INTEGRATION == external-contract ]] ||
    die "ROOTFS_DEV_UNSIGNED=1 needs DEVICE=myron, STAGE_ONLY=1 and ROOTFS_INTEGRATION=external-contract"
  for signing_path in /src/keys /src/keys/fingerprint /src/keys/gnupg; do
    if [[ $signing_path == /src/keys ]]; then
      [[ ! -L $signing_path && ( ! -e $signing_path || -d $signing_path ) ]] && continue
    fi
    [[ ! -e $signing_path && ! -L $signing_path ]] ||
      die "the development build refuses signing material exposed through /src"
  done
  [[ -f $marker && ! -L $marker ]] && cmp -s "$marker" <(printf '%s' "${DEV_MARKER_TEXT:?}") ||
    die "the development repository marker is missing or not exact"
  [[ -z $(find /repo/aarch64 -name '*.sig' -print -quit) ]] || die "the development repository holds a signature file"
  [[ ${REPO_STANZA_SED:?} == *'SigLevel = Optional TrustedOnly'* ]] || die "the development stanza does not trust the repository"
  manifest_repo_line=${DEV_MANIFEST_LINE:?}
else
  [[ ! -e $marker && ! -L $marker ]] || die "the signed repository holds the development marker"
  [[ ${REPO_STANZA_SED:?} != *SigLevel* ]] || die "the signed stanza relaxes SigLevel"
  manifest_repo_line=${SIGNED_MANIFEST_LINE:?}
fi

# [omamobile] first, from the repository being shipped
sed -i "$REPO_STANZA_SED" /etc/pacman.conf
pacman -Sy >/dev/null
available() { pacman -Sp --print-format %n "$1" >/dev/null 2>&1; }

base_list=/src/rootfs/packages.base
ours_list=/src/rootfs/packages.omamobile
if [[ $ROOTFS_PACKAGE_PROFILE != default ]]; then
  base_list+=.$ROOTFS_PACKAGE_PROFILE
  ours_list+=.$ROOTFS_PACKAGE_PROFILE
fi
[[ -f $base_list && -f $ours_list ]] ||
  die "missing rootfs package profile '$ROOTFS_PACKAGE_PROFILE'"
mapfile -t base < <(list "$base_list")
mapfile -t ours < <(list "$ours_list")
ours+=("$DEVICE_PACKAGE")
read -ra board <<<"${ROOTFS_PACKAGES:-}"
ours+=("${board[@]}")
missing=() skipped_ours=()
for p in "${base[@]}"; do available "$p" || missing+=("$p"); done
((${#missing[@]} == 0)) || die "not in any repository: ${missing[*]}"
# Every package of ours must come from [omamobile], not a same-named one
# elsewhere (Mesa, Hyprland, libcamera are in Arch Linux ARM and [omarchy]
# too). One allowed to be missing is left to whatever depends on it.
ours_present=()
for p in "${ours[@]}"; do
  repo=$(pacman -Sp -dd --print-format %r "$p" 2>/dev/null | tail -1 || true)
  if [[ $repo == omamobile ]]; then
    ours_present+=("$p")
  elif [[ " $ALLOW_MISSING " == *" $p "* ]]; then
    skipped_ours+=("$p")
  else
    missing+=("$p${repo:+ (only in [$repo])}")
  fi
done
((${#missing[@]} == 0)) || die "not in out/repo: ${missing[*]} (build them: tools/build-packages; or allow: --allow-missing)"

say "Base system and Omarchy (${#base[@]} packages)"
pacstrap -C /etc/pacman.conf -c -M "$T" "${base[@]}" >/var/log/pacstrap-base.log 2>&1 || { tail -40 /var/log/pacstrap-base.log; die "pacstrap failed"; }

omarchy_list=$T/usr/share/omarchy/install/omarchy-base.packages
[[ -f $omarchy_list ]] || die "no $omarchy_list in the omarchy package"
mapfile -t skip < <(list /src/rootfs/packages.omarchy-skip)
want=() unavailable=()
while read -r p; do
  [[ " ${skip[*]} " == *" $p "* ]] && continue
  if available "$p"; then want+=("$p"); else unavailable+=("$p"); fi
done < <(list "$omarchy_list")
say "Omarchy's package list: ${#want[@]} packages (${#unavailable[@]} not built for aarch64, ${#skip[@]} skipped)"
pacstrap -C /etc/pacman.conf -c -M "$T" --needed "${want[@]}" >/var/log/pacstrap-omarchy.log 2>&1 || { tail -40 /var/log/pacstrap-omarchy.log; die "pacstrap (Omarchy's list) failed"; }

say "Omarchy Mobile packages: ${ours_present[*]}"
pacstrap -C /etc/pacman.conf -c -M "$T" --needed "${ours_present[@]}" >/var/log/pacstrap-omamobile.log 2>&1 || { tail -40 /var/log/pacstrap-omamobile.log; die "pacstrap (Omarchy Mobile) failed"; }

package_closure="not applicable"
if [[ $ROOTFS_PACKAGE_PROFILE == myron ]]; then
  required=(omamobile-apps-myron mesa-myron-zink-turnip omamobile-myron-gpu-profile)
  forbidden=(omamobile-apps omacam neard libcamera libcamera-ipa pipewire-libcamera
             gst-plugin-libcamera libfprint vulkan-panfrost)
  absent=() present=()
  for p in "${required[@]}"; do
    pacman -r "$T" -Qq "$p" >/dev/null 2>&1 || absent+=("$p")
  done
  ((${#absent[@]} == 0)) || die "Myron stage misses required packages: ${absent[*]}"
  for p in "${forbidden[@]}"; do
    pacman -r "$T" -Qq "$p" >/dev/null 2>&1 && present+=("$p")
  done
  ((${#present[@]} == 0)) || die "Myron stage resolved forbidden packages: ${present[*]}"
  package_closure="required present; forbidden absent"
fi

say "pacman.conf and the [omamobile] repository"
sed "s/@OMARCHY_CHANNEL@/$OMARCHY_CHANNEL/" /src/rootfs/pacman.conf > "$T/etc/pacman.conf"
# The shipped trust never carries the build's: Required, never Optional or TrustAll
[[ $(grep -c '^[[:space:]]*SigLevel' "$T/etc/pacman.conf") == 1 ]] &&
  grep -qx 'SigLevel = Required DatabaseOptional' "$T/etc/pacman.conf" &&
  ! grep -Eq 'TrustAll|TrustedOnly' "$T/etc/pacman.conf" ||
  die "the staged pacman.conf does not keep SigLevel = Required DatabaseOptional"
if [[ $ROOTFS_PACKAGE_PROFILE == myron ]]; then
  mirrorlist=$T/etc/pacman.d/omamobile-mirrorlist
  [[ -f $mirrorlist && ! -L $mirrorlist ]] &&
    cmp -s "$mirrorlist" /src/packages/omamobile-device-myron/etc/omamobile-mirrorlist ||
    die "the staged [omamobile] mirrorlist differs from the committed one-server policy"
fi
# pacman.conf includes this file for every upstream repository. Copy it through
# a no-follow descriptor only when every effective line is a Server directive;
# an injected Include or SigLevel must never survive into the published stage.
python3 -I - "/etc/pacman.d/mirrorlist" "$T/etc/pacman.d/mirrorlist" <<'PY'
import os
import re
import stat
import sys

source = sys.argv[1]
target = sys.argv[2]
try:
    descriptor = os.open(source, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
except OSError as error:
    raise SystemExit(f"unsafe upstream mirrorlist: {error.strerror}")
try:
    metadata = os.fstat(descriptor)
    if not stat.S_ISREG(metadata.st_mode):
        raise SystemExit("unsafe upstream mirrorlist: not a regular file")
    data = os.read(descriptor, 1024 * 1024 + 1)
finally:
    os.close(descriptor)
if len(data) > 1024 * 1024:
    raise SystemExit("unsafe upstream mirrorlist: too large")
try:
    text = data.decode("utf-8")
except UnicodeDecodeError:
    raise SystemExit("unsafe upstream mirrorlist: not UTF-8")
directives = [line.strip() for line in text.splitlines() if line.strip() and not line.strip().startswith("#")]
if not directives or any(not re.fullmatch(r"Server\s*=\s*\S+", line) for line in directives):
    raise SystemExit("unsafe upstream mirrorlist: only Server directives are allowed")
os.makedirs(os.path.dirname(target), exist_ok=True)
flags = os.O_WRONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC
try:
    output = os.open(target, flags)
except FileNotFoundError:
    try:
        output = os.open(target, flags | os.O_CREAT | os.O_EXCL, 0o644)
    except OSError as error:
        raise SystemExit(f"unsafe staged upstream mirrorlist: {error.strerror}")
except OSError as error:
    raise SystemExit(f"unsafe staged upstream mirrorlist: {error.strerror}")
try:
    metadata = os.fstat(output)
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1:
        raise SystemExit("unsafe staged upstream mirrorlist: not an independent regular file")
    os.ftruncate(output, 0)
    os.fchmod(output, 0o644)
    remaining = memoryview(data)
    while remaining:
        written = os.write(output, remaining)
        if written == 0:
            raise SystemExit("unsafe staged upstream mirrorlist: short write")
        remaining = remaining[written:]
finally:
    os.close(output)
PY
mkdir -p "$T/var/lib/omamobile/repo/aarch64"
cp -a /repo/aarch64/. "$T/var/lib/omamobile/repo/aarch64/"
chown -R 0:0 "$T/var/lib/omamobile/repo"
# The image's sync databases match its pacman.conf ([omamobile] from file://)
cp /var/lib/pacman/sync/*.db "$T/var/lib/pacman/sync/" 2>/dev/null || true

if [[ $ROOTFS_INTEGRATION == kernel-modules ]]; then
  say "Kernel modules $KERNEL_RELEASE"
  mkdir -p "$T/usr/lib/modules"
  rm -rf "${T:?}/usr/lib/modules/$KERNEL_RELEASE"
  zstd -dc /modules | tar -C "$T/usr/lib/modules" -xf - --no-same-owner
  [[ -d $T/usr/lib/modules/$KERNEL_RELEASE ]] || die "the modules tarball has no $KERNEL_RELEASE"
  depmod -b "$T" -a "$KERNEL_RELEASE"
  # bin/omamobile push compares this with its tarball, so it won't push them again
  echo "$MODULES_SHA256" > "$T/usr/lib/modules/$KERNEL_RELEASE/.omamobile-tarball"
fi

say "Omarchy patches (omamobile-omarchy)"
# The same code path as every Omarchy upgrade on a phone: the package's pacman
# hook already applied the series when pacstrap installed it; this runs it
# again (a no-op when it is in place) and stops the build if it isn't, since
# an image without the lock's PIN pad can't be unlocked by touch.
applied=() upstream=()
if [[ -x $T/usr/bin/omamobile-omarchy-patches ]]; then
  arch-chroot "$T" omamobile-omarchy-patches apply --quiet ||
    { arch-chroot "$T" omamobile-omarchy-patches status; tail -40 "$T/var/log/omamobile/omarchy-patches.log"; die "the Omarchy patch series does not apply"; }
  status=$(arch-chroot "$T" omamobile-omarchy-patches status)
  read -r -a applied <<<"$(sed -n 's/^applied: //p' <<<"$status")"
  read -r -a upstream <<<"$(sed -n 's/^already in omarchy: //p' <<<"$status")"
  echo "    applied: ${#applied[@]}, already in Omarchy: ${upstream[*]:-none}"
elif [[ " $ALLOW_MISSING " == *" omamobile-omarchy "* ]]; then
  echo "    omamobile-omarchy is missing (allowed): Omarchy is unpatched"
else
  die "omamobile-omarchy is not installed"
fi

say "Services"
systemctl --root="$T" enable NetworkManager.service systemd-networkd.service systemd-resolved.service \
  sshd.service sddm.service >/dev/null 2>&1
systemctl --root="$T" mask systemd-networkd-wait-online.service NetworkManager-wait-online.service >/dev/null 2>&1
ln -sfn /run/systemd/resolve/stub-resolv.conf "$T/etc/resolv.conf"
echo omamobile > "$T/etc/hostname"

say "Removing per-machine state"
# No account but root, and root locked: the user comes from firstboot.conf
grep -q '^alarm:' "$T/etc/passwd" && die "an alarm account in the image"
awk -F: '$3 >= 1000 && $3 != 65534 {print $1}' "$T/etc/passwd" | grep -q . && die "a user account in the image"
sed -i 's/^root:[^:]*:/root:!*:/' "$T/etc/shadow"
rm -rf "$T/etc/pacman.d/gnupg"                 # firstboot makes the phone's own keyring
rm -f "$T"/etc/ssh/ssh_host_*                  # sshd makes the phone's own host keys
printf 'uninitialized\n' > "$T/etc/machine-id" # systemd makes the phone's own id
rm -f "$T/var/lib/systemd/random-seed" "$T/var/lib/dbus/machine-id"
rm -rf "$T"/root/.ssh "$T"/root/.bash_history "$T"/root/.gnupg
rm -rf "$T"/etc/NetworkManager/system-connections/* "$T"/var/lib/NetworkManager/*
rm -rf "$T"/var/cache/pacman/pkg/* "$T"/var/log/journal/* "$T"/tmp/* "$T"/var/tmp/*
find "$T/var/log" -type f -exec truncate -s 0 {} +

say "MANIFEST"
{
  if [[ $STAGE_ONLY == 1 ]]; then
    echo "# Omarchy Mobile root STAGE (not bootable, not an image)"
  else
    echo "# Omarchy Mobile root image"
  fi
  echo "version: $VERSION"
  echo "device: $DEVICE ($DEVICE_PACKAGE${ROOTFS_PACKAGES:+ $ROOTFS_PACKAGES})"
  echo "built: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "repository commit: $GIT_COMMIT"
  echo "arch linux arm tarball sha256: $ALARM_SHA256"
  echo "omarchy channel: $OMARCHY_CHANNEL"
  echo "rootfs package profile: $ROOTFS_PACKAGE_PROFILE"
  echo "package closure: $package_closure"
  echo "$manifest_repo_line"
  if [[ $STAGE_ONLY == 1 ]]; then
    echo "stage: non-bootable; not image-ready; not hardware-qualified"
    echo "rootfs integration: external-contract"
    echo "kernel modules: none (external contract, no module payload)"
    echo "boot payload: none; proprietary payload: none"
  else
    echo "kernel modules: $KERNEL_RELEASE (tarball sha256 $MODULES_SHA256)"
  fi
  echo "omarchy patches applied: ${applied[*]:-none}"
  echo "omarchy patches already in omarchy: ${upstream[*]:-none}"
  echo "omarchy packages not built for aarch64: ${unavailable[*]:-none}"
  echo "omarchy packages skipped: ${skip[*]:-none}"
  echo "omamobile packages missing (allowed): ${skipped_ours[*]:-none}"
  echo
  echo "# packages (name version repository)"
  pacman -Sl > /tmp/sync-list
  pacman -r "$T" -Q | awk 'NR == FNR { if (!($2 in repo)) repo[$2] = $1; next }
                           { print $1, $2, (($1 in repo) ? repo[$1] : "local") }' /tmp/sync-list -
} > /out/MANIFEST
install -Dm644 /out/MANIFEST "$T/usr/share/omamobile/rootfs/MANIFEST"

if [[ $STAGE_ONLY == 1 ]]; then
  say "Stage tree (no ext4 image)"
  rm -rf /out/stage
  mkdir -p /out/stage
  tar -C "$T" --numeric-owner -cf - . | tar -C /out/stage --numeric-owner -xpf -
  echo "    $(du -sx --block-size=1M "$T" | cut -f1) MiB staged as a tree; no image, no filesystem"
  exit 0
fi

say "ext4 image"
used=$(du -sx --block-size=1M "$T" | cut -f1)
size=$(( (used * 12 / 10 + 768 + 63) / 64 * 64 ))
rm -f /out/rootfs.img
truncate -s "${size}M" /out/rootfs.img
# -m 1: 1% reserved for root, not 5% of a ~100 GB userdata
mkfs.ext4 -q -L omamobile-root -m 1 -d "$T" /out/rootfs.img
e2fsck -fn /out/rootfs.img >/dev/null
echo "    ${used} MiB of files in a ${size} MiB file system"
