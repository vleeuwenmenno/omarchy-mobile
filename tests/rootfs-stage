reject "an uncompressed arm64 kernel image" "boot payload" python3 -c 'from pathlib import Path; p=Path("tree/opt/Image"); p.parent.mkdir(parents=True); p.write_bytes(b"\0" * 56 + b"ARMd" + b"\0" * 4)'
reject "an unusually named arm64 kernel image" "boot payload" python3 -c 'from pathlib import Path; p=Path("tree/opt/Image.raw"); p.parent.mkdir(parents=True); p.write_bytes(b"\0" * 56 + b"ARMd" + b"\0" * 4)'
reject "a non-payload file in boot" "kernel, module, or boot payload boot" bash -c 'mkdir -p tree/boot && : > tree/boot/readme'
reject "a boot symlink" "boot path is not a real directory" bash -c 'ln -s /nonexistent-omamobile tree/boot'
reject "a vendor path" "proprietary or vendor path" mkdir tree/vendor
reject "firmware" "firmware entry is not a regular file" bash -c 'mkdir -p tree/usr/lib/firmware/qcom'
reject "a regulatory symlink" "firmware entry is not a regular file" bash -c 'rm tree/usr/lib/firmware/regulatory.db; ln -s /dev/null tree/usr/lib/firmware/regulatory.db'
reject "a regulatory directory" "firmware entry is not a regular file" bash -c 'rm tree/usr/lib/firmware/regulatory.db; mkdir tree/usr/lib/firmware/regulatory.db'
reject "an escaping firmware directory" "firmware directory is not a real directory" bash -c 'mv tree/usr/lib/firmware outside-firmware; ln -s "$PWD/outside-firmware" tree/usr/lib/firmware'
reject "a GPU activation unit" "custom GPU/session activation" bash -c ': > tree/etc/systemd/system/omamobile-myron-gpu.service'
reject "a Myron session reference" "GPU profile verification" bash -c 'echo ExecStart=/usr/bin/omamobile-myron-session > tree/etc/systemd/system/x.service'
reject "an SDDM GPU environment override" "GPU profile verification" \
  bash -c 'mkdir -p tree/etc/sddm.conf.d; printf "[General]\nGreeterEnvironment=LD_LIBRARY_PATH=/usr/lib/omamobile/myron-gpu\n" > tree/etc/sddm.conf.d/20-myron.conf'
reject "a Wayland session GPU launcher" "GPU profile verification" \
  bash -c 'mkdir -p tree/usr/share/wayland-sessions; printf "[Desktop Entry]\nExec=env VK_DRIVER_FILES=/usr/lib/omamobile/myron-gpu/freedreno-kgsl.json Hyprland\n" > tree/usr/share/wayland-sessions/myron.desktop'
reject "an SDDM xprofile GPU override" "GPU profile verification" \
  bash -c 'printf "export LD_LIBRARY_PATH=/usr/lib/omamobile/myron-gpu\n" > tree/etc/xprofile'
reject "an SDDM xinit hook GPU override" "GPU profile verification" \
  bash -c 'mkdir -p tree/etc/X11/xinit/xinitrc.d; printf "export LIBGL_DRIVERS_PATH=/usr/lib/omamobile/myron-gpu/dri\n" > tree/etc/X11/xinit/xinitrc.d/90-myron.sh; chmod +x tree/etc/X11/xinit/xinitrc.d/90-myron.sh'
reject "an SDDM Xsession hook GPU override" "GPU profile verification" \
  bash -c 'mkdir -p tree/etc/X11/Xsession.d; printf "export VK_DRIVER_FILES=/usr/lib/omamobile/myron-gpu/freedreno-kgsl.json\n" > tree/etc/X11/Xsession.d/90-myron'
reject "a changed GPU payload" "GPU profile verification" bash -c 'printf changed >> tree/usr/lib/omamobile/myron-gpu/libvulkan_freedreno.so'
if ((EUID != 0)); then
  reject "an unreadable directory holding boot.img" "stage traversal failed" \
    bash -c 'mkdir -p tree/opt/hidden && : > tree/opt/hidden/boot.img && chmod 000 tree/opt/hidden'
else
  echo "skip - unreadable directory test (running as root)"
fi
reject "an escaping modules symlink" "kernel modules path is not a real directory" \
  bash -c 'mkdir -p outside-modules/6.12 && : > outside-modules/6.12/x && rm -rf tree/usr/lib/modules && ln -s "$PWD/outside-modules" tree/usr/lib/modules'
reject "a dangling modules symlink" "kernel modules path is not a real directory" \
  bash -c 'rm -rf tree/usr/lib/modules; ln -s /nonexistent-omamobile tree/usr/lib/modules'
reject "a dangling vendor symlink" "proprietary or vendor path vendor" ln -s /nonexistent-omamobile tree/vendor
reject "a dangling GPU activation symlink" "custom GPU/session activation" \
  ln -s /nonexistent-omamobile tree/etc/systemd/system/omamobile-myron-gpu.service
reject "an unmerged /lib firmware path" "system library alias is not a symlink" \
  bash -c 'mkdir -p tree/lib/firmware/qcom && : > tree/lib/firmware/qcom/private.bin'
reject "a redirected /lib firmware path" "system library alias differs" \
  bash -c 'mkdir -p tree/usr/local/lib/firmware/qcom && : > tree/usr/local/lib/firmware/qcom/private.bin && ln -s usr/local/lib tree/lib'
# Standard Arch top-level symlinks are not a reason to reject
accept_symlinks() {
  rm -rf "$t/m"; mkdir "$t/m"; synthetic "$t/m"
  ln -s usr/lib "$t/m/tree/lib"; ln -s usr/bin "$t/m/tree/sbin"
  mkdir -p "$t/m/tree/usr/lib/modules"
  check_stage "$t/m/tree" "$t/m/MANIFEST" >/dev/null || fail "standard symlinks and an empty modules directory are rejected"
  pass "standard Arch symlinks and an empty modules directory are accepted"
}
accept_symlinks

# Repository mode, trust and emulator payload (tools/build-rootfs --dev-unsigned)
reject_dev() { # NAME EXPECT MUTATION... (starts from a valid development stage)
  local name=$1 expect=$2 msg; shift 2
  chmod -R u+rwx "$t/m" 2>/dev/null || true
  rm -rf "$t/m"; mkdir "$t/m"; synthetic_dev "$t/m"
  (cd "$t/m" && "$@")
  if msg=$(check_stage "$t/m/tree" "$t/m/MANIFEST"); then fail "$name is accepted"; fi
  grep -q "$expect" <<<"$msg" || fail "$name rejected for the wrong reason: $msg"
  pass "$name is rejected"
}
rm -rf "$t/m"; mkdir "$t/m"; synthetic_dev "$t/m"
check_stage "$t/m/tree" "$t/m/MANIFEST" >/dev/null || fail "a development stage with marker and manifest line is rejected"
pass "a development stage with marker and manifest line is accepted"
# Names: dev-unsigned in the name exactly when the stage is a development stage
mkdir "$t/n"; synthetic_dev "$t/n"
mv "$t/n/tree" "$t/n/omamobile-rootfs-stage-dev-unsigned-x-aarch64"
check_stage "$t/n/omamobile-rootfs-stage-dev-unsigned-x-aarch64" "$t/n/MANIFEST" 1 >/dev/null ||
  fail "a correctly named development stage is rejected"
mv "$t/n/omamobile-rootfs-stage-dev-unsigned-x-aarch64" "$t/n/omamobile-rootfs-stage-x-aarch64"
if msg=$(check_stage "$t/n/omamobile-rootfs-stage-x-aarch64" "$t/n/MANIFEST" 1); then fail "a development stage without dev-unsigned in its name is accepted"; fi
grep -q "must have dev-unsigned in its name" <<<"$msg" || fail "unnamed development stage rejected for the wrong reason: $msg"
rm -rf "$t/s"; mkdir "$t/s"; synthetic "$t/s"
mv "$t/s/tree" "$t/s/omamobile-rootfs-stage-dev-unsigned-x-aarch64"
if msg=$(check_stage "$t/s/omamobile-rootfs-stage-dev-unsigned-x-aarch64" "$t/s/MANIFEST" 1); then fail "a signed stage named dev-unsigned is accepted"; fi
grep -q "lacks the development marker" <<<"$msg" || fail "misnamed signed stage rejected for the wrong reason: $msg"
pass "stage names say dev-unsigned exactly for development stages"
reject_dev "a development stage with a signed-release manifest" "lacks the unsigned development repository line" \
  sed -i 's/^repository signatures: .*/repository signatures: signed release/' MANIFEST
reject_dev "a development stage with both manifest lines" "claims a signed release" \
  bash -c 'echo "repository signatures: signed release" >> MANIFEST'
reject "a signed stage with the unsigned manifest line" "unsigned development repository without its marker" \
  sed -i 's/^repository signatures: .*/repository signatures: none (unsigned development build; not a release)/' MANIFEST
reject "a stage without a repository signature line" "lacks the signed release repository line" \
  sed -i '/^repository signatures: /d' MANIFEST
reject "a signed stage with a marker lacking the manifest line" "unsigned development repository line" \
  bash -c 'printf "development-only: unsigned package repository\nrelease-authority: false\ndeployment-authorized: false\n" > tree/var/lib/omamobile/repo/aarch64/.omamobile-dev-unsigned'
reject_dev "a marker with other bytes" "exact bytes" \
  bash -c 'printf "development-only: unsigned package repository\nrelease-authority: true\ndeployment-authorized: false\n" > tree/var/lib/omamobile/repo/aarch64/.omamobile-dev-unsigned'
reject_dev "a marker without its final newline" "exact bytes" \
  bash -c 'printf "development-only: unsigned package repository\nrelease-authority: false\ndeployment-authorized: false" > tree/var/lib/omamobile/repo/aarch64/.omamobile-dev-unsigned'
reject_dev "a dangling marker symlink" "not a regular file" \
  bash -c 'rm tree/var/lib/omamobile/repo/aarch64/.omamobile-dev-unsigned; ln -s /nonexistent-omamobile tree/var/lib/omamobile/repo/aarch64/.omamobile-dev-unsigned'
reject_dev "a marker directory" "not a regular file" \
  bash -c 'rm tree/var/lib/omamobile/repo/aarch64/.omamobile-dev-unsigned; mkdir tree/var/lib/omamobile/repo/aarch64/.omamobile-dev-unsigned'
reject_dev "a marker FIFO" "not a regular file" \
  bash -c 'rm tree/var/lib/omamobile/repo/aarch64/.omamobile-dev-unsigned; mkfifo tree/var/lib/omamobile/repo/aarch64/.omamobile-dev-unsigned'
reject_dev "a signature in the development repository" "signature file in the development repository" \
  ln -s /nonexistent-omamobile tree/var/lib/omamobile/repo/aarch64/x.pkg.tar.zst.sig
reject_dev "a TrustAll relaxation in the staged pacman.conf" "SigLevel is not Required" \
  bash -c 'sed -i "s/^SigLevel = .*/SigLevel = TrustAll/" tree/etc/pacman.conf'
reject_dev "a TrustAll remark left in the staged pacman.conf" "leaks" \
  bash -c 'echo "# SigLevel = TrustAll" >> tree/etc/pacman.conf'
reject_dev "an Optional TrustedOnly stanza in the staged pacman.conf" "SigLevel is not Required" \
  bash -c 'sed -i "s/^\[omamobile\]/[omamobile]\nSigLevel = Optional TrustedOnly/" tree/etc/pacman.conf'
reject_dev "a staged pacman.conf with Optional global trust" "SigLevel is not Required DatabaseOptional" \
  bash -c 'sed -i "s/^SigLevel = .*/SigLevel = Optional/" tree/etc/pacman.conf'
reject_dev "a staged pacman.conf with a per-repository SigLevel" "SigLevel is not Required DatabaseOptional" \
  bash -c 'sed -i "s/^\[omarchy\]/[omarchy]\nSigLevel = Optional/" tree/etc/pacman.conf'
reject_dev "a staged build-time file:///repo server" "staged \[omamobile\] repository differs" \
  bash -c 'sed -i "s#^Include = /etc/pacman.d/omamobile-mirrorlist#Server = file:///repo/\$arch#" tree/etc/pacman.conf'
reject_dev "a signature relaxation in the included mirrorlist" "one-server allowlist" \
  bash -c 'echo "SigLevel = Optional TrustAll" >> tree/etc/pacman.d/omamobile-mirrorlist'
reject_dev "a signature relaxation in the upstream mirrorlist" "non-Server directive" \
  bash -c 'echo "SigLevel = Optional TrustAll" >> tree/etc/pacman.d/mirrorlist'
reject_dev "a nested include in the upstream mirrorlist" "non-Server directive" \
  bash -c 'echo "Include = /etc/pacman.d/unchecked" >> tree/etc/pacman.d/mirrorlist'
reject_dev "a missing staged pacman.conf" "missing or unsafe" rm tree/etc/pacman.conf
reject_dev "a qemu static emulator" "qemu emulator payload" \
  bash -c 'mkdir -p tree/usr/bin && : > tree/usr/bin/qemu-aarch64-static'
reject "a qemu binfmt registration" "qemu emulator payload" \
  bash -c 'mkdir -p tree/usr/lib/binfmt.d && : > tree/usr/lib/binfmt.d/qemu-aarch64.conf'
reject_dev "an image beside the development stage payload" "boot payload" bash -c 'mkdir -p tree/boot && : > tree/boot/boot.img'
reject_dev "a kernel module in a development stage" "kernel modules in the stage" bash -c 'mkdir -p tree/usr/lib/modules/6.12 && : > tree/usr/lib/modules/6.12/x'
reject_dev "a vendor path in a development stage" "proprietary or vendor path" mkdir tree/vendor
