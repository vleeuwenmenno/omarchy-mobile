# post-pcm_start stream boundary, then removes it on normal exit.
session_case=$work/session
mkdir -p "$session_case"
cp "$bridge_session" "$session_case/bridge-session.py"
cat >"$session_case/bridge.py" <<'PY'
import os
import pathlib

def stream_pcm():
    marker = pathlib.Path(os.environ["MYRON_SPEAKER_STREAM_READY"])
    if not marker.is_file():
        raise RuntimeError("stream marker missing")
    pathlib.Path(os.environ["MYRON_SPEAKER_TEST_RESULT"]).write_text("observed\n")

def main():
    stream_pcm()
PY
MYRON_SPEAKER_STREAM_READY="$session_case/stream-ready" \
MYRON_SPEAKER_TEST_RESULT="$session_case/result" \
  python3 "$session_case/bridge-session.py" || fail 'PCM-start handshake wrapper failed'
[[ $(cat "$session_case/result") == observed && ! -e $session_case/stream-ready ]] ||
  fail 'PCM-start handshake marker was late or survived bridge exit'
pass 'speaker wrapper marks only the active post-pcm_start stream boundary'

# Exercise the real producer against a real FIFO. It must stop after one
# period, leak no second-period byte before the marker, then deliver 720000
# bytes total after PCM-start readiness.
writer_case=$work/writer
mkdir -p "$writer_case"
mkfifo "$writer_case/speaker.pcm"
python3 - "$writer_case/speaker.pcm" "$writer_case/stream-ready" "$writer_case/result" <<'PY' &
import os
import pathlib
import select
import sys

fifo, marker, result = sys.argv[1:]
period = 3840 * 2 * 2
fd = os.open(fifo, os.O_RDONLY)
try:
    initial = bytearray()
    while len(initial) < period:
        chunk = os.read(fd, period - len(initial))
        if not chunk:
            raise RuntimeError("producer closed before initial period")
        initial.extend(chunk)
    if select.select([fd], [], [], 0.25)[0]:
        raise RuntimeError("producer leaked payload before PCM-start marker")
    pathlib.Path(marker).write_text("ready\n")
    total = len(initial)
    while True:
        chunk = os.read(fd, 65536)
        if not chunk:
            break
        total += len(chunk)
    pathlib.Path(result).write_text(f"{len(initial)} {total}\n")
finally:
    os.close(fd)
PY
bridge_reader=$!
python3 "$bridge_writer" "$writer_case/speaker.pcm" "$writer_case/stream-ready" ||
  fail 'real speaker FIFO producer failed its handshake fixture'
wait "$bridge_reader" || fail 'speaker FIFO reader observed ordering failure'
bridge_reader=''
[[ $(cat "$writer_case/result") == '15360 720000' ]] ||
  fail 'speaker FIFO producer changed the period or total payload bound'
pass 'real FIFO producer waits after one period, then delivers exact bounded payload'

