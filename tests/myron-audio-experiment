  [[ -z $guard_one ]] || kill "$guard_one" >/dev/null 2>&1 || true
  [[ -z $guard_two ]] || kill "$guard_two" >/dev/null 2>&1 || true
  [[ -z $bridge_reader ]] || kill "$bridge_reader" >/dev/null 2>&1 || true
  rm -rf -- "$work"
