def setup_main(**over):
    base = tempfile.mkdtemp(dir=work)
    os.chmod(base, 0o700)
    t.TRUST_TOP = base
    P = {k: f"{base}/{k}" for k in ("uname", "notes", "compatible", "cmdline", "bootconfig", "boot_id", "mountinfo")}
    P.update(runtime=f"{base}/run", state=f"{base}/state", sysdev=f"{base}/sysdev", sysfs=f"{base}/sysfs", dev=f"{base}/dev")
    os.makedirs(P["runtime"]); os.makedirs(P["state"], mode=0o700); os.makedirs(f"{P['sysdev']}/7:3/loop")
    boot = "11111111-2222-3333-4444-555555555555"
    for key, value in [("uname", t.EXPECTED_KERNEL), ("cmdline", "x androidboot.slot_suffix=_a y"), ("boot_id", boot)]:
        open(P[key], "w").write(value + "\n")
    open(P["notes"], "wb").write(b"notes")
    t.EXPECTED_NOTES = hashlib.sha256(b"notes").hexdigest()
    open(P["compatible"], "wb").write(b"qcom,canoe-mtp\0other\0")
    open(f"{P['runtime']}/boot-id", "w").write(boot + "\n")
    open(f"{P['runtime']}/image-id", "w").write("abcd\n")
    success = open(f"{P['state']}/success", "w"); success.write(f"boot_id={boot}\nimage_id=abcd\n"); success.close()
    os.chmod(f"{P['state']}/success", 0o600)
    image = f"{P['state']}/rootfs.img"
    open(image, "wb").write(b"x"); os.chmod(image, 0o600)
    open(f"{P['sysdev']}/7:3/loop/backing_file", "w").write(image + "\n")
    open(P["mountinfo"], "w").write("1 0 7:3 / / rw - ext4 /dev/loop3 rw\n")
    t.PATHS.update(P)
    t.subprocess.run = lambda *a, **k: types_ns(returncode=0)
    for key, value in over.items():
        value()
    return P

