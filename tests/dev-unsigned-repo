ln -s ../dev-unsigned/other "$R/out/repo/aarch64"
refuses "tools/build-packages through out/repo/aarch64 linked into the dev tree" 'resolves into the development-only repository' build-packages packages/fixture
refuses "tools/repo-build through out/repo/aarch64 linked into the dev tree" 'resolves into the development-only repository' repo-build
refuses "tools/repo-push through out/repo/aarch64 linked into the dev tree" 'resolves into the development-only repository' repo-push
