# --- E: marker forms --------------------------------------------------------
make_marker() { # DIR KIND
  local dir=$1 kind=$2
  mkdir -p "$dir"
  case $kind in
    wrong-bytes) printf 'development-only: unsigned package repository\nrelease-authority: true\ndeployment-authorized: false\n' > "$dir/$MARKER_NAME" ;;
    no-newline) printf '%s' "${MARKER_TEXT%$'\n'}" > "$dir/$MARKER_NAME" ;;
    crlf) printf '%s' "${MARKER_TEXT//$'\n'/$'\r\n'}" > "$dir/$MARKER_NAME" ;;
    extra-line) printf '%sextra: true\n' "$MARKER_TEXT" > "$dir/$MARKER_NAME" ;;
    empty) : > "$dir/$MARKER_NAME" ;;
    oversized) head -c 5000 /dev/zero | tr '\0' x > "$dir/$MARKER_NAME" ;;
    dangling-link) ln -s /nonexistent-omamobile "$dir/$MARKER_NAME" ;;
    link-to-exact) printf '%s' "$MARKER_TEXT" > "$dir/real-marker"; ln -s real-marker "$dir/$MARKER_NAME" ;;
    hardlink) printf '%s' "$MARKER_TEXT" > "$dir/real-marker"; ln "$dir/real-marker" "$dir/$MARKER_NAME" ;;
    directory) mkdir "$dir/$MARKER_NAME" ;;
    fifo) mkfifo "$dir/$MARKER_NAME" ;;
    exact) printf '%s' "$MARKER_TEXT" > "$dir/$MARKER_NAME" ;;
    *) fail "unknown marker kind $kind" ;;
  esac
}
for kind in wrong-bytes no-newline crlf extra-line empty oversized dangling-link link-to-exact hardlink directory fifo; do
  new_repo
  make_marker "$R/$DEV" "$kind"
  refuses "a $kind marker in the development repository" 'development marker' build-packages --dev-unsigned packages/fixture
done
pass "the development build accepts only the exact regular marker (wrong bytes, newline, CRLF, extra line, empty, oversized, dangling or valid links, directory, FIFO all refused)"

# Signed and phone-facing paths refuse every marker form, the exact one included
for kind in exact wrong-bytes dangling-link link-to-exact hardlink directory fifo; do
  new_repo
  mkdir -p "$R/keys/gnupg"; echo FAKEKEY > "$R/keys/fingerprint"
  make_marker "$R/out/repo/aarch64" "$kind"
  : > "$R/out/repo/aarch64/omamobile.db"
  refuses "tools/build-packages with a $kind marker" 'development-only unsigned repository marker' build-packages packages/fixture
  refuses "tools/repo-build with a $kind marker" 'development-only unsigned repository marker' repo-build
  refuses "tools/repo-push with a $kind marker" 'development-only unsigned repository marker' repo-push
done
pass "signed build-packages, repo-build and repo-push refuse the marker in every form before any side effect or phone contact"

# --- I: isolation -----------------------------------------------------------
new_repo
mkdir -p "$R/keys/gnupg"; echo FAKEKEY > "$R/keys/fingerprint"
bp --dev-unsigned packages/fixture 2>/dev/null && fail "a development build ran beside signing material"
rm -rf "$R/keys"
bp --dev-unsigned packages/fixture || fail "the development build fails"
mkdir -p "$R/out"
ln -s dev-unsigned/repo "$R/out/repo"
mkdir -p "$R/keys/gnupg"; echo FAKEKEY > "$R/keys/fingerprint"
rm -f "$CALLS"
refuses "tools/build-packages through a symlinked out/repo" 'development-only' build-packages packages/fixture
refuses "tools/repo-build through a symlinked out/repo" 'development-only' repo-build
refuses "tools/repo-push through a symlinked out/repo" 'development-only' repo-push
