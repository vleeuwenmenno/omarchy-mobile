rm -f "$CALLS" "$GPGCALLS" "$PHONECALLS"
refuses "a signed package path linked into the development repository" 'signed repository artifact is a link' build-packages --dev-unsigned --force packages/fixture
[[ $(sha256sum "$R/$DEV/$pkg") == "$before" ]] || fail "the refused reverse link changed development package bytes"
grep -qx signature-sentinel "$R/out/repo/aarch64/$pkg.sig" || fail "the refused reverse link changed the signed signature"
pass "development builds refuse signed package paths that alias development artifacts"

# A development package must never share an inode with a signed artifact: cp -f
# would otherwise replace the signed bytes while leaving its signature intact.
new_repo
bp --dev-unsigned packages/fixture || fail "the alias fixture build fails"
mkdir -p "$R/out/repo/aarch64"
pkg=fixture-1-1-aarch64.pkg.tar.zst
cp "$R/$DEV/$pkg" "$R/out/repo/aarch64/$pkg"
rm "$R/$DEV/$pkg"
ln "$R/out/repo/aarch64/$pkg" "$R/$DEV/$pkg"
echo signature-sentinel > "$R/out/repo/aarch64/$pkg.sig"
before=$(sha256sum "$R/out/repo/aarch64/$pkg")
rm -f "$CALLS" "$GPGCALLS" "$PHONECALLS"
refuses "a package hardlinked to the signed repository" 'not an independent regular file' build-packages --dev-unsigned --force packages/fixture
[[ $(sha256sum "$R/out/repo/aarch64/$pkg") == "$before" ]] || fail "the refused hardlink changed signed package bytes"
grep -qx signature-sentinel "$R/out/repo/aarch64/$pkg.sig" || fail "the refused hardlink changed the signed signature"
pass "development packages cannot alias signed package inodes"

# --- F: signatures ----------------------------------------------------------
for kind in dangling-link regular directory link-to-file; do
  new_repo
  make_marker "$R/$DEV" exact
  echo old > "$R/$DEV/old-1-1-aarch64.pkg.tar.zst"
  case $kind in
    dangling-link) ln -s /nonexistent-omamobile "$R/$DEV/old-1-1-aarch64.pkg.tar.zst.sig" ;;
    regular) echo sig > "$R/$DEV/old-1-1-aarch64.pkg.tar.zst.sig" ;;
    directory) mkdir "$R/$DEV/old-1-1-aarch64.pkg.tar.zst.sig" ;;
    link-to-file) echo sig > "$t/sig-target"; ln -s "$t/sig-target" "$R/$DEV/old-1-1-aarch64.pkg.tar.zst.sig" ;;
  esac
  refuses "a $kind *.sig in the development repository" 'holds a signature file' build-packages --dev-unsigned packages/fixture
  [[ -e $R/$DEV/old-1-1-aarch64.pkg.tar.zst.sig || -L $R/$DEV/old-1-1-aarch64.pkg.tar.zst.sig ]] || fail "a $kind signature was deleted"
  [[ -f $R/$DEV/old-1-1-aarch64.pkg.tar.zst ]] || fail "the package beside a $kind signature was deleted"
done
pass "every *.sig (dangling links and directories included) is refused and never deleted in development mode"

# --- G: signing material ----------------------------------------------------
for form in fingerprint-file gnupg-dir gnupg-dangling-link fingerprint-dangling-link keys-file keys-dangling-link keys-link-to-empty-dir; do
  new_repo
  case $form in
    fingerprint-file) mkdir "$R/keys"; echo FAKEKEY > "$R/keys/fingerprint" ;;
    gnupg-dir) mkdir -p "$R/keys/gnupg" ;;
    gnupg-dangling-link) mkdir "$R/keys"; ln -s /nonexistent-omamobile "$R/keys/gnupg" ;;
    fingerprint-dangling-link) mkdir "$R/keys"; ln -s /nonexistent-omamobile "$R/keys/fingerprint" ;;
    keys-file) echo unexpected > "$R/keys" ;;
    keys-dangling-link) ln -s /nonexistent-omamobile "$R/keys" ;;
    keys-link-to-empty-dir) mkdir "$t/empty-keys"; ln -s "$t/empty-keys" "$R/keys" ;;
  esac
  refuses "--dev-unsigned with $form" 'signing material' build-packages --dev-unsigned packages/fixture
  [[ ! -e $R/out ]] || fail "--dev-unsigned with $form created output before refusing"
  refuses "--dev-unsigned --list with $form" 'signing material' build-packages --dev-unsigned --list packages/fixture
  rm -rf "$R/keys" "$t/empty-keys"
done
pass "development mode refuses any keys/fingerprint, keys/gnupg or keys link, dangling or not, before creating anything"

