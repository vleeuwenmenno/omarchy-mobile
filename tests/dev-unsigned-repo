new_repo
mkdir -p "$R/out/repo/aarch64"; echo signed-bytes > "$R/out/repo/aarch64/signed-1-1-aarch64.pkg.tar.zst"; echo sig > "$R/out/repo/aarch64/signed-1-1-aarch64.pkg.tar.zst.sig"
