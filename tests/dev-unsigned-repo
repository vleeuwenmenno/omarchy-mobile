bp --dev-unsigned packages/fixture || fail "the development build fails beside a signed repository"
after=$(cd "$R/out/repo" && find . -type f -exec sha256sum {} + | LC_ALL=C sort)
[[ $before == "$after" ]] || fail "the development build changed the signed repository"
[[ ! -e $R/$DEV/signed-1-1-aarch64.pkg.tar.zst && ! -e $R/out/dev-unsigned/signed-1-1-aarch64.pkg.tar.zst ]] || fail "signed bytes were copied into the development repository"
pass "a development build leaves the signed repository byte for byte alone and imports nothing from it"

# A signed package path must never resolve to a development package. Replacing
# the dev inode would otherwise silently change signed bytes while its old
# detached signature stayed in place.
new_repo
bp --dev-unsigned packages/fixture || fail "the reverse-alias fixture build fails"
mkdir -p "$R/out/repo/aarch64"
pkg=fixture-1-1-aarch64.pkg.tar.zst
ln -s "../../../dev-unsigned/repo/aarch64/$pkg" "$R/out/repo/aarch64/$pkg"
