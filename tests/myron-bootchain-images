C = B.collect()
P = C.preflight()
D = P.deploy()
K = D.kernel()
paths = {key: Path(value) for key, value in json.loads((work / "fixture/paths.json").read_text()).items()}
contracts_root = paths["contracts_root"]
contracts = D.load_contracts(contracts_root)
_, _, snapshot_sha = P.snapshot().load_snapshot_contract(contracts_root, contracts)
preflight_bytes = D.render_json(P.expected_preflight_contract(contracts, snapshot_sha))
(contracts_root / P.PREFLIGHT_CONTRACT_PATH).parent.mkdir(parents=True, exist_ok=True)
