#!/bin/bash
# SPDX-License-Identifier: MIT
# Offline tests for the Myron synthetic R3 image parsers (Phase 2.15B): Android boot v0-v4,
# vendor_boot v3-v4 and DT table v0 into the metadata-only R3 operation. Everything here is
# synthetic: no phone, no network, no process, no block device, no real firmware. The image
# bytes are generated at runtime by tests/myron-fixtures/boot_images.py, independently of the
# parser, and exist only in a temporary directory: no binary fixture is committed.
set -euo pipefail
export LC_ALL=C
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }
tmp=$(mktemp -d)
trap 'chmod -R u+rwx "$tmp" 2>/dev/null || true; rm -rf "$tmp"' EXIT
export PYTHONPYCACHEPREFIX="$tmp/pycache"
tmp=$(realpath "$tmp")

python3 -m py_compile tools/myron-bootchain tools/lib/myron-bootchain-impl.py tests/myron-fixtures/boot_images.py \
  || fail "tool and fixture builder parse"
bash -n tests/myron-bootchain-images || fail "runner parses"
grep -q 'synthetic-binary-image-fixture' tools/lib/myron-bootchain-impl.py || fail "tool lacks the synthetic image transport"
[[ $(wc -l < tools/myron-bootchain) -le 90 ]] || fail "the trusted loader grew past 90 lines"
pass "tool and builder parse, the loader stayed small"

tools/myron-bootchain derive-contract > "$tmp/derived.json" || fail "derive-contract failed"
cmp -s "$tmp/derived.json" device/myron/bootchain-contract.json \
  || fail "committed bootchain contract differs from derive-contract (regenerate it, see docs/myron/R3-PARSER-GATE.md)"
tools/myron-bootchain show | cmp -s - "$tmp/derived.json" || fail "show differs from derive-contract"
pass "derive-contract output equals the committed 0.3.0 bootchain contract byte for byte"

mkdir "$tmp/fixture"
MYRON_SNAPSHOT_FIXTURE_OUT="$tmp/fixture" tests/myron-snapshot > "$tmp/snapshot-suite.log" \
  || { cat "$tmp/snapshot-suite.log" >&2; fail "snapshot fixture export"; }

python3 - "$PWD" "$tmp" <<'PY' || exit 1
