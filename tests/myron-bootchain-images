assert code == 0
request_sha256 = digest((request / "SHA256SUMS").read_bytes())
READS = json.loads((request / "request.json").read_text())["requested_reads"]
R1, R2, R3, R4, R5, R6, R7 = [row["id"] for row in READS]
R2_ROW, R3_ROW = READS[1], READS[2]
assert R3 == B.R3_ID and R2 == B.R2_ID
assert [R3_ROW[key] for key in ("max_output_bytes", "max_fixture_input_bytes", "max_hardware_read_bytes")] == [
    1048576, 67108864, 65536], "the three collector R3 limits are distinct and unchanged"
NAMES = sorted(r + s for r in ("boot", "init_boot", "vendor_boot", "vendor_kernel_boot", "dtbo", "recovery")
               for s in ("", "_a", "_b"))
assert NAMES == B.IMAGE_NAMES and len(NAMES) == 18


def role_of(name):
    return name[:-2] if name.endswith(("_a", "_b")) else name


# --- scenarios -------------------------------------------------------------------------


def r2_operation(partitions, req_sha=None):
    rows = [{"partition_name": name, "size_bytes": size, "bootable_flag": False,
             "slot_suffix": name[-2:] if name.endswith(("_a", "_b")) else ""}
            for name, size in sorted(partitions.items())]
    return jbytes({
        "schema": C.OPERATION_SCHEMA, "kind": C.OPERATION_KIND, "id": R2,
        "request_sha256": req_sha or request_sha256, "transport": C.TRANSPORT,
        "read_domain": C.READ_DOMAIN, "read_only": True, "bytes_read": 4096,
        "data": {"partitions": rows, "recovery_present": any(role_of(n) == "recovery" for n in partitions)},
    })


class Scenario:
    pass


def make(images, label="scn", *, capacity=None, extra_parts=None, req_sha=None, inv_sha=None,
         manifest_edit=None, rows_edit=None, edits=None, drop=(), extra_files=None, manifest_raw=None,
         inventory_names=None, keep_rows=False):
    """Write one inventory file and one flat image fixture. IMAGES: name -> (bytes, meta)."""
    s = Scenario()
    s.images = images
    parts = {name: (capacity or {}).get(name, 64 * F.MIB) for name in (inventory_names or images)}
    parts.update(extra_parts or {"pmos_root": 8 * 1024 ** 3})
    s.partitions = parts
    base = fresh(label)
    s.inv = base / "inventory" / "R2.json"
    s.inv.parent.mkdir()
    s.inv_bytes = r2_operation(parts, req_sha)
    s.inv.write_bytes(s.inv_bytes)
    s.inv.chmod(0o644)
    s.inv.parent.chmod(0o755)
    s.inv_sha = digest(s.inv_bytes)
    s.imgs = base / "images"
    s.imgs.mkdir()
    files = {name: data for name, (data, _meta) in images.items()}
    original = dict(files)
    files.update(edits or {})
    rows = [{"partition_name": n, "present": n in (original if not keep_rows else files),
             "size_bytes": len((original if not keep_rows else files)[n]) if n in (original if not keep_rows else files) else None,
             "fixture_sha256": digest((original if not keep_rows else files)[n]) if n in (original if not keep_rows else files) else None}
            for n in NAMES]
    if rows_edit:
        rows_edit(rows)
    document = {"schema": 1, "kind": B.IMAGES_KIND, "format_version": 1, "bootchain_contract_sha256": BC,
                "request_sha256": req_sha or request_sha256, "inventory_sha256": inv_sha or s.inv_sha,
                "synthetic": True, "images": rows}
    if manifest_edit:
        manifest_edit(document)
    s.manifest = manifest_raw if manifest_raw is not None else jbytes(document)
    s.manifest_doc = document
    for name, data in {**{f"{n}.img": d for n, d in files.items()}, "images.json": s.manifest,
                       **(extra_files or {})}.items():
        if name in drop:
            continue
        (s.imgs / name).write_bytes(data)
        (s.imgs / name).chmod(0o644)
    s.imgs.chmod(0o755)
    s.sizes = sum(len(d) for d in original.values())
    s.S = len(s.manifest) + s.sizes
    return s


def cli(command, s, *extra):
    if command == "plan-images":
        return [command, "--request", request, "--inventory", s.inv, *extra]
    return [command, "--request", request, "--inventory", s.inv, "--images", s.imgs, *extra]


def parse_ok(s, label="out"):
    out = work / f"{label}-{counter[0] + 1}"
    counter[0] += 1
    summary, raw = expect_ok(*cli("parse-images", s, "--out", out))
    return summary, out


def image(name, data_meta):
    return B.image_summary(name, data_meta[0])


def reject(name, label, data, code):
    try:
        B.image_summary(label, data)
    except B.ImageError as error:
        assert error.code == code, f"{name}: expected {code}, got {error.code}: {error}"
        text = str(error)
        assert text.endswith(f"(code {code})") and "\n" not in text
        assert CANARY not in text and not re.search(r"\d{3,}", text.replace("32 bits", "")), text
    else:
        raise AssertionError(f"{name}: accepted")
    ok(f"{name} is {code}")


# --- the contract ------------------------------------------------------------------------

contract = json.loads(bootchain_contract_bytes)
assert contract["format_version"] == "0.3.0"
