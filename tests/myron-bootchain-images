forge("a parse claiming captured provenance", rewrite("parse.json", lambda v: v["provenance"].update(captured=True)))
forge("a parse bound to another request", rewrite("parse.json", lambda v: v.update(request_sha256="4" * 64)))
forge("a mode change", lambda t: os.chmod(t / "parse.json", 0o600))
forge("a symlinked parse file", lambda t: ((t / "parse.json").unlink(), (t / "parse.json").symlink_to(t / "SHA256SUMS")))
forge("an executable parse file", lambda t: os.chmod(t / "parse.json", 0o755))
expect_fail("verify against another inventory", ["verify-images", "--request", request, "--inventory", other_inventory.inv,
                                                 "--images", scn.imgs, "--parse", out_dir], None)
expect_fail("verify against another fixture", cli("verify-images", full, "--parse", out_dir), None)
expect_fail("verify with a missing parse", cli("verify-images", scn, "--parse", work / f"{CANARY}-none"), "image-input-rejected")
expect_fail("verify with a parse inside the images", cli("verify-images", scn, "--parse", scn.imgs / "sub"), "image-input-rejected")
expect_fail("verify-parse refuses an image artifact", ["verify-parse", "--request", request, "--reads", scn.imgs, "--parse", out_dir])
expect_fail("a parse under another name is not the R2 artifact", ["verify-parse", "--request", request, "--reads", out_dir,
