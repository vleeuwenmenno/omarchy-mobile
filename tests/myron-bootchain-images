assert C.policy_registry()["operations"][R3]["budgets"]["max_output_bytes"] == 1048576
for name in ("capture", "preflight", "deployment", "snapshot", "session", "stage", "kernel"):
    assert "bootchain" not in (repo / f"device/myron/{name}-contract.json").read_text(), "pins are one-way"
ok("the 0.3.0 contract binds the independent image-parser contract, the R2/R3 command scopes, R4 alone deferred and every false authority")

# --- positive parsers: every supported version, family, role and page size -------------------

BODY = 3000


def check_positive(name, built):
    data, meta = built
    got = image(name, built)
    want = F.expected(data, meta)
    assert got == want, (name, json.dumps(got, indent=1, sort_keys=True), json.dumps(want, indent=1, sort_keys=True))
    return got


for role in ("boot", "recovery"):
    for version in (0, 1, 2):
        for page in (2048, 4096, 8192, 16384):
            kwargs = dict(kernel=F.blob("k", BODY), ramdisk=F.blob("r", BODY + 7), second=F.blob("s", 500),
                          page=page)
            if version >= 1:
                kwargs["dtbo"] = F.blob("d", 900)
            if version >= 2:
                kwargs["dtb"] = F.blob("t", 1100)
            got = check_positive(role + "_a", F.boot_legacy(version, **kwargs))
            assert got["os_version"] == F.OS_VERSION and got["sha256"] is None
            assert got["coverage"]["kind"] == "metadata-only" and len(got["coverage"]["ranges"]) == 1
            assert all(c["sha256"] is None for c in got["components"]), "payload stays uncovered"
        check_positive(role, F.boot_legacy(version, os_version=0))  # literal os_version 0 is preserved
        assert image(role, F.boot_legacy(version, os_version=0))["os_version"] == 0
    for version in (3, 4):
        kwargs = dict(kernel=F.blob("k", BODY), ramdisk=F.blob("r", 5000))
        if version == 4:
            kwargs["signature"] = F.blob("sig", 700)
        got = check_positive(role + "_b", F.boot_modern(version, **kwargs))
        assert got["page_size"] == 4096
        check_positive(role, F.boot_modern(version))  # every component empty
for name in ("init_boot", "init_boot_a", "init_boot_b"):
    got = check_positive(name, F.boot_modern(4, ramdisk=F.blob("r", 6000), signature=F.blob("sig", 300)))
    assert [c for c in got["components"] if c["role"] == "kernel"][0]["size_bytes"] == 0
# recovery_dtbo: empty allows the writer's zero and the computed position; the dtb never derives from it
check_positive("boot", F.boot_legacy(2, kernel=F.blob("k", 100), dtbo=b"", dtb=F.blob("t", 64), dtbo_offset=0))
data, meta = F.boot_legacy(2, kernel=F.blob("k", 100), dtbo=b"", dtb=F.blob("t", 64))
dtb = [c for c in image("boot", (data, meta))["components"] if c["role"] == "dtb"][0]
assert dtb["offset"] == 8192 and dtb["size_bytes"] == 64
ok("Android boot v0-v2 (four page sizes), v3 and v4, init_boot and literal os_version 0 parse to the independent expectation")

for role in ("vendor_boot", "vendor_kernel_boot"):
    for page in (2048, 4096, 8192, 16384):
        check_positive(role + "_a", F.vendor(3, page=page, ramdisk=F.blob("v", 4000), dtb=F.blob("d", 1500)))
        frags = [F.fragment("f0", 1000, 1), F.fragment("f1", 2500, 2), F.fragment("f2", 3, 3), F.fragment("f3", 77, 0)]
        got = check_positive(role + "_b", F.vendor(4, page=page, fragments=frags, dtb=F.blob("d", 1500),
                                                   bootconfig=F.blob("bc", 123)))
        assert got["table"]["entry_count"] == 4 and got["table"]["size_bytes"] == 432
        assert [c["ramdisk_type"] for c in got["components"] if c["role"] == "vendor_ramdisk_fragment"] == [1, 2, 3, 0]
    check_positive(role, F.vendor(3))
# count zero: the table object stays, hash is SHA-256 of empty and there is no table coverage range
got = check_positive("vendor_boot", F.vendor(4, dtb=F.blob("d", 10)))
assert got["table"]["entry_count"] == 0 and got["table"]["size_bytes"] == 0
assert got["table"]["sha256"] == F.EMPTY_SHA256 and len(got["coverage"]["ranges"]) == 1
# count 64, zero-size fragments at in-bounds offsets, and one empty name
many = [F.fragment(f"m{i}", 40 + i, i % 4) for i in range(64)]
got = check_positive("vendor_boot_a", F.vendor(4, fragments=many))
assert len(got["components"]) == 64 + 2
zero = [F.fragment("a", 100, 1), F.fragment("z1", 0, 2, name=b"", rel=100), F.fragment("z2", 0, 3, rel=0),
        F.fragment("b", 50, 2, rel=100)]
check_positive("vendor_boot_a", F.vendor(4, fragments=zero, section_size=150))
# table row order need not equal offset order
got = check_positive("vendor_boot_a", F.vendor(4, fragments=[
    F.fragment("late", 300, 1, rel=600), F.fragment("early", 600, 2, rel=0)], section_size=900))
assert [c["index"] for c in got["components"] if c["role"] == "vendor_ramdisk_fragment"] == [0, 1]
# adjacent header and table ranges merge when the page is the header span
ok("vendor_boot v3 and v4 (four page sizes, counts 0..64, reordered rows, zero-size fragments, one empty name) parse to the independent expectation")

for page in (2048, 4096, 8192, 16384):
    check_positive("dtbo_a", F.dt_table([F.blob("a", 300), F.blob("b", 41), F.blob("c", 1)], page=page))
check_positive("dtbo_b", F.dt_table([F.blob("only", 5)], trailing=bytes(1000)))
check_positive("dtbo", F.dt_table([F.blob("p", 10), b"", F.blob("q", 9)], entries_offset=96, gap=b""))
got = check_positive("dtbo", F.dt_table([F.blob(f"e{i}", 7) for i in range(256)]))
assert got["table"]["entry_count"] == 256 and len(got["components"]) == 256
got = check_positive("dtbo_a", F.dt_table([F.blob("a", 20)]))
assert len(got["coverage"]["ranges"]) == 1 and got["coverage"]["covered_bytes"] == 32 + 32, "header and table merge"
got = check_positive("dtbo_a", F.dt_table([F.blob("a", 20)], entries_offset=64))
assert len(got["coverage"]["ranges"]) == 2, "an explicit table offset leaves a gap uncovered"
unaligned_dt = F.dt_table([F.blob("unaligned", 17)])
assert len(unaligned_dt[0]) % unaligned_dt[1]["page_size"] != 0
check_positive("dtbo_a", unaligned_dt)
text = json.dumps(got)
for value in (F.CANARY_VALUE, F.CANARY_VALUE + 1):
    assert str(value) not in text, "DT id, revision and custom values are never emitted"
ok("DT table v0 (four page sizes, explicit table offset, trailing bytes, 1..256 entries, zero-size entries) parses; ids and revisions are not emitted")

# --- adversarial parsers -----------------------------------------------------------------

good_boot = {v: F.boot_legacy(v, kernel=F.blob("k", 3000), ramdisk=F.blob("r", 100)) for v in (0, 1, 2)}
good_boot.update({v: F.boot_modern(v, kernel=F.blob("k", 3000), ramdisk=F.blob("r", 100)) for v in (3, 4)})
for version, (data, _meta) in good_boot.items():
    for cut in (0, 1, 47, F.BOOT_HEADER[version] - 1):
        reject(f"boot v{version} truncated to {cut}", "boot_a", data[:cut], "image-corrupt")
    reject(f"boot v{version} cut inside the payload", "boot_a", data[:-5000], "image-corrupt")
    broken = bytearray(data)
    broken[0] ^= 0xFF
    reject(f"boot v{version} with a wrong magic", "boot_a", bytes(broken), "image-identity-mismatch")
    reject(f"boot v{version} under a vendor_boot name", "vendor_boot_a", data, "image-identity-mismatch")
    reject(f"boot v{version} under a dtbo name", "dtbo_a", data, "image-identity-mismatch")
for bad in (5, 6, 0x10000, 0xFFFFFFFF):
    data = bytearray(good_boot[0][0])
    data[40:44] = bad.to_bytes(4, "little")
    reject(f"boot version {bad}", "boot_a", bytes(data), "image-unsupported")
    data[40:44] = bad.to_bytes(4, "big")
    reject(f"boot version {bad} in the wrong endianness", "boot_a", bytes(data),
           "image-unsupported" if bad.to_bytes(4, "big") != b"\0\0\0\0" else "image-unsupported")
# the version field read big endian: 1 becomes 0x01000000
data = bytearray(good_boot[1][0])
data[40:44] = (1).to_bytes(4, "big")
reject("boot version written big endian", "boot_a", bytes(data), "image-unsupported")
reject("init_boot with a v3 image", "init_boot_a", good_boot[3][0], "image-unsupported")
reject("init_boot with a v2 image", "init_boot_a", good_boot[2][0], "image-unsupported")
reject("init_boot v4 with a kernel", "init_boot_a", F.boot_modern(4, kernel=F.blob("k", 10))[0], "image-unsupported")
for page, code in ((1024, "image-unsupported"), (32768, "image-unsupported"), (3000, "image-corrupt"),
                   (0, "image-corrupt"), (1, "image-unsupported"), (0xFFFFFFFF, "image-corrupt"),
                   (4097, "image-corrupt")):
    data = bytearray(good_boot[2][0])
    data[36:40] = page.to_bytes(4, "little")
    reject(f"boot page size {page}", "boot_a", bytes(data), code)
for version in (3, 4):
    data = bytearray(good_boot[version][0])
    data[20:24] = (F.BOOT_HEADER[3 if version == 4 else 4]).to_bytes(4, "little")
    reject(f"boot v{version} header_size of the other version", "boot_a", bytes(data), "image-corrupt")
    reject(f"boot v{version} header_size zero", "boot_a", F.boot_modern(version, header_size=0)[0], "image-corrupt")
for version in (1, 2):
    reject(f"boot v{version} header_size mismatch", "boot_a",
           F.boot_legacy(version, kernel=F.blob("k", 10), header_size=1)[0], "image-corrupt")
# recovery_dtbo offsets
reject("nonempty recovery_dtbo with a zero offset", "boot_a",
       F.boot_legacy(1, kernel=F.blob("k", 10), dtbo=F.blob("d", 10), dtbo_offset=0)[0], "image-corrupt")
reject("nonempty recovery_dtbo with a shifted offset", "boot_a",
