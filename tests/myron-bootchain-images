def rewrite(relative, edit):
    def mutate(target):
        path = target / relative
        value = json.loads(path.read_text())
        edit(value)
        path.write_bytes(jbytes(value))
        sums = "".join(f"{digest((target / p).read_bytes())}  {p}\n" for p in ("operations/" + R3 + ".json", "parse.json"))
        (target / "SHA256SUMS").write_text(sums)
    return mutate


