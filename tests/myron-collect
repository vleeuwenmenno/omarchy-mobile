def operation_document(operation_id, req_sha=None, data=None, **overrides):
    value = {
        "schema": 1, "kind": C.OPERATION_KIND, "id": operation_id,
        "request_sha256": req_sha or request_sha256, "transport": C.TRANSPORT,
        "read_only": True, "bytes_read": 4096,
        "data": copy.deepcopy(data if data is not None else DATA[operation_id]),
    }
    value.update(overrides)
    return value


def write_capture(path, documents=None, raw=None, manifest_edit=None, req_sha=None):
    """Write a capture tree; DOCUMENTS and RAW override per-operation content."""
    documents = documents or {}
    raw = raw or {}
    (path / "operations").mkdir(parents=True)
    files = {}
    for operation_id in OPERATION_IDS:
        name = f"operations/{operation_id}.json"
        files[name] = raw.get(operation_id) or D.render_json(
            documents.get(operation_id) or operation_document(operation_id, req_sha)
        )
        (path / name).write_bytes(files[name])
        (path / name).chmod(0o644)
    manifest = C.manifest_document(
        envs, req_sha or request_sha256, request_document, files
    )
    if manifest_edit:
        manifest_edit(manifest)
    (path / "capture.json").write_bytes(D.render_json(manifest))
    (path / "capture.json").chmod(0o644)
    (path / "operations").chmod(0o755)
    path.chmod(0o755)


