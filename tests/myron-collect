def digest(data):
    return hashlib.sha256(data).hexdigest()


def ok(name):
    print(f"ok - {name}")


counter = [0]


def fresh(name):
    counter[0] += 1
    path = work / f"{name}-{counter[0]}"
    path.mkdir()
    return path


def invoke(*arguments, root=None):
    out, err = io.StringIO(), io.StringIO()
    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
        try:
            code = C.main([str(value) for value in arguments], contracts_root=root or contracts_root)
        except SystemExit as error:
            code = error.code
    return code, out.getvalue(), err.getvalue()


def expect_ok(*arguments, **kwargs):
    code, out, err = invoke(*arguments, **kwargs)
    assert code == 0, (arguments, err)
    return json.loads(out), out


def expect_fail(name, arguments, *outputs, match=None, **kwargs):
    code, out, err = invoke(*arguments, **kwargs)
    assert code != 0, f"{name}: accepted\n{out}"
    if match is not None:
        assert match in err, f"{name}: expected {match!r}, got {err!r}"
    for output in outputs:
        assert not os.path.lexists(output), f"{name}: left output {output}"
    ok(f"{name} is rejected")
    return err


def walk(path):
    descriptor = D.open_canonical_dir(str(path), "test tree")
    try:
        tree = D.walk_tree(descriptor, D.STAGE_LIMITS, allow_symlinks=False, keep_data=True)
    finally:
        os.close(descriptor)
    return tree.entries, tree.data


