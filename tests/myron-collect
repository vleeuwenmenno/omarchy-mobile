    else:
        raise AssertionError(f"identifier hidden beside a hash was accepted: {hostile}")
ok("underscore, hyphen, suffixed and boundary excluded names reject; lookalikes and hashes pass")

# 5. R5 list bound is 256.
def r5_list(count):
    document = operation_document(R5)
    document["data"] = {
        "module_names": [f"m{i}" for i in range(count)], "load_order_index": list(range(count)),
        "taint_flags": [""] * count, "order_matches_declared": False,
    }
    return D.render_json(document)


C.validate_operation(r5_list(256), R5_SPEC, request_sha256, envs.identity)
for count in (257, 1024):
    try:
        C.validate_operation(r5_list(count), R5_SPEC, request_sha256, envs.identity)
    except C.CollectError as error:
        assert "R5 module names must hold 0..256 entries" in str(error), error
    else:
        raise AssertionError(f"{count} modules accepted")
ok("R5 accepts 256 modules and rejects 257 with the list-bound error")

