        assert r5_error(word.replace("_", "")) is None, word
    for form in (f"{word}x", f"x{word}", f"{word}s9", f"{word}_x".replace("_x", "x")):
        assert r5_error(form) is None, (form, r5_error(form))
bad_capture("android_id module name", {R5: lambda d: d["data"]["module_names"].__setitem__(
    2, "android_id")}, match="excluded identifier or payload field")
