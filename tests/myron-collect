def consistency_drift(name, apply, restore):
    """A drift that contradicts the registry's own bounds stops every command instead."""
    apply()
    try:
        code, _out, err = invoke("show")
        assert code != 0 and "policy registry is inconsistent" in err, (name, err)
        try:
            C.policy_registry()
        except C.CollectError:
            pass
        else:
            raise AssertionError(f"{name}: contradictory registry served")
    finally:
        restore()
    code, _out, err = invoke("show")
    assert code == 0, err
    ok(f"{name} contradicts the registry and stops every command")


