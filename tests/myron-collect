def tool_copy(name, edit=None):
    """A private copy of tools/ whose collector source is edited, loaded as its own module."""
    base = fresh(name)
    (base / "packages").mkdir()
    for part in ["tools", *(f"packages/{p.name}" for p in (repo / "packages").glob("omamobile-myron-*"))]:
        shutil.copytree(repo / part, base / part, ignore=shutil.ignore_patterns("__pycache__"))
    source = base / "tools/lib/myron-collect-impl.py"
    if edit is not None:
        text = source.read_text()
        edited = edit(text)
        assert edited != text, f"{name}: edit changed nothing"
        source.write_text(edited)
    return base, load(f"collect_copy_{counter[0]}", base / "tools/myron-collect")


