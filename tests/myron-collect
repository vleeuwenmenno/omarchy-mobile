#!/bin/bash
# SPDX-License-Identifier: MIT
# Offline tests for the bounded Myron pre-captured fixture collector.
set -euo pipefail
export LC_ALL=C
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }
tmp=$(mktemp -d)
trap 'chmod -R u+rwx "$tmp" 2>/dev/null || true; rm -rf "$tmp"' EXIT
export PYTHONPYCACHEPREFIX="$tmp/pycache"
tmp=$(realpath "$tmp")

impl=tools/lib/myron-collect-impl.py
python3 -m py_compile tools/myron-collect "$impl" || fail "tool parses"
for f in tools/myron-collect "$impl"; do
  grep -Eq '^(import|from) (subprocess|shutil|socket|urllib|http|ctypes|ssl|requests)|os\.(system|popen|exec|spawn|fork)|posix_spawn' "$f" \
    && fail "$f references process, network, or broad-copy facilities"
  grep -Eqi '\b(adb|fastboot|ssh|scp|rsync|curl|wget)\b' "$f" \
    && fail "$f names a live transport command"
done
grep -q 'external-precaptured-fixture' "$impl" || fail "tool lacks the fixture transport"
[[ $(wc -l < tools/myron-collect) -le 90 ]] || fail "the trusted loader grew past 90 lines"
pass "loader and implementation parse and have no process, network, broad-copy, or live-transport facility"

tools/myron-collect show > "$tmp/show.json" || fail "repository capture contract failed"
python3 - "$tmp/show.json" <<'PY' || exit 1
import hashlib, json, sys
value = json.load(open(sys.argv[1]))
assert value["kind"] == "myron-capture-collector-contract"
assert value["format_version"] == "0.1.0"
assert value["pinned_versions"] == {
    "deployment": "0.4.0", "preflight": "0.2.0", "snapshot": "0.2.0",
}
assert value["transport"] == "external-precaptured-fixture"
assert value["capture_schema"] == "myron-capture-evidence-v1"
assert len(value["blockers"]) == 7
assert len(value["authority"]) == 9 and all(v is False for v in value["authority"].values())
assert value["evidence"]["level"] == "artifact-structure-only"
assert value["evidence"]["live"] is False and value["evidence"]["executes"] is False
assert value["evidence"]["kit_snapshot_reverified"] is False
assert value["evidence"]["remote_commands"] == []
pinned = value["components"]["preflight_contract"]
assert pinned["path"] == "device/myron/preflight-contract.json"
assert pinned["sha256"] == hashlib.sha256(
    open("device/myron/preflight-contract.json", "rb").read()
).hexdigest()
preflight = json.load(open("device/myron/preflight-contract.json"))
assert "capture-contract" not in json.dumps(preflight), "pin must be one-way"
PY
pass "repository contract is canonical, one-way pinned, and authorizes nothing"

