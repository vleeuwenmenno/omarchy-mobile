def padded_metadata(name, version, covered_total):
    """A metadata-only image whose coverage totals exactly COVERED_TOTAL bytes."""
    image = make(name, version)
    base = image["coverage"]["covered_bytes"]
    last = max(c["offset"] + c["size_bytes"] for c in image["components"])
    start = last + 4096
