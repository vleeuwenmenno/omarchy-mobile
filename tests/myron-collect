def drift(name, apply, restore):
    apply()
    try:
        drifted = D.render_json(
            C.expected_capture_contract(D.sha256_bytes(preflight_bytes), contracts)
        )
        assert drifted != baseline, f"{name}: contract did not change"
        assert digest(drifted) != digest(baseline)
        try:
            C.load_capture_contract(contracts_root, D.sha256_bytes(preflight_bytes), contracts)
        except C.CollectError as error:
            assert "differs from its derived form" in str(error), error
        else:
            raise AssertionError(f"{name}: repository contract accepted after drift")
        code, _out, err = invoke("show")
        assert code != 0 and "differs from its derived form" in err, err
    finally:
        restore()
    assert D.render_json(
        C.expected_capture_contract(D.sha256_bytes(preflight_bytes), contracts)
    ) == baseline
    ok(f"{name} changes the derived contract and the repository contract is refused")


