# Over-depth documents never reach the canonical renderer.
renders = []
real_render = D.render_json


def counting_render(value):
    if type(value) is dict and type(value.get("data")) is list:  # only the hostile document
        renders.append(True)
    return real_render(value)


def deep(levels):
    return b'{"data": ' + b"[" * levels + b"]" * levels + b"}"


def refused_before_render(label, call, levels):
    renders.clear()
    try:
        call()
    except C.CollectError as error:
        assert "nests too deeply" in str(error), (label, error)
    else:
        raise AssertionError(f"{label}: over-depth document accepted")
    assert not renders, f"{label}: the renderer ran on a {levels}-deep document"


big_spec = {**READS[0], "max_bytes": 1024 * 1024}
for levels in (C.MAX_DEPTH + 1, C.PLAN_MAX_DEPTH + 1, 800):
    raw = deep(levels)
    assert len(raw) < 1024 * 1024
    manifest_capture = fresh("deep-manifest") / "capture"
    write_capture(manifest_capture)
    (manifest_capture / "capture.json").write_bytes(raw)
    plan_path = fresh("deep-plan") / "plan.json"
    plan_path.write_bytes(raw)

    def verify_plan():
        code, _out, err = invoke("verify-plan", "--request", request, "--plan", plan_path)
        assert code != 0, "plan: over-depth document accepted"
        if "nests too deeply" not in err:
            raise AssertionError(err)
        raise C.CollectError("nests too deeply")

    D.render_json = counting_render
    try:
        refused_before_render("operation", lambda: C.validate_operation(
            raw, big_spec, request_sha256, envs.identity), levels)
        refused_before_render("manifest", lambda: C.read_capture(
            str(manifest_capture), envs, request_document, request_sha256), levels)
        if levels > C.PLAN_MAX_DEPTH:
            refused_before_render("plan", verify_plan, levels)
    finally:
        D.render_json = real_render
    ok(f"a {levels}-deep operation and manifest (and plan, past its bound) are refused before the canonical renderer runs")

