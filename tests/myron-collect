def rule_image(image_hash=None, table=None, components=(), header_hash=HASH_A, size=1 << 20):
    return [{"image": {
        "size_bytes": size, "sha256": image_hash,
        "header": {"offset": 0, "size_bytes": 512, "sha256": header_hash},
