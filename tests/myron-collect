def bad_capture(name, edit=None, *, raw=None, manifest_edit=None, req_sha=None, documents=None,
                match=None):
    """Build a capture whose manifest is regenerated, so only validators can object."""
    base = fresh("capture-tamper") / "capture"
    docs = documents or {}
    if edit:
        for operation_id, mutate in edit.items():
            document = operation_document(operation_id)
            mutate(document)
            docs[operation_id] = document
    write_capture(base, docs, raw, manifest_edit, req_sha)
    out = work / f"tamper-out-{counter[0]}"
    expect_fail(name, ["collect", "--request", request, "--capture", base, "--out", out], out,
                match=match)
    return base


