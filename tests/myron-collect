def tampered_evidence(name, mutate_document=None, mutate_files=None, match=None):
    clone = fresh("evidence-tamper") / "evidence"
    shutil.copytree(evidence_a, clone)
    if mutate_document:
        value = json.loads((clone / "evidence.json").read_text())
        mutate_document(value)
        (clone / "evidence.json").write_bytes(D.render_json(value))
    if mutate_files:
        mutate_files(clone)
    files = ["STATUS.txt", "contracts/capture-contract.json", "evidence.json", "status.json"]
    (clone / "SHA256SUMS").write_text("".join(
        f"{digest((clone / path).read_bytes())}  {path}\n" for path in files
    ))
    expect_fail(name, ["verify-evidence", *args(), "--evidence", clone], match=match)


