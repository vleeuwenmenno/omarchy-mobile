# Admission races: the tree changes after the listing, while the descriptors are being pinned.
# Every case must refuse before ONE payload byte is read, and the injection must really fire.
def admission_race(label, hooks, match):
    base = fresh("admission") / "reads"
    write_reads(base)
    out = work / f"admission-out-{counter[0]}"
    fired = []
    real_open = D.open_pinned_regular_at

    def factory(original):
        def patched(directory_fd, name, description):
            hook = hooks.get((name, "before")) if name in S.CLOSURE else None
            if hook:
                fired.append((name, "before"))
                hook(base)
            result = original(directory_fd, name, description)
            hook = hooks.get((name, "after")) if name in S.CLOSURE else None
            if hook:
                fired.append((name, "after"))
                hook(base)
            return result
        return patched

    with_patch(D, "open_pinned_regular_at", factory, lambda: expect_fail(
        label, ["rehearse", "--request", request, "--reads", base, "--out", out], out,
        match=match, untouched=base))
    assert fired, f"{label}: the injection never ran"
    assert D.open_pinned_regular_at is real_open
    return base


def unlink(name):
    return lambda base: (base / name).unlink()


def add_file(base):
    (base / "late-extra.bin").write_bytes(b"x" * 6949)


def rename_away(name):
    return lambda base: (base / name).rename(base / (name + ".moved"))


def make_executable(name):
    return lambda base: (base / name).chmod(0o755)


def replace_with_copy(name):
    def apply(base):
        (base / "swap.tmp").write_bytes((base / name).read_bytes())
        (base / "swap.tmp").chmod(0o644)
        os.replace(base / "swap.tmp", base / name)
    return apply


def grow(name):
    def apply(base):
        with (base / name).open("ab") as stream:
            stream.write(b" ")
    return apply


