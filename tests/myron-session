SUM_FILES = lambda root: sorted(
    str(p.relative_to(root)) for p in root.rglob("*") if p.is_file() and p.name != "SHA256SUMS")


def reseal(clone):
    (clone / "SHA256SUMS").write_text("".join(
        f"{digest((clone / name).read_bytes())}  {name}\n" for name in SUM_FILES(clone)))


def tampered(name, mutate_files=None, *, resum=True, match=None, absent=()):
    clone = fresh("rehearsal-tamper") / "rehearsal"
    shutil.copytree(rehearsal_a, clone)
    if mutate_files:
        mutate_files(clone)
    if resum:
        reseal(clone)
    return expect_fail(name, ["verify-rehearsal", *args(), "--rehearsal", clone], match=match, absent=absent)


