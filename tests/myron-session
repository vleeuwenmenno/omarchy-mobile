def tool_copy(name, edit=None):
    """A private copy of tools/ with its own session source, loaded as its own module."""
    base = fresh(name)
    (base / "packages").mkdir()
    for part in ["tools", *(f"packages/{p.name}" for p in (repo / "packages").glob("omamobile-myron-*"))]:
