def manifest_document(files, req_sha=None, **overrides):
    value = {
        "schema": 1, "kind": S.READS_KIND, "format_version": "0.1.0",
        "session_contract_sha256": SC, "request_sha256": req_sha or request_sha256,
        "synthetic": True,
        "files": [{"path": name, "bytes": len(files[name]), "sha256": digest(files[name])}
                  for name in sorted(files)],
    }
    value.update(overrides)
    return value


def write_reads(path, edits=None, drop=(), manifest_edit=None, manifest_raw=None, req_sha=None,
                keep_manifest_rows=False):
    """Write the flat closure; EDITS replace file bytes and the manifest is regenerated."""
    files = good_files()
    original = copy.deepcopy(files)
    for name, data in (edits or {}).items():
        files[name] = data
    path.mkdir(parents=True)
    manifest_files = original if keep_manifest_rows else files
    manifest = manifest_document(manifest_files, req_sha)
    if manifest_edit:
        manifest_edit(manifest)
    raw = manifest_raw if manifest_raw is not None else jbytes(manifest)
    for name, data in {**files, "reads.json": raw}.items():
        if name in drop:
            continue
        (path / name).write_bytes(data)
        (path / name).chmod(0o644)
    path.chmod(0o755)
    return files


