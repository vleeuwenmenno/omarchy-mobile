# Changes during the captured-descriptor reads fail for instability, never for a later manifest mismatch.
def during_read(label, victim_name, mutate, match, nth=1):
    base = fresh("during-read") / "reads"
    write_reads(base)
    victim = str(base / victim_name)
    seen, fired = [0], []
    original = os.read

    def patched(descriptor, count):
        try:
            target = os.readlink(f"/proc/self/fd/{descriptor}")
        except OSError:
            target = ""
        if target == victim:
            seen[0] += 1
            if seen[0] == nth:
                fired.append(True)
                mutate(base)
        return original(descriptor, count)

    out = work / f"during-read-out-{counter[0]}"
    os.read = patched
    try:
        err = expect_fail(label, ["rehearse", "--request", request, "--reads", base, "--out", out], out,
                          match=match)
    finally:
        os.read = original
    assert fired, f"{label}: the injection never ran"
    assert "differs from the file" not in err, f"{label}: failed on a manifest mismatch, not instability"


def append_bytes(name, extra=b"extra\t\n"):
    def apply(base):
        with (base / name).open("ab") as stream:
            stream.write(extra)
    return apply


def overwrite_same_size(name):
    def apply(base):
        data = (base / name).read_bytes()
        with (base / name).open("r+b") as stream:
            stream.write(bytes([data[0] ^ 1]) + data[1:])
    return apply


def truncate(name, cut=3):
    return lambda base: (base / name).write_bytes((base / name).read_bytes()[:-cut])


