# Mount crossing: inside the reads read, report a different mount for every descriptor after the first.
real_mount = K.mount_id_for_fd


def crossing_reader(original):
    def patched(*a, **kw):
        mounts = [0]

        def crossing_mount(descriptor, label):
            mounts[0] += 1
            return real_mount(descriptor, label) + (mounts[0] > 1)

        K.mount_id_for_fd = crossing_mount
        try:
            return original(*a, **kw)
        finally:
            K.mount_id_for_fd = real_mount
    return patched


