#!/bin/bash
# SPDX-License-Identifier: MIT
# Offline tests for the metadata-only Myron snapshot/rollback candidate.
set -euo pipefail
export LC_ALL=C
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }
tmp=$(mktemp -d)
trap 'chmod -R u+rwx "$tmp" 2>/dev/null || true; rm -rf "$tmp"' EXIT
export PYTHONPYCACHEPREFIX="$tmp/pycache"
tmp=$(realpath "$tmp")

python3 -m py_compile tools/myron-snapshot || fail "tool parses"
grep -Eq '^(import|from) (subprocess|shutil)|os\.(system|popen|exec|spawn|fork)|posix_spawn' tools/myron-snapshot \
  && fail "tool references process-spawning or broad-copy facilities"
pass "tool parses and spawns nothing"

tools/myron-snapshot show > "$tmp/show.json" || fail "repository snapshot contract failed"
python3 - "$tmp/show.json" <<'PY' || exit 1
import json, sys
value = json.load(open(sys.argv[1]))
assert value["kind"] == "myron-snapshot-candidate-contract"
assert value["format_version"] == "0.1.0"
assert len(value["blockers"]) == 7
assert value["snapshot"]["capture_status"] == "not-captured"
assert value["snapshot"]["quiescence"] == "not-proven"
assert value["rollback"]["status"] == "not-proven"
for flag in (
    "atomicity_proven", "rollback_proven", "deployment_authorized", "bootable",
    "flashable", "image_ready", "hardware_qualified", "atomic_snapshot_proof",
):
    assert value[flag] is False
PY
pass "repository snapshot contract is canonical and refuses every authority claim"

python3 - "$PWD" "$tmp" <<'PY' || exit 1
