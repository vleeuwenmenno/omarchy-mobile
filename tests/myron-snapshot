S = load("snapshot_tool_test", repo / "tools/myron-snapshot")
K = D.kernel()


def digest(data):
    return hashlib.sha256(data).hexdigest()


def canonical(value):
    return (json.dumps(value, indent=2, sort_keys=True) + "\n").encode()


def ok(name):
    print(f"ok - {name}")


counter = [0]


def fresh(name):
    counter[0] += 1
    path = work / f"{name}-{counter[0]}"
    path.mkdir()
    return path


