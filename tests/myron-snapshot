def make_rootfs(fixture):
    base = fresh("rootfs")
    tree = base / "omamobile-rootfs-stage-synthetic-aarch64"
    (tree / "etc/systemd/system").mkdir(parents=True)
    for script in (
        "packages/omamobile-device-myron/install",
        "packages/omamobile-myron-kernel-contract/install",
        "packages/omamobile-myron-gpu-profile/install",
        "packages/omamobile-myron-gpu-profile/test/stage-mesa-fixture",
    ):
        subprocess.run([str(repo / script), str(tree)], check=True, stdout=subprocess.DEVNULL)
    share = tree / "usr/share/omamobile/myron-kernel-contract"
    (share / "reference.json").write_bytes(fixture["reference_bytes"])
    (share / "stage-contract.json").write_bytes(fixture["stage_bytes"])
    (tree / "usr/lib/firmware").mkdir(parents=True)
    (tree / "usr/lib/firmware/regulatory.db").write_bytes(b"")
    (tree / "usr/lib/firmware/regulatory.db.p7s").write_bytes(b"")
    manifest = Path(str(tree) + ".MANIFEST")
    manifest.write_text(
        "# Omarchy Mobile root STAGE (not bootable, not an image)\n"
        "version: synthetic\n"
        "rootfs integration: external-contract\n"
        "rootfs package profile: myron\n"
        "package closure: required present; forbidden absent\n"
        "kernel modules: none (external contract, no module payload)\n"
        "boot payload: none; proprietary payload: none\n"
    )
    return tree, manifest


def invoke(module, root, *arguments):
    out, err = io.StringIO(), io.StringIO()
    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
        try:
            code = module.main([str(item) for item in arguments], contracts_root=root)
        except SystemExit as error:
            code = error.code
    return code, out.getvalue(), err.getvalue()


def deploy_ok(root, *arguments):
    code, out, err = invoke(D, root, *arguments)
    assert code == 0, err
    return json.loads(out)


def snapshot_args(kit, rootfs, manifest, archive):
    return (
        "--kit", kit,
        "--rootfs-stage", rootfs,
        "--rootfs-manifest", manifest,
        "--assets", archive,
        "--runtime-assets", "none",
        "--vmlinux-symvers", "none",
        "--module-symvers", "none",
    )


def snapshot_ok(root, *arguments):
    code, out, err = invoke(S, root, *arguments)
    assert code == 0, err
    return json.loads(out)


def snapshot_fail(name, root, arguments, *outputs):
    code, out, err = invoke(S, root, *arguments)
    assert code != 0, f"{name}: accepted\n{out}"
    for output in outputs:
        assert not os.path.lexists(output), f"{name}: left output {output}"
    ok(f"{name} is rejected")


def walk(path, *, allow_symlinks=False):
    descriptor = D.open_canonical_dir(str(path), "test tree")
    try:
        tree = D.walk_tree(
            descriptor, D.ROOTFS_LIMITS, allow_symlinks=allow_symlinks, keep_data=True
        )
    finally:
        os.close(descriptor)
    return tree.entries, tree.data


fixture = make_fixture()
rootfs, rootfs_manifest = make_rootfs(fixture)
stage = work / "module-stage"
deploy_ok(fixture["root"], "stage-modules", "--assets", fixture["archive"], "--out", stage)
kit = work / "kit"
deploy_ok(
    fixture["root"], "assemble",
    "--rootfs-stage", rootfs, "--rootfs-manifest", rootfs_manifest,
    "--module-stage", stage, "--assets", fixture["archive"],
    "--runtime-assets", "none", "--vmlinux-symvers", "none",
    "--module-symvers", "none", "--out", kit,
)
base_args = snapshot_args(kit, rootfs, rootfs_manifest, fixture["archive"])

# Deterministic exact closure.
snapshot_a = work / "snapshot-a"
snapshot_b = work / "snapshot-b"
bound = snapshot_ok(fixture["root"], "bind", *base_args, "--out", snapshot_a)
snapshot_ok(fixture["root"], "bind", *base_args, "--out", snapshot_b)
assert walk(snapshot_a) == walk(snapshot_b)
entries, data = walk(snapshot_a)
assert sorted(e.path for e in entries if e.kind == "file") == [
    "SHA256SUMS", "STATUS.txt", "contracts/snapshot-contract.json",
    "snapshot.json", "status.json",
]
assert {e.path for e in entries if e.kind == "dir"} == {".", "contracts"}
assert bound["capture_status"] == "not-captured"
assert bound["atomicity_proven"] is False and bound["rollback_proven"] is False
assert bound["deployment_authorized"] is False
document = json.loads(data["snapshot.json"])
assert document["status"]["blockers"] == D.BLOCKERS
assert document["capture"] == {
    "generation": 0, "method": "synthetic-offline", "quiescence": "not-proven",
    "source_kind": "directory", "status": "not-captured",
}
assert not any(marker in b"".join(data.values()) for marker in (b"vermagic=", b"SECRET"))
ok("bind is deterministic and writes only five refusal-preserving metadata files")

verified = snapshot_ok(fixture["root"], "verify", *base_args, "--snapshot", snapshot_a)
assert verified["status"] == "verified" and verified["deployment_authorized"] is False
ok("verify recomputes the deployment kit and every snapshot binding")

# A manifest path replaced after kit verification must never become the bound
# identity. The already-verified kit is the source of that generation's hash.
manifest_a = rootfs_manifest.read_bytes()
manifest_b = manifest_a + b"replacement-after-verification\n"
real_verify_deployment = S.verify_deployment
replaced = [False]


def replace_manifest_after_verify(contracts, args):
    report = real_verify_deployment(contracts, args)
    if not replaced[0]:
        replaced[0] = True
        rootfs_manifest.write_bytes(manifest_b)
    return report


S.verify_deployment = replace_manifest_after_verify
manifest_race_snapshot = work / "snapshot-manifest-race"
try:
    result = snapshot_ok(
        fixture["root"], "bind", *base_args, "--out", manifest_race_snapshot
    )
finally:
    S.verify_deployment = real_verify_deployment
    rootfs_manifest.write_bytes(manifest_a)
assert result["status"] == "bound"
_, race_data = walk(manifest_race_snapshot)
race_document = json.loads(race_data["snapshot.json"])
assert race_document["bindings"]["rootfs"]["manifest_sha256"] == digest(manifest_a)
assert race_document["bindings"]["rootfs"]["manifest_sha256"] != digest(manifest_b)
snapshot_ok(
    fixture["root"], "verify", *base_args, "--snapshot", manifest_race_snapshot
)
ok("manifest replacement after verification cannot alter the kit-bound identity")

# Keeping the old checksum list while replacing kit.json after verification
# must not let the replacement supply a new manifest identity.
kit_document_a = (kit / "kit.json").read_bytes()
real_verify_deployment = S.verify_deployment
replaced = [False]


def replace_kit_document_after_verify(contracts, args):
    report = real_verify_deployment(contracts, args)
    if not replaced[0]:
        replaced[0] = True
        value = json.loads(kit_document_a)
        value["rootfs"]["manifest_sha256"] = "0" * 64
        (kit / "kit.json").write_bytes(D.render_json(value))
    return report


S.verify_deployment = replace_kit_document_after_verify
kit_race_snapshot = work / "snapshot-kit-race"
try:
    snapshot_fail(
        "kit.json replacement after verification", fixture["root"],
        ["bind", *base_args, "--out", kit_race_snapshot], kit_race_snapshot,
    )
finally:
    S.verify_deployment = real_verify_deployment
    (kit / "kit.json").write_bytes(kit_document_a)
ok("post-verification kit replacement cannot alter bound rootfs evidence")

# Read-only rollback rehearsal: match is not proof; any content or metadata drift fails.
rollback = fresh("rollback") / "tree"
shutil.copytree(rootfs, rollback, symlinks=True)
result = snapshot_ok(
    fixture["root"], "rehearse-rollback", "--snapshot", snapshot_a, "--tree", rollback
)
assert result["status"] == "digest-match"
assert result["atomicity_proven"] is False and result["rollback_proven"] is False
(rollback / "tmp").mkdir(mode=0o777)
(rollback / "tmp").chmod(0o1777)
code, out, err = invoke(
    S, fixture["root"], "rehearse-rollback", "--snapshot", snapshot_a, "--tree", rollback
)
assert code == 1 and not err and json.loads(out)["status"] == "digest-mismatch"
(rollback / "tmp").rmdir()


def mismatch(name, mutate):
    clone = fresh("rollback-mismatch") / "tree"
    shutil.copytree(rootfs, clone, symlinks=True)
    mutate(clone)
    code, out, err = invoke(
        S, fixture["root"], "rehearse-rollback", "--snapshot", snapshot_a, "--tree", clone
    )
    assert code == 1 and not err, (name, out, err)
    value = json.loads(out)
    assert value["status"] == "digest-mismatch"
    assert value["atomicity_proven"] is False and value["rollback_proven"] is False


mismatch("changed byte", lambda t: (t / "usr/share/omamobile/device-myron/version").write_bytes(b"changed\n"))
mismatch("changed mode", lambda t: os.chmod(t / "usr/share/omamobile/device-myron/version", 0o600))
mismatch("added file", lambda t: (t / "extra").write_bytes(b"x"))
mismatch("removed file", lambda t: (t / "usr/share/omamobile/device-myron/version").unlink())
mismatch("unfollowed symlink", lambda t: (t / "escape").symlink_to("/etc/passwd"))
ok("rollback rehearsal matches only a byte-and-mode-identical tree and proves nothing")

for name, mutation in (
    ("hardlink", lambda t: os.link(t / "usr/share/omamobile/device-myron/version", t / "linked")),
    ("special file", lambda t: os.mkfifo(t / "fifo")),
):
    clone = fresh("unsafe-tree") / "tree"
    shutil.copytree(rootfs, clone, symlinks=True)
    mutation(clone)
    snapshot_fail(
        name, fixture["root"],
        ["rehearse-rollback", "--snapshot", snapshot_a, "--tree", clone],
    )

# Strict document and authority refusal. The checksum mismatch cannot mask the
# stronger document validator because snapshot.json is parsed first.
def tampered_snapshot(name, mutate):
    clone = fresh("snapshot-tamper") / "snapshot"
    shutil.copytree(snapshot_a, clone)
    value = json.loads((clone / "snapshot.json").read_text())
    mutate(value)
    (clone / "snapshot.json").write_bytes(D.render_json(value))
    files = [
        "STATUS.txt", "contracts/snapshot-contract.json", "snapshot.json", "status.json"
    ]
    (clone / "SHA256SUMS").write_text("".join(
        f"{digest((clone / path).read_bytes())}  {path}\n" for path in files
    ))
    snapshot_fail(
        name, fixture["root"], ["verify", *base_args, "--snapshot", clone]
    )


tampered_snapshot("unknown snapshot field", lambda v: v.update(extra=True))
tampered_snapshot("boolean snapshot schema", lambda v: v.update(schema=True))
tampered_snapshot("floating snapshot schema", lambda v: v.update(schema=1.0))
tampered_snapshot("boolean capture generation", lambda v: v["capture"].update(generation=False))
tampered_snapshot("floating capture generation", lambda v: v["capture"].update(generation=0.0))
tampered_snapshot("false atomicity claim", lambda v: v["status"].update(atomicity_proven=True))
tampered_snapshot("false rollback claim", lambda v: v["status"].update(rollback_proven=True))
tampered_snapshot("false deployment claim", lambda v: v["status"].update(deployment_authorized=True))
tampered_snapshot("changed capture status", lambda v: v["capture"].update(status="captured"))
tampered_snapshot("changed quiescence", lambda v: v["capture"].update(quiescence="proven"))
tampered_snapshot("changed rollback status", lambda v: v["rollback"].update(status="proven"))
tampered_snapshot("changed blocker", lambda v: v["status"]["blockers"].pop())
tampered_snapshot("changed contract hash", lambda v: v.update(contract_sha256="0" * 64))
tampered_snapshot("changed runtime digest", lambda v: v["bindings"]["runtime"].update(digest="0" * 64))
tampered_snapshot("changed ABI scope", lambda v: v["bindings"]["abi"].update(scope="full"))
ok("strict snapshot schema rejects tamper and every authority claim")

# Non-canonical JSON and checksum closure tamper.
clone = fresh("snapshot-noncanonical") / "snapshot"
shutil.copytree(snapshot_a, clone)
(clone / "snapshot.json").write_text(json.dumps(document))
snapshot_fail("non-canonical snapshot JSON", fixture["root"], ["verify", *base_args, "--snapshot", clone])
clone = fresh("snapshot-sums") / "snapshot"
shutil.copytree(snapshot_a, clone)
(clone / "SHA256SUMS").write_bytes(b"0" * 64 + b"  snapshot.json\n")
snapshot_fail("changed checksum closure", fixture["root"], ["verify", *base_args, "--snapshot", clone])

# Deployment input tamper is caught before a snapshot can be bound or verified.
bad_archive = fresh("bad-archive") / "assets.tar.gz"
bad_archive.write_bytes(fixture["archive"].read_bytes() + b"x")
snapshot_fail(
    "changed module archive", fixture["root"],
    ["verify", *snapshot_args(kit, rootfs, rootfs_manifest, bad_archive), "--snapshot", snapshot_a],
)
bad_manifest = fresh("bad-manifest") / "rootfs.MANIFEST"
bad_manifest.write_bytes(rootfs_manifest.read_bytes() + b"changed\n")
snapshot_fail(
    "changed rootfs manifest", fixture["root"],
    ["verify", *snapshot_args(kit, rootfs, bad_manifest, fixture["archive"]), "--snapshot", snapshot_a],
)
bad_rootfs = fresh("bad-rootfs") / "rootfs"
shutil.copytree(rootfs, bad_rootfs, symlinks=True)
(bad_rootfs / "opt-drift").write_bytes(b"drift")
snapshot_fail(
    "changed rootfs", fixture["root"],
    ["verify", *snapshot_args(kit, bad_rootfs, rootfs_manifest, fixture["archive"]), "--snapshot", snapshot_a],
)
bad_kit = fresh("bad-kit") / "kit"
shutil.copytree(kit, bad_kit)
(bad_kit / "status.json").write_bytes(b"{}\n")
snapshot_fail(
    "changed deployment kit", fixture["root"],
    ["verify", *snapshot_args(bad_kit, rootfs, rootfs_manifest, fixture["archive"]), "--snapshot", snapshot_a],
)
ok("kit, rootfs, manifest and archive changes fail closed")

# Output safety and input preservation.
existing = work / "existing"
existing.mkdir()
snapshot_fail(
    "existing output", fixture["root"], ["bind", *base_args, "--out", existing]
)
inside = rootfs / "snapshot-output"
snapshot_fail(
    "output inside rootfs", fixture["root"], ["bind", *base_args, "--out", inside], inside
)
unsafe_parent = work / "unsafe-parent"
unsafe_parent.mkdir()
unsafe_parent.chmod(0o777)
try:
    snapshot_fail(
        "unsafe output parent", fixture["root"],
        ["bind", *base_args, "--out", unsafe_parent / "snapshot"],
        unsafe_parent / "snapshot",
    )
finally:
    unsafe_parent.chmod(0o700)
ok("publication refuses existing, overlapping and unsafe output paths")

# A distinct valid kit/rootfs generation cannot verify snapshot A.
rootfs_b, manifest_b = make_rootfs(fixture)
(rootfs_b / "opt-generation-b").write_bytes(b"generation-b")
stage_b = work / "module-stage-b"
deploy_ok(fixture["root"], "stage-modules", "--assets", fixture["archive"], "--out", stage_b)
kit_b = work / "kit-b"
deploy_ok(
    fixture["root"], "assemble",
    "--rootfs-stage", rootfs_b, "--rootfs-manifest", manifest_b,
    "--module-stage", stage_b, "--assets", fixture["archive"],
    "--runtime-assets", "none", "--vmlinux-symvers", "none",
    "--module-symvers", "none", "--out", kit_b,
)
snapshot_fail(
    "snapshot from another generation", fixture["root"],
    ["verify", *snapshot_args(kit_b, rootfs_b, manifest_b, fixture["archive"]),
     "--snapshot", snapshot_a],
)
ok("snapshot A cannot verify against a distinct valid kit generation")

# The tool itself never spawns a process.
def boom(*args, **kwargs):
    raise AssertionError("process spawn attempted")


saved = (os.system, os.fork, os.posix_spawn, os.execv, os.execvp)
os.system, os.fork, os.posix_spawn, os.execv, os.execvp = (boom,) * 5
try:
    snapshot_ok(fixture["root"], "verify", *base_args, "--snapshot", snapshot_a)
    snapshot_ok(
        fixture["root"], "rehearse-rollback", "--snapshot", snapshot_a, "--tree", rollback
    )
finally:
    os.system, os.fork, os.posix_spawn, os.execv, os.execvp = saved
ok("verify and rollback rehearsal spawn no process")
PY

pass "myron snapshot candidate tests passed"
