#!/bin/bash
# SPDX-License-Identifier: MIT
# The installer's tests (no phone, nothing flashed): tools/install-phone
# against a fake fastboot, tools/phone-provision against a synthetic backup
# (and a container standing in for the phone, with Docker), the initramfs's
# first-boot growth, the bring-up overlays, the simplefb trigger, the storage guard's packed
# allowlist and the USB product string, bin/omamobile's boot-image layouts
# and flash against a fake fastboot, omamobile-firstboot's own tests, and the
# smoke test of the newest root image in out/ if there is one, the Myron
# deployment/snapshot/preflight refusal gates, the collector's fixture checks, the synthetic session rehearsal, the synthetic GPT-to-R2 parser, the synthetic boot, vendor boot and DT table image-to-R3 parser, the synthetic device tree and DT table R4 count and index-membership parser, the external kernel-source bundle identity verifier and patch structure analyzer, the synthetic discovery-plan validator, the unsigned development repository's isolation, marker, lock and rootfs host-side tests and the aarch64 binfmt matrix, and the felix and myron packages' tests.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
for f in tools/install-phone tools/phone-provision tools/build-rootfs tools/build-packages tools/make-bundle tools/verify-myron-kernel-contract tools/verify-myron-gpu-profile tools/myron-dev-image-compose tools/myron-build-test-init-boot tools/myron-build-main-init-boot \
         tools/lib/alarm.sh tools/lib/dev-repo.sh tools/lib/alarm-setup tools/repo-build tools/repo-push rootfs/build-inside rootfs/lib/*.sh tests/*; do
  [[ -f $f ]] || continue   # tests/owl is the OWL conformance suite's folder
  bash -n "$f" || { echo "not ok - $f parses" >&2; exit 1; }
done
sh -n initramfs/init
sh -n device/flame/initramfs/init
sh -n device/flame/initramfs/build
bash -n tools/build-flame-probe
echo "ok - scripts parse"
for t in tests/pr-check tests/kernel-pr-check tests/install-phone tests/phone-provision tests/initramfs-grow tests/images-layout tests/device-overlays tests/simplefb-trigger tests/storage-guard tests/usb-product tests/boot-method tests/rootfs-stage tests/alarm-binfmt tests/dev-unsigned-repo tests/dev-unsigned-rootfs tests/kernel-contract tests/myron-deployment tests/myron-snapshot tests/myron-preflight tests/myron-collect tests/myron-session tests/myron-hardware-test tests/myron-main tests/myron-audio-experiment tests/myron-slot-a-success tests/myron-cellular-stage tests/myron-cellular-op tests/myron-cellular-start tests/myron-ipa-guard tests/myron-modemmanager-admission tests/myron-bluetooth-cooldown-logic tests/myron-bootchain tests/myron-bootchain-images tests/myron-bootchain-selection tests/myron-kernel-source tests/myron-discovery tests/flame-probe packages/omamobile-firstboot/test/all packages/omamobile-apps-myron/test/all packages/omamobile-device-felix/test/all packages/omamobile-myron-kernel-contract/test/all packages/omamobile-device-myron/test/all packages/omamobile-myron-gpu-profile/test/all; do
  echo "# $t"
  "$t"
done
shopt -s nullglob
latest=""
for f in out/omamobile-rootfs-*-aarch64.img.zst; do latest=$f; done
if [[ -n $latest ]]; then
  echo "# tests/rootfs-smoke $latest"
  tests/rootfs-smoke "$latest"
else
  echo "ok - # skip: no root image in out/ for tests/rootfs-smoke (tools/build-rootfs)"
fi
