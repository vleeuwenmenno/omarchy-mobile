# fault -> reason (the fault is a wrapper failure; "-trunc" makes a copy succeed but leave an empty file)
stage_fault() { # NAME FAULT_LINE REASON [PREP...]
  local name=$1 line=$2 reason=$3; shift 3
  make_stage "$name"
  [[ -z $line ]] || printf '%s\n' "${line//@R@/$R}" >"$R/fault"
  local prep; for prep in "$@"; do eval "${prep//@R@/$R}"; done
  run_stage "$name" || { cat "$R/out"; fail "stage($name): the driver itself failed"; }
  expect_fallback "$reason"
}
