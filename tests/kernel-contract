#!/bin/bash
# SPDX-License-Identifier: MIT
# Repository integration checks for the inert Myron kernel contract.
set -euo pipefail
export LC_ALL=C
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

cmp -s device/myron/kernel-contract.json \
  packages/omamobile-myron-kernel-contract/reference.json \
  || fail "canonical and packaged contracts differ"
cmp -s device/myron/stage-contract.json \
  packages/omamobile-myron-kernel-contract/stage-contract.json \
  || fail "canonical and packaged stage contracts differ"
grep -qx 'BOOT_METHOD=external-android' device/myron/device.conf \
  || fail "Myron boot method is no longer external-android"
grep -qx 'ROOTFS_PACKAGES="omamobile-myron-kernel-contract"' device/myron/device.conf \
  || fail "Myron descriptor does not request the verifier package"
pass "descriptor selects the exact metadata contract and remains fail closed"

mkdir -p "$tmp/fakes"
: > "$tmp/calls"
for command in ssh scp adb fastboot docker mount tar pacman depmod modprobe systemctl; do
  printf '#!/bin/sh\nprintf "%%s\\n" "%s $*" >> "$CALLS"\nexit 97\n' "$command" \
    > "$tmp/fakes/$command"
  chmod +x "$tmp/fakes/$command"
done
CALLS="$tmp/calls" PATH="$tmp/fakes:$PATH" \
  tools/verify-myron-kernel-contract show > "$tmp/reference.json" \
  || fail "read-only contract display failed"
[[ ! -s $tmp/calls ]] || fail "contract display invoked an external system tool"
python3 - "$tmp/reference.json" <<'PY' || exit 1
import json, sys
data = json.load(open(sys.argv[1]))
assert data["payload"] == {"kind": "metadata-only"}
assert data["activation"]["mode"] == "disabled"
assert data["activation"]["source_lock_reproduction"] == "not_verified"
assert data["module_assets"]["forbidden_modules"] == ["rmnet_core"]
assert data["device"]["boot_method"] == "external-android"
PY
pass "contract is read-only, metadata-only, and activation-disabled"

CALLS="$tmp/calls" PATH="$tmp/fakes:$PATH" \
  tools/verify-myron-kernel-contract show-stage > "$tmp/stage-contract.json" \
  || fail "read-only stage contract display failed"
python3 - "$tmp/stage-contract.json" device/myron/kernel-contract.json <<'PY' || exit 1
import hashlib, json, sys
stage = json.load(open(sys.argv[1]))
assert stage["reference_sha256"] == hashlib.sha256(open(sys.argv[2], "rb").read()).hexdigest()
assert stage["stage"]["kind"] == "external-kernel-module-stage"
assert stage["stage"]["activation"] == "disabled"
assert stage["stage"]["boot_payload"] is False and stage["stage"]["image"] is False
assert stage["stage"]["payload"] == "metadata-only"
PY
: > "$tmp/not-the-archive"
mkdir "$tmp/stage-root"
for args in "plan-stage --assets $tmp/not-the-archive" \
            "verify-stage --assets $tmp/not-the-archive --root $tmp/stage-root"; do
  # shellcheck disable=SC2086
  if CALLS="$tmp/calls" PATH="$tmp/fakes:$PATH" \
      tools/verify-myron-kernel-contract $args >/dev/null 2>&1; then
    fail "stage command accepted an archive that is not the qualified one"
  fi
done
[[ ! -s $tmp/calls ]] || fail "stage commands invoked an external system tool"
[[ -z $(ls -A "$tmp/stage-root") ]] || fail "stage verification wrote into the root"
pass "stage contract is bound to the reference; stage commands run no external tool and write nothing"

for args in "verify-abi --assets $tmp/not-the-archive --vmlinux-symvers $tmp/not-the-archive --module-symvers $tmp/not-the-archive"; do
  # shellcheck disable=SC2086
  if CALLS="$tmp/calls" PATH="$tmp/fakes:$PATH" \
      tools/verify-myron-kernel-contract $args >"$tmp/abi.out" 2>/dev/null; then
    fail "verify-abi accepted inputs that are not the qualified ones"
  fi
  [[ ! -s $tmp/abi.out ]] || fail "verify-abi printed a result for rejected inputs"
done
[[ ! -s $tmp/calls ]] || fail "verify-abi invoked an external system tool"
pass "verify-abi is bound to the qualified inputs, runs no external tool and writes nothing"

packages/omamobile-myron-kernel-contract/install "$tmp/stage"
while IFS= read -r -d '' file; do
  magic=$(od -An -tx1 -N8 "$file" | tr -d ' \n')
  case $magic in
    7f454c46*|1f8b08*|28b52ffd*|fd377a585a00*|504b0304*|414e44524f494421*|4d5a*)
      fail "contract package contains binary/archive magic: ${file#$tmp/stage/}"
      ;;
  esac
done < <(find "$tmp/stage" -type f -print0)
for path in usr/bin/omamobile-myron-kernel-verify \
            usr/share/omamobile/myron-kernel-contract/stage-contract.json; do
  [[ -f $tmp/stage/$path ]] || fail "contract package lacks $path"
done
cmp -s device/myron/stage-contract.json \
  "$tmp/stage/usr/share/omamobile/myron-kernel-contract/stage-contract.json" \
  || fail "installed stage contract differs from the canonical copy"
"$tmp/stage/usr/bin/omamobile-myron-kernel-verify" show-stage >/dev/null \
  || fail "installed verifier rejects its installed stage contract"
if find "$tmp/stage" \( -path '*/systemd/*' -o -path '*/pacman.d/*' -o -path '*/modprobe.d/*' \
     -o -path '*/udev/*' -o -path '*/vulkan/*' -o -path '*/usr/lib/modules*' \
     -o -path '*/boot/*' -o -path '*/myron-gki-module-sets*' -o -name '*.ko' \) | grep -q .; then
  fail "contract package stages a payload or activation path"
fi
pass "contract package contains no kernel, module, firmware, image, or archive payload"
