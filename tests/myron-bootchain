def second_pass_mutation(label, command, nth, mutate, admission):
    base = fresh("second-pass") / "reads"
    write_reads(base)
    state = {"calls": 0, "inside": False, "names": 0, "fired": []}
    real_stat = os.stat

    def wrap_settle(original):
        def patched(*a, **kw):
            state["calls"] += 1
            state["inside"] = True
            try:
                return original(*a, **kw)
            finally:
                state["inside"] = False
        return patched

    def stat_hook(path, *a, **kw):
        if state["inside"] and state["calls"] == nth and path == "reads.json":
            state["names"] += 1
            if state["names"] == 2:  # second per-file pass, after the header was checked
                state["fired"].append(True)
                mutate(base)
        return real_stat(path, *a, **kw)

    if command == "parse":
        out = work / f"second-pass-out-{counter[0]}"
        arguments = ["parse", "--request", request, "--reads", base, "--out", out]
    else:
        out = parse_a
        arguments = ["verify-parse", "--request", request, "--reads", base, "--parse", parse_a]
    os.stat = stat_hook
    try:
        with payload_counter(base) as counted:
            code, stdout, stderr = with_patch(B, "settle_reads", wrap_settle, lambda: invoke(*arguments))
    finally:
        os.stat = real_stat
    assert state["fired"], f"{label}: the injection never ran"
    if admission:
        # the admission settle missed it: bounded payload bytes were consumed, the later settle refuses
        assert code != 0 and not stdout, f"{label}: accepted"
        assert 0 < counted[0] <= 50176, f"{label}: {counted[0]} payload bytes"
        assert "parsed" not in stderr and "verified" not in stderr
        if command == "parse":
            assert not os.path.lexists(out), f"{label}: left output"
    else:
        # past the captured bytes' final observation: the already-bound snapshot may be produced...
        assert code == 0, f"{label}: {stderr}"
        if command == "parse":
            assert walk(out) == baseline_tree, f"{label}: artifact differs from the validated snapshot"
        # ...but the source changed, so an immediate unhooked verification rejects it
        verify_against = out if command == "parse" else parse_a
        code2, stdout2, _ = invoke("verify-parse", "--request", request, "--reads", base, "--parse", verify_against)
        assert code2 != 0 and not stdout2, f"{label}: the changed source verified"
    ok(f"{label}: " + ("rejected after bounded payload, no output" if admission
