def write_capture(base, r2_bytes, others, extra_manifest=None):
    """The exact capture tree, from this test's own manifest logic (not the collector's builder)."""
    base.mkdir(parents=True)
    (base / "operations").mkdir()
    files = {f"operations/{R2}.json": r2_bytes}
    for operation_id, value in others.items():
        files[f"operations/{operation_id}.json"] = jbytes({
            "schema": 2, "kind": "myron-precaptured-operation", "id": operation_id,
            "request_sha256": request_sha256, "transport": "external-precaptured-fixture",
            "read_domain": "fixture", "read_only": True, "bytes_read": 4096, "data": value})
    manifest = {
        "schema": 1, "kind": "myron-precaptured-fixture", "format_version": C.VERSION,
        "contract_sha256": digest(capture_contract_bytes), "request_sha256": request_sha256,
        "capture_schema": P.CAPTURE_SCHEMA, "transport": "external-precaptured-fixture", "live": False,
        "operations": [{"id": i, "sha256": digest(files[f"operations/{i}.json"]),
                        "bytes": len(files[f"operations/{i}.json"])} for i in OPERATION_IDS],
    }
    if extra_manifest:
        extra_manifest(manifest)
    files["capture.json"] = jbytes(manifest)
    for name, content in files.items():
        (base / name).write_bytes(content)
        (base / name).chmod(0o644)
    (base / "operations").chmod(0o755)
    base.chmod(0o755)
    return files


