# An unexpected ValueError at runtime is one fixed line; the text never leaves.
def raiser(error):
    def replacement(original):
        def raising(*args, **kwargs):
            raise error
        return raising
    return replacement


for error in (ValueError(f"{CANARY} /secret/path\nERROR: injected"), UnicodeDecodeError("utf-8", b"\xff", 0, 1, CANARY)):
    out, err = io.StringIO(), io.StringIO()
    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
        code = with_patch(B, "load_environment", raiser(error), lambda: B.main(["show"], contracts_root=contracts_root))
    assert code == 1 and out.getvalue() == "", (code, out.getvalue())
    assert err.getvalue() == "ERROR: an input could not be processed (code value-error)\n", err.getvalue()
# SystemExit and KeyboardInterrupt are never swallowed by the runtime handlers.
for error in (SystemExit(0), KeyboardInterrupt()):
    try:
        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
            with_patch(B, "load_environment", raiser(error), lambda: B.main(["show"], contracts_root=contracts_root))
    except type(error):
        pass
    else:
        raise AssertionError(f"{type(error).__name__} was swallowed")
ok("a hostile dependency version is one fixed line naming no version; a runtime ValueError is fixed and exits are not swallowed")

