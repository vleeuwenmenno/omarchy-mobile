# Dependency acquisition is fully protected. Every case runs in a fresh process, so no import
# cache of this test or of an earlier case can hide a failure. The checkout path carries a canary.
import subprocess

STARTUP = "ERROR: bootchain dependencies could not be loaded (code dependency-rejected)\n"
CANARY = "CANARYq7"
DEPENDENCIES = {
    "collector": "tools/myron-collect",
    "preflight": "tools/myron-preflight",
    "snapshot": "tools/myron-snapshot",
    "deployment": "tools/myron-deployment",
    "kernel verifier": "packages/omamobile-myron-kernel-contract/bin/omamobile-myron-kernel-verify",
    "GPU verifier": "packages/omamobile-myron-gpu-profile/bin/omamobile-myron-gpu-profile",
}
DAMAGE = {
    "missing": lambda path: path.unlink(),
    "syntax-invalid": lambda path: path.write_text("def (:\n"),
    "raising": lambda path: path.write_text(f"raise RuntimeError('{CANARY} raised')\n"),
    "exiting with 0": lambda path: path.write_text("raise SystemExit(0)\n"),
    "exiting with text": lambda path: path.write_text(f"raise SystemExit('{CANARY} exit')\n"),
}


def startup_copy(name):
    base = fresh(f"{CANARY}-{name}")
    (base / "packages").mkdir()
    for part in ["tools", *(f"packages/{p.name}" for p in (repo / "packages").glob("omamobile-myron-*"))]:
        shutil.copytree(repo / part, base / part, ignore=shutil.ignore_patterns("__pycache__"))
    return base


for label, relative in DEPENDENCIES.items():
    for kind, damage in DAMAGE.items():
        base = startup_copy("startup")
        target = base / relative
        removed = target.name
        damage(target)
        arguments = {
            "show": [],
            "derive-contract": [],
            "plan": ["--request", str(base / "no-request")],
            "parse": ["--request", str(base / "no-request"), "--reads", str(base / "no-reads"),
                      "--out", str(base / "no-out")],
            "verify-parse": ["--request", str(base / "no-request"), "--reads", str(base / "no-reads"),
                             "--parse", str(base / "no-parse")],
        }
        for command, extra in arguments.items():
            done = subprocess.run(
                [sys.executable, "-I", str(base / "tools/myron-bootchain"), command, *extra],
                capture_output=True, text=True, cwd=base, env={"PATH": os.environ["PATH"], "LC_ALL": "C"},
            )
            where = f"{kind} {label} ({command})"
            assert done.returncode == 1, (where, done.returncode, done.stderr)
            assert done.stdout == "", (where, done.stdout)
            assert done.stderr == STARTUP, (where, done.stderr)
            for leak in (CANARY, removed, str(base), "Traceback", "Errno", "No such file", "raised", "exit"):
                assert leak not in done.stderr, (where, leak)
ok("a missing, syntax-invalid, raising or exiting dependency is one fixed value-free line for all five commands, in a fresh process")


def all_five(base):
    return {
        "show": [],
        "derive-contract": [],
        "plan": ["--request", str(base / "no-request")],
        "parse": ["--request", str(base / "no-request"), "--reads", str(base / "no-reads"),
                  "--out", str(base / "no-out")],
        "verify-parse": ["--request", str(base / "no-request"), "--reads", str(base / "no-reads"),
                         "--parse", str(base / "no-parse")],
    }


def startup_refusal(where, base, expected=STARTUP, leaks=()):
    for command, extra in all_five(base).items():
        done = subprocess.run(
            [sys.executable, "-I", str(base / "tools/myron-bootchain"), command, *extra],
            capture_output=True, text=True, cwd=base, env={"PATH": os.environ["PATH"], "LC_ALL": "C"},
        )
        assert done.returncode == 1 and done.stdout == "" and done.stderr == expected, (where, command, done)
        assert not (base / "no-out").exists(), (where, command)
        for leak in (CANARY, str(base), "Traceback", "Errno", *leaks):
            assert leak not in done.stderr, (where, command, leak)


