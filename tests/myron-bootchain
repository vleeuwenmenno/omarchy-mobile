def rewrite_in_place(base):
    victim = base / "gpt-primary-header.bin"
    content = bytearray(victim.read_bytes())
    content[0] ^= 0x01  # same size: only mtime and ctime move
    with victim.open("r+b") as stream:
        stream.write(bytes(content))


