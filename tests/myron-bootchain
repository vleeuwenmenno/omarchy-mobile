def mapped_mutation(command, nth):
    base = fresh("mmap-source") / "reads"
    write_reads(base)
    victim = base / "gpt-primary-entries.bin"
    out = work / f"mmap-out-{counter[0]}"
    calls, fired = [0], []
    with victim.open("r+b") as stream, mmap.mmap(stream.fileno(), 0) as mapping:
        mapping[0] = mapping[0]  # fault a writable page now; later stores need no write fault
        before = D.fingerprint(victim.stat())
        real_read = os.read

        def mutating_read(descriptor, count):
            data = real_read(descriptor, count)
            if data and os.readlink(f"/proc/self/fd/{descriptor}") == str(victim):
                calls[0] += 1
                if calls[0] == nth:
                    mapping[100] = mapping[100] ^ 0xFF
                    fired.append(True)
                    assert D.fingerprint(victim.stat()) == before, "the mapped store moved the metadata"
            return data

        if command == "parse":
            arguments = ["parse", "--request", request, "--reads", base, "--out", out]
        else:
            arguments = ["verify-parse", "--request", request, "--reads", base, "--parse", parse_a]
        os.read = mutating_read
        try:
            code, stdout, stderr = invoke(*arguments)
        finally:
            os.read = real_read
        assert fired, f"{command}: the mapped mutation never ran"
        assert D.fingerprint(victim.stat()) == before
        assert code == 0, f"{command}: {stderr}"  # the bound snapshot was produced from the bytes read
        if command == "parse":
