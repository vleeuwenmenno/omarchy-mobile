def settle_mutation(label, nth, command, match, untouched=True):
    base = fresh("settle-mutation") / "reads"
    write_reads(base)
    state = {"calls": 0, "inside": False, "fired": []}
    real_stat = os.stat

    def wrap_settle(original):
        def patched(*a, **kw):
            state["calls"] += 1
            state["inside"] = True
            try:
                return original(*a, **kw)
            finally:
                state["inside"] = False
        return patched

    def stat_hook(path, *a, **kw):
        if state["inside"] and state["calls"] == nth and path == "reads.json" and not state["fired"]:
            state["fired"].append(True)
            (base / "late-extra.bin").write_bytes(b"x" * 6949)
        return real_stat(path, *a, **kw)

    if command == "parse":
        out = work / f"settle-mutation-out-{counter[0]}"
        arguments, outputs = ["parse", "--request", request, "--reads", base, "--out", out], (out,)
    else:
        arguments, outputs = ["verify-parse", "--request", request, "--reads", base, "--parse", parse_a], ()
    os.stat = stat_hook
    try:
        with_patch(B, "settle_reads", wrap_settle, lambda: expect_fail(
            label, arguments, *outputs, match=match, untouched=base if untouched else None))
    finally:
        os.stat = real_stat
    assert state["fired"], f"{label}: the injection never ran"


