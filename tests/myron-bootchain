TABLE = 16384
BOOT_BIT = 0x4
DISK_GUID = bytes.fromhex("c3a1f0e29b7d4c58a6e3d1b0f2879a4e")
TYPE_GUID = bytes.fromhex("5d8e2fb1a04c43769e1b7c30d4a8f651")
NAME_CANARY = "canary" + "q7k2"


def crc(data):
    return zlib.crc32(data) & 0xFFFFFFFF


def unique_guid(name):
    return hashlib.sha256(b"unique-guid-" + name.encode()).digest()[:16]


def guid_forms(raw):
    forms = set()
    for value in (raw.hex(), str(uuid.UUID(bytes=raw)), str(uuid.UUID(bytes_le=raw))):
        forms |= {value, value.upper()}
    return forms


def name_field(name):
    data = name.encode("utf-16-le")
    assert len(data) <= 72
    return data + bytes(72 - len(data))


def entry(first, last, attributes, name_raw, type_guid=TYPE_GUID, unique=None, name=None):
    unique = unique if unique is not None else unique_guid(name)
    return type_guid + unique + struct.pack("<QQQ", first, last, attributes) + name_raw


def header(sector, my, alt, first, last, guid, entries_lba, entries_crc, *, revision=0x00010000,
           size=92, reserved=0, count=128, entry_size=128, signature=b"EFI PART", trailing=None,
           crc_value=None, mutate=None):
    raw = bytearray(sector)
    struct.pack_into("<8sIIIIQQQQ16sQIII", raw, 0, signature, revision, size, 0, reserved, my, alt,
                     first, last, guid, entries_lba, count, entry_size, entries_crc)
    for offset, value in (trailing or {}).items():
        raw[offset:offset + len(value)] = value
    if mutate:
        mutate(raw)
    stored = crc(bytes(raw[:size])) if crc_value is None else crc_value
    struct.pack_into("<I", raw, 16, stored)
    return bytes(raw)


UNITS = [  # (name, size in 4096-byte units, attributes), in LBA order
    ("boot_a", 24576, 0x8000000000000004), ("vendor_boot_a", 24576, 0x1000000000000003),
    ("pmos_root", 10485760, 0), ("dtbo_a", 6144, 0x0000000000000008),
    ("recovery_a", 25600, 0xFFFFFFFFFFFFFFFB), ("boot_b", 24576, 0x1000000000000003),
    ("init_boot_a", 2048, 0),
]


def default_parts(sector):
    scale, lba, parts = 4096 // sector, 2 + TABLE // sector, []
    for name, units, attributes in UNITS:
        sectors = units * scale
        parts.append((name, lba, lba + sectors - 1, attributes))
        lba += sectors + 2
    return parts, lba


def disk_for(sector):
    return default_parts(sector)[1] + 1000 + TABLE // sector


def slot_of(index):
    return (index * 37 + 5) % 128  # arbitrary, distinct, not LBA order


def build_table(parts, slots=None, name_raws=None, edit=None):
    table = bytearray(TABLE)
    for slot in range(128):  # unused entries hold garbage everywhere but the type GUID
        table[slot * 128 + 16:(slot + 1) * 128] = bytes([0xEE]) * 112
        table[slot * 128:slot * 128 + 16] = bytes(16)
    seen = set()
    for index, (name, first, last, attributes) in enumerate(parts):
        slot = slots[index] if slots else slot_of(index)
        raw = (name_raws or {}).get(name) or name_field(name)
        unique = unique_guid(name) if name not in seen else hashlib.sha256(b"repeat-%d" % index).digest()[:16]
        seen.add(name)
        table[slot * 128:(slot + 1) * 128] = entry(first, last, attributes, raw, unique=unique)
    if edit:
        edit(table)
    return table


def gpt_files(sector=4096, disk=None, parts=None, slots=None, name_raws=None, table_edit=None,
              primary_table_edit=None, backup_table_edit=None, after_edit=None, ph=None, bh=None,
              ph_kw=None, bh_kw=None):
    parts = parts if parts is not None else default_parts(sector)[0]
    disk = disk if disk is not None else disk_for(sector)
    n = TABLE // sector
    table = build_table(parts, slots, name_raws, table_edit)
    table_crc = crc(bytes(table))
    primary_table, backup_table = bytearray(table), bytearray(table)
    if primary_table_edit:
        primary_table_edit(primary_table)
    if backup_table_edit:
        backup_table_edit(backup_table)
    if after_edit:  # both copies, checksum not recomputed
        after_edit(primary_table)
        after_edit(backup_table)
    p = dict(my=1, alt=disk - 1, first=2 + n, last=disk - 2 - n, guid=DISK_GUID, entries_lba=2,
             entries_crc=table_crc)
    b = dict(my=disk - 1, alt=1, first=2 + n, last=disk - 2 - n, guid=DISK_GUID,
             entries_lba=disk - 1 - n, entries_crc=table_crc)
    p.update(ph or {})
    b.update(bh or {})
    return {
        "geometry.json": jbytes({"schema": 1, "kind": "myron-synthetic-gpt-geometry",
                                 "sector_bytes": sector, "disk_lbas": disk}),
        "gpt-primary-header.bin": header(sector, p["my"], p["alt"], p["first"], p["last"], p["guid"],
                                         p["entries_lba"], p["entries_crc"], **(ph_kw or {})),
        "gpt-primary-entries.bin": bytes(primary_table),
        "gpt-backup-header.bin": header(sector, b["my"], b["alt"], b["first"], b["last"], b["guid"],
                                        b["entries_lba"], b["entries_crc"], **(bh_kw or {})),
        "gpt-backup-entries.bin": bytes(backup_table),
    }


