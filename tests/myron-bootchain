def r3_complete(r2_names, rows):
    """The migrated R3 completeness this test expects of the collector itself: exactly the
    eighteen supported names, an image where R2 lists the name and null where it does not."""
    if [row["partition_name"] for row in rows] != fixtures.NAMES:
        return False
