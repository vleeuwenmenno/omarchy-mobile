# Admission races: the tree changes after the listing, while the descriptors are being pinned.
def admission_race(label, hooks, match):
    base = fresh("admission") / "reads"
    write_reads(base)
    out = work / f"admission-out-{counter[0]}"
    fired = []
    real_open = D.open_pinned_regular_at

    def factory(original):
        def patched(directory_fd, name, description):
            hook = hooks.get((name, "before")) if name in B.CLOSURE else None
            if hook:
                fired.append((name, "before"))
                hook(base)
            result = original(directory_fd, name, description)
            hook = hooks.get((name, "after")) if name in B.CLOSURE else None
            if hook:
                fired.append((name, "after"))
                hook(base)
            return result
        return patched

    with_patch(D, "open_pinned_regular_at", factory, lambda: expect_fail(
        label, ["parse", "--request", request, "--reads", base, "--out", out], out,
        match=match, untouched=base))
    assert fired, f"{label}: the injection never ran"
    assert D.open_pinned_regular_at is real_open


