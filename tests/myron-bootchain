def version_pin(label, tool, old, new, expect):
    base = fresh("version-pin")
    (base / "packages").mkdir()
    for part in ["tools", *(f"packages/{p.name}" for p in (repo / "packages").glob("omamobile-myron-*"))]:
        shutil.copytree(repo / part, base / part, ignore=shutil.ignore_patterns("__pycache__"))
    target = base / tool
    text = target.read_text()
    assert old in text, label
    target.write_text(text.replace(old, new, 1))
    module = load(f"bootchain_pin_{counter[0]}", base / "tools/myron-bootchain")
    err = io.StringIO()
    with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(err):
        code = module.main(["show"], contracts_root=contracts_root)
    assert code != 0 and expect in err.getvalue(), (label, err.getvalue())
    ok(f"{label} is refused before any use")


