@contextlib.contextmanager
def payload_counter(directory):
    """Count the bytes os.read returns from any file under DIRECTORY (None: count nothing)."""
    counted = [0]
    if directory is None:
        yield counted
        return
    prefix = str(directory) + "/"
    original = os.read

    def counting(descriptor, count):
        block = original(descriptor, count)
        try:
            target = os.readlink(f"/proc/self/fd/{descriptor}")
        except OSError:
            target = ""
        if target.startswith(prefix):
            counted[0] += len(block)
        return block

    os.read = counting
    try:
        yield counted
    finally:
        os.read = original


def expect_fail(name, arguments, *outputs, match=None, absent=(), untouched=None, single_line=False, **kwargs):
    """UNTOUCHED names a reads directory from which not one payload byte may have been read."""
    with payload_counter(untouched) as counted:
        code, out, err = invoke(*arguments, **kwargs)
    assert code != 0, f"{name}: accepted\n{out}"
    assert out == "", f"{name}: stdout is not empty"
    if untouched is not None:
        assert counted[0] == 0, f"{name}: {counted[0]} payload bytes were read before the refusal"
    if match is not None:
        assert match in err, f"{name}: expected {match!r}, got {err!r}"
    if single_line:
        assert err.count("\n") == 1 and err.startswith("ERROR: "), f"{name}: not one line: {err!r}"
    for text in absent:
        assert text not in err and text not in out, f"{name}: diagnostics echo {text!r}: {err}"
    for output in outputs:
        assert not os.path.lexists(output), f"{name}: left output {output}"
    ok(f"{name} is rejected")
    return err


