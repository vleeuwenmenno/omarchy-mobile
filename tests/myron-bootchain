def manifest_document(files, req_sha=None, **overrides):
    value = {
        "schema": 1, "kind": B.READS_KIND, "format_version": 1,
        "bootchain_contract_sha256": BC, "request_sha256": req_sha or request_sha256,
        "synthetic": True,
        "files": [{"path": name, "bytes": len(files[name]), "sha256": digest(files[name])}
                  for name in sorted(files)],
    }
    value.update(overrides)
    return value


def write_reads(path, files=None, edits=None, drop=(), manifest_edit=None, manifest_raw=None,
                req_sha=None, keep_manifest_rows=False):
    """Write the flat closure; EDITS replace file bytes and the manifest is regenerated."""
    files = copy.deepcopy(files if files is not None else gpt_files())
    original = copy.deepcopy(files)
    for name, data in (edits or {}).items():
        files[name] = data
    path.mkdir(parents=True)
    manifest = manifest_document(original if keep_manifest_rows else files, req_sha)
    if manifest_edit:
        manifest_edit(manifest)
    raw = manifest_raw if manifest_raw is not None else jbytes(manifest)
    for name, data in {**files, "reads.json": raw}.items():
        if name in drop:
            continue
        (path / name).write_bytes(data)
        (path / name).chmod(0o644)
    path.chmod(0o755)
    return files


