#!/bin/bash
# SPDX-License-Identifier: MIT
# Static safety checks for the temporary, loop-mounted Myron hardware test.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

overlay=device/myron/hardware-test-overlay
compose=tools/myron-dev-image-compose
keyfile_audit=tools/myron-networkmanager-keyfile-audit
initboot=tools/myron-build-test-init-boot
initramfs=device/myron/hardware-test-initramfs
input_stage=$overlay/usr/local/sbin/myron-input-stage
battery_start=$overlay/usr/local/sbin/myron-batterysecret-start
battery_stage=$overlay/usr/local/sbin/myron-battery-stage
peripheral_audit=$overlay/usr/local/sbin/myron-peripheral-audit
bluetooth_experiment=device/myron/kernel-experiments/bluetooth-no-open-reset
bluetooth_compose=$bluetooth_experiment/compose-payload.sh
bluetooth_selector=$bluetooth_experiment/module-dir-selector.sh
bluetooth_boot_builder=$bluetooth_experiment/build-boot.py
bluetooth_only_start=$bluetooth_experiment/bluetooth-only-start.sh
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }

bash -n "$compose" "$keyfile_audit" "$initboot" "$bluetooth_compose" || fail 'image builders parse'
[[ -x $keyfile_audit ]] || fail 'NetworkManager keyfile audit is not executable'
sh -n "$bluetooth_selector" "$bluetooth_only_start" || fail 'Bluetooth experiment scripts parse'
python3 -c 'compile(open(__import__("sys").argv[1], encoding="utf-8").read(), __import__("sys").argv[1], "exec")' \
  "$bluetooth_boot_builder" || fail 'Bluetooth boot builder parses'
tests/myron-bluetooth-logic || fail 'Bluetooth executable logic checks failed'
tests/myron-cellular-stage || fail 'cellular stage checks failed'
tests/myron-cellular-start || fail 'cellular start checks failed'
tests/myron-ipa-guard || fail 'IPA guard checks failed'
tests/myron-modemmanager-admission || fail 'ModemManager admission checks failed'
for fragment in "$initramfs/fail-boot.sh" "$initramfs/systemd-stage.sh" "$initramfs/watchdog.sh"; do
  sh -n "$fragment" || fail "$fragment parses"
done
for script in "$overlay/usr/local/bin/myron-start-omarchy" \
  "$overlay/usr/local/bin/myron-omarchy-setup-user" \
  "$overlay/usr/local/bin/myron-speaker-sink" \
  "$overlay/usr/local/bin/myron-microphone-source" \
  "$overlay/usr/local/bin/omamobile-microphone" \
  "$overlay/usr/local/bin/omamobile-gnss" \
  "$overlay/usr/local/libexec/myron-shell-bin/quickshell" \
  "$overlay/usr/local/sbin/myron-reference-radio-start" \
  "$overlay/usr/local/sbin/myron-cellular-start" \
  "$overlay/usr/local/sbin/myron-cellular-stage" \
  "$overlay/usr/local/sbin/myron-ipa-guard" \
  "$overlay/usr/local/sbin/myron-modemmanager-start" \
  "$overlay/usr/local/sbin/myron-reference-audio-start" \
  "$overlay/usr/local/sbin/myron-coexistence-start" \
  "$overlay/usr/local/sbin/myron-audio-stage" \
  "$overlay/usr/local/sbin/myron-speaker-dsp-stage" \
  "$overlay/usr/local/sbin/myron-speaker-prepare" \
  "$overlay/usr/local/sbin/myron-speaker-powerdown" \
  "$overlay/usr/local/sbin/myron-microphone-prepare" \
  "$overlay/usr/local/sbin/myron-microphone-bridge" \
  "$overlay/usr/local/sbin/myron-bluetooth-stage" \
  "$battery_start" \
  "$battery_stage" \
  "$peripheral_audit" \
  "$overlay/usr/local/sbin/myron-audio-devnodes" \
  "$overlay/usr/local/sbin/myron-omarchy-prepare" \
  "$overlay/usr/local/sbin/myron-omarchy-qualify"; do
  sh -n "$script" || fail "$script parses"
  [[ -x $script ]] || fail "$script is executable"
done
python3 -c 'import pathlib, sys; compile(pathlib.Path(sys.argv[1]).read_bytes(), sys.argv[1], "exec")' \
  "$input_stage" || fail "$input_stage parses"
[[ -x $input_stage ]] || fail "$input_stage is not executable"
[[ -x $initboot ]] || fail 'init_boot builder is executable'
pass 'composer, initramfs and hardware-test scripts parse'

(
  keywork=$(mktemp -d /tmp/myron-keyfiles.XXXXXX)
  trap 'rm -rf -- "$keywork"' EXIT
  for store in etc/NetworkManager/system-connections usr/lib/NetworkManager/system-connections run/NetworkManager/system-connections; do
    rm -rf "$keywork/root"
    mkdir -p "$keywork/root/$store"
    printf '[connection]\nid=wifi\ntype=wifi\n' >"$keywork/root/$store/wifi.nmconnection"
    "$keyfile_audit" "$keywork/root" >/dev/null || fail "valid keyfile rejected in $store"
    printf ' [ connection ] \nid=test\n Type = GSM \n' >"$keywork/root/$store/cell.nmconnection"
    out=$("$keyfile_audit" "$keywork/root" 2>&1) && fail "cellular keyfile accepted in $store"
    [[ $out == *'unexpected GSM or CDMA'* ]] || fail "wrong cellular rejection in $store: $out"
  done
  rm -rf "$keywork/root"; mkdir -p "$keywork/root/etc/NetworkManager/system-connections"
  printf '[ gsm ]\napn=internet\n' >"$keywork/root/etc/NetworkManager/system-connections/cell"
  "$keyfile_audit" "$keywork/root" >/dev/null 2>&1 && fail 'spaced GSM section accepted'
  printf 'type=gsm\n' >"$keywork/root/etc/NetworkManager/system-connections/bad"
  out=$("$keyfile_audit" "$keywork/root" 2>&1) && fail 'malformed keyfile accepted'
  [[ $out == *'malformed NetworkManager keyfile'* ]] || fail "wrong malformed rejection: $out"
  rm -f "$keywork/root/etc/NetworkManager/system-connections/bad" "$keywork/root/etc/NetworkManager/system-connections/cell"
  printf '[connection]\nid=hidden\ntype=gsm\0hidden\n' >"$keywork/root/etc/NetworkManager/system-connections/nul"
  out=$("$keyfile_audit" "$keywork/root" 2>&1) && fail 'NUL-hidden cellular keyfile accepted'
  [[ $out == *'malformed NetworkManager keyfile'* ]] || fail "wrong NUL rejection: $out"
  rm -rf "$keywork/root"; mkdir -p "$keywork/root/etc/NetworkManager" "$keywork/real-store"
  ln -s "$keywork/real-store" "$keywork/root/etc/NetworkManager/system-connections"
  out=$("$keyfile_audit" "$keywork/root" 2>&1) && fail 'linked keyfile store accepted'
  [[ $out == *'invalid NetworkManager keyfile store'* ]] || fail "wrong linked-store rejection: $out"
  rm -rf "$keywork/root"; mkdir -p "$keywork/root" "$keywork/real-etc/NetworkManager/system-connections"
  ln -s "$keywork/real-etc" "$keywork/root/etc"
  out=$("$keyfile_audit" "$keywork/root" 2>&1) && fail 'keyfile store with linked ancestor accepted'
  [[ $out == *'invalid NetworkManager keyfile store'* ]] || fail "wrong linked-ancestor rejection: $out"
  rm -rf "$keywork/root"; mkdir -p "$keywork/root/etc/NetworkManager/system-connections"
  printf '[connection]\nid=unsafe\ntype=ethernet\ninterface-name=rmnet_ipa0\n' >"$keywork/root/etc/NetworkManager/system-connections/unsafe"
  out=$("$keyfile_audit" "$keywork/root" 2>&1) && fail 'rmnet-bound ethernet keyfile accepted'
  [[ $out == *'unsafe modem-interface'* ]] || fail "wrong modem-interface rejection: $out"
  printf '[keyfile]\npath=/etc/NetworkManager/system-connections/other\n' >"$keywork/root/etc/NetworkManager/system-connections/unsafe"
  out=$("$keyfile_audit" "$keywork/root" 2>&1) && fail '[keyfile] path accepted'
  [[ $out == *'unsafe modem-interface'* ]] || fail "wrong keyfile-path rejection: $out"
)
pass 'all NetworkManager stores reject cellular, malformed and linked keyfiles'

profile=$overlay/etc/uwsm/env.d/20-myron-gpu
for exact in \
  'export LD_LIBRARY_PATH=/usr/lib/omamobile/myron-gpu' \
  'export LIBGL_DRIVERS_PATH=/usr/lib/omamobile/myron-gpu/dri' \
  'export MESA_LOADER_DRIVER_OVERRIDE=zink' \
  'export VK_DRIVER_FILES=/usr/lib/omamobile/myron-gpu/freedreno-kgsl.json' \
  'unset WAYLAND_DISPLAY AQ_BACKEND EGL_PLATFORM'; do
  grep -Fxq "$exact" "$profile" || fail "native GPU profile lacks: $exact"
done
grep -Fq 'exec uwsm start' "$overlay/usr/local/bin/myron-start-omarchy" ||
  fail 'session wrapper does not enter UWSM'
grep -Fq 'PATH=/usr/local/libexec/myron-shell-bin:' "$overlay/usr/local/bin/myron-start-omarchy" ||
  fail 'session does not scope the Myron shell renderer wrapper'
grep -Fxq 'export QT_QUICK_BACKEND=software' \
  "$overlay/usr/local/libexec/myron-shell-bin/quickshell" ||
  fail 'quickshell wrapper does not select the software Qt Quick backend'
grep -Fxq 'exec /usr/bin/quickshell "$@"' \
  "$overlay/usr/local/libexec/myron-shell-bin/quickshell" ||
  fail 'quickshell wrapper does not delegate to the packaged executable'
pass 'native session keeps exact isolated Zink/Turnip profile'

prepare=$overlay/usr/local/sbin/myron-omarchy-prepare
qualify=$overlay/usr/local/sbin/myron-omarchy-qualify
grep -Fq '8ba2b05e346c638d699e16d4b782378e394bba374a12b16abacc1b905cb8d608' "$prepare" ||
  fail 'prepare does not pin exact kernel notes'
grep -Fq 'dadfc0372f028cd5c9810415167af6c182e79fbf2954e7c555a8a1108cf33e1e' "$prepare" ||
  fail 'prepare does not allow the exact no-opening-reset candidate notes'
grep -Fq '0ecd0f4eb2f6ab7c073ef2f2afd94e4185ac404b2b01a04a666188d63f029db8' "$prepare" ||
  fail 'prepare does not allow the exact public-address candidate notes'
grep -Fq '1e4a036d6f8bcc2602567ec5e0ff7aaa871564af18c9c7c8dee426b110834eea' "$prepare" ||
  fail 'prepare does not allow the exact inquiry-stop candidate notes'
grep -Fq 'install -m0755 /omarchy-prepare' "$bluetooth_compose" ||
  fail 'Bluetooth experiment composer does not install candidate-aware preparation'
grep -Fq -- '--firmware-dir' "$bluetooth_compose" ||
  fail 'Bluetooth experiment composer does not require a private firmware input'
grep -Fq 'myron-bluetooth-firmware' "$bluetooth_compose" ||
  fail 'Bluetooth experiment composer does not install private firmware into the payload'
grep -Fq "grep -aFq 'recovering discovery stop on Inquiry Complete' \"\$dist/bluetooth.ko\"" \
  "$bluetooth_compose" ||
  fail 'Bluetooth composer does not verify the inquiry-stop module diagnostic'
grep -Fq 'for name in hci_uart bluetooth; do' "$bluetooth_compose" ||
  fail 'Bluetooth composer does not verify both changed modules'
grep -Fq 'expected_release=6.12.23-android16-5-g5a0e85dd9db0-dirty-4k' \
  "$bluetooth_compose" ||
  fail 'Bluetooth composer does not require the exact stamped release'
grep -Fq '1e4a036d6f8bcc2602567ec5e0ff7aaa871564af18c9c7c8dee426b110834eea' \
  "$bluetooth_selector" ||
  fail 'Bluetooth module selector does not allow the inquiry-stop candidate'
for required in \
  'BASE_SHA256 = "def61369f915cfe3327f73391056290027565d172d9786c75fe373f61e2ffe08"' \
  'KERNEL_SHA256 = "672808b1277b583fdc398986bfe8d100b2ebbf1c2cfbb9d14dd257366d1a5937"' \
  'refusing to replace output' 'candidate kernel readback differs'; do
  grep -Fq "$required" "$bluetooth_boot_builder" ||
    fail "Bluetooth boot builder lacks: $required"
done
for required in card0-DSI-1 /dev/dri/card0 /dev/dri/renderD128 /dev/kgsl-3d0 \
  /dev/dma_heap/system /dev/dri/dmaheap-sys '/usr/lib/omamobile/myron-gpu/' \
  enable_touch_raw hardware-test.disarm; do
  grep -Fq "$required" "$qualify" || fail "qualification lacks $required"
done
grep -Fq 'printf '\''%s\n'\'' 0 >"$touch_raw_control"' "$prepare" ||
  fail 'prepare does not disable Xiaomi THP raw mode'
for key in pmic_pwrkey pmic_resin; do
  grep -Fq "classify_key $key" "$prepare" ||
    fail "prepare does not persist runtime input classification for $key"
done
grep -Eq 'stable_seconds=90$' "$qualify" || fail 'qualification window is not 90 seconds'
grep -Fq 'llvmpipe|swrast' "$qualify" || fail 'software renderer rejection is absent'
grep -Fq 'runuser -u "$owner" -- test -w /dev/dma_heap/system' "$qualify" ||
  fail 'qualification does not prove the compositor user can access the DMA heap'
grep -Fq '/usr/bin/eglinfo -B' "$qualify" ||
  fail 'qualification does not exercise a separate native Wayland EGL client'
grep -Fq 'client_wayland_log=/run/myron-eglinfo-wayland.log' "$qualify" ||
  fail 'qualification does not isolate the native Wayland EGL result'
grep -Fq 'capture && /^X11 platform:$/ { exit }' "$qualify" ||
  fail 'qualification does not bound the Wayland EGL result before X11'
grep -Fq 'Adreno.*840.*MESA_TURNIP' "$qualify" ||
  fail 'native client qualification does not require Adreno 840 Turnip'
grep -Fq 'node_from_class /sys/class/dma_heap/system/dev /dev/dma_heap/system video 0660' "$prepare" ||
  fail 'prepare does not create the canonical system DMA-heap node'
grep -Fq 'node_from_class /sys/class/dma_heap/system/dev /dev/dri/dmaheap-sys video 0660' "$prepare" ||
  fail 'prepare does not create the downstream DMA-heap DRI alias'
grep -Fq 'hyprland.lock' "$qualify" ||
  fail 'qualification does not resolve the runtime IPC instance from Hyprland lock metadata'
for required in \
  'backlight=/sys/class/backlight/panel0-backlight/brightness' \
  'torch=/sys/class/leds/amber:flash-2/brightness' \
  'chgrp video "$backlight"' 'chmod 0664 "$backlight"' \
  'chgrp input "$torch"' 'chmod 0664 "$torch"'; do
  grep -Fq "$required" "$prepare" ||
    fail "hardware preparation lacks control contract: $required"
done
pass 'qualification requires native DSI, GPU nodes, isolated Mesa and stable Hyprland'

grep -Fq 'ConditionPathExists=/run/myron-host/var/lib/omarchy-mobile/hardware-test.armed' \
  "$overlay/usr/lib/systemd/system/myron-omarchy-prepare.service" ||
  fail 'prepare unit is not armed by host-root marker'
grep -Fq 'ConditionPathExists=/run/myron-host/var/lib/omarchy-mobile/hardware-test.armed' \
  "$overlay/usr/lib/systemd/system/myron-omarchy-qualify.service" ||
  fail 'qualify unit is not armed by host-root marker'
grep -Fq 'Address=172.16.42.1/24' "$overlay/etc/systemd/network/10-myron-usb0.network" ||
  fail 'static USB rescue address is absent'
grep -Fq 'functions/acm.usb0' "$initramfs/systemd-stage.sh" ||
  fail 'initramfs ACM rescue console is absent'
grep -Fq 'Before=sysinit.target' \
  "$overlay/usr/lib/systemd/system/myron-hardware-watchdog.service" ||
  fail 'rollback watchdog does not start before sysinit'
grep -Fq 'fail_boot previous-test-rebooted-before-disarm' "$initramfs/systemd-stage.sh" ||
  fail 'initramfs does not restore after an unexpected armed test reboot'
grep -Fq 'enable myron-hardware-watchdog.service' "$compose" ||
  fail 'rollback watchdog is not enabled in the payload'
grep -Fq 'myron-coexistence.service' "$compose" ||
  fail 'guarded coexistence bring-up is not enabled in the payload'
grep -Fq 'coexistence|cellular' "$compose" ||
  fail 'composer does not restrict the hardware-test profile'
grep -Fq 'mask systemd-firstboot.service' "$compose" ||
  fail 'interactive stock firstboot is not masked'
grep -Fq 'mask ModemManager.service' "$compose" ||
  fail 'coexistence profile does not mask ModemManager'
grep -Fq 'unmask ModemManager.service' "$compose" ||
  fail 'cellular profile does not unmask ModemManager'
grep -Fq 'disable ModemManager.service' "$compose" ||
  fail 'cellular profile does not keep ModemManager behind its guarded transaction'
grep -Fq 'enable myron-cellular.service' "$compose" ||
  fail 'cellular profile does not enable its guarded transaction'
grep -Fq 'Session=myron-omarchy.desktop' "$overlay/etc/sddm.conf.d/zz-myron-test.conf" ||
  fail 'late SDDM override does not select the isolated Myron session'
grep -Fq 'TimeoutStartSec=3min' \
  "$overlay/etc/systemd/system/omamobile-firstboot.service.d/90-myron-hardware-test.conf" ||
  fail 'temporary firstboot cannot release the display manager before rollback'
grep -Fq 'Environment=OMAMOBILE_FIRSTBOOT_SKIP_FIREWALL=1' \
  "$overlay/etc/systemd/system/omamobile-firstboot.service.d/90-myron-hardware-test.conf" ||
  fail 'temporary firstboot does not defer the unavailable downstream firewall'
grep -Fq 'Environment=OMAMOBILE_FIRSTBOOT_DEFER_OMARCHY_PROVISION=1' \
  "$overlay/etc/systemd/system/omamobile-firstboot.service.d/90-myron-hardware-test.conf" ||
  fail 'temporary firstboot does not defer network-only desktop provisioning'
grep -Fxq 'ConditionPathExists=' \
  "$overlay/usr/lib/systemd/user/omamobile-setup-user.service.d/90-myron-hardware-test.conf" ||
  fail 'temporary first login does not run the idempotent mobile profile setup'
grep -Fxq 'ExecStart=/usr/local/bin/myron-omarchy-setup-user' \
  "$overlay/usr/lib/systemd/user/omamobile-setup-user.service.d/90-myron-hardware-test.conf" ||
  fail 'temporary first login does not run the Myron mobile setup wrapper'
for output in Virtual-1 Virtual-2; do
  grep -Fq "hl.monitor({ output = \"$output\", disabled = true })" \
    "$overlay/usr/local/bin/myron-omarchy-setup-user" ||
    fail "mobile setup does not disable zero-size $output"
done
grep -Fq 'hl.monitor({ output = "DSI-1", mode = "preferred", position = "auto", scale = 2.0 })' \
  "$overlay/usr/local/bin/myron-omarchy-setup-user" ||
  fail 'mobile setup does not apply the attended Myron display scale'
grep -Fq 'scale-in-vertical-screen-orientation 1.8' \
  "$overlay/usr/local/bin/myron-omarchy-setup-user" ||
  fail 'mobile setup does not enlarge the portrait on-screen keyboard'
for key in pmic_pwrkey pmic_resin; do
  grep -Fq "ATTRS{name}==\"$key\", ENV{ID_INPUT}=\"1\", ENV{ID_INPUT_KEY}=\"1\"" \
    "$overlay/etc/udev/rules.d/70-myron-hardware-test.rules" ||
    fail "udev rules do not classify $key for Hyprland"
done
rules=$overlay/etc/udev/rules.d/70-myron-hardware-test.rules
for port in 'rmnet_ipa*' 'qmapmux*'; do
  grep -Fxq "SUBSYSTEM==\"net\", KERNEL==\"$port\", ENV{ID_MM_QCOM_SOC}=\"1\", ENV{ID_MM_PHYSDEV_UID}=\"qcom-soc\", ENV{ID_MM_CANDIDATE}=\"1\"" "$rules" ||
    fail "downstream IPA net port classification is missing or inexact: $port"
done
[[ $(grep -c 'ID_MM_QCOM_SOC' "$rules") == 2 ]] || fail 'unexpected extra qcom-soc udev rules'
marker=$overlay/etc/myron/use-in-tree-rmnet
[[ -f $marker && ! -L $marker && ! -s $marker ]] || fail 'in-tree rmnet marker is not an empty regular file'
grep -Fq 'etc/myron/use-in-tree-rmnet' "$compose" && grep -Fq 'use-in-tree-rmnet" -a ! -L' "$compose" ||
  fail 'composer does not verify the in-tree rmnet marker'
grep -Fq "stat /etc/myron/use-in-tree-rmnet" "$compose" ||
  fail 'composer does not verify the marker in the composed image'
grep -Fq '"$root/usr/local/sbin/myron-ipa-guard"' "$compose" ||
  fail 'composer does not install the IPA guard as executable'
dropin=$overlay/etc/systemd/system/ModemManager.service.d/20-myron-radio.conf
for line in 'Requires=myron-reference-radio.service' 'After=myron-reference-radio.service' \
  'ConditionPathExists=/run/myron-wireless-ready' \
  'ConditionPathExists=/run/omamobile-myron/modem-manager-allowed' 'Restart=no' \
  'RestrictAddressFamilies=AF_INET'; do
  grep -Fxq "$line" "$dropin" || fail "ModemManager drop-in lacks: $line"
done
for line in 'ExecStart=' 'ExecStart=/usr/local/sbin/myron-modemmanager-start'; do
  grep -Fxq "$line" "$dropin" || fail "ModemManager drop-in lacks the one-start wrapper: $line"
done
nm_conf=$overlay/etc/NetworkManager/conf.d/20-myron-cellular-unmanaged.conf
grep -Fxq '[device-myron-cellular]' "$nm_conf" && grep -Fxq 'match-device=type:gsm' "$nm_conf" && grep -Fxq 'managed=0' "$nm_conf" &&
  grep -Fxq 'allowed-connections=uuid:7c3b1d52-6f0e-4a84-9d2a-4d59a0c1e5f3' "$nm_conf" && grep -Fxq 'stop-match=yes' "$nm_conf" ||
  fail 'NetworkManager does not hold GSM devices unmanaged at boot'
[[ $(grep -c '^[a-z]' "$nm_conf") == 4 ]] || fail 'unexpected extra NetworkManager inhibit settings'
# qmapmux* is the data interface NetworkManager configures during activation: never unmanaged.
if grep -rnE 'unmanaged-devices.*(qmapmux|rmnet)|interface-name:(qmapmux|rmnet)' "$overlay/etc/NetworkManager"; then
  fail 'NetworkManager is told to leave a modem data interface unmanaged'
fi
grep -Fq 'unexpected GSM or CDMA NetworkManager keyfile' "$keyfile_audit" || fail 'keyfile audit does not reject a shipped GSM keyfile'
grep -Fq 'myron-networkmanager-keyfile-audit:/keyfile-audit:ro' "$compose" &&
  grep -Fq '/keyfile-audit "$root"' "$compose" || fail 'composer does not run the keyfile audit in the payload'
grep -Fq 'ModemManager D-Bus alias is not the canonical unit' "$compose" || fail 'composer does not check the ModemManager alias'
guard_unit=$overlay/usr/lib/systemd/system/myron-ipa-guard.service
grep -Fxq 'ExecStart=/usr/local/sbin/myron-ipa-guard run' "$guard_unit" && grep -Fxq 'Restart=no' "$guard_unit" ||
  fail 'IPA guard unit is not a single read-only run'
grep -q '^\[Install\]' "$guard_unit" && fail 'IPA guard unit must have no Install section'
grep -Fq 'Before=ModemManager.service' "$guard_unit" || fail 'IPA guard is not ordered before ModemManager'
link=$overlay/etc/systemd/network/10-myron-wlan.link
grep -Fxq 'OriginalName=wlan*' "$link" ||
  fail 'WLAN link does not match the downstream kernel interface name'
grep -Fxq 'Path=platform-1c00000.pcie-pci-0000:01:00.0' "$link" ||
  fail 'WLAN link is not scoped to the Myron CNSS PCIe function'
grep -Fxq 'Name=wlan0' "$link" ||
  fail 'WLAN link does not preserve the reference wlan0 contract'
pass 'services require explicit arm marker and preserve USB rescue address'

coexist=$overlay/usr/local/sbin/myron-coexistence-start
coexist_unit=$overlay/usr/lib/systemd/system/myron-coexistence.service
cellular=$overlay/usr/local/sbin/myron-cellular-start
cellular_unit=$overlay/usr/lib/systemd/system/myron-cellular.service
previous=0
for required in \
  'systemctl start myron-reference-radio.service' \
  '/usr/local/sbin/myron-bluetooth-stage arm' \
  '/usr/local/sbin/myron-bluetooth-stage start' \
  'systemctl start myron-reference-audio-foundation.service' \
  'systemctl start myron-speaker-bridge.service'; do
  line=$(grep -nF "$required" "$coexist" | cut -d: -f1)
  [[ -n $line && $line -gt $previous ]] ||
    fail "coexistence order is missing or invalid at: $required"
  previous=$line
done
grep -Fq 'ModemManager must remain stopped until coexistence is qualified' "$coexist" ||
  fail 'coexistence bring-up does not defer modem/GNSS userspace'
grep -Fq 'myron-hardware-watchdog.service' "$coexist" ||
  fail 'coexistence bring-up does not require the rollback watchdog'
grep -Fq 'Before=NetworkManager.service display-manager.service myron-omarchy-qualify.service' "$coexist_unit" ||
  fail 'coexistence service is not ordered before networking, graphics, and qualification'
main_body=$(sed -n '/^main() {$/,/^}$/p' "$cellular")
previous=0
for required in \
  'check_rmnet_assets' \
  'systemctl start myron-reference-radio.service' \
  'udevadm settle --timeout=30' \
  'check_radio_result' \
  'start_guard' \
  'modem-manager-allowed' \
  'systemctl start ModemManager.service'; do
