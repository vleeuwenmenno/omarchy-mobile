def fdt_case(label, data, code):
    try:
        B.parse_fdt_component(data)
    except B.SelectionError as error:
        assert error.code == code, f"{label}: expected {code}, got {error.code}: {error}"
        text = str(error)
        assert text.endswith(f"(code {code})") and "\n" not in text
        assert CANARY not in text and not re.search(r"\d{3,}", text), text
    else:
        raise AssertionError(f"{label}: accepted")
    ok(f"{label} is {code}")


