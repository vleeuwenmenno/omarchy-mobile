def r2_operation(partitions, req_sha=None, schema=None):
    rows = [{"partition_name": name, "size_bytes": size, "bootable_flag": False,
             "slot_suffix": name[-2:] if name.endswith(("_a", "_b")) else ""}
            for name, size in sorted(partitions.items())]
    return jbytes({
        "schema": C.OPERATION_SCHEMA if schema is None else schema, "kind": C.OPERATION_KIND, "id": R2,
        "request_sha256": req_sha or request_sha256, "transport": C.TRANSPORT,
        "read_domain": C.READ_DOMAIN, "read_only": True, "bytes_read": 4096,
        "data": {"partitions": rows, "recovery_present": any(role_of(n) == "recovery" for n in partitions)},
    })


def dtbo_image(entries, page=2048):
    """(bytes, meta) for a DT table image the independent builder placed."""
    data = S.dtbo(entries, page=page)
    cursor, components = 32 + 32 * len(entries), []
    for index, item in enumerate(entries):
        components.append(F.component("dt_entry", index, cursor, len(item["payload"])))
        cursor += len(item["payload"])
    meta = {"format": "android-dt-table", "version": 0, "page_size": page, "os_version": None, "header": 32,
            "table": {"role": "dt_entry_table", "offset": 32, "size": 32 * len(entries), "entry_size": 32,
                      "count": len(entries)},
            "components": components}
    return data, meta


def vendor_image(dtb, version=4):
    if version == 4:
        return F.vendor(4, fragments=[F.fragment("v0", 600, 1)], dtb=dtb, bootconfig=F.blob("vb", 40))
    return F.vendor(3, page=2048, ramdisk=F.blob("vr", 700), dtb=dtb)


def entries_of(count, base=1):
    return [S.entry(F.blob(f"d{i}", 24 + i % 5), base + i, 100 + i, (i, 2 * i, 3 * i, 4 * i)) for i in range(count)]


