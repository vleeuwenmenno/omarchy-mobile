def invoke(*arguments, root=None):
    out, err = io.StringIO(), io.StringIO()
    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
        try:
            code = B.main([str(value) for value in arguments], contracts_root=root or contracts_root)
        except SystemExit as error:
            code = error.code
    return code, out.getvalue(), err.getvalue()


def expect_ok(*arguments):
    code, out, err = invoke(*arguments)
    assert code == 0, (arguments[0], err)
    return json.loads(out), out


def expect_fail(name, arguments, code_name=None, outputs=(), absent=(CANARY,)):
    code, out, err = invoke(*arguments)
    assert code != 0, f"{name}: accepted\n{out}"
    assert out == "", f"{name}: stdout is not empty"
    assert err.count("\n") == 1 and err.startswith("ERROR: "), f"{name}: not one line: {err!r}"
    if code_name is not None:
        assert err.rstrip().endswith(f"(code {code_name})"), f"{name}: expected {code_name}, got {err!r}"
    for text in absent:
        assert text not in err, f"{name}: diagnostics echo {text!r}: {err}"
    for output in outputs:
        assert not os.path.lexists(output), f"{name}: left output {output}"
    ok(f"{name} is rejected as {code_name or 'a fixed refusal'}")
    return err


def with_patch(owner, attribute, replacement, run):
    original = getattr(owner, attribute)
    setattr(owner, attribute, replacement(original))
    try:
        return run()
    finally:
        setattr(owner, attribute, original)


def set_constant(name, value, run):
    original = getattr(B, name)
    setattr(B, name, value)
    try:
        return run()
    finally:
        setattr(B, name, original)


