fdt_case("65 concatenated blobs", b"".join(S.fdt() for _ in range(65)), "selection-budget")
# tightly concatenated blobs only: no scan, no gap, no trailing byte
fdt_case("a gap of zero bytes between blobs", S.fdt() + bytes(8) + S.fdt(), "selection-corrupt")
fdt_case("a trailing zero word after the last blob", S.fdt() + bytes(4), "selection-corrupt")
fdt_case("trailing bytes shorter than a header", S.fdt() + b"\x01", "selection-corrupt")
fdt_case("a trailing blob-shaped tail with a bad magic", S.fdt() + S.fdt(header={"magic": 0xD00DFEEE}), "selection-corrupt")
fdt_case("an empty component", b"", "selection-unsupported")
# versions and header shape
fdt_case("a v16 blob", S.fdt(version=16, last_comp=16), "selection-unsupported")
fdt_case("a v18 blob", S.fdt(version=18, last_comp=16), "selection-unsupported")
fdt_case("a v17 blob with last_comp_version 17", S.fdt(last_comp=17), "selection-unsupported")
fdt_case("a v17 blob with last_comp_version 15", S.fdt(last_comp=15), "selection-unsupported")
fdt_case("last_comp_version above the version", S.fdt(version=17, last_comp=18), "selection-corrupt")
fdt_case("a bad magic", S.fdt(header={"magic": 0}), "selection-corrupt")
fdt_case("a truncated header", S.fdt()[:39], "selection-corrupt")
