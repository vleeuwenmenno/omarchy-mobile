    D.DeploymentError(f"cannot publish /{CANARY}: Invalid argument"))),
    lambda: expect_fail("a deployment publish failure", cli("parse-selection", scn, "--out", out), "publish-rejected", [out]))
real_publish = D.publish
race_scn = make(STANDARD, "publish-race", claim={"dtb_index": 1, "dtbo_entry_index": 0})
out = work / "publish-race-out"


def racing_publish(out_path, protected, ids, spec, verify_built):
    def wrapped(temporary, descriptor):
        (race_scn.sel / "witness.json").write_bytes(jbytes({**race_scn.witness_doc, "claim": {"dtb_index": 2, "dtbo_entry_index": 0}}))
        return verify_built(temporary, descriptor)
    return real_publish(out_path, protected, ids, spec, wrapped)


D.publish = racing_publish
try:
    expect_fail("a witness changed between the build and the published verification",
                cli("parse-selection", race_scn, "--out", out), None, [out])
finally:
    D.publish = real_publish
substitute = make(STANDARD, "publish-substitute", claim=None)
out = work / "publish-substitute-out"


def substituting_publish(out_path, protected, ids, spec, verify_built):
    os.mkdir(out_path)  # an output appears after the checks and before the no-replace publish
    return real_publish(out_path, protected, ids, spec, verify_built)


D.publish = substituting_publish
try:
    expect_fail("an output substituted before the no-replace publish", cli("parse-selection", substitute, "--out", out),
                "publish-rejected")
    assert os.listdir(out) == [], "the substituted output is left untouched"
finally:
    D.publish = real_publish
ok("publication failures are one fixed code, a changed witness is caught by the published verification, and a substituted output is never replaced")

