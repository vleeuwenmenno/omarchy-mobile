trap 'chmod -R u+rwx "$tmp" 2>/dev/null || true; rm -rf "$tmp"' EXIT
export PYTHONPYCACHEPREFIX="$tmp/pycache"
tmp=$(realpath "$tmp")

python3 -m py_compile tools/myron-bootchain tools/lib/myron-bootchain-impl.py tests/myron-fixtures/boot_images.py \
