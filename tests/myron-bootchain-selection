class Scenario:
    pass


def make(images, label="scn", *, base="vendor_boot_a", dtbo="dtbo_a", claim=None, capacity=None,
         witness_edit=None, manifest_edit=None, witness_raw=None, manifest_raw=None, extra_files=None,
         image_edit=None, r3_dir=None):
    """Write an inventory, a flat image fixture, the R3 parse of that fixture (by the real
    parse-images command) and the two-file selection fixture. IMAGES: name -> (bytes, meta)."""
    s = Scenario()
    s.images, s.base, s.dtbo, s.claim = images, base, dtbo, claim
    parts = {name: (capacity or {}).get(name, 64 * F.MIB) for name in images}
    parts["pmos_root"] = 8 * 1024 ** 3
    root = fresh(label)
    s.root = root
    s.inv = root / "inventory" / "R2.json"
    s.inv.parent.mkdir()
    s.inv_bytes = r2_operation(parts)
    s.inv.write_bytes(s.inv_bytes)
    s.inv.chmod(0o644)
    s.inv.parent.chmod(0o755)
    s.inv_sha = digest(s.inv_bytes)
    s.imgs = root / "images"
    s.imgs.mkdir()
    rows = [{"partition_name": n, "present": n in images, "size_bytes": len(images[n][0]) if n in images else None,
             "fixture_sha256": digest(images[n][0]) if n in images else None} for n in NAMES]
    document = {"schema": 1, "kind": B.IMAGES_KIND, "format_version": 1, "bootchain_contract_sha256": BC,
                "request_sha256": request_sha256, "inventory_sha256": s.inv_sha, "synthetic": True, "images": rows}
    s.images_manifest = jbytes(document)
    for name, (data, _meta) in images.items():
        (s.imgs / f"{name}.img").write_bytes(data)
        (s.imgs / f"{name}.img").chmod(0o644)
    (s.imgs / "images.json").write_bytes(s.images_manifest)
    (s.imgs / "images.json").chmod(0o644)
    s.imgs.chmod(0o755)
    s.images_sha = digest(s.images_manifest)
    s.r3_bytes = len(s.images_manifest) + sum(len(d) for d, _m in images.values())
    s.r3 = r3_dir or root / "r3"
    if r3_dir is None:
        code, out, err = invoke("parse-images", "--request", request, "--inventory", s.inv, "--images", s.imgs,
                                "--out", s.r3)
        assert code == 0, err
    s.r3_sums = (s.r3 / "SHA256SUMS").read_bytes()
    s.r3_op_bytes = (s.r3 / f"operations/{R3}.json").read_bytes()
    s.r3_parse_sha = digest(s.r3_sums)
    s.r3_op_sha = digest(s.r3_op_bytes)
    s.sel = root / "selection"
    s.sel.mkdir()
    write_selection(s, claim, witness_edit=witness_edit, manifest_edit=manifest_edit, witness_raw=witness_raw,
                    manifest_raw=manifest_raw, extra_files=extra_files)
    return s


def write_selection(s, claim, *, witness_edit=None, manifest_edit=None, witness_raw=None, manifest_raw=None,
                    extra_files=None):
    witness = {"schema": 1, "kind": B.WITNESS_KIND, "format_version": 1, "request_sha256": request_sha256,
               "r3_operation_sha256": s.r3_op_sha, "base_source_partition": s.base,
               "dtbo_source_partition": s.dtbo, "synthetic": True, "claim": claim}
    if witness_edit:
        witness_edit(witness)
    s.witness_bytes = witness_raw if witness_raw is not None else jbytes(witness)
    manifest = {"schema": 1, "kind": B.SELECTION_KIND, "format_version": 1, "bootchain_contract_sha256": BC,
                "request_sha256": request_sha256, "inventory_sha256": s.inv_sha, "r3_parse_sha256": s.r3_parse_sha,
                "r3_operation_sha256": s.r3_op_sha, "images_sha256": s.images_sha,
                "base_source_partition": s.base, "dtbo_source_partition": s.dtbo,
                "witness_bytes": len(s.witness_bytes), "witness_sha256": digest(s.witness_bytes), "synthetic": True}
    if manifest_edit:
        manifest_edit(manifest)
    s.manifest_doc, s.witness_doc = manifest, witness
    s.manifest_bytes = manifest_raw if manifest_raw is not None else jbytes(manifest)
    for name in ("selection.json", "witness.json"):
        if (s.sel / name).exists() or (s.sel / name).is_symlink():
            (s.sel / name).unlink()
    for name, data in {"selection.json": s.manifest_bytes, "witness.json": s.witness_bytes,
                       **(extra_files or {})}.items():
        (s.sel / name).write_bytes(data)
        (s.sel / name).chmod(0o644)
    s.sel.chmod(0o755)
    s.S = s.r3_bytes + len(s.manifest_bytes) + len(s.witness_bytes)


def cli(command, s, *extra):
    if command == "plan-selection":
        return [command, "--request", request, "--inventory", s.inv, *extra]
    return [command, "--request", request, "--inventory", s.inv, "--images", s.imgs, "--r3-parse", s.r3,
            "--selection", s.sel, *extra]


