def crossing(original):
    def patched(*a, **kw):
        calls = [0]

        def mount(descriptor, label):
            calls[0] += 1
            return real_mount(descriptor, label) + (calls[0] > 1)
        K.mount_id_for_fd = mount
        try:
            return original(*a, **kw)
        finally:
            K.mount_id_for_fd = real_mount
    return patched


