ACTIONS = {
    "truncation": (1, lambda p: os.truncate(p, p.stat().st_size - 5)),
    "growth": (1, lambda p: p.open("ab").write(b"x")),
    "same-size rewrite": (2, lambda p: (p.write_bytes(bytes(reversed(p.read_bytes()))), shift_times(p))),
    "chmod": (2, lambda p: os.chmod(p, 0o600)),
    "metadata change": (2, lambda p: shift_times(p)),
    "extra link": (2, lambda p: os.link(p, p.with_name(p.name + ".alias"))),
    "truncate after read": (2, lambda p: os.truncate(p, 3)),
}
