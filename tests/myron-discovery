for other in sorted((repo / "device/myron").glob("*-contract.json")):
    value = json.loads(other.read_bytes())
    if other.name == "discovery-contract.json" or "authority" not in value or "blockers" not in value:
        continue
    seen_authority += 1
    assert all(v is False for v in value["authority"].values()) and len(value["blockers"]) == 7, other.name
    assert value["blockers"] == contract["blockers"], other.name
    assert "myron-discovery" not in json.dumps(value), other.name
assert seen_authority >= 3
assert contract["authority"]["hardware_read_authorized"] is False
ok("authorities stay false and the seven blockers stay unchanged in every contract")
PY
pass "authority and blocker flags are unchanged in the device configuration"
grep -Eq '^BOOT_METHOD=external-android$' device/myron/device.conf || fail "device.conf boot method changed"
grep -Eq '^BOOT_IMAGES=""$' device/myron/device.conf || fail "device.conf BOOT_IMAGES is not empty"
grep -Eq '^UFS_RW=""$' device/myron/device.conf || fail "device.conf UFS_RW is not empty"

grep -Eq 'tests/myron-discovery' tests/all || fail "tests/all does not run tests/myron-discovery"
[[ ! -e out/discovery ]] || fail "unexpected discovery artifact"
