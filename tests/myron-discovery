#!/bin/bash
# SPDX-License-Identifier: MIT
# Offline tests for the Myron synthetic discovery-plan validator (Phase 2.19).
# Everything is synthetic: no request, approval, transport, capture, phone or network.
set -euo pipefail
export LC_ALL=C
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }
tmp=$(mktemp -d)
trap 'chmod -R u+rwx "$tmp" 2>/dev/null || true; rm -rf "$tmp"' EXIT
export PYTHONPYCACHEPREFIX="$tmp/pycache"
tmp=$(realpath "$tmp")

tool=tools/myron-discovery
impl=tools/lib/myron-discovery-impl.py
contract=device/myron/discovery-contract.json
python3 -B -m py_compile "$tool" "$impl" 2>/dev/null || python3 -c 'import ast,sys; [ast.parse(open(f).read()) for f in sys.argv[1:]]' "$tool" "$impl" || fail "tool parses"
for f in "$tool" "$impl"; do
  grep -Eq '^(import|from) (subprocess|shutil|socket|urllib|http|ctypes|ssl|requests|zipfile|tarfile|gzip|zlib|lzma|bz2|pty|signal|tempfile|argparse|traceback)|os\.(system|popen|exec|spawn|fork|mkdir|makedirs|rename|replace|unlink|remove|rmdir|chmod|chown|write|symlink|link)\(|posix_spawn' "$f" \
    && fail "$f references process, network, archive, or write facilities"
  grep -Eqi '\b(adb|fastboot|ssh|scp|rsync|curl|wget)\b' "$f" && fail "$f names a live transport command"
  grep -Eq 'os\.environ|getenv|traceback' "$f" && fail "$f reads the environment or prints tracebacks"
done
[[ $(wc -l < "$tool") -le 90 ]] || fail "the trusted loader grew past 90 lines"
[[ -x $tool ]] || fail "tool is not executable"
pass "loader and implementation parse and have no process, network, environment, or write facility"

[[ $("$tool" --version) == 0.1.0 ]] || fail "version"
"$tool" show > "$tmp/show.json" || fail "show failed"
cmp -s "$tmp/show.json" "$contract" || fail "show differs from the committed contract"
(cd / && "$OLDPWD/$tool" show | cmp -s - "$tmp/show.json") || fail "show depends on the working directory"
pass "show emits the exact committed contract from any working directory"

set +e
for args in "" "bogus" "show extra" "check-plan" "check-plan --stdin extra" "check-plan stdin" "check-plan --stdin=1" "--version x" "show --stdin" "check-plan /x"; do
  # shellcheck disable=SC2086
  echo '{}' | "$tool" $args > "$tmp/out" 2> "$tmp/err"; rc=$?
  [[ $rc -eq 2 && ! -s $tmp/out && $(cat "$tmp/err") == "myron-discovery: E_USAGE" ]] || fail "misuse '$args' rc=$rc"
done
echo '{}' | "$tool" check-plan --stdin > "$tmp/out" 2> "$tmp/err"; rc=$?
[[ $rc -eq 1 && ! -s $tmp/out && $(cat "$tmp/err") == "myron-discovery: E_REFUSED" ]] || fail "refusal rc=$rc"
set -e
pass "misuse exits 2 and refusal exits 1 with empty stdout and one fixed stderr line"

mkdir "$tmp/fixture"
MYRON_SNAPSHOT_FIXTURE_OUT="$tmp/fixture" tests/myron-snapshot > "$tmp/snapshot-suite.log" 2>&1 \
  || { cat "$tmp/snapshot-suite.log" >&2; fail "snapshot fixture export"; }

python3 -B - "$PWD" "$tmp" <<'PY' || exit 1
import contextlib, copy, hashlib, importlib.machinery, importlib.util, inspect, io, json, os
import re, shutil, socket, subprocess, sys
from pathlib import Path

repo = Path(sys.argv[1])
work = Path(sys.argv[2])
sys.dont_write_bytecode = True


def load(name, path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


M = load("discovery_test", repo / "tools/myron-discovery")
sha = lambda data: hashlib.sha256(data).hexdigest()
TOOL = str(repo / "tools/myron-discovery")


def ok(message):
    print(f"ok - {message}")


def expect(reason, function, *args):
    try:
        function(*args)
    except M.Refusal as error:
        assert error.reason == reason, (reason, error.reason)
        return
    raise AssertionError(f"expected refusal {reason}")


contract_bytes = (repo / "device/myron/discovery-contract.json").read_bytes()
contract = json.loads(contract_bytes)
env = M.load_environment()
actual = env["actual"]
assert actual["contract_sha256"] == sha(contract_bytes)
assert actual["implementation_sha256"] == M.CAPTURED_IMPLEMENTATION_SHA256 == \
    sha((repo / "tools/lib/myron-discovery-impl.py").read_bytes())


def good_plan():
    return {
        "schema": "myron-discovery-plan/1",
        "kind": "myron-discovery-plan",
        "domain": "synthetic-discovery-plan",
        "stage": 1,
        "bindings": {
            "contract_sha256": actual["contract_sha256"],
            "implementation_sha256": actual["implementation_sha256"],
            "synthetic_review_context_sha256": contract["review_context_sha256"],
        },
        "target_ref": "synthetic-target-ref-1",
        "trust_ref": "synthetic-trust-ref-1",
        "output_ref": "synthetic-output-ref-1",
        "recovery_ref": "synthetic-recovery-ref-1",
        "sources": [
            {"source_ref": "synthetic-source-ref-1", "metadata_profile_id": "synthetic-profile-identity"},
            {"source_ref": "synthetic-source-ref-2", "metadata_profile_id": "synthetic-profile-topology"},
            {"source_ref": "synthetic-source-ref-3", "metadata_profile_id": "synthetic-profile-topology"},
        ],
        "operations": [
            {"sequence": 1, "source_ref": "synthetic-source-ref-1",
             "command_id": "synthetic-command-identity", "max_returned_bytes": 1024, "timeout_ms": 2000},
            {"sequence": 2, "source_ref": "synthetic-source-ref-2",
             "command_id": "synthetic-command-topology", "max_returned_bytes": 4096, "timeout_ms": 5000},
            {"sequence": 3, "source_ref": "synthetic-source-ref-2",
             "command_id": "synthetic-command-geometry", "max_returned_bytes": 1024, "timeout_ms": 2000},
            {"sequence": 4, "source_ref": "synthetic-source-ref-3",
             "command_id": "synthetic-command-topology", "max_returned_bytes": 4096, "timeout_ms": 5000},
            {"sequence": 5, "source_ref": "synthetic-source-ref-3",
             "command_id": "synthetic-command-geometry", "max_returned_bytes": 1024, "timeout_ms": 2000},
        ],
        "limits": {"max_calls": 5, "max_returned_bytes": 11264, "max_elapsed_ms": 16000},
        "stop_policy_id": "synthetic-stop-on-first-anomaly",
    }


def check(plan, reason=None, contract_value=None, actual_value=None):
    c = contract_value or contract
    a = actual_value or actual
    if reason is None:
        M.validate_plan(plan, c, a)
    else:
        expect(reason, M.validate_plan, plan, c, a)


def mutate(reason, function, **kwargs):
    plan = good_plan()
    function(plan)
    check(plan, reason, **kwargs)


def raw_check(data, reason=None):
    try:
        M.check_plan(data, env)
    except M.Refusal as error:
        assert reason is not None and error.reason == reason, (reason, error.reason)
        return
    assert reason is None, f"expected refusal {reason}"


# ---------------------------------------------------------------- contract
assert contract_bytes == M.render_json(M.expected_contract())
assert contract["schema"] == "myron-discovery-contract/1" and contract["version"] == "0.1.0"
assert contract["domain"] == "synthetic-discovery-plan"
for other in ("capture-contract", "session-contract", "bootchain-contract", "preflight-contract",
              "snapshot-contract", "deployment-contract", "kernel-source-contract"):
    other_schema = json.loads((repo / f"device/myron/{other}.json").read_bytes()).get("schema")
    assert other_schema != contract["schema"], other
assert not contract["schema"].startswith("myron-capture") and not contract["schema"].startswith("myron-fixture")
assert contract["stages"]["supported"] == [1]
assert [(s["stage"], s["status"]) for s in contract["stages"]["unsupported_deferred"]] == [
    (2, "unsupported-documentation-only"), (3, "unsupported-documentation-only"),
    (4, "unsupported-documentation-only")]
assert "profiles" not in contract["stages"] and "executable" not in json.dumps(contract["stages"])
assert contract["authority"] == dict.fromkeys(sorted(contract["authority"]), False)
assert sorted(contract["authority"]) == sorted([
    "atomic_snapshot_proof", "atomicity_proven", "bootable", "deployment_authorized",
    "flashable", "hardware_qualified", "hardware_read_authorized", "image_ready",
    "rollback_proven"]) and len(contract["authority"]) == 9
other_blockers = json.loads((repo / "device/myron/capture-contract.json").read_bytes())["blockers"]
assert contract["blockers"] == other_blockers and len(other_blockers) == 7
assert contract["stage0"]["status"] == "unresolved" and contract["stage0"]["waived"] is False
assert contract["stage0"]["prerequisites_satisfied"] is False and len(contract["stage0"]["prerequisites"]) == 7
assert contract["binding"]["loader_excluded"] is True and contract["binding"]["covers_runtime_dependencies"] is False
text = contract_bytes.decode()
assert "sha256" not in json.dumps({k: v for k, v in contract.items()
                                   if k not in ("binding", "review_context_sha256", "plan")}).replace("sha256-of", "")
assert contract["review_context_sha256"] == sha(M.canonical_json(contract["review_context"]))
assert not re.search(r"[0-9a-f]{64}", re.sub(r'"review_context_sha256": "[0-9a-f]{64}"', "", text)), \
    "contract carries a digest of itself, the implementation or a private input"
assert not re.search(r"(?i)https?://|ssh-|/dev/|/sys/|/proc/|/home/|\\.\\./|\\bsda\\b|ufs|[0-9a-f]{2}(:[0-9a-f]{2}){5}", text)
assert contract["non_goals"] == list(M.NON_GOALS) and "converter-to-capture-fixtures" in contract["non_goals"]
ok("contract is canonical, namespace-distinct, Stage 1 only, all authority false, blockers and Stage 0 unchanged")

ctx = contract["review_context"]
refs = [r for key in ("target_refs", "trust_refs", "output_refs", "recovery_refs", "stop_policy_ids") for r in ctx[key]]
refs += [s["source_ref"] for s in ctx["sources"]] + [c["command_id"] for c in ctx["commands"]]
refs += [p["metadata_profile_id"] for p in ctx["metadata_profiles"]]
assert all(r.startswith("synthetic-") and re.fullmatch(r"[a-z0-9-]+", r) for r in refs)
assert len(refs) == len(set(refs))
assert {c for p in ctx["metadata_profiles"] for c in p["command_ids"]} == {c["command_id"] for c in ctx["commands"]}
assert all(s["metadata_profile_id"] in {p["metadata_profile_id"] for p in ctx["metadata_profiles"]} for s in ctx["sources"])
assert all(not re.search(r"[/\\ *$;&|<>:.]", c["command_id"]) for c in ctx["commands"])
required = ctx["stage1_required_operations"]
assert [r["phase"] for r in required][0] == "identity-trust-check"
assert [(r["source_ref"], r["command_id"]) for r in required] == [
    ("synthetic-source-ref-1", "synthetic-command-identity"),
    ("synthetic-source-ref-2", "synthetic-command-topology"),
    ("synthetic-source-ref-2", "synthetic-command-geometry"),
    ("synthetic-source-ref-3", "synthetic-command-topology"),
    ("synthetic-source-ref-3", "synthetic-command-geometry")]
assert [s["source_ref"] for s in ctx["sources"]] == [r["source_ref"] for r in required][0:1] + ["synthetic-source-ref-2", "synthetic-source-ref-3"]
assert ctx["min_distinct_topology_sources"] == 2 and ctx["topology_command_id"] == "synthetic-command-topology"
assert len({r["source_ref"] for r in required if r["command_id"] == ctx["topology_command_id"]}) >= 2
assert len(set(map(lambda r: (r["source_ref"], r["command_id"]), required))) == len(required)
ok("review context is finite, dummy-only, and every command id is an inert identifier")
ok("the contract encodes required Stage 1 coverage in order with two distinct topology sources")

# ---------------------------------------------------------------- accept
check(good_plan())
raw_check(json.dumps(good_plan()).encode())
raw_check(json.dumps(good_plan(), indent=4, sort_keys=True).encode())
result = M.check_plan(json.dumps(good_plan()).encode(), env)
assert result == M.render_json(M.check_result_document())
doc = json.loads(result)
assert doc == contract["check_result"]
assert [doc[k] for k in ("hardware_read_authorized", "execution_supported", "approval_issued",
                         "evidence_collected", "blockers_cleared", "stage0_prerequisites_satisfied")] == [False] * 6
other = good_plan()
for operation in other["operations"]:
    operation["max_returned_bytes"], operation["timeout_ms"] = 1, 1
other["limits"] = {"max_calls": 5, "max_returned_bytes": 5, "max_elapsed_ms": 5}
assert M.check_plan(json.dumps(other).encode(), env) == result, "success document depends on the input"
other = good_plan()
for operation in other["operations"]:
    operation["max_returned_bytes"], operation["timeout_ms"] = 512, 500
other["limits"] = {"max_calls": 5, "max_returned_bytes": 2560, "max_elapsed_ms": 2500}
assert M.check_plan(json.dumps(other).encode(), env) == result, "success document depends on the input"
ok("a valid plan yields one fixed success document that claims nothing")

# ---------------------------------------------------------------- bindings
for name in M.BINDING_KEYS:
    mutate("binding", lambda p, n=name: p["bindings"].__setitem__(n, "0" * 64))
    mutate("binding", lambda p, n=name: p["bindings"].__setitem__(n, p["bindings"][n].upper()))
    mutate("binding", lambda p, n=name: p["bindings"].__setitem__(n, p["bindings"][n][:-1]))
    mutate("binding", lambda p, n=name: p["bindings"].__setitem__(n, 7))
    mutate("keys", lambda p, n=name: p["bindings"].pop(n))
mutate("keys", lambda p: p["bindings"].__setitem__("extra", "x"))
mutate("keys", lambda p: p.__setitem__("bindings", {**p["bindings"], "binding_loader_sha256": "a" * 64}), )
check(good_plan(), "binding", actual_value={**actual, "contract_sha256": "1" * 64})
check(good_plan(), "binding", actual_value={**actual, "implementation_sha256": "2" * 64})
changed = copy.deepcopy(contract)
changed["review_context"]["target_refs"].append("synthetic-target-ref-2")
check(good_plan(), "binding", contract_value=changed)
ok("each binding is exact and a changed contract, implementation or review context breaks the plan")

# ---------------------------------------------------------------- scoped fields
mutate("schema", lambda p: p.__setitem__("schema", "myron-discovery-plan/2"))
mutate("schema", lambda p: p.__setitem__("schema", "myron-capture-fixture/1"))
mutate("kind", lambda p: p.__setitem__("kind", "myron-precaptured-fixture"))
mutate("keys", lambda p: p.pop("schema"))
for name in ("target_ref", "trust_ref", "output_ref", "recovery_ref", "stop_policy_id"):
    mutate("reference", lambda p, n=name: p.__setitem__(n, "unknown-id"))
    mutate("reference", lambda p, n=name: p.__setitem__(n, ""))
    mutate("reference", lambda p, n=name: p.__setitem__(n, p[n] + " "))
    mutate("reference", lambda p, n=name: p.__setitem__(n, p[n].upper()))
    mutate("reference", lambda p, n=name: p.__setitem__(n, None))
    mutate("reference", lambda p, n=name: p.__setitem__(n, [p[n]]))
    mutate("keys", lambda p, n=name: p.pop(n))
mutate("reference", lambda p: p.__setitem__("target_ref", "synthetic-trust-ref-1"))
mutate("reference", lambda p: p.__setitem__("output_ref", "synthetic-recovery-ref-1"))
for sentinel in ("ssh-ed25519", "/dev/sda", "https://example.invalid/x", "sda", "$(id)", "*", "../x"):
    mutate("reference", lambda p, s=sentinel: p.__setitem__("target_ref", s))
    mutate("dangling-source", lambda p, s=sentinel: p["operations"][0].__setitem__("source_ref", s))
    mutate("command", lambda p, s=sentinel: p["operations"][0].__setitem__("command_id", s))
ok("every reference resolves only inside the review context and each field mutation refuses")

mutate("stage-unsupported", lambda p: p.__setitem__("stage", 2))
mutate("stage-unsupported", lambda p: p.__setitem__("stage", 3))
mutate("stage-unsupported", lambda p: p.__setitem__("stage", 4))
mutate("stage-unsupported", lambda p: p.__setitem__("stage", 0))
mutate("stage", lambda p: p.__setitem__("stage", True))
mutate("stage", lambda p: p.__setitem__("stage", "1"))
mutate("stage", lambda p: p.__setitem__("stage", None))
for domain in ("fixture", "hardware", "live", "myron-precaptured-fixture", "hardware-discovery",
               "synthetic-discovery-plan ", "Synthetic-Discovery-Plan", "", None, 1):
    mutate("domain", lambda p, d=domain: p.__setitem__("domain", d))
ok("stages 2-4 and every foreign domain are refused")

mutate("sources", lambda p: p.__setitem__("sources", []))
mutate("sources", lambda p: p.__setitem__("sources", {}))
mutate("keys", lambda p: p["sources"][0].__setitem__("x", 1))
mutate("keys", lambda p: p["sources"][0].pop("metadata_profile_id"))
mutate("source-profile", lambda p: p["sources"][0].__setitem__("metadata_profile_id", "synthetic-profile-topology"))
mutate("source-profile", lambda p: p["sources"][0].__setitem__("metadata_profile_id", "unknown"))
mutate("reference", lambda p: p["sources"][1].__setitem__("source_ref", "synthetic-source-ref-9"))
mutate("source-duplicate", lambda p: p["sources"].append(dict(p["sources"][1])))
mutate("source-order", lambda p: p["sources"].reverse())
mutate("command-profile", lambda p: p["operations"][0].__setitem__("source_ref", "synthetic-source-ref-3"))
mutate("dangling-source", lambda p: p["operations"][0].__setitem__("source_ref", "synthetic-source-ref-9"))
mutate("operations", lambda p: p.__setitem__("operations", []))
mutate("operations", lambda p: p.__setitem__("operations", None))
mutate("forbidden-field", lambda p: p["operations"][0].__setitem__("retry", 1))
mutate("keys", lambda p: p["operations"][0].pop("timeout_ms"))
mutate("command", lambda p: p["operations"][0].__setitem__("command_id", "unknown-command"))
mutate("command-profile", lambda p: p["operations"][0].__setitem__("command_id", "synthetic-command-topology"))
mutate("command-profile", lambda p: p["operations"][1].__setitem__("command_id", "synthetic-command-identity"))
mutate("operation-duplicate", lambda p: p["operations"][2].__setitem__("command_id", "synthetic-command-topology"))
mutate("sequence", lambda p: p["operations"].reverse())
mutate("sequence", lambda p: p["operations"][1].__setitem__("sequence", 3))
mutate("sequence", lambda p: p["operations"][0].__setitem__("sequence", 0))
mutate("sequence", lambda p: p["operations"][0].__setitem__("sequence", 2))
mutate("sequence", lambda p: p["operations"][0].__setitem__("sequence", True))
mutate("sequence", lambda p: p["operations"][0].__setitem__("sequence", "1"))
mutate("sequence", lambda p: p["operations"][2].__setitem__("sequence", 4))
mutate("sequence", lambda p: p["operations"][1].__setitem__("sequence", 1))
ok("unknown ids, dangling or unused sources, duplicates, and noncontiguous or reordered sequences refuse")

# ---------------------------------------------------------------- required Stage 1 coverage
def renumber(plan):
    for index, operation in enumerate(plan["operations"], 1):
        operation["sequence"] = index
    plan["limits"]["max_calls"] = len(plan["operations"])


def keep_sources(plan, *numbers):
    plan["sources"] = [s for s in plan["sources"] if s["source_ref"][-1] in numbers]


def only(plan, *pairs):
    plan["operations"] = [o for o in plan["operations"] if (o["source_ref"][-1], o["command_id"][18:]) in pairs]
    renumber(plan)


def identity_only(p):
    keep_sources(p, "1"); only(p, ("1", "identity"))
def topology_only(p):
    keep_sources(p, "2", "3"); only(p, ("2", "topology"), ("3", "topology"))
def geometry_only(p):
    keep_sources(p, "2", "3"); only(p, ("2", "geometry"), ("3", "geometry"))
def topology_source_omitted(p):
    keep_sources(p, "1", "2"); only(p, ("1", "identity"), ("2", "topology"), ("2", "geometry"))
def identity_missing_with_source(p):
    only(p, ("2", "topology"), ("2", "geometry"), ("3", "topology"), ("3", "geometry"))
def geometry_missing(p):
    only(p, ("1", "identity"), ("2", "topology"), ("2", "geometry"), ("3", "topology"))
def topology_missing(p):
    only(p, ("1", "identity"), ("2", "geometry"), ("3", "topology"), ("3", "geometry"))
def identity_last(p):
    p["operations"].append(p["operations"].pop(0)); renumber(p)
def commands_swapped(p):
    p["operations"][1], p["operations"][2] = p["operations"][2], p["operations"][1]; renumber(p)
def sources_swapped(p):
    ops = p["operations"]; ops[1:3], ops[3:5] = ops[3:5], ops[1:3]; renumber(p)
def topology_first(p):
    ops = p["operations"]; ops[0], ops[1] = ops[1], ops[0]; renumber(p)

for name, reason, function in (
        ("identity-only", "required-sources", identity_only),
        ("topology-only", "required-sources", topology_only),
        ("geometry-only", "required-sources", geometry_only),
        ("topology source omitted", "required-sources", topology_source_omitted),
        ("identity operation missing", "source-unused", identity_missing_with_source),
        ("geometry operation missing", "required-coverage", geometry_missing),
        ("topology operation missing", "required-coverage", topology_missing),
        ("identity last", "required-order", identity_last),
        ("topology before geometry swapped", "required-order", commands_swapped),
        ("topology sources swapped", "required-order", sources_swapped),
        ("identity not first", "required-order", topology_first)):
    mutate(reason, function)
# every omitted source or command is refused, whatever the other operations are
for omitted in range(5):
    plan = good_plan(); del plan["operations"][omitted]; renumber(plan)
    try:
        check(plan)
    except M.Refusal as error:
        assert error.reason in ("source-unused", "required-coverage"), error.reason
    else:
        raise AssertionError("an omitted required operation was accepted")
# the minimum number of distinct topology sources is enforced from the contract
changed = copy.deepcopy(contract)
changed["review_context"]["min_distinct_topology_sources"] = 3
plan = good_plan()
plan["bindings"]["synthetic_review_context_sha256"] = sha(M.canonical_json(changed["review_context"]))
check(plan, "topology-sources", contract_value=changed)
# lower positive budgets stay valid; the required list may not move
plan = good_plan()
for operation in plan["operations"]:
    operation["max_returned_bytes"], operation["timeout_ms"] = 1, 1
plan["limits"] = {"max_calls": 5, "max_returned_bytes": 5, "max_elapsed_ms": 5}
check(plan)
ok("required sources and commands cannot be omitted, added or reordered; lower budgets stay valid")

# ---------------------------------------------------------------- budgets: exact ceilings and +1
for key in ("max_returned_bytes", "timeout_ms"):
    for bad in (0, -1, True, False, "1", None, 1.5, [1]):
        if isinstance(bad, float):
            continue
        mutate("budget-type", lambda p, k=key, b=bad: p["operations"][0].__setitem__(k, b))
mutate("operation-bytes", lambda p: p["operations"][0].__setitem__("max_returned_bytes", 1025))
mutate("operation-timeout", lambda p: p["operations"][0].__setitem__("timeout_ms", 2001))
mutate("operation-bytes", lambda p: p["operations"][1].__setitem__("max_returned_bytes", 4097))
mutate("operation-timeout", lambda p: p["operations"][1].__setitem__("timeout_ms", 5001))
for command in ctx["commands"]:
    index = [o["command_id"] for o in good_plan()["operations"]].index(command["command_id"])
    def at_ceiling(p, i=index, c=command):
        p["operations"][i]["max_returned_bytes"] = c["max_returned_bytes"]
        p["operations"][i]["timeout_ms"] = c["max_timeout_ms"]
        p["limits"]["max_returned_bytes"] = 11264
        p["limits"]["max_elapsed_ms"] = 16000
    plan = good_plan(); at_ceiling(plan); check(plan)
for bad in (0, -1, True, "1", None):
    for key in M.LIMIT_KEYS:
        mutate("budget-type", lambda p, k=key, b=bad: p["limits"].__setitem__(k, b))
mutate("keys", lambda p: p["limits"].pop("max_calls"))
mutate("forbidden-field", lambda p: p["limits"].__setitem__("max_retries", 0))
mutate("forbidden-field", lambda p: p["limits"].__setitem__("concurrency", 1))
# aggregate bytes: exact, then +1
plan = good_plan(); plan["limits"]["max_returned_bytes"] = 11264; check(plan)
