for i in {1..20}; do [[ -e $fix/lock-held ]] && break; command sleep 0.05; done
[[ -e $fix/lock-held ]] || fail 'watch-stopped contention holder did not take the lock'
opq watch-stopped || fail 'observer exit hook under lock contention'
[[ -e $fix/op/watch-stopped && $(pubv state) == restart && $(reboots) == 0 ]] || fail 'lock contention left a dead observer displayed on'
wait "$holder" || true
rm -f "$fix/lock-held"
opq watch && fail 'a late observer revived after the exit hook'
sealed_attended; opq proof-ready || fail 'proof-ready'; MOCK_UID=4242 opq record-evidence && fail 'record-evidence as non-root'
reset; opq record-evidence && fail 'record-evidence with no operation'
[[ ! -e $fix/main/cellular-evidence ]] || fail 'a refused record wrote evidence'
pass 'evidence: sealed attended/live-observer only, bound to boot, startup/reboot policy, profile, units, NM, APN, kernel and image'

# ---- the watcher -----------------------------------------------------------------
sealed_attended
: >"$fix/calls"
# A newly started observer owns starting -> up before its first poll.
echo starting >"$fix/op/lifecycle"
printf 'grep -Fxq up %s/op/lifecycle\n' "$fix" >"$fix/hook-sleep-1"
# two transient failures recover; three in a row are lost
printf 'touch %s/guard-bad\n' "$fix" >"$fix/hook-sleep-2"; printf 'rm -f %s/guard-bad\n' "$fix" >"$fix/hook-sleep-4"
printf 'touch %s/nm-down\n' "$fix" >"$fix/hook-sleep-6"
opq watch || { cat "$work/out"; fail 'watch'; }
grep -Fq 'result=lost' "$work/out" || fail 'watch did not report lost'
[[ $(cat "$fix/op/lifecycle") == lost && $(pubv state) == restart ]] || fail 'lost lifecycle / public state'
n=$(cat "$fix/sleep-n"); [[ $n == 8 ]] || fail "watch needed $n polls (two transients must recover, then three losses)"
[[ $(reboots) == 0 ]] || fail 'the watcher rebooted'
grep -E '^nmcli' "$fix/calls" | grep -Ev '^nmcli -t -g GENERAL.STATE connection show uuid' && fail 'the watcher ran an nmcli command other than a read'
grep -Eq 'systemctl (start|stop)|main-os' "$fix/calls" && fail 'the watcher started, stopped or rebooted something'
grep -Fq 'guard check' "$fix/calls" || fail 'the watcher did not read the IPA guard'
[[ $(st) == sealed ]] || fail 'watcher changed the operation state'
# lost is final: no later publish returns it to on
op publish; [[ $(pubv state) == restart ]] || fail 'a publish revived lost data'
# refuses outside a sealed operation
reset; to_ready qualified; opq watch && fail 'watch before the seal'
reset; opq watch && fail 'watch with no operation'
sealed_attended; rm -f "$fix/op/lifecycle"; opq watch && fail 'watch without a lifecycle'
pass 'watcher: self-admits starting to up, observes only, debounces, lost is final, never mutates or reboots'

# ---- the public status -------------------------------------------------------------
pubstate() { op publish; printf '%s/%s' "$(pubv state)" "$(pubv evidence)"; }
reset; [[ $(pubstate) == idle/absent ]] || fail 'idle public state'
reset; opq begin qualified; [[ $(pubstate) == starting/absent ]] || fail 'starting public state'
reset; to_ready qualified; opq abort failed; [[ $(pubstate) == restart/absent ]] || fail 'restart public state'
reset; to_ready qualified; opq seal; [[ $(pubstate) == on/absent ]] || fail 'on public state'
reset; opq begin qualified; printf 'garbage\n' >"$fix/op/state"; [[ $(pubstate) == restart/absent ]] || fail 'unknown state must not read as idle'
reset; op publish; grep -Fq "boot_id=$bootid" "$fix/public/state" || fail 'public boot id'
[[ $(wc -l <"$fix/public/state") == 3 ]] || fail 'public state shape'
grep -Eiq '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+|imei|apn|uuid' "$fix/public/state" && fail 'public state carries an identifier'
reset; op publish; echo 'evidence-garbage' >"$fix/main/cellular-evidence"; chmod 600 "$fix/main/cellular-evidence"
op publish; [[ $(pubv evidence) == invalid ]] || fail 'garbage evidence must read invalid'
pass 'public status: words only, unknown is restart-required never idle, garbage evidence is invalid'

# ---- launch and confirmation ---------------------------------------------------------
TOKEN=ONE-SHOT-CELLULAR-DATA-REBOOT-REQUIRED
reset; opq launch WRONG && fail 'launch accepted a wrong token'; opq launch && fail 'launch without a token'
[[ ! -e $fix/op/confirm ]] && ! grep -q 'attended.service' "$fix/calls" || fail 'a refused launch confirmed or started'
reset; MOCK_UID=4242 opq launch "$TOKEN" && fail 'launch as non-root'
reset; opq launch "$TOKEN" || { cat "$work/out"; fail 'launch'; }
grep -Fq 'systemctl start --no-block myron-cellular-attended.service' "$fix/calls" || fail 'launch did not start the attended unit'
[[ $(stat -c %a "$fix/op/confirm") == 600 ]] || fail 'confirm mode'
op confirmed || fail 'confirmed after launch'
opq confirmed && fail 'confirmation is not single-use'
reset; touch "$fix/op/x" 2>/dev/null || mkdir -p "$fix/op"; printf 'boot_id=%s\n' "$other" >"$fix/op/confirm"; chmod 600 "$fix/op/confirm"
opq confirmed && fail 'a confirmation from another boot was accepted'
reset; sed -i 's/latch=absent/latch=present/' "$fix/main-status"; opq launch "$TOKEN" && fail 'launch on a latched boot'
reset; opq begin attended; opq launch "$TOKEN" && fail 'launch while an operation is armed'
reset; mkdir -p "$fix/stage-mutation"; opq launch "$TOKEN" && fail 'launch after a mutation'
pass 'launch: exact token, committed boot, single-use confirmation, one start'

printf 'ok - tests/myron-cellular-op\n' >/dev/null
