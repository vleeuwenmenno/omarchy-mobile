#!/bin/bash
# SPDX-License-Identifier: MIT
# shellcheck disable=SC2016,SC2154
# Executes the persistent main boot's cellular operation supervisor
# (myron-cellular-op) against fake systemctl, ss, ip, nmcli, the IPA guard and
# the main control: arming before any mutation, the live state machine, the
# seal/abort race under one lock, the fresh-SSH nonce proof, evidence binding,
# the watcher, the public status, and the static units. Nothing touches a
# phone, a network or a block device.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }
# shellcheck source=/dev/null
source tests/lib/myron-sh-harness.sh

overlay=device/myron/main-overlay
op_src=$overlay/usr/local/sbin/myron-cellular-op
units_dir=$overlay/usr/lib/systemd/system
polkit_src=$overlay/etc/polkit-1/rules.d/50-myron-cellular-enable.rules
helper_src=$overlay/usr/local/bin/myron-mobile-data
reboot_src=$overlay/usr/local/sbin/myron-cellular-reboot-failsafe
stage_src=device/myron/hardware-test-overlay/usr/local/sbin/myron-cellular-stage
root=$(pwd)

shellcheck_bin=$(command -v shellcheck || true)
if [[ -z $shellcheck_bin ]] || ! "$shellcheck_bin" --version >/dev/null 2>&1; then
  shellcheck_bin=$(ls /home/menno/.local/share/mise/installs/shellcheck/*/shellcheck-*/shellcheck 2>/dev/null | tail -n1 || true)
fi

# ---- static ----------------------------------------------------------------
for f in "$op_src" "$helper_src" "$reboot_src"; do
  [[ -x $f ]] || fail "$f is executable"
  sh -n "$f" || fail "$f parses as POSIX sh"
  bash -n "$f" || fail "$f parses as bash"
  if [[ -n $shellcheck_bin ]]; then "$shellcheck_bin" -s sh -e SC2086,SC2034,SC2046,SC2015,SC2155,SC2294,SC2329 "$f" || fail "shellcheck $f"; fi
done
if grep -nE '\[\[[^:]|<<<|(^|[[:space:]])local[[:space:]]|\bfunction\b|\bdeclare\b|\bmapfile\b|&>|<\(' "$op_src" "$helper_src" "$reboot_src"; then
  fail 'supervisor or helper uses shell syntax outside POSIX sh'
fi
# The supervisor only ever starts the timer, the watcher and the attended unit,
# stops the timer and the operation units, and observes the connection.
if grep -nE 'systemctl +(restart|reload|kill|mask|unmask|disable|enable|daemon|reboot|poweroff|isolate)' "$op_src"; then
  fail 'supervisor runs a forbidden systemctl verb'
fi
if grep -nE 'nmcli +(radio|networking|device +(set|connect|disconnect|reapply)|connection +(up|down|add|modify|delete|reload))|mmcli|rfkill|modprobe|rmmod|insmod|fastboot|\bdd\b|blockdev|sgdisk|--set-|/dev/(disk|block|sd|mmc)|\bkill(all)?\b' "$op_src" |
  grep -vE '^[0-9]+:[[:space:]]*#'; then
  fail 'supervisor contains a radio, NetworkManager mutation, storage or direct reboot action'
fi
if grep -nE '^[[:space:]]*(exec[[:space:]]+)?reboot([;&|[:space:]]|$)' "$op_src"; then
  fail 'supervisor contains a direct reboot action'
fi
if grep -nE 'recover|set_latch|[/]latch|latch[.]new' "$op_src" | grep -vE '^[0-9]+:[[:space:]]*#'; then
  fail 'supervisor refers to the recovery latch'
fi
grep -Fq 'exec "$reboot_failsafe" --reason "cellular-op-$reason"' "$op_src" || fail 'abort does not delegate to the reboot failsafe'
grep -Fq '"$main_os" reboot-normal --reason "$reason"' "$reboot_src" || fail 'reboot failsafe does not try main-os first'
grep -Fq 'systemctl --no-block reboot' "$reboot_src" || fail 'reboot failsafe lacks a normal systemd request'
grep -Fq 'reboot -f' "$reboot_src" || fail 'reboot failsafe lacks a forced plain reboot'
if grep -nE 'recover|set_latch|[/]latch|latch[.]new|fastboot|reboot-to-bootloader|\bdd\b|blockdev|sgdisk|--set-|/dev/(disk|block|sd|mmc)' "$reboot_src" |
  grep -vE '^[0-9]+:[[:space:]]*#'; then
  fail 'reboot failsafe can select recovery, a slot or storage'
fi
lock_bound=$(sed -n 's/^lock_seconds=//p' "$op_src")
stop_bound=$(sed -n 's/^stop_seconds=//p' "$op_src")
controller_bound=$(sed -n 's/^controller_seconds=//p' "$reboot_src")
controller_kill_bound=$(sed -n 's/^controller_kill_seconds=//p' "$reboot_src")
grace_bound=$(sed -n 's/^grace_seconds=//p' "$reboot_src")
command_bound=$(sed -n 's/^command_seconds=//p' "$reboot_src")
(( lock_bound + 3 * (stop_bound + 1) + controller_bound + controller_kill_bound + grace_bound + 4 * (command_bound + 1) < 300 )) || fail 'worst-case abort path is not below 300 seconds'
grep -Fq 'myron-cellular-reboot-failsafe' tools/myron-dev-image-compose || fail 'composer omits the reboot failsafe'
grep -Fq "cellular reboot failsafe differs from the repository" tools/myron-dev-image-compose || fail 'composer does not byte-verify the reboot failsafe'
for program in \
  device/myron/main-overlay/usr/local/sbin/myron-cellular-op \
  device/myron/main-overlay/usr/local/bin/myron-mobile-data \
  device/myron/hardware-test-overlay/usr/local/sbin/myron-cellular-stage; do
  grep -Fq "$program" tools/myron-dev-image-compose || fail "composer does not byte-verify $program"
done
grep -Fq 'cellular program differs from the repository' tools/myron-dev-image-compose || fail 'composer cellular-program mismatch is not fatal'
if grep -niE 'imei|imsi|iccid|msisdn|own-numbers|equipment-identifier|hw-addr|mac-address|ether ' "$op_src" "$helper_src" "$reboot_src"; then
  fail 'supervisor or helper reads or prints identity fields'
fi
# Helper: only ModemManager listing and keys, and the one start.
grep -E 'mmcli' "$helper_src" | grep -vE 'mmcli -L|mmcli -m "\$\(printf|^[[:space:]]*#' && fail 'helper runs an mmcli command other than list and keys'
# Only: read the owned gate unit, start/stop that gate, start the enable unit.
if grep -E 'systemctl' "$helper_src" | grep -vE '^[[:space:]]*#' |
  grep -vE 'systemctl show -p LoadState -p ActiveState "\$block_unit"|exec systemctl (stop|start) "\$block_unit"|exec systemctl start --no-block "\$enable_unit"'; then
  fail 'helper runs a systemctl command other than the gate read, gate start/stop and enable start'
fi
grep -Fq 'exec systemctl start --no-block "$enable_unit"' "$helper_src" || fail 'helper does not start exactly the enable unit'
if grep -nE 'nmcli|rfkill|connection (up|down)|device (disconnect|set)' "$helper_src"; then fail 'helper touches NetworkManager or rfkill'; fi
pass 'supervisor and helpers: POSIX syntax, bounded plain reboot, forbidden actions, no latch, no identity'

# Constants shared with the stage and the units.
window=$(sed -n 's/^window_seconds=\([0-9]*\)$/\1/p' "$op_src")
timer_sec=$(sed -n 's/^OnActiveSec=\([0-9]*\)s$/\1/p' "$units_dir/myron-cellular-op.timer")
[[ $window == "$timer_sec" && $window == 1200 ]] || fail "timer window ($timer_sec) differs from the supervisor's ($window)"
[[ $(sed -n 's/^confirm_token=//p' "$op_src") == "$(sed -n 's/^confirm_token=//p' "$stage_src")" ]] || fail 'confirmation token differs between stage and supervisor'
[[ $(sed -n 's/^target_uuid=//p' "$op_src") == "$(sed -n 's/^target_uuid=//p' "$stage_src")" ]] || fail 'target UUID differs between stage and supervisor'
[[ $(sed -n 's/^mutation_marker=//p' "$op_src") == /run/myron-cellular-stage/mutation && \
   $(sed -n 's/^runtime_dir=//p' "$stage_src") == /run/myron-cellular-stage ]] || fail 'mutation marker path differs between stage and supervisor'
listed=$(sed -n "s/^units='\(.*\)'$/\1/p" "$op_src" | tr ' ' '\n' | sort)
present=$(cd "$units_dir" && ls myron-cellular-op* myron-cellular-attended.service myron-cellular-enable.service myron-cellular-watch.service myron-cellular-publish.service | sort -u)
[[ $listed == "$present" ]] || fail 'the fingerprint unit list differs from the operation units'
grep -Fxq 'min_remaining_begin=1140' "$op_src" || fail 'begin deadline floor'
grep -Fxq 'min_remaining_arm=480' "$stage_src" && grep -Fxq 'min_remaining_activate=420' "$stage_src" || fail 'existing 480/420 deadline floors changed'
pass 'timer window, token, UUID, marker path and unit list agree'

# Units: static, never enabled except the publisher, abort not ordered after or tied to the worker.
for u in myron-cellular-op.timer myron-cellular-op-abort.service myron-cellular-op-failed.service myron-cellular-attended.service \
  myron-cellular-enable.service myron-cellular-watch.service myron-cellular-publish.service; do
  grep -Fxq 'ConditionPathExists=/run/myron-main/boot-id' "$units_dir/$u" || fail "$u is not limited to the main boot"
  if grep -nE '^(Requires|Wants|BindsTo|PartOf|Requisite|After|Before|Conflicts|PropagatesStopTo)=.*myron-cellular-(attended|enable|op)' "$units_dir/$u"; then
    fail "$u is ordered against or tied to another operation unit"
  fi
done
for u in myron-cellular-op.timer myron-cellular-op-abort.service myron-cellular-op-failed.service myron-cellular-attended.service \
  myron-cellular-enable.service myron-cellular-watch.service; do
  ! grep -q '^\[Install\]' "$units_dir/$u" || fail "$u is installable"
done
grep -Fxq 'WantedBy=multi-user.target' "$units_dir/myron-cellular-publish.service" || fail 'publisher is not installable'
for u in myron-cellular-attended.service myron-cellular-enable.service; do
  grep -Fxq 'OnFailure=myron-cellular-op-failed.service' "$units_dir/$u" || fail "$u lacks OnFailure"
  grep -Fxq 'TimeoutStartSec=1100' "$units_dir/$u" || fail "$u bound"
  grep -Fxq 'Type=oneshot' "$units_dir/$u" || fail "$u type"
done
grep -Fxq 'ExecStart=/usr/local/sbin/myron-cellular-stage main-run attended' "$units_dir/myron-cellular-attended.service" || fail 'attended ExecStart'
grep -Fxq 'ExecStart=/usr/local/sbin/myron-cellular-stage main-run qualified' "$units_dir/myron-cellular-enable.service" || fail 'enable ExecStart'
grep -Fxq 'ExecStart=/usr/local/sbin/myron-cellular-op abort deadline' "$units_dir/myron-cellular-op-abort.service" || fail 'deadline ExecStart'
grep -Fxq 'ExecStart=/usr/local/sbin/myron-cellular-op abort failed' "$units_dir/myron-cellular-op-failed.service" || fail 'failure ExecStart'
grep -Fxq 'Unit=myron-cellular-op-abort.service' "$units_dir/myron-cellular-op.timer" || fail 'timer target'
grep -Fxq 'RemainAfterElapse=no' "$units_dir/myron-cellular-op.timer" || fail 'timer elapse'
grep -Fxq 'Restart=no' "$units_dir/myron-cellular-watch.service" || fail 'watcher restarts'
grep -Fxq 'ExecStopPost=/usr/local/sbin/myron-cellular-op watch-stopped' "$units_dir/myron-cellular-watch.service" || fail 'watcher exit does not publish loss'
if grep -nE 'reboot|OnFailure' "$units_dir/myron-cellular-watch.service" | grep -v '^[0-9]*:#'; then fail 'watcher can reboot'; fi
grep -Fxq 'TimeoutStartSec=300' "$units_dir/myron-cellular-op-abort.service" || fail 'deadline abort bound'
grep -Fxq 'TimeoutStartSec=300' "$units_dir/myron-cellular-op-failed.service" || fail 'failure abort bound'
# Polkit: exactly the enable unit, start only, active local intended user.
grep -Fq 'action.lookup("unit") == "myron-cellular-enable.service"' "$polkit_src" &&
  grep -Fq 'action.lookup("verb") == "start"' "$polkit_src" &&
  grep -Fq 'subject.local && subject.active' "$polkit_src" &&
  grep -Fq 'subject.user == "menno"' "$polkit_src" || fail 'polkit rule is not the exact unit, start, active local user'
if grep -nE 'isInGroup|/\^|test\(|"stop"|restart|attended' "$polkit_src" | grep -v '^[0-9]*:[[:space:]]*//'; then fail 'polkit rule is broader than the one start'; fi
[[ $(grep -c 'polkit.Result.YES' "$polkit_src") == 1 ]] || fail 'polkit rule grants more than once'
pass 'units static and unordered against the worker; only the publisher installable; polkit exactly one start for one user'

# ---- harness ---------------------------------------------------------------
work=$(mktemp -d /tmp/myron-cellular-op.XXXXXX)
trap 'chmod -R u+rwx "$work" 2>/dev/null || true; rm -rf -- "$work"' EXIT
uid=$(id -u) gid=$(id -g)
fix=$work/fix; bin=$work/bin; opc=$work/myron-cellular-op
mkdir -p "$fix" "$bin"
bootid=11111111-2222-3333-4444-555555555555
other=99999999-2222-3333-4444-555555555555
image=0123456789abcdef0123456789abcdef
nonce_re='^[0-9a-f]{32}$'

patch_op() {
  sh_patch "$op_src" "$opc" "main_os=$fix/main-os" "stage=$work/stage" "self=$opc" "helper=$work/helper" \
    "reboot_failsafe=$work/reboot-helper" "startup_helper=$work/startup" "guard=$fix/guard" "nm_conf=$work/nm.conf" "apn_config=$work/apn" \
    "profile_file=$work/profile" "unit_dir=$work/units" "polkit_rule=$work/polkit.rules" \
    "rescue_before=$fix/rescue.before" "net_root=$fix/net" "op_dir=$fix/op" "public_dir=$fix/public" \
    "lock_file=$fix/lock" "mutation_marker=$fix/stage-mutation" "runtime_boot_id=$fix/run/boot-id" \
    "runtime_image_id=$fix/run/image-id" "main_state=$fix/main" "log=$fix/log" "boot_id_file=$fix/bootid" \
    "uptime_file=$fix/uptime" "notes_file=$work/notes" "root_uid=$uid" "root_gid=$gid" \
    "lock_seconds=2" "stop_seconds=3" "observer_start_seconds=2" "watch_poll_seconds=1" "watch_failures=3"
}
mock() { printf '#!/bin/sh\nfix=%s\n%s\n' "$fix" "$2" >"$bin/$1"; chmod +x "$bin/$1"; }
mock id 'echo ${MOCK_UID:-'"$uid"'}'
mock sync ':'
mock sleep 'read -r up _ <"$fix/uptime"; up=${up%%.*}; echo "$((up + $1)).00 0.00" >"$fix/uptime"
n=$(cat "$fix/sleep-n" 2>/dev/null || echo 0); n=$((n+1)); echo $n >"$fix/sleep-n"
[ ! -f "$fix/hook-sleep-$n" ] || sh "$fix/hook-sleep-$n"'
mock systemctl 'echo "systemctl $*" >>"$fix/calls"
args=; for a in "$@"; do case $a in --quiet|--no-block) ;; *) args="$args $a" ;; esac; done
set -- $args
verb=$1; unit=${2:-}
case $verb in
is-active) [ -e "$fix/active-$unit" ] ;;
start)
  [ ! -f "$fix/hook-start-$unit" ] || sh "$fix/hook-start-$unit"
  [ ! -e "$fix/fail-start-$unit" ] || exit 1
  [ -e "$fix/no-activate-$unit" ] || touch "$fix/active-$unit"
  if [ "$unit" = myron-cellular-watch.service ] && [ ! -e "$fix/no-admit-$unit" ]; then echo up >"$fix/op/lifecycle"; fi
  case $unit in *.timer)
    read -r up _ <"$fix/uptime"; up=${up%%.*}
    echo "$(( (up - ${TIMER_SKEW:-0}) * 1000000 ))" >"$fix/entered" ;; esac ;;
stop)
  [ ! -f "$fix/hook-stop-$unit" ] || sh "$fix/hook-stop-$unit"
  rm -f "$fix/active-$unit" ;;
show)
  [ ! -f "$fix/hook-show" ] || sh "$fix/hook-show"
  cat "$fix/entered" 2>/dev/null ;;
reboot) [ ! -e "$fix/fail-systemd-reboot" ] ;;
esac'
mock main-os 'echo "main-os $*" >>"$fix/calls"
case $1 in
status) cat "$fix/main-status" ;;
reboot-normal) [ "${MAIN_OS_HANG:-0}" != 1 ] || /bin/sleep 3; exit ${MAIN_OS_RC:-0} ;;
esac'
mock guard 'echo "guard $*" >>"$fix/calls"; [ ! -e "$fix/guard-bad" ]'
mv "$bin/guard" "$fix/guard"
mv "$bin/main-os" "$fix/main-os"
cp "$fix/main-os" "$work/main-os.mock"
mock nmcli 'echo "nmcli $*" >>"$fix/calls"; [ ! -e "$fix/nm-down" ] && echo activated || echo deactivated'
mock ss 'echo "ss $*" >>"$fix/calls"; cat "$fix/ss-established" 2>/dev/null; true'
mock ip 'echo "ip $*" >>"$fix/calls"; cat "$fix/ip-addr" 2>/dev/null; true'
mock reboot 'echo "reboot $*" >>"$fix/calls"'

reboot_mock=$work/reboot-helper.mock
printf '#!/bin/sh\necho "reboot-helper $*" >>%q\nexit "${FAILSAFE_RC:-0}"\n' "$fix/calls" >"$reboot_mock"
chmod +x "$reboot_mock"

reset() {
  rm -rf "$fix/op" "$fix/public" "$fix/main" "$fix/run" "$fix/net" "$work/units" "$fix"/active-* "$fix"/hook-* "$fix"/fail-* \
    "$fix"/no-activate-* "$fix"/no-admit-* \
    "$fix"/calls "$fix/entered" "$fix/lock" "$fix/log" "$fix/sleep-n" "$fix/guard-bad" "$fix/nm-down" "$fix/stage-mutation" \
    "$fix/rescue.before" "$fix/ss-established" "$fix/ip-addr" "$work/apn"
  mkdir -p "$fix/run" "$fix/main" "$fix/net/usb0" "$fix/net/wlan0/wireless" "$fix/net/rmnet_data0" "$work/units"
  chmod 700 "$fix/main"
  cp "$work/main-os.mock" "$fix/main-os"; chmod +x "$fix/main-os"
  echo "$bootid" >"$fix/bootid"; echo "$bootid" >"$fix/run/boot-id"; echo "$image" >"$fix/run/image-id"
  echo '1000.00 0.00' >"$fix/uptime"
  printf 'os=omarchy boot_id=%s latch=absent pending=absent success=current image=present next_boot=omarchy\n' "$bootid" >"$fix/main-status"
  printf 'stage-v1\n' >"$work/stage"; printf 'helper-v1\n' >"$work/helper"; printf 'startup-v1\n' >"$work/startup"
  cp "$reboot_mock" "$work/reboot-helper"; chmod +x "$work/reboot-helper"
  printf 'cellular\n' >"$work/profile"; chmod 644 "$work/profile"
  printf 'nm-v1\n' >"$work/nm.conf"; printf 'notes-v1' >"$work/notes"
  cp "$units_dir"/myron-cellular-*.service "$units_dir"/myron-cellular-op.timer "$work/units/"
  cp "$polkit_src" "$work/polkit.rules"
  touch "$fix/calls" "$fix/log"
  unset MOCK_UID MAIN_OS_RC MAIN_OS_HANG FAILSAFE_RC TIMER_SKEW SSH_CONNECTION || true
  patch_op
}
op() { PATH=$bin:$PATH sh "$opc" "$@"; }
opq() { op "$@" >"$work/out" 2>&1; }       # output kept in $work/out
st() { sed -n 's/^state=//p' "$fix/op/state" 2>/dev/null; }
pubv() { sed -n "s/^$1=//p" "$fix/public/state"; }
calls() { cat "$fix/calls"; }
reboots() { grep -c '^reboot-helper --reason' "$fix/calls" || true; }
mark_all() { for s in "$@"; do opq mark "$s" || { cat "$work/out"; fail "mark $s"; }; done; }
to_ready() { # kind
  opq begin "$1" || { cat "$work/out"; fail 'begin'; }
  mark_all attempting activating active ready
}
to_ready_with_proofs() {
  to_ready attended
  echo 'ESTAB 0 0 172.16.42.1:22 172.16.42.2:51000' >"$fix/ss-established"
}
no_identity() { :; }

# ---- normal reboot failsafe -------------------------------------------------
# Every controller outcome reaches the same systemd request and forced plain
# fallback in this mock environment. On a phone a successful reboot never
# returns far enough to execute the fallback.
rebootc=$work/myron-cellular-reboot-failsafe
patch_reboot() {
  sh_patch "$reboot_src" "$rebootc" "main_os=$fix/main-os" "runtime_boot_id=$fix/run/boot-id" \
    "boot_id_file=$fix/bootid" "controller_seconds=1" "controller_kill_seconds=1" "grace_seconds=2" "poll_seconds=1" \
    "command_seconds=2" "root_uid=$uid"
}
run_reboot() { PATH=$bin:$PATH sh "$rebootc" --reason cellular-op-failed >"$work/reboot-out" 2>&1; }
for outcome in returned failed hung unavailable systemd-refused; do
  reset; patch_reboot; : >"$fix/calls"
  case $outcome in
  returned) run_reboot && fail 'failsafe returned success after a returned controller' ;;
  failed) MAIN_OS_RC=1 run_reboot && fail 'failsafe returned success after a failed controller' ;;
  hung) MAIN_OS_HANG=1 run_reboot && fail 'failsafe returned success after a hung controller' ;;
  unavailable) rm -f "$fix/main-os"; run_reboot && fail 'failsafe returned success without main-os' ;;
  systemd-refused) touch "$fix/fail-systemd-reboot"; run_reboot && fail 'failsafe returned success after systemd refused reboot' ;;
  esac
  if [[ $outcome == unavailable ]]; then
    ! grep -q '^main-os ' "$fix/calls" || fail 'failsafe called unavailable main-os'
  else
    grep -Fxq 'main-os reboot-normal --reason cellular-op-failed' "$fix/calls" || fail "failsafe did not call main-os for $outcome"
  fi
  grep -Fxq 'systemctl --no-block reboot' "$fix/calls" || fail "failsafe omitted systemd reboot for $outcome"
  grep -Fxq 'reboot -f' "$fix/calls" || fail "failsafe omitted forced plain reboot for $outcome"
  grep -Eq 'recover|latch|bootloader' "$fix/calls" && fail "failsafe selected recovery for $outcome"
done
reset; patch_reboot; : >"$fix/calls"; MOCK_UID=4242 run_reboot && fail 'reboot failsafe accepted a non-root caller'
[[ ! -s $fix/calls ]] || fail 'non-root reboot failsafe acted'
reset; patch_reboot; echo "$other" >"$fix/run/boot-id"; : >"$fix/calls"
run_reboot && fail 'reboot failsafe accepted another boot'; [[ ! -s $fix/calls ]] || fail 'foreign-boot reboot failsafe acted'
pass 'normal reboot failsafe: root/current-main only; controller/systemd failure, return, absence and hang reach forced plain fallback'

# ---- begin: committed boot only, timer armed after the state, before any mutation
reset
opq begin attended || { cat "$work/out"; fail 'begin on a committed main boot'; }
grep -Fq 'result=armed kind=attended remaining_seconds=1200' "$work/out" || fail 'begin output'
[[ $(st) == armed ]] || fail 'begin state'
[[ -f $fix/active-myron-cellular-op.timer ]] || fail 'begin did not start the timer'
[[ $(stat -c %a "$fix/op/state") == 600 ]] || fail 'state file mode'
grep -Fq 'kind=attended' "$fix/op/state" || fail 'state kind'
[[ $(pubv state) == starting && $(pubv evidence) == absent && $(pubv boot_id) == "$bootid" ]] || fail 'begin public state'
[[ $(stat -c %a "$fix/public/state") == 644 ]] || fail 'public state mode'
out=$(op remaining); [[ $out == 1200 ]] || fail "remaining right after begin: $out"
echo '1100.00 0.00' >"$fix/uptime"; out=$(op remaining); [[ $out == 1100 ]] || fail "remaining after 100 s: $out"
# the state is written BEFORE the timer starts (ordering)
reset; printf 'grep -Fq "state=armed" "%s/op/state" || exit 9\n' "$fix" >"$fix/hook-start-myron-cellular-op.timer"
opq begin attended || fail 'begin: the state was not armed before the timer started'
# a refused begin leaves no timer and no reboot
for case in 'latch=present:latch' 'pending=current:pending' 'success=other:success' 'os=pmos:os=omarchy' 'image=absent:image'; do
  reset
  sed -i "s/${case%%=*}=[a-z]*/${case%%:*}/" "$fix/main-status"
  opq begin attended && fail "begin accepted ${case#*:}"
  [[ ! -e $fix/op/state && ! -e $fix/active-myron-cellular-op.timer ]] || fail "refused begin left state or timer (${case#*:})"
done
reset; echo "$other" >"$fix/run/boot-id"; opq begin attended && fail 'begin accepted a runtime boot id from another boot'
reset; rm -f "$fix/run/boot-id"; opq begin attended && fail 'begin accepted a non-main runtime'
reset; MOCK_UID=4242 opq begin attended && fail 'begin as non-root'
reset; opq begin bogus && fail 'begin accepted an unknown kind'
reset; opq begin attended; opq begin attended && fail 'a second begin was accepted'
reset; touch "$fix/active-myron-cellular-op.timer"; opq begin attended && fail 'begin with an active timer'
[[ ! -e $fix/op/state ]] || fail 'begin with an active timer wrote state'
# timer failures cancel the operation, no reboot
reset; touch "$fix/fail-start-myron-cellular-op.timer"; opq begin attended && fail 'begin without a timer'
[[ $(st) == refused && $(reboots) == 0 ]] || fail 'a failed timer start must refuse without a reboot'
