#!/bin/bash
# SPDX-License-Identifier: MIT
# Execute the bounded Bluetooth-only thermal cooldown control flow.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

wrapper=device/myron/kernel-experiments/bluetooth-no-open-reset/bluetooth-only-start.sh
# shellcheck disable=SC1090
source <(sed '/^\[ "$(id -u)" = 0 \]/,$d' "$wrapper")

tmp=$(mktemp -d /tmp/myron-bluetooth-cooldown.XXXXXX)
trap 'rm -rf -- "$tmp"' EXIT
fake_uptime=$tmp/uptime
fail_test() { printf 'not ok - %s\n' "$1" >&2; exit 1; }

awk() {
	if [[ ${2:-} == /proc/uptime ]]; then
		command awk "$1" "$fake_uptime"
	else
		command awk "$@"
	fi
}

sleep() {
	current=$(cut -d' ' -f1 "$fake_uptime")
	printf '%s 0\n' "$((current + $1))" >"$fake_uptime"
}

reset_clock() { printf '%s 0\n' 100 >"$fake_uptime"; }

reset_clock
hottest_temperature() { printf '%s\n' '74000 mock-sensor 8'; }
cool_log=$tmp/cool.log
wait_for_cooldown >"$cool_log"
grep -Fq 'stable_samples=4/4' "$cool_log" ||
	fail_test 'four stable samples were not required'
grep -Fq 'result=ready target_mc=75000 stable_seconds=15' "$cool_log" ||
	fail_test '15-second cooldown was not reported'
[[ $(<"$fake_uptime") == '115 0' ]] ||
	fail_test 'cooldown did not span 15 monotonic seconds'

reset_clock
hottest_temperature() { printf '%s\n' '80000 mock-sensor 8'; }
cooldown_timeout_seconds=10
if (wait_for_cooldown) >"$tmp/hot.log" 2>&1; then
	fail_test 'sustained heat passed cooldown'
fi
grep -Fq 'Bluetooth cooldown did not reach 75000 mC for 15 seconds' "$tmp/hot.log" ||
	fail_test 'sustained heat did not fail closed'

reset_clock
hottest_temperature() { return 1; }
if (wait_for_cooldown) >"$tmp/missing.log" 2>&1; then
	fail_test 'missing thermal data passed cooldown'
fi
grep -Fq 'reason=temperature-unavailable' "$tmp/missing.log" ||
	fail_test 'missing thermal data was not recorded'

printf '%s\n' 'ok - Bluetooth cooldown is bounded, stable and fails closed without sensors'
