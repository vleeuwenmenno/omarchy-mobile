#!/bin/bash
# SPDX-License-Identifier: MIT
# Validate the private inquiry-stop build and exercise fail-closed composer gates.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

dist=${1:-out/private/gki-bluetooth-inquiry-stop-v5-stamped}
base=${2:-out/private/myron-omarchy-hardware-test-20261026-v14b.img}
firmware=${3:-out/private/myron-bluetooth-b}
composer=device/myron/kernel-experiments/bluetooth-no-open-reset/compose-payload.sh
if [[ ! -d $dist || ! -f $base || ! -d $firmware ]]; then
  if (($#)); then
    printf 'not ok - explicit private artifact input is missing\n' >&2
    exit 1
  fi
  printf 'ok - private Bluetooth artifacts unavailable; rejection probe skipped\n'
  exit 0
fi

fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
tmp=$(mktemp -d /tmp/myron-bluetooth-artifacts.XXXXXX)
trap 'rm -rf -- "$tmp"' EXIT

declare -A expected=(
  [Image]=672808b1277b583fdc398986bfe8d100b2ebbf1c2cfbb9d14dd257366d1a5937
  [kernel.notes]=1e4a036d6f8bcc2602567ec5e0ff7aaa871564af18c9c7c8dee426b110834eea
  [kernel_aarch64_dot_config]=33b6eaf87b7ca2d0d06dd10dbe2a4ce3d58e50ad804d6b385cd5f953e2fe3b95
  [vmlinux.symvers]=aaf3fa84f4ccbab54327eee5a7fed7903e3f79af9ab53fdffe5165b27f2fa9f1
  [kernel_aarch64_Module.symvers]=d5507f9cfb0ba26541dd7c76e077601da89e0ab650ec69acaf854b62ee247f37
  [bluetooth.ko]=c69bd2a120843f33983bcd53e93f12eecfe53c8d6c65e1952111f352bf0d6ca2
  [btbcm.ko]=9042c46a7b350ee70bcb49cfb12c9111f6a47dfcf3f9ca176533875b8483970c
  [btqca.ko]=395a40611e6510910d8a069b32eef631cf7cf56a1f2ff526a03c8e0772b166ef
  [hci_uart.ko]=8a032d5ebb174ff81c0aa01d6ecc34fd9718723ffa432c0ae56416918a6772a9
  [pwrseq-core.ko]=93ee7bc34a78303d569944d177832e3519ba7fb8f283a32fa6baea7f97c11104
  [rfkill.ko]=7e3caceca204611bf88495b5554e7ff9de693d2551fcb25cfb83356cbe134f34
  [rmnet.ko]=3b3f75d3738e77a3afd572a83f8cdce8aab9022409b3c9b2830860304a2990a0
)
for name in "${!expected[@]}"; do
  [[ -f $dist/$name && ! -L $dist/$name ]] || fail "missing regular artifact: $name"
  actual=$(sha256sum "$dist/$name" | awk '{print $1}')
  [[ $actual == "${expected[$name]}" ]] || fail "artifact hash differs: $name"
done
[[ ! -s $dist/abi_stgdiff/abi.report.plain ]] || fail 'protected ABI report is not empty'

expected_release=6.12.23-android16-5-g5a0e85dd9db0-dirty-4k
for name in hci_uart bluetooth; do
  release=$(modinfo -F vermagic "$dist/$name.ko" | awk '{print $1}')
  [[ $release == "$expected_release" ]] || fail "module release differs: $name"
done

real_sha256sum=$(command -v sha256sum)
mkdir -p "$tmp/hash-bin"
printf '%s\n' '#!/bin/sh' \
  'case "$1" in */Image) printf "%064d  %s\\n" 0 "$1" ;;' \
  '*) exec "$MYRON_REAL_SHA256SUM" "$@" ;; esac' \
  >"$tmp/hash-bin/sha256sum"
chmod 0755 "$tmp/hash-bin/sha256sum"
if MYRON_REAL_SHA256SUM=$real_sha256sum PATH="$tmp/hash-bin:$PATH" \
  "$composer" --base-image "$base" --dist "$dist" --firmware-dir "$firmware" \
  --out "$tmp/hash-accepted.img" >"$tmp/hash.log" 2>&1; then
  fail 'composer accepted a wrong candidate hash'
fi
grep -Fq 'candidate artifact hash differs: Image' "$tmp/hash.log" ||
  fail 'wrong-hash rejection did not reach the expected gate'
[[ ! -e $tmp/hash-accepted.img ]] || fail 'wrong-hash rejection created an output image'

real_modinfo=$(command -v modinfo)
mkdir -p "$tmp/vermagic-bin"
printf '%s\n' '#!/bin/sh' \
  'if [ "$1" = -F ] && [ "$2" = vermagic ] && [ "${3##*/}" = "$MYRON_BAD_MODULE.ko" ]; then' \
  '  printf "%s\\n" "wrong-release SMP preempt mod_unload modversions aarch64"' \
  '  exit 0' \
  'fi' \
  'exec "$MYRON_REAL_MODINFO" "$@"' \
  >"$tmp/vermagic-bin/modinfo"
chmod 0755 "$tmp/vermagic-bin/modinfo"
for name in hci_uart bluetooth; do
  output=$tmp/$name-accepted.img
  if MYRON_BAD_MODULE=$name MYRON_REAL_MODINFO=$real_modinfo \
    PATH="$tmp/vermagic-bin:$PATH" \
    "$composer" --base-image "$base" --dist "$dist" --firmware-dir "$firmware" \
    --out "$output" >"$tmp/$name.log" 2>&1; then
    fail "composer accepted wrong vermagic for $name"
  fi
  grep -Fq "candidate module release differs: $name" "$tmp/$name.log" ||
    fail "wrong-vermagic rejection did not identify $name"
  [[ ! -e $output ]] || fail "wrong-vermagic rejection created output for $name"
done

printf 'ok - exact v5 hashes, ABI and releases; wrong hash and both wrong vermagics rejected\n'
