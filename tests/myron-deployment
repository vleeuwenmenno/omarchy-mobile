def kit_case(name, reason, mutate, rootfs_mutate=None):
    clone = fresh("kitcase")
    kit = clone / "kit"
    shutil.copytree(kit_a, kit, symlinks=True)
    mutate(kit)
    tree, mani = rootfs, manifest
    if rootfs_mutate:
        tree, mani = make_rootfs(fx)
        rootfs_mutate(tree, mani)
    for command in ("verify", "gate"):
        code, out, err = run(root, command, "--kit", kit, "--rootfs-stage", tree, "--rootfs-manifest", mani)
        assert code != 0, f"{name}: {command} accepted"
        assert reason in err, f"{name}: {command} wrong reason: {err.strip()}"
        assert "artifact_verified" not in out, f"{name}: {command} reported a verified artifact"
    ok(f"{name} is rejected by verify and gate")


def edit_json(relative, function):
    def mutate(kit):
        target = kit / relative
        document = json.loads(target.read_text())
        function(document)
        target.write_bytes(T.render_json(document))
    return mutate


