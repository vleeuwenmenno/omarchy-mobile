def rt_check(command, kit, runtime_root, runtime_manifest=RT_MANIFEST):
    argv = [command, "--kit", kit, "--rootfs-stage", rootfs, "--rootfs-manifest", manifest,
            "--runtime-assets", runtime_root]
    if runtime_manifest is not None:
        argv += ["--runtime-manifest", runtime_manifest]
    return argv


def rt_fail(name, argv, contains, *outputs, contracts=None):
    code, out, err = run(contracts or root, *argv)
    assert code != 0, f"{name}: accepted"
    assert contains in err, f"{name}: wrong reason: {err.strip()}"
    assert "artifact_verified" not in out and '"status": "assembled"' not in out, name
    for path in outputs:
        assert not os.path.lexists(path), f"{name}: left output {path}"
    if outputs:
        assert not any(".tmp-" in p.name for p in Path(outputs[0]).parent.iterdir()), f"{name}: left temp"
    ok(f"{name} is rejected")


