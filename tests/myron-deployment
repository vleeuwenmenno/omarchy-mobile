#!/bin/bash
# SPDX-License-Identifier: MIT
# Offline tests for tools/myron-deployment, the laptop-only, non-flashable
# Myron deployment-candidate kit. Synthetic bytes only: nothing here is a
# kernel, module, firmware, boot image, or private runtime asset. No root,
# device, Docker, or network access.
set -euo pipefail
export LC_ALL=C
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }
tmp=$(mktemp -d)
trap 'chmod -R u+rwx "$tmp" 2>/dev/null || true; rm -rf "$tmp"' EXIT
export PYTHONPYCACHEPREFIX="$tmp/pycache"
tmp=$(realpath "$tmp")

python3 -m py_compile tools/myron-deployment || fail "tool parses"
grep -Eq '^(import|from) (subprocess|shutil)|os\.(system|popen|exec|spawn|fork)|posix_spawn' tools/myron-deployment \
  && fail "tool references process-spawning or broad-copy facilities"
pass "tool parses and spawns nothing"

# Repository contract: strictly derived and bound; the real show works.
mkdir -p "$tmp/fakes"
: > "$tmp/calls"
for command in ssh scp adb fastboot docker mount tar pacman depmod modprobe systemctl cp; do
  printf '#!/bin/sh\nprintf "%%s\\n" "%s $*" >> "$CALLS"\nexit 97\n' "$command" > "$tmp/fakes/$command"
  chmod +x "$tmp/fakes/$command"
done
CALLS="$tmp/calls" PATH="$tmp/fakes:$PATH" tools/myron-deployment show > "$tmp/show.json" \
  || fail "show of the repository deployment contract failed"
python3 - "$tmp/show.json" <<'PY' || exit 1
import json, sys
c = json.load(open(sys.argv[1]))
assert c["deployment_authorized"] is False and c["bootable"] is False
assert c["flashable"] is False and c["image_ready"] is False
assert c["runtime"]["required_features"] == ["gpu", "wifi", "touch"]
assert c["runtime"]["bytes"] == "external-private"
assert c["modules"]["order"]["status"] == "unverified"
assert c["modules"]["order"]["modules"] == [
    "pwrseq-core", "bluetooth", "btbcm", "btqca", "hci_uart", "rfkill", "rmnet",
]
assert c["modules"]["file_count"] == 8 and len(c["blockers"]) == 7
PY
: > "$tmp/not-the-archive"
if CALLS="$tmp/calls" PATH="$tmp/fakes:$PATH" \
    tools/myron-deployment stage-modules --assets "$tmp/not-the-archive" --out "$tmp/never" >/dev/null 2>&1; then
  fail "stage-modules accepted an archive that is not the qualified one"
fi
[[ ! -e $tmp/never ]] || fail "refused stage-modules left output"
[[ ! -s $tmp/calls ]] || fail "tool invoked an external system tool"
pass "repository contract is canonical, show is read-only, a wrong archive writes nothing"

python3 - "$PWD" "$tmp" <<'PY' || exit 1
import contextlib
import errno
import gzip
import hashlib
import importlib.machinery
import importlib.util
import io
import json
import os
from pathlib import Path
import shutil
import stat
import subprocess
import sys
import tarfile
from types import SimpleNamespace

repo = Path(sys.argv[1])
work = Path(sys.argv[2])
sys.dont_write_bytecode = True
loader = importlib.machinery.SourceFileLoader("deploy_tool", str(repo / "tools/myron-deployment"))
spec = importlib.util.spec_from_loader(loader.name, loader)
T = importlib.util.module_from_spec(spec)
loader.exec_module(T)
K = T.kernel()

counter = [0]


def ok(name):
    print(f"ok - {name}")


def digest(data):
    return hashlib.sha256(data).hexdigest()


def fresh(label):
    counter[0] += 1
    path = work / f"{label}-{counter[0]}"
    path.mkdir()
    return path


# ---- synthetic qualified inputs ------------------------------------------------

RELEASE = "test-release"
MODULES = ["alpha", "beta"]
RUNTIME_MARKER = b"SECRET-RUNTIME-ASSET-BYTES"


def make_fixture(variant=None):
    base = fresh("fixture")
    notes = b"synthetic-notes\n"
    image, config = b"synthetic-image\n", b"synthetic-config\n"
    directory = f"/usr/local/lib/myron-gki-module-sets/{digest(notes)}"
    payload = {
        "candidate-module-dir.sh": b"#!/bin/sh\nexit 0\n",
        "previous-module-dir.sh": b"#!/bin/sh\nexit 1\n",
        "kernel-notes.bin": notes,
        **{
            f"modules/{name}.ko": (
                f"module-{name}\0vermagic={'other' if variant == 'vermagic' else RELEASE} SMP\0"
            ).encode()
            for name in MODULES
        },
    }
    manifest = {
        "phase": "inactive-staging-payload-only",
        "candidate_image_sha256": digest(image),
        "candidate_config_sha256": digest(config),
        "candidate_notes_sha256": digest(notes),
        "module_directory": directory,
        "selector_destination": "/usr/local/sbin/myron-attempt79-module-dir",
        "files": {name: digest(data) for name, data in sorted(payload.items())},
    }
    payload["manifest.json"] = (json.dumps(manifest, sort_keys=True) + "\n").encode()
    payload["SHA256SUMS"] = "".join(
        f"{digest(data)}  {name}\n" for name, data in sorted(payload.items())
    ).encode()
    archive = base / "assets.tar.gz"
    with archive.open("wb") as output:
        with gzip.GzipFile(filename="", mode="wb", fileobj=output, mtime=0) as zipped:
            with tarfile.open(fileobj=zipped, mode="w") as tar:
                for name, data in sorted(payload.items()):
                    info = tarfile.TarInfo("fixture/" + name)
                    info.size = len(data)
                    info.mode = 0o644
                    tar.addfile(info, io.BytesIO(data))
                if variant == "extra-member":
                    info = tarfile.TarInfo("fixture/extra.txt")
                    info.size = 1
                    tar.addfile(info, io.BytesIO(b"x"))
                if variant == "link-member":
                    info = tarfile.TarInfo("fixture/modules/alpha.ko")
                    info.type = tarfile.SYMTYPE
                    info.linkname = "/etc/passwd"
                    tar.addfile(info)
    reference = {
        "schema": 1,
        "device": {
            "codename": "myron", "compatible": "qcom,canoe-mtp", "soc": "sm8850",
            "model_contains": "Myron", "boot_method": "external-android",
        },
        "kernel": {
            "release": RELEASE, "gki_source_revision": "0" * 40,
            "image_sha256": digest(image), "notes_sha256": digest(notes),
            "config_sha256": digest(config),
            "vmlinux_symvers_sha256": "5" * 64, "module_symvers_sha256": "6" * 64,
        },
        "source": {"lock_sha256": "2" * 64, "manifest_sha256": "3" * 64, "patches": {"0001-test.patch": "4" * 64}},
        "module_assets": {
            "archive_sha256": digest(archive.read_bytes()), "root": "fixture",
            "module_directory": directory,
            "candidate_selector_sha256": digest(payload["candidate-module-dir.sh"]),
            "previous_selector_sha256": digest(payload["previous-module-dir.sh"]),
            "forbidden_modules": ["rmnet_core"], "modules": MODULES,
        },
        "runtime_assets": {"manifest_sha256": digest(RUNTIME_MARKER)},
        "activation": {
            "mode": "disabled", "source_lock_reproduction": "not_verified",
            "device_qualification": "reference_evidence_only",
        },
        "payload": {"kind": "metadata-only"},
        "provenance": {
            "reference_repository_base_commit": "1" * 40, "reference_worktree_state": "synthetic",
            "qualification": "test", "status": "metadata-only",
        },
    }
    reference_bytes = (json.dumps(reference, indent=2, sort_keys=True) + "\n").encode()
    stage = K.expected_stage_contract(reference, digest(reference_bytes))
    stage_bytes = (json.dumps(stage, indent=2, sort_keys=True) + "\n").encode()
    gpu_bytes = (repo / T.GPU_REFERENCE_PATH).read_bytes()
    root = base / "contracts-root"
    for relative, data in (
        (T.KERNEL_REFERENCE_PATH, reference_bytes),
        (T.STAGE_CONTRACT_PATH, stage_bytes),
        (T.GPU_REFERENCE_PATH, gpu_bytes),
    ):
        (root / relative).parent.mkdir(parents=True, exist_ok=True)
        (root / relative).write_bytes(data)
    deployment = T.expected_deployment_contract(reference, digest(reference_bytes), digest(stage_bytes), digest(gpu_bytes))
    (root / T.DEPLOYMENT_CONTRACT_PATH).write_bytes(T.render_json(deployment))
    return {
        "base": base, "root": root, "archive": archive, "reference": reference,
        "reference_bytes": reference_bytes, "stage_bytes": stage_bytes, "gpu_bytes": gpu_bytes,
    }


def make_rootfs(fx):
    base = fresh("rootfs")
    tree = base / "omamobile-rootfs-stage-synthetic-aarch64"
    (tree / "etc/systemd/system").mkdir(parents=True)
    for script in (
        "packages/omamobile-device-myron/install",
        "packages/omamobile-myron-kernel-contract/install",
        "packages/omamobile-myron-gpu-profile/install",
        "packages/omamobile-myron-gpu-profile/test/stage-mesa-fixture",
    ):
        subprocess.run([str(repo / script), str(tree)], check=True, stdout=subprocess.DEVNULL)
    share = tree / "usr/share/omamobile/myron-kernel-contract"
    (share / "reference.json").write_bytes(fx["reference_bytes"])
    (share / "stage-contract.json").write_bytes(fx["stage_bytes"])
    (tree / "usr/lib/firmware").mkdir(parents=True)
    (tree / "usr/lib/firmware/regulatory.db").write_bytes(b"")
    (tree / "usr/lib/firmware/regulatory.db.p7s").write_bytes(b"")
    manifest = Path(str(tree) + ".MANIFEST")
    manifest.write_text(
        "# Omarchy Mobile root STAGE (not bootable, not an image)\n"
        "version: synthetic\n"
        "rootfs integration: external-contract\n"
        "rootfs package profile: myron\n"
        "package closure: required present; forbidden absent\n"
        "kernel modules: none (external contract, no module payload)\n"
        "boot payload: none; proprietary payload: none\n"
    )
    return tree, manifest


def run_exact(root, *argv):
    out, err = io.StringIO(), io.StringIO()
    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
        try:
            code = T.main([str(item) for item in argv], contracts_root=root)
        except SystemExit as error:
            code = error.code
    return code, out.getvalue(), err.getvalue()


def run(root, *argv):
    arguments = list(argv)
    if arguments and arguments[0] in ("assemble", "verify", "gate") and "--assets" not in arguments:
        arguments.extend(("--assets", archive))
    return run_exact(root, *arguments)


def expect_ok(root, *argv):
    code, out, err = run(root, *argv)
    assert code == 0, f"{argv[0]} failed: {err}"
    return json.loads(out)


def expect_fail(name, root, argv, contains, *outputs):
    code, out, err = run(root, *argv)
    assert code != 0, f"{name}: accepted"
    assert contains in err, f"{name}: wrong reason: {err.strip()}"
    for path in outputs:
        assert not os.path.lexists(path), f"{name}: left output {path}"
    siblings = [p.name for p in Path(outputs[0]).parent.iterdir()] if outputs else []
    assert not any(".tmp-" in s and "someoneelse" not in s for s in siblings), f"{name}: left temp {siblings}"
    ok(f"{name} is rejected")


def snapshot(path):
    fd = T.open_canonical_dir(str(path), "snapshot")
    try:
        tree = T.walk_tree(fd, T.ROOTFS_LIMITS, allow_symlinks=True, keep_data=True)
    finally:
        os.close(fd)
    return tree.entries, tree.data


fx = make_fixture()
root, archive = fx["root"], fx["archive"]
rootfs, manifest = make_rootfs(fx)
archive_before = digest(archive.read_bytes())

# ---- happy path, determinism, no input mutation --------------------------------
stage_a, stage_b = work / "stage-a", work / "stage-b"
result = expect_ok(root, "stage-modules", "--assets", archive, "--out", stage_a)
assert result["status"] == "staged" and result["file_count"] == 3 and result["deployment_authorized"] is False
expect_ok(root, "stage-modules", "--assets", archive, "--out", stage_b)
assert snapshot(stage_a) == snapshot(stage_b)
entries, _ = snapshot(stage_a)
files = sorted(e.path for e in entries if e.kind == "file")
assert files == sorted([
    f"usr/local/lib/myron-gki-module-sets/{fx['reference']['kernel']['notes_sha256']}/{name}.ko"
    for name in MODULES
] + ["usr/local/sbin/myron-attempt79-module-dir"]), files
modes = {e.path: e.mode for e in entries}
assert modes["usr/local/sbin/myron-attempt79-module-dir"] == 0o755
assert all(e.mode == 0o755 for e in entries if e.kind == "dir")
assert all(e.mode == 0o644 for e in entries if e.kind == "file" and e.path.endswith(".ko"))
assert not any("notes" in e.path.rsplit("/", 1)[-1] or "previous" in e.path or e.path.endswith(".json") for e in entries if e.kind == "file")
ok("stage-modules writes exactly the selector and the modules, deterministically")

rootfs_before, rootfs_data = snapshot(rootfs)
stage_before = snapshot(stage_a)
manifest_before = manifest.read_bytes()
kit_a, kit_b = work / "kit-a", work / "kit-b"
result = expect_ok(root, "assemble", "--rootfs-stage", rootfs, "--rootfs-manifest", manifest,
                   "--module-stage", stage_a, "--out", kit_a)
assert result["status"] == "assembled" and result["deployment_authorized"] is False and result["archive_proven"] is True
expect_ok(root, "assemble", "--rootfs-stage", rootfs, "--rootfs-manifest", manifest,
          "--module-stage", stage_b, "--assets", archive, "--out", kit_b)
assert snapshot(kit_a) == snapshot(kit_b), "kits are not deterministic"
assert (rootfs_before, rootfs_data) == snapshot(rootfs), "assemble mutated the rootfs"
assert stage_before == snapshot(stage_a) and manifest.read_bytes() == manifest_before
assert digest(archive.read_bytes()) == archive_before
ok("assemble is deterministic and leaves every input untouched")

verified = expect_ok(root, "verify", "--kit", kit_a, "--rootfs-stage", rootfs)
assert verified["status"] == "verified" and verified["deployment_authorized"] is False
expect_ok(root, "verify", "--kit", kit_a, "--rootfs-stage", rootfs, "--assets", archive)
gate = expect_ok(root, "gate", "--kit", kit_a, "--rootfs-stage", rootfs)
assert gate["artifact_verified"] is True and gate["deployment_authorized"] is False
assert gate["bootable"] is False and gate["flashable"] is False and gate["image_ready"] is False
assert gate["blockers"] == T.BLOCKERS and gate["decision"] == "refused"
code, _, err = run(root, "gate", "--kit", kit_a, "--rootfs-stage", rootfs)
assert "refused" in err
ok("verify recomputes every binding; gate verifies but always refuses authorization")

# ---- kit holds public contracts and overlay only ---------------------------------
kit_entries, kit_data = snapshot(kit_a)
top = {e.path for e in kit_entries if "/" not in e.path and e.path != "."}
assert top == {"contracts", "overlay", "kit.json", "status.json", "STATUS.txt", "SHA256SUMS"}, top
ko = [e.path for e in kit_entries if e.path.endswith(".ko")]
assert len(ko) == len(MODULES) and all(p.startswith("overlay/usr/local/lib/myron-gki-module-sets/") for p in ko)
for forbidden in ("boot", "etc", "vendor", "systemd", "firmware", "modprobe.d", "vulkan", "libalpm"):
    assert not any(forbidden in e.path.split("/") for e in kit_entries), forbidden
blob = b"".join(kit_data.values())
assert RUNTIME_MARKER not in blob and b"ExecStart" not in blob and b"vmlinuz" not in blob
assert b"/usr/share/omamobile/myron-gpu/reference.json" not in b"".join(
    d for p, d in kit_data.items() if p.startswith("overlay/")
)
assert not any(p.startswith("overlay/usr/share") or p.startswith("overlay/usr/lib") for p in kit_data)
status = json.loads(kit_data["status.json"])
assert status["deployment_authorized"] is False and status["blockers"] == T.BLOCKERS
kit_document = json.loads(kit_data["kit.json"])
assert kit_document["rootfs"]["copied_into_kit"] is False
assert kit_document["runtime"]["bytes"] == "external-private"
assert b"NOT bootable" in kit_data["STATUS.txt"]
sums = kit_data["SHA256SUMS"].decode().splitlines()
assert len(sums) == len([e for e in kit_entries if e.kind == "file"]) - 1
ok("kit carries only public contracts, the module overlay and status files; no rootfs, runtime bytes or activation")

# ---- no external commands, in-process too -----------------------------------------
def boom(*args, **kwargs):
    raise AssertionError("external command attempted")


saved = (subprocess.Popen, os.system, os.fork, os.posix_spawn, os.execv, os.execvp)
subprocess.Popen, os.system, os.fork, os.posix_spawn, os.execv, os.execvp = (boom,) * 6
try:
    probe = work / "probe-kit"
    expect_ok(root, "assemble", "--rootfs-stage", rootfs, "--rootfs-manifest", manifest,
              "--module-stage", stage_a, "--out", probe)
    expect_ok(root, "gate", "--kit", probe, "--rootfs-stage", rootfs)
finally:
    subprocess.Popen, os.system, os.fork, os.posix_spawn, os.execv, os.execvp = saved
ok("no process is spawned by any command")

# ---- wrong component hashes, strict contract ---------------------------------------
def contract_variant(mutate):
    clone = fresh("variant")
    shutil.copytree(root, clone / "root")
    mutate(clone / "root")
    return clone / "root"


def edit_deployment(function):
    def mutate(path):
        target = path / T.DEPLOYMENT_CONTRACT_PATH
        document = json.loads(target.read_text())
        function(document)
        target.write_bytes(T.render_json(document))
    return mutate


def deploy_text(function):
    def mutate(path):
        target = path / T.DEPLOYMENT_CONTRACT_PATH
        target.write_text(function(target.read_text()))
    return mutate


for name, mutate, reason in (
    ("a wrong kernel-reference hash", edit_deployment(lambda d: d["components"]["kernel_reference"].update(sha256="0" * 64)), "differs at components"),
    ("a wrong stage-contract hash", edit_deployment(lambda d: d["components"]["stage_contract"].update(sha256="0" * 64)), "differs at components"),
    ("a wrong GPU-profile hash", edit_deployment(lambda d: d["components"]["gpu_profile_reference"].update(sha256="0" * 64)), "differs at components"),
    ("a changed GPU reference", lambda p: (p / T.GPU_REFERENCE_PATH).write_bytes(b'{"schema": 1}\n'), "profile reference"),
    ("a changed stage contract", lambda p: (p / T.STAGE_CONTRACT_PATH).write_bytes(fx["stage_bytes"].replace(b"0755", b"0777", 1)), "stage contract"),
    ("a wrong runtime manifest hash", edit_deployment(lambda d: d["runtime"].update(manifest_sha256="0" * 64)), "differs at runtime"),
    ("missing runtime features", edit_deployment(lambda d: d["runtime"].update(required_features=["gpu", "wifi"])), "differs at runtime"),
    ("reordered runtime features", edit_deployment(lambda d: d["runtime"].update(required_features=["wifi", "gpu", "touch"])), "differs at runtime"),
    ("a runtime bytes claim of public", edit_deployment(lambda d: d["runtime"].update(bytes="public")), "differs at runtime"),
    ("an authorization claim", edit_deployment(lambda d: d.update(deployment_authorized=True)), "differs at deployment_authorized"),
    ("a bootable claim", edit_deployment(lambda d: d.update(bootable=True)), "differs at bootable"),
    ("an omitted blocker", edit_deployment(lambda d: d["blockers"].pop()), "differs at blockers"),
    ("a reordered blocker list", edit_deployment(lambda d: d["blockers"].reverse()), "differs at blockers"),
    ("an unknown field", edit_deployment(lambda d: d.update(extra=1)), "top-level fields differ"),
    ("a verified module order", edit_deployment(lambda d: d["modules"]["order"].update(status="verified")), "differs at modules"),
    ("a boolean standing for an integer", deploy_text(lambda t: t.replace('"schema": 1', '"schema": true', 1)), "differs at schema"),
    ("a float standing for an integer", deploy_text(lambda t: t.replace('"file_count": 3', '"file_count": 3.0')), "differs at modules"),
    ("a duplicate key", deploy_text(lambda t: t.replace('"bootable": false,', '"bootable": false, "bootable": false,', 1)), "duplicate JSON key"),
    ("a non-finite number", deploy_text(lambda t: t.replace('"file_count": 3', '"file_count": NaN')), "non-finite"),
    ("a non-canonical rendering", deploy_text(lambda t: t.replace("\n", "\n ", 1)), "canonical form"),
):
    root_variant = contract_variant(mutate)
    code, out, err = run(root_variant, "show")
    assert code != 0 and not out, f"{name}: accepted"
    assert reason in err, f"{name}: wrong reason: {err.strip()}"
    ok(f"{name} is rejected by the deployment contract")

# ---- archive deviations come from the kernel verifier ------------------------------
for variant, reason in (("extra-member", "member set differs"), ("link-member", "member set differs"), ("vermagic", "exact kernel release")):
    other = make_fixture(variant)
    out = work / f"never-{variant}"
    expect_fail(f"an archive with {variant}", other["root"],
                ["stage-modules", "--assets", other["archive"], "--out", out], "", out)
tampered = work / "tampered.tar.gz"
tampered.write_bytes(archive.read_bytes() + b"x")
expect_fail("an archive with a wrong hash", root, ["stage-modules", "--assets", tampered, "--out", work / "never-t"], "SHA-256 differs", work / "never-t")
fifo = work / "assets.fifo"
os.mkfifo(fifo)
expect_fail("a FIFO archive", root, ["stage-modules", "--assets", fifo, "--out", work / "never-f"], "not a regular file", work / "never-f")
link = work / "assets-link.tar.gz"
link.symlink_to(archive)
expect_fail("a symlinked archive", root, ["stage-modules", "--assets", link, "--out", work / "never-l"], "not a regular file", work / "never-l")

# A special inode is rejected from O_PATH metadata before any data-open.
probe = fresh("special-open")
(probe / "entry").write_bytes(b"regular fixture")
probe_fd = os.open(probe, os.O_RDONLY | os.O_DIRECTORY)
real_open, real_fstat = T.os.open, T.os.fstat
pinned_fd, data_opened = [-1], [False]
def guarded_open(path, flags, *args, **kwargs):
    if isinstance(path, str) and path == "entry" and flags & os.O_PATH:
        descriptor = real_open(path, flags, *args, **kwargs)
        pinned_fd[0] = descriptor
        return descriptor
    if isinstance(path, str) and path == f"/proc/self/fd/{pinned_fd[0]}":
        data_opened[0] = True
    return real_open(path, flags, *args, **kwargs)
def special_fstat(descriptor):
    if descriptor == pinned_fd[0]:
        return SimpleNamespace(st_mode=stat.S_IFCHR | 0o600)
    return real_fstat(descriptor)
T.os.open, T.os.fstat = guarded_open, special_fstat
try:
    try:
        T.open_pinned_regular_at(probe_fd, "entry", "special probe")
    except T.DeploymentError as error:
        assert "not a regular file" in str(error)
    else:
        raise AssertionError("special inode accepted")
finally:
    T.os.open, T.os.fstat = real_open, real_fstat
    os.close(probe_fd)
assert not data_opened[0], "special inode received a data-open"
assert K.read_limited_regular is T.kernel().read_limited_regular
ok("special inputs are type-checked before data-open; archive verification has no shared override")

# Entry bounds stop enumeration before the full directory is accumulated.
bounded = fresh("bounded-enumeration")
bounded_fd = os.open(bounded, os.O_RDONLY | os.O_DIRECTORY)
real_scandir = T.os.scandir
produced = [0]
class ManyEntries:
    def __enter__(self): return self
    def __exit__(self, *args): return False
    def __iter__(self): return self
    def __next__(self):
        if produced[0] >= 10_000:
            raise StopIteration
        produced[0] += 1
        return SimpleNamespace(name=f"entry-{produced[0]:05d}")
def many_scandir(descriptor):
    return ManyEntries() if descriptor == bounded_fd else real_scandir(descriptor)
T.os.scandir = many_scandir
try:
    try:
        T.walk_tree(bounded_fd, T.Limits(2, 2, 1024, 1024), allow_symlinks=False)
    except T.DeploymentError as error:
        assert "entry bound" in str(error)
    else:
        raise AssertionError("unbounded directory enumeration accepted")
finally:
    T.os.scandir = real_scandir
    os.close(bounded_fd)
assert produced[0] == 3, produced[0]
ok("entry bound stops directory enumeration before sorting")

# ---- output and input path rules ----------------------------------------------------
parent = fresh("paths")
(parent / "dir").mkdir()
(parent / "file").write_text("x")
(parent / "dangling").symlink_to(parent / "nowhere")
(parent / "realdir").mkdir()
(parent / "viadir").symlink_to(parent / "realdir")
for name, out, reason in (
    ("an existing directory output", parent / "dir", "already exists"),
