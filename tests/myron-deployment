RT_MANIFEST = fx["runtime_manifest"]


def make_runtime(files=None, base=None):
    tree = (base or fresh("runtime")) / "assets"
    for target, (feature, data) in (files or RUNTIME_FILES).items():
        path = tree / target.lstrip("/")
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(data)
        path.chmod(0o640)
    return tree


