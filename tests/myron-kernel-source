def recording_capture(directory, name, size, mount, budget, path):
    data = real_capture(directory, name, size, mount, budget, path)
    captured_buffers.append((path, data))
    return data


def guarded_open(path, *args, **kwargs):
    assert not in_analyzer[0], "analyzer opened a file"
    if str(path).endswith(".patch"):
        opened.append(str(path))
    return real_open(path, *args, **kwargs)


def watching_analyze(patches, profile):
    seen_by_analyzer.extend(patches)
    in_analyzer[0] = True
    try:
        return real_analyze(patches, profile)
    finally:
        in_analyzer[0] = False


guarded = {"read": os.read, "scandir": os.scandir, "lstat": os.lstat, "fstat": os.fstat}


def forbid_io(name):
    def refuse_io(*_a, **_k):
        raise AssertionError(f"analyzer used os.{name}")
    return refuse_io


K.capture_file, os.open, K.analyze_patch_series = recording_capture, guarded_open, watching_analyze


def pure_analyze(patches, profile):
    for name in guarded:
        setattr(os, name, forbid_io(name))
    try:
        return watching_analyze(patches, profile)
    finally:
        for name, function in guarded.items():
            setattr(os, name, function)


