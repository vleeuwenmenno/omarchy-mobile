def prelude_bytes(size):
    base = len(envelope("", message="").encode())
    remaining = size - base
    assert remaining >= 0
    full, extra = divmod(remaining, 100)
    message = ("m" * 99 + "\n") * full + ("" if extra == 0 else "n" * (extra - 1) + "\n")
    text = envelope(GOOD, message=message)
    assert text.index("diff --git") == size, (text.index("diff --git"), size)
    return text


