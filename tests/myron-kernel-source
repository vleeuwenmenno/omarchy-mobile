# ---------------------------------------------------------------- races
def race(stage, action, reason, expected_path=None):
    bundle, bundle_spec = build()
    fired = []

    def hook(name, context):
        if name == stage and (expected_path is None or context["path"] == expected_path) and not fired:
            fired.append(True)
            action(Path(bundle), context)

    K._HOOK = hook
    try:
        expect(reason, K.check_bundle, bundle, bundle_spec)
    finally:
        K._HOOK = None
    assert fired, stage


