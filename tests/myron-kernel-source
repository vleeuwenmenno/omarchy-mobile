#!/bin/bash
# SPDX-License-Identifier: MIT
# Offline tests for the Myron external kernel-source bundle verifier (Phase 2.17).
# Everything is synthetic: no private bundle, no phone, no network, no process.
set -euo pipefail
export LC_ALL=C
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }
tmp=$(mktemp -d)
trap 'chmod -R u+rwx "$tmp" 2>/dev/null || true; rm -rf "$tmp"' EXIT
export PYTHONPYCACHEPREFIX="$tmp/pycache"
tmp=$(realpath "$tmp")

tool=tools/myron-kernel-source
impl=tools/lib/myron-kernel-source-impl.py
python3 -B -m py_compile "$tool" "$impl" 2>/dev/null || python3 -c 'import ast,sys; [ast.parse(open(f).read()) for f in sys.argv[1:]]' "$tool" "$impl" || fail "tool parses"
for f in "$tool" "$impl"; do
  grep -Eq '^(import|from) (subprocess|shutil|socket|urllib|http|ctypes|ssl|requests|zipfile|tarfile|gzip|zlib|lzma|bz2|pty|signal|tempfile)|os\.(system|popen|exec|spawn|fork|mkdir|makedirs|rename|replace|unlink|remove|rmdir|chmod|chown|write|symlink|link)\(|posix_spawn' "$f" \
    && fail "$f references process, network, archive, or write facilities"
  grep -Eqi '\b(adb|fastboot|ssh|scp|rsync|curl|wget)\b' "$f" && fail "$f names a live transport command"
  grep -Eq 'os\.environ|getenv|argparse|traceback' "$f" && fail "$f reads the environment or prints tracebacks"
done
[[ $(wc -l < "$tool") -le 90 ]] || fail "the trusted loader grew past 90 lines"
pass "loader and implementation parse and have no process, network, environment, or write facility"
[[ -x $tool ]] || fail "tool is not executable"
[[ ! -e device/myron/kernel-source ]] || fail "device/myron/kernel-source exists: no private bytes may live in the repository"
pass "no bundle bytes in the repository"

[[ $("$tool" --version) == 0.1.0 ]] || fail "version"
"$tool" show > "$tmp/show.json" || fail "show failed"
cmp -s "$tmp/show.json" device/myron/kernel-source-contract.json || fail "show differs from the committed contract"
"$tool" plan > "$tmp/plan.json" || fail "plan failed"
(cd / && "$OLDPWD/$tool" show | cmp -s - "$tmp/show.json") || fail "show depends on the working directory"
(cd / && "$OLDPWD/$tool" plan | cmp -s - "$tmp/plan.json") || fail "plan depends on the working directory"
[[ $(wc -c < "$tmp/plan.json") -le 65536 ]] || fail "plan exceeds 64 KiB"
pass "production show and plan are deterministic across working directories"

set +e
for args in "" "bogus" "show extra" "plan extra" "verify" "verify --root" "verify --root a b" "--root /x" "--version x" "verify --root=/x" "verify /x"; do
  # shellcheck disable=SC2086
  KERNEL_SOURCE_ROOT=/x "$tool" $args > "$tmp/out" 2> "$tmp/err"; rc=$?
  [[ $rc -eq 2 && ! -s $tmp/out && $(cat "$tmp/err") == "myron-kernel-source: E_USAGE" ]] || fail "misuse '$args' rc=$rc"
done
for root in relative /nonexistent/x /tmp/ /tmp//x /tmp/./x /tmp/../x /; do
  "$tool" verify --root "$root" > "$tmp/out" 2> "$tmp/err"; rc=$?
  [[ $rc -eq 1 && ! -s $tmp/out && $(cat "$tmp/err") == "myron-kernel-source: E_REFUSED" ]] || fail "refusal '$root' rc=$rc"
done
set -e
pass "misuse exits 2 and refusals exit 1 with empty stdout and one fixed stderr line"

python3 -B - "$PWD" "$tmp" <<'PY' || exit 1
import contextlib, copy, hashlib, importlib.machinery, importlib.util, json, os, socket, stat
import subprocess, sys
from pathlib import Path

repo = Path(sys.argv[1])
work = Path(sys.argv[2])
sys.dont_write_bytecode = True


def load(name, path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


K = load("kernel_source_test", repo / "tools/myron-kernel-source")
R = K.Refusal
sha = lambda data: hashlib.sha256(data).hexdigest()


def expect(reason, function, *args, **kwargs):
    try:
        function(*args, **kwargs)
    except R as error:
        assert error.reason == reason, (reason, error.reason)
        return
    raise AssertionError(f"expected refusal {reason}")


def ok(message):
    print(f"ok - {message}")


# ---------------------------------------------------------------- production binding
kernel_bytes = (repo / "device/myron/kernel-contract.json").read_bytes()
assert sha(kernel_bytes) == "80321c737de5dd4ac7a671a83453c225ae23b7c2c1313e6cba0f8811ddcc8193"
assert len(kernel_bytes) == K.KERNEL_CONTRACT_SIZE
kernel = json.loads(kernel_bytes)
contract_bytes = (repo / "device/myron/kernel-source-contract.json").read_bytes()
assert contract_bytes == K.render_json(K.expected_contract())
contract = json.loads(contract_bytes)
assert contract["schema"] == 1 and contract["version"] == "0.1.0"
assert contract["kernel_contract"]["sha256"] == sha(kernel_bytes)
pins = {f["path"]: f for f in contract["bundle"]["files"]}
assert [f["path"] for f in contract["bundle"]["files"]] == [
    "source-lock.json", "stamped-manifest.xml", "vt.fragment",
    "patches/0001-bluetooth-qca-preinitialized-ibs.patch",
    "patches/0002-bluetooth-qca-vote-msm-geni-uart-clock.patch",
    "patches/0003-gki-export-rmnet-module.patch",
    "patches/0007-ipc-export-namespace-symbols.patch"]
