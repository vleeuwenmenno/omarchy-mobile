class Counting:
    def __init__(self, inner):
        self.inner = inner

    def __enter__(self):
        self.inner.__enter__()
        return self

    def __exit__(self, *arguments):
        return self.inner.__exit__(*arguments)

    def __iter__(self):
        for entry in self.inner:
            yielded.append(entry.name)
            yield entry


