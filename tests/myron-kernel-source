def canary_envelope(values, body):
    headers = (f"From: {values['from']} <x@example.invalid>\n {values['fold']}\n",
               f"Date: {values['date']}\n", f"Subject: [PATCH] {values['subject']}\n")
    mbox = f"From {values['mbox']} Mon Sep 17 00:00:00 2001\n"
    stat = f" {values['stat']}.c | 9 +-\n 3 files changed, 8 insertions(+), 7 deletions(-)\n\n"
    return envelope(body, message=f"{values['message']}\ndiff --git a/{values['message']} b/x\n",
                    stat=stat, footer=f"-- \n{values['version']}\n", headers=headers, mbox=mbox)


def canary_doc(values):
    texts = [canary_envelope(values, GOOD), canary_envelope(values, SHARED), canary_envelope(values, GOOD),
             canary_envelope(values, stale)]
    return K.render_json(K.analysis_document(K.analyze_patch_series(
        tuple(t.encode() for t in texts), K.patch_profile())))


