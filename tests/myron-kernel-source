def padded(size):
    lines = "".join("+" + "z" * 6000 + "\n" for _ in range(10))
    head = sect("a.c", hunk(1, 0, 2, 11, lines + "+")).encode() + b"\n"
    pad = size - len(head)
    assert 0 <= pad < 8000, pad
    return head.replace(b"+\n", b"+" + b"y" * pad + b"\n")


