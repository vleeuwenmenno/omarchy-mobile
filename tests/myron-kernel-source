                "https://Android.googlesource.com/x", "https://android.googlesource.com//x",
                "https://android.googlesource.com/.x", None):
    lock_case("lock-project-url", lambda v, u=bad_url: v["projects"][2].update(url=u))
lock_case("lock-project-url-duplicate",
          lambda v: v["projects"][2].update(url=v["projects"][0]["url"]))
for bad_revision in ("A" * 40, "a" * 39, "a" * 41, "g" * 40, 7, None):
    lock_case("lock-project-revision", lambda v, r=bad_revision: v["projects"][2].update(revision=r))
lock_case("lock-project-overlap", lambda v: v["projects"][2].update(path="common"))
lock_case("lock-project-overlap", lambda v: v["projects"][2].update(path="common/sub"))
lock_case("lock-project-overlap", lambda v: v["projects"][2].update(path="build"))
lock_case("lock-links", lambda v: v["links"].append({"path": "second", "target": "common/y"}))
lock_case("lock-link-keys", lambda v: v["links"][0].update(extra=1))
lock_case("lock-link-keys", lambda v: v["links"].__setitem__(0, []))
lock_case("lock-link-path", lambda v: v["links"][0].update(path="../escape"))
lock_case("lock-link-path", lambda v: v["links"][0].update(target="/etc/passwd"))
lock_case("lock-link-path", lambda v: v["links"][0].update(target="build/../common/x"))
lock_case("lock-link-collision", lambda v: v["links"][0].update(path="common"))
lock_case("lock-link-collision", lambda v: v["links"][0].update(path="tools"))
lock_case("lock-link-collision", lambda v: v["links"][0].update(path="common/inside"))
lock_case("lock-link-target", lambda v: v["links"][0].update(target="outside/file"))
lock_case("lock-link-target", lambda v: v["links"][0].update(target="build/other"))
lock_case("lock-link-target", lambda v: v["links"][0].update(target="link.sh/x"))
two_links = synth_lock()
two_links["links"].append({"path": "second", "target": "common/y"})
