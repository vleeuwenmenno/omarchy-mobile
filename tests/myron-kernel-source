def patch_set(*texts):
    names = list(SYN_NAMES)
    contents = default_contents()
    for name, text in zip(names, texts):
        contents["patches/" + name] = text.encode() if isinstance(text, str) else text
    return contents


def run_cli(arguments, spec_override=None):
    saved_spec = K.production_spec
    if spec_override is not None:
        K.production_spec = lambda environment: spec_override
    old_out, old_err = sys.stdout, sys.stderr
    sys.stdout = io.TextIOWrapper(io.BytesIO(), encoding="ascii")
    sys.stderr = io.StringIO()
    try:
        status = K.main(arguments)
        sys.stdout.flush()
        return status, sys.stdout.buffer.getvalue(), sys.stderr.getvalue()
    finally:
        sys.stdout, sys.stderr = old_out, old_err
        K.production_spec = saved_spec


