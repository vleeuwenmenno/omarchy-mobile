apn_case 'empty file' ''
reset; armed; echo 'apn=ok' >"$apn_config"; stat_reply='1000 644'
expect_fail 'APN not root-owned' 'not root-owned' cmd_data "$TOKEN"
reset; armed; echo 'apn=ok' >"$apn_config"; stat_reply='0 666'
expect_fail 'APN writable' 'writable' cmd_data "$TOKEN"
reset; armed; echo 'apn=ok' >"$work/apn.real"; ln -s "$work/apn.real" "$apn_config"
expect_fail 'APN symlink' 'not a regular file' cmd_data "$TOKEN"
rm -f "$work/apn.real"
pass 'APN config is exactly one terminated root-owned record and defaults to internet'

# -- radio-off and radio-on are unavailable -------------------------------------------
for cmd in radio-off radio-on; do
  reset; armed
  expect_fail "$cmd" "$cmd is unavailable" cmd_radio_refused "$cmd"
  [[ ! -s $calls && ! -d $mutation_marker && ! -e $data_state ]] || tfail "$cmd touched the modem, NM or state"
  rc=0; out=$(sh "$stage" "$cmd" 2>&1) || rc=$?
  [[ $rc -eq 1 && $out == *"$cmd is unavailable"* ]] || tfail "real $cmd: rc=$rc $out"
done
reset; armed; expect_ok data cmd_data "$TOKEN" >/dev/null
for cmd in radio-off radio-on; do expect_fail "$cmd after data" 'is unavailable' cmd_radio_refused "$cmd"; done
grep -Eq 'mmcli|power' "$calls" && tfail 'radio refusal touched the modem'
pass 'radio-off and radio-on are always refused without touching the modem'

# -- usage ---------------------------------------------------------------------------
for arg in '' bogus 'status extra' 'identity x' 'arm x' 'qualify x' 'radio-off x' 'data' 'data a b' 'finish' 'disarm'; do
  rc=0; out=$(sh "$stage" $arg 2>&1) || rc=$?
  [[ $rc -eq 2 && $out == *usage* ]] || tfail "usage for '$arg': rc=$rc"
done
[[ $stage_target_uuid != "$secret_uuid" ]] || tfail 'test must not reuse the real target UUID'
pass 'dispatcher rejects bad usage; finish and disarm do not exist'
