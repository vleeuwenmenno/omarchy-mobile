#!/bin/bash
# SPDX-License-Identifier: MIT
# Execute the one-shot Myron cellular data stage's gates against mocked
# mmcli/nmcli/ip/curl/resolvectl and fake host state. Nothing touches a phone
# or a network.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

stage=device/myron/hardware-test-overlay/usr/local/sbin/myron-cellular-stage
tfail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }

[[ -x $stage ]] || tfail 'stage is executable'
sh -n "$stage" || tfail 'stage parses as POSIX sh'
bash -n "$stage" || tfail 'stage parses as bash'
if shellcheck --version >/dev/null 2>&1; then
  shellcheck -s sh -e SC2086,SC2034,SC2046,SC2015,SC2155,SC2294 "$stage" || tfail 'shellcheck'
fi
# POSIX sh only: no bash-isms in the guarded root script.
if grep -nE '\[\[[^:]|<<<|(^|[[:space:]])local[[:space:]]|\bfunction\b|\$\{[^}]*(//|,,|\^\^)|\bdeclare\b|\bmapfile\b|&>|<\(' "$stage"; then
  tfail 'stage uses shell syntax outside POSIX sh'
fi
# The sbin script never stops, restarts, disconnects, reconnects or re-enables,
# never changes modem power, and never touches storage.
if grep -nE 'connection (down|delete|reapply)|device (disconnect|reapply)|\bdisconnect\b|systemctl +(stop|restart|reload|kill|mask|disable|start)|\bkill(all)?\b|modprobe|rmmod|insmod|fastboot|\bdd\b|--enable|--disable|set-power-state|--set-|\bsudo\b|/dev/(disk|block|sd|mmc)|remoteproc[^ ]*/state|nmcli +(radio|networking)|\brfkill\b|\bnv\b' "$stage"; then
  tfail 'stage contains a forbidden stop, disconnect, re-enable, power or storage action'
fi
# No identity readers.
if grep -niE 'imei|imsi|iccid|msisdn|own-numbers|equipment-identifier|operator-code|operator-name|hw-addr|mac-address|ether ' "$stage"; then
  tfail 'stage reads or prints identity fields'
fi
# The modem is only ever listed or read as keys.
if grep -nE 'mmcli' "$stage" | grep -vE 'mmcli -L|mmcli -m "\$modem" -K|command -v|for tool|^[0-9]+:#|mmcli nmcli|mm_key|mmcli.*\)$'; then
  tfail 'stage runs an mmcli command other than list and read-only keys'
fi
# Every radio-path tool call is bounded by timeout and sheds raw stderr.
joined=$(sed ':a;/\\$/{N;s/\\\n//;ba}' "$stage")
if printf '%s\n' "$joined" | grep -E '(^|[^-_/a-zA-Z])(mmcli|nmcli|curl|resolvectl|ss|ip) -' |
  grep -vE 'timeout -k [0-9]+ [0-9]+ (mmcli|nmcli|curl|resolvectl|ss|ip)|command -v|for tool|ERROR|usage|printf|^[[:space:]]*#|mm_key|persist|case '; then
  tfail 'stage runs mmcli/nmcli/curl/resolvectl/ss/ip without a timeout'
fi
# Every profile mutation, activation and lookup uses the fixed UUID, never a name.
if grep -nE 'connection (modify|up) ' "$stage" | grep -vE 'uuid "\$target_uuid"'; then
  tfail 'stage mutates or activates a profile by name'
fi
grep -Fq 'connection.uuid "$target_uuid"' "$stage" || tfail 'profile is not created with the fixed UUID'
grep -Fq 'gsm.home-only yes' "$stage" || tfail 'profile is not home-only'
grep -Fq 'nmcli device set "$control" autoconnect no' "$stage" || tfail 'stage does not suppress device autoconnect'
grep -Fq 'nmcli device set "$control" managed yes' "$stage" || tfail 'stage does not manage the control device explicitly'
[[ $(grep -c 'nmcli device set' "$stage") == 2 ]] || tfail 'stage changes device properties outside the two reviewed mutations'
grep -Fq 'ipv4.routing-rules ""' "$stage" || tfail 'stage does not clear inherited routing rules'
if grep -nE 'ipv4\.routing-rules +(priority|from)|from all table' "$stage"; then tfail 'stage installs its own from-all routing rule'; fi
# Failure logs never carry variables: persist only the fixed message.
grep -Fq 'persist "result=failed message=$1"' "$stage" || tfail 'failure logging can persist variable detail'
if printf '%s\n' "$joined" | grep -E 'timeout -k [0-9]+ [0-9]+ (mmcli|nmcli|curl|resolvectl|ip)' | grep -vE '2>/dev/null|>/dev/null 2>&1'; then
  tfail 'stage lets a tool write raw stderr'
fi
grep -Fq 'connection.autoconnect no' "$stage" || tfail 'stage does not set autoconnect off'
grep -Fq 'curl -q --interface' "$stage" || tfail 'curl does not ignore its config file first'
for flag in '--retry 0' '--resolve' "--noproxy '*'" '--proto =https' '--tlsv1.2' '--max-time' '--max-filesize' '--max-redirs 0'; do
  grep -Fq -- "$flag" "$stage" || tfail "probe lacks $flag"
done
# No finish or disarm command, and the host disarm marker is only ever removed.
if grep -nE '^(finish|disarm)\)|cmd_(finish|disarm)' "$stage"; then tfail 'stage exposes finish or disarm'; fi
if grep -n 'host_disarm' "$stage" | grep -vE 'host_disarm=|rm -f "\$host_disarm"|-e "\$host_disarm"'; then
  tfail 'stage writes the host disarm marker'
fi
pass 'cellular stage syntax, forbidden-action, privacy and bounded-call greps'

work=$(mktemp -d /tmp/myron-cellular-stage.XXXXXX)
trap 'rm -rf -- "$work"' EXIT
# shellcheck disable=SC1090
source <(sed '/^# --- main ---$/,$d' "$stage")

calls=$work/calls
runtime_dir=$work/run
mutation_marker=$runtime_dir/mutation
arm_marker=$runtime_dir/stage-armed
data_state=$runtime_dir/data.state
log=$work/host-log
host_state=$work/host
host_armed=$host_state/hardware-test.armed
host_disarm=$host_state/hardware-test.disarm
init_boot_sha_file=$host_state/hardware-test-init-boot.sha256
rollback_complete=$host_state/hardware-test.rollback-complete
init_boot_rollback=$work/init_boot.img
boot_rollback=$work/boot.img
profile_file=$work/profile
cellular_ready=$work/cellular-ready
wireless_ready=$work/wireless-ready
apn_config=$work/apn
os_release=$work/os-release
dt_root=$work/dt
notes_file=$work/notes
uptime_file=$work/uptime
boot_id_file=$work/boot-id
net_root=$work/net
sys_module=$work/sys-module
thermal_root=$work/thermal
bluetooth_hci=$work/hci0
expected_kernel=6.12.23-test
rescue_before=$runtime_dir/rescue.before
rescue_after=$runtime_dir/rescue.after
init_boot_size=16
boot_size=32
qualify_steps=2
late_steps=2

secret_imei=358240051111110
secret_iccid=8931080019000000000
secret_number=+31612345678
secret_ip=100.77.88.99
secret_wifi_ip=192.168.50.7
secret_dns=198.51.100.53
secret_apn=carrier-secret-apn.example
secret_uuid=4f2a9c1e-1b2d-4c3e-8f40-0123456789ab
other_uuid=11111111-2222-4333-8444-555555555555
real_uid=0
[[ $target_uuid =~ ^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$ ]] || tfail 'stage target UUID is not a fixed lowercase UUID'
stage_target_uuid=$target_uuid
target_uuid=$secret_uuid

printf 'notes' >"$notes_file"
expected_notes=$(sha256sum "$notes_file" | awk '{print $1}')
printf '%s' 0123456789abcdef >"$work/init_boot.good"
printf '%s' 0123456789abcdef0123456789abcdef >"$work/boot.good"
rollback_init_boot_sha=$(sha256sum "$work/init_boot.good" | awk '{print $1}')
rollback_boot_sha=$(sha256sum "$work/boot.good" | awk '{print $1}')
candidate_sha=$(printf candidate | sha256sum | awk '{print $1}')
payload_sha=$(printf payload | sha256sum | awk '{print $1}')

reset() {
  rm -rf "$runtime_dir" "$calls" "$log" "$apn_config" "$net_root" "$bluetooth_hci" "$host_state" \
    "$sys_module" "$thermal_root" "$work/activated" "$work/managed" "$work/profile-created" "$work/profile-modified" \
    "$work/device-autoconnect-off" "$work/auto-activated" "$work/late-autoconnect" "$work"/arrive.* "$work/dtmodel" \
    "$init_boot_rollback" "$boot_rollback" "$work"/real* "$arm_marker" "$work/peer-route-calls"
  : >"$calls"
  mkdir -p "$net_root/rmnet_data0" "$net_root/rmnet_ipa0" "$net_root/wlan0" "$net_root/usb0" "$host_state" "$dt_root" \
    "$thermal_root/thermal_zone0"
  echo up >"$net_root/wlan0/operstate"; echo unknown >"$net_root/usb0/operstate"
  echo 4 >"$net_root/wlan0/ifindex"; echo 5 >"$net_root/usb0/ifindex"; echo 3 >"$net_root/rmnet_data0/ifindex"
  for m in rmnet rmnet_mem gsim ipam ipanetm rmnet_ctl; do mkdir -p "$sys_module/$m"; done
  echo battery >"$thermal_root/thermal_zone0/type"; echo 60000 >"$thermal_root/thermal_zone0/temp"
  : >"$cellular_ready"; echo ready >"$wireless_ready"; echo cellular >"$profile_file"
  printf 'payload_sha256=%s\nwatchdog_seconds=900\n' "$payload_sha" >"$host_armed"
  printf '%s\n' "$candidate_sha" >"$init_boot_sha_file"
  cp "$work/init_boot.good" "$init_boot_rollback"; cp "$work/boot.good" "$boot_rollback"
  printf 'Myron Test Device\0' >"$dt_root/model"
  printf 'qcom,canoe-mtp\0qcom,canoe\0' >"$dt_root/compatible"
  printf 'ID=omarchy\nNAME=Omarchy\n' >"$os_release"
  printf 'notes' >"$notes_file"
  echo boot-X >"$boot_id_file"
  echo '500.00 0.00' >"$uptime_file"
  wd_enter=100000000
  expected_notes=$(sha256sum "$notes_file" | awk '{print $1}')
  active_units=' myron-hardware-watchdog.service ModemManager.service myron-ipa-guard.service '
  guard_rc=0 guard_log=$work/guard-log; : >"$guard_log"
  hci=0 modems=1 unlock=-- reg=home packet=attached power=on state=registered
  access_len=2 access1=lte access2=5gnr bearers=0
  nm_ok=0 m_profile_exists=0 autoconnect_reply=no up_rc=0 up_activates=1 activated=0
  gsm_state=disconnected gsm_boot=unmanaged gsm_devices=1 m_active_gsm=0 m_active_after=0 m_busy_state=activating
  m_rows='' m_auto='' m_own_auto=no m_homeonly=yes m_initial_eps=no m_id_reply=myron-cellular m_uuid_by_name=$secret_uuid
  m_profile_routes='' m_profile_addresses='' m_profile_gateway='' m_secondaries='' m_profile_metric=700
  m_bound=ttyMODEM0 m_wifi=connected m_wifi_after=connected m_listeners_after='LISTEN 0 128 0.0.0.0:22 0.0.0.0:*\n'
  m_listeners='LISTEN 0 128 0.0.0.0:22 0.0.0.0:*\n' \
  m_sessions="0 0 172.16.42.1:22 172.16.42.2:51000\\n0 0 $secret_wifi_ip:22 192.168.50.9:51001\\n"
  m_sessions_after=$m_sessions
  curl_code=204 curl_local=$secret_ip dns_lines=1 addr_lines=1 m_default_lines=1 m_route_table=1430
  rule_line="100:	from all oif rmnet_data0 lookup 1430 proto kernel"
  m_pre_rule='' m_post_rule='' m_usb=1 m_usb_addr_after=same m_wifi_addr=$secret_wifi_ip m_wifi_addr_after=same
  m_usb_route_lost=0 m_profile_rules='' m_profile_table=0 m_profile_never=no cell_dns_ok=1 cell_dns_ip=8.8.4.4
  wifi_dns_ok=1 up_delay=0 sleep_advance=0 managed_state_after=disconnected autoactivate=0
  m_device_auto=yes device_autoconnect_set_ok=1
  timeout_advance_after_marker=0 timeout_advance_after_activation=0 heat_after_activation=0 m_usb_ifindex_after=
  m_peer_dev=usb0 m_peer_src=172.16.42.1 m_peer_via= m_peer_table=
  m_peer_dev_after=usb0 m_peer_src_after=172.16.42.1 m_peer_via_after= m_peer_table_after=
  m_wifi_peer_dev=wlan0 m_wifi_peer_src=$secret_wifi_ip m_wifi_peer_via= m_wifi_peer_table=
  m_wifi_peer_dev_after=wlan0 m_wifi_peer_src_after=$secret_wifi_ip m_wifi_peer_via_after= m_wifi_peer_table_after=
  m_main_default='default via 192.168.1.1 dev wlan0 metric 600'
  m_link_dns_data=$secret_dns m_link_dns_control='' m_counter_move=both
  route_get_dev=rmnet_data0
  mkdir -p "$net_root/rmnet_data0/statistics"
  echo 100 >"$net_root/rmnet_data0/statistics/tx_packets"; echo 100 >"$net_root/rmnet_data0/statistics/rx_packets"
  stat_reply='0 600' uid=$real_uid conflict=1 kernel=$expected_kernel
  noisy=1
}

# shellcheck disable=SC1091
source tests/lib/myron-cellular-mocks.sh
guard_check() { echo "guard ${*:-plain}" >>"$guard_log"; return "$guard_rc"; }
run() { ( "$@" ) 2>&1; }
expect_fail() { # description expected-substring command...
  local what=$1 want=$2 out rc=0; shift 2
  out=$(run "$@") || rc=$?
  [[ $rc -ne 0 ]] || tfail "$what: command succeeded"
  [[ $out == *"$want"* ]] || tfail "$what: expected '$want', got: $out"
  no_identity "$out"
}
expect_ok() {
  local what=$1 out rc=0; shift
  out=$(run "$@") || rc=$?
  [[ $rc -eq 0 ]] || tfail "$what: failed: $out"
  no_identity "$out"
  printf '%s\n' "$out"
}
no_identity() { # text
  local secret
  for secret in "$secret_imei" "$secret_iccid" "$secret_number" "$secret_ip" "$secret_wifi_ip" "$secret_dns" \
    "$secret_apn" "$secret_uuid" ttyMODEM0 rmnet_data0 "$candidate_sha" "$payload_sha"; do
    [[ -z $secret || $1 != *"$secret"* ]] || tfail "output leaked identity, address or hash data: $secret"
  done
}
no_secrets_anywhere() { no_identity "$(cat "$log" "$runtime_dir"/data.state "$calls.out" 2>/dev/null || true)"; }
nm_untouched() { ! grep -q nmcli "$calls" || tfail "$1: NetworkManager was mutated"; }
armed() { mkdir -p "$runtime_dir"; printf 'boot_id=boot-X\n' >"$arm_marker"; }
TOKEN=ONE-SHOT-CELLULAR-DATA-REBOOT-REQUIRED

# -- identity -----------------------------------------------------------------------
reset
out=$(expect_ok identity cmd_identity)
[[ $out == *'result=ok'*'device=myron'*'compatible=exact'*'kernel=exact'*'notes=exact'*'rollback_boot=exact'* ]] ||
  tfail "identity output: $out"
id_gate() { local what=$1 want=$2 setup=$3
  reset; eval "$setup"; expect_fail "identity: $what" "$want" cmd_identity
  [[ ! -e $arm_marker ]] || tfail "identity $what armed"; }
id_gate 'not root' 'must run as root' uid=1000
id_gate 'kernel' 'unexpected kernel release' 'kernel=6.12.23-other'
id_gate 'notes' 'notes differ' 'echo wrong >"$notes_file"'
id_gate 'model' 'model is not Myron' "printf 'Other Phone\\0' >\"\$dt_root/model\""
id_gate 'compatible' 'compatible differs' "printf 'qcom,other\\0qcom,canoe-mtp\\0' >\"\$dt_root/compatible\""
id_gate 'os' 'not Omarchy' 'echo ID=arch >"$os_release"'
id_gate 'profile' 'profile is not selected' 'echo coexistence >"$profile_file"'
id_gate 'no host arm' 'arm is absent' 'rm -f "$host_armed"'
id_gate 'host arm symlink' 'arm is absent' 'mv "$host_armed" "$work/real-arm"; ln -s "$work/real-arm" "$host_armed"'
id_gate 'arm extra line' 'arm metadata is invalid' 'echo extra >>"$host_armed"'
id_gate 'arm bad payload' 'arm metadata is invalid' 'printf "payload_sha256=zz\nwatchdog_seconds=900\n" >"$host_armed"'
id_gate 'watchdog short' 'duration metadata' 'printf "payload_sha256=%s\nwatchdog_seconds=300\n" "$payload_sha" >"$host_armed"'
id_gate 'watchdog long' 'duration metadata' 'printf "payload_sha256=%s\nwatchdog_seconds=9000\n" "$payload_sha" >"$host_armed"'
id_gate 'rollback complete' 'rollback already completed' ': >"$rollback_complete"'
id_gate 'candidate missing' 'candidate init_boot metadata' 'rm -f "$init_boot_sha_file"'
id_gate 'candidate short' 'candidate init_boot metadata' 'echo abc >"$init_boot_sha_file"'
id_gate 'candidate upper' 'candidate init_boot metadata' 'echo "${candidate_sha^^}" >"$init_boot_sha_file"'
id_gate 'candidate two lines' 'candidate init_boot metadata' 'echo "$candidate_sha" >>"$init_boot_sha_file"'
id_gate 'candidate is rollback' 'candidate init_boot metadata' 'echo "$rollback_init_boot_sha" >"$init_boot_sha_file"'
id_gate 'init_boot rollback size' 'init_boot rollback image' 'echo x >>"$init_boot_rollback"'
id_gate 'init_boot rollback hash' 'init_boot rollback image' 'printf %s XXXXXXXXXXXXXXXX >"$init_boot_rollback"'
id_gate 'init_boot rollback missing' 'init_boot rollback image' 'rm -f "$init_boot_rollback"'
id_gate 'init_boot rollback link' 'init_boot rollback image' 'mv "$init_boot_rollback" "$work/real.img"; ln -s "$work/real.img" "$init_boot_rollback"'
id_gate 'boot rollback size' 'kernel-boot rollback image' 'echo x >>"$boot_rollback"'
id_gate 'boot rollback hash' 'kernel-boot rollback image' 'printf %s XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX >"$boot_rollback"'
id_gate 'boot rollback missing' 'kernel-boot rollback image' 'rm -f "$boot_rollback"'
pass 'identity validates device, kernel, notes, OS, profile and exact candidate and rollback metadata, aggregate output only'

# -- arm -----------------------------------------------------------------------------
reset; : >"$host_disarm"
out=$(expect_ok arm cmd_arm)
[[ $out == *'result=armed'*'rollback=armed'*'remaining_seconds=500'* ]] || tfail "arm output: $out"
[[ ! -e $host_disarm ]] || tfail 'arm left the host disarm marker'
grep -Fxq 'boot_id=boot-X' "$arm_marker" || tfail 'arm marker is not boot-scoped'
nm_untouched arm
[[ ! -d $mutation_marker ]] || tfail 'arm took the mutation lock'
reset; expect_ok 'arm twice' cmd_arm >/dev/null; expect_ok 'arm twice' cmd_arm >/dev/null
reset; : >"$host_disarm"; kernel=other
expect_fail 'arm without identity' 'unexpected kernel release' cmd_arm
[[ -e $host_disarm && ! -e $arm_marker ]] || tfail 'arm changed state before identity passed'
reset; active_units=' '
expect_fail 'arm without watchdog' 'watchdog is not active' cmd_arm
[[ ! -e $arm_marker ]] || tfail 'arm marker written without watchdog'
reset; echo '520.00 0' >"$uptime_file"        # 900 - (520 - 100) = 480: exactly enough
expect_ok 'arm at the minimum deadline' cmd_arm >/dev/null
reset; echo '521.00 0' >"$uptime_file"        # 479: too close
expect_fail 'arm near deadline' 'deadline is too close' cmd_arm
[[ ! -e $arm_marker ]] || tfail 'arm marker written with an insufficient deadline'
reset; wd_enter=; expect_fail 'arm unknown deadline' 'deadline is unavailable' cmd_arm
pass 'arm needs identity, removes the host disarm, proves watchdog and deadline, writes a boot-scoped marker only'

# -- status --------------------------------------------------------------------------
reset
before=$(find "$work" -type f ! -name guard-log | sort | md5sum)
out=$(expect_ok status cmd_status)
[[ $out == *'watchdog_disarm=absent'*'stage_armed=no'*'ipa_guard=clean'*'data_attempted=no'*'reboot_required=no'* ]] || tfail "status output: $out"
[[ $out == *'access=lte-or-5g'*'radio_off=unavailable'*'radio_on=unavailable'* ]] || tfail "status output: $out"
[[ $(find "$work" -type f ! -name guard-log | sort | md5sum) == "$before" && ! -d $runtime_dir ]] || tfail 'status changed state'
nm_untouched status
reset; : >"$host_disarm"; armed; active_units=' myron-hardware-watchdog.service '
out=$(expect_ok status cmd_status)
[[ $out == *'watchdog_disarm=present'*'stage_armed=yes'*'ipa_guard=inactive'* ]] || tfail "status output: $out"
pass 'status is read-only and private'

# -- qualify gates (read-only) -------------------------------------------------------
reset
out=$(expect_ok qualify cmd_qualify)
[[ $out == *'result=ready'*'bluetooth=absent'*'audio=inactive'*'ipa_guard=clean'*'isolation=clean'*'modem_count=1'* ]] || tfail "qualify output: $out"
[[ ! -d $mutation_marker ]] || tfail 'qualify took the lock'
nm_untouched qualify
gate() { # description expected setup [command]
  local what=$1 want=$2 setup=$3 cmd=${4:-cmd_qualify}
  reset; armed; eval "$setup"
  expect_fail "gate: $what" "$want" "$cmd" ${5:-}
  [[ ! -s $calls ]] || tfail "gate $what ran a mutating command"
  [[ ! -d $mutation_marker ]] || tfail "gate $what took the lock"
}
gates() {
  local c=${1:-cmd_qualify} t=${2:-}
  gate 'not root' 'must run as root' uid=1000 "$c" "$t"
  gate 'no arm' 'arm is absent' 'rm -f "$host_armed"' "$c" "$t"
  gate 'watchdog' 'watchdog is not active' "active_units=' ModemManager.service myron-ipa-guard.service '" "$c" "$t"
  gate 'wrong profile' 'profile is not selected' 'echo coexistence >"$profile_file"' "$c" "$t"
  gate 'foundation' 'cellular foundation is not ready' 'rm -f "$cellular_ready"' "$c" "$t"
  gate 'radio' 'radio foundation is not ready' ': >"$wireless_ready"' "$c" "$t"
  gate 'ModemManager' 'ModemManager is not active' "active_units=' myron-hardware-watchdog.service myron-ipa-guard.service '" "$c" "$t"
  gate 'NetworkManager' 'NetworkManager is not running' nm_ok=1 "$c" "$t"
  gate 'coexistence' 'coexistence profile must remain inactive' "active_units+=' myron-coexistence.service '" "$c" "$t"
  gate 'audio' 'AudioReach must remain inactive' "active_units+=' myron-reference-audio-foundation.service '" "$c" "$t"
  gate 'speaker' 'speaker bridge must remain inactive' "active_units+=' myron-speaker-bridge.service '" "$c" "$t"
  gate 'bluetooth' 'Bluetooth controller must remain absent' 'touch "$bluetooth_hci"' "$c" "$t"
  gate 'bluetooth transport' 'Bluetooth transport must remain inactive' conflict=0 "$c" "$t"
  gate 'rmnet not loaded' 'in-tree rmnet is not loaded' 'rmdir "$sys_module/rmnet"' "$c" "$t"
  gate 'rmnet_core loaded' 'rmnet_core must remain absent' 'mkdir "$sys_module/rmnet_core"' "$c" "$t"
  for m in rmnet_mem gsim ipam ipanetm rmnet_ctl; do
    gate "module $m" "required radio module is not loaded: $m" "rmdir \"\$sys_module/$m\"" "$c" "$t"
  done
  gate 'no rmnet_ipa0' 'rmnet_ipa0 does not exist' 'rmdir "$net_root/rmnet_ipa0"' "$c" "$t"
  gate 'guard inactive' 'IPA guard is not active' "active_units=' myron-hardware-watchdog.service ModemManager.service '" "$c" "$t"
  gate 'guard dirty' 'IPA guard is not clean' 'guard_rc=1' "$c" "$t"
  gate 'thermal at limit' 'temperature safety limit' 'echo 95000 >"$thermal_root/thermal_zone0/temp"' "$c" "$t"
  gate 'thermal unreadable' 'sensors are unavailable' 'rm -rf "$thermal_root/thermal_zone0"' "$c" "$t"
  gate 'no modem' 'expected exactly one modem, found 0' modems=0 "$c" "$t"
  gate 'two modems' 'expected exactly one modem, found 2' modems=2 "$c" "$t"
  gate 'SIM PIN' 'SIM is not ready' unlock=sim-pin "$c" "$t"
  gate 'power low' 'SIM is not ready' power=low "$c" "$t"
  gate 'no packet' 'not attached to the home network' packet=detached "$c" "$t"
  gate 'unregistered' 'not attached to the home network' reg=searching "$c" "$t"
  gate 'roaming' 'not attached to the home network' reg=roaming "$c" "$t"
  gate 'UMTS only' 'access technology is not LTE or 5G' 'access_len=1 access1=umts' "$c" "$t"
  gate 'GSM and EDGE' 'access technology is not LTE or 5G' 'access1=gsm access2=edge' "$c" "$t"
  gate 'HSPA only' 'access technology is not LTE or 5G' 'access1=hspa-plus access2=hsupa' "$c" "$t"
  gate 'access missing' 'access technology is not LTE or 5G' 'access_len=0' "$c" "$t"
  gate 'access length junk' 'access technology is not LTE or 5G' 'access_len=--' "$c" "$t"
  gate 'two gsm devices' 'exactly one NetworkManager modem device' gsm_devices=2 "$c" "$t"
