#!/bin/bash
# SPDX-License-Identifier: MIT
# Execute privacy-safe parsers used by the one-shot Bluetooth transaction.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

stage=device/myron/hardware-test-overlay/usr/local/sbin/myron-bluetooth-stage
# shellcheck disable=SC1090
source <(sed '/^boot_id=$(cat \/proc\/sys\/kernel\/random\/boot_id)$/,$d' "$stage")

tmp=$(mktemp -d /tmp/myron-bluetooth-logic.XXXXXX)
trap 'rm -rf -- "$tmp"' EXIT
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
equal() { [[ $1 == "$2" ]] || fail "$3: expected $2, got $1"; }

dd if=/dev/zero of="$tmp/nvm" bs=1 count=98 status=none
printf '\x06\x05\x04\x03\x02\x01' |
  dd of="$tmp/nvm" bs=1 seek=92 conv=notrunc status=none
equal "$(nvm_public_address "$tmp/nvm")" '01:02:03:04:05:06' \
  'NVM little-endian public address'

mgmt_fixture=$tmp/mgmt
bluetooth_fixture=$tmp/bluetoothctl
timeout() {
  shift
  case "$*" in
    'btmgmt config'|'btmgmt --index 0 info') cat "$mgmt_fixture" ;;
    'bluetoothctl show') cat "$bluetooth_fixture" ;;
    *) return 124 ;;
  esac
}

printf 'hci0:\tUnconfigured controller\n' >"$mgmt_fixture"
mgmt_has_unconfigured_hci0 || fail 'unconfigured MGMT index was not recognized'
printf 'hci0:\tPrimary controller\n\taddr A1:B2:C3:D4:E5:F6 version 13 manufacturer 29 class 0x000000\n' \
  >"$mgmt_fixture"
if mgmt_has_unconfigured_hci0; then
  fail 'configured controller was accepted as unconfigured'
fi
equal "$(mgmt_configured_address)" 'a1:b2:c3:d4:e5:f6' \
  'configured MGMT address parser'
equal "$(printf '\001\033[1;30mDevice AA:BB:CC:DD:EE:FF JBL Flip 6\033[0m\002\n' |
  strip_terminal_controls)" 'Device AA:BB:CC:DD:EE:FF JBL Flip 6' \
  'BlueZ terminal control stripping'
printf '\033[0;93mDiscovering:\033[0m no\n' >"$bluetooth_fixture"
equal "$(bluetooth_discovering)" no 'bounded discovery-state parser'

scan=$tmp/scan
printf '\033[1;30mDevice AA:BB:CC:DD:EE:FF JBL Flip 6\033[0m\n' >"$scan"
equal "$(fresh_event_count JBL '' "$scan")" 0 'cached proxy is not fresh discovery'
printf '\001[\033[0;92mNEW\033[0m] Device AA:BB:CC:DD:EE:FF JBL Flip 6\002\n' >"$scan"
equal "$(fresh_event_count JBL '' "$scan")" 1 'new named peer is fresh discovery'
printf '[\033[0;92mNEW\033[0m] Device AA:BB:CC:DD:EE:FF Other Speaker\n' >"$scan"
equal "$(fresh_event_count JBL '' "$scan")" 0 'unrelated new peer is rejected'
printf '[\033[0;93mCHG\033[0m] Device AA:BB:CC:DD:EE:FF RSSI: -42\n' >"$scan"
equal "$(fresh_event_count JBL aa:bb:cc:dd:ee:ff "$scan")" 1 \
  'cached named peer requires fresh advertisement data'
printf '[\033[0;93mCHG\033[0m] Device AA:BB:CC:DD:EE:FF ManufacturerData.Key: 0x0001\n' >"$scan"
equal "$(fresh_event_count JBL aa:bb:cc:dd:ee:ff "$scan")" 1 \
  'manufacturer data is fresh advertisement data'
printf '[\033[0;93mCHG\033[0m] Device AA:BB:CC:DD:EE:FF Connected: yes\n' >"$scan"
equal "$(fresh_event_count JBL aa:bb:cc:dd:ee:ff "$scan")" 0 \
  'non-discovery property change is rejected'

printf '%s\n' 'ok - Bluetooth MGMT and fresh-discovery failure paths'
