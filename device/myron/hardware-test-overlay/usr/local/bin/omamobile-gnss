#!/bin/sh
# SPDX-License-Identifier: MIT
# Myron hardware-test Location switch backed by the qualified Qualcomm modem.
set -eu

mmcli=${OMAMOBILE_MYRON_MMCLI:-/usr/bin/mmcli}
modem=${OMAMOBILE_MYRON_MODEM:-any}
audio_experiment=/etc/omamobile/myron-audio-experiment
admission=/run/omamobile-myron/gnss-admission
allow_dir=/var/lib/omamobile-location
allow_marker=$allow_dir/enabled
geoclue_unit=geoclue.service
prepare_unit=omamobile-gnss-prepare.service

usage() {
  printf '%s\n' 'usage: omamobile-gnss on|off|force|unforce|status [--json]' >&2
  exit 2
}

as_root() {
  action=$1
  if [ "$(id -u)" != 0 ]; then
    case $action in on|off) exec systemctl start "omamobile-gnss-location@$action.service" ;; esac
    printf 'omamobile-gnss: %s requires root\n' "$action" >&2
    exit 1
  fi
}

refuse_audio_experiment() {
  [ ! -e "$audio_experiment" ] && [ ! -L "$audio_experiment" ] || {
    printf '%s\n' 'omamobile-gnss: blocked by the one-shot audio experiment' >&2
    exit 1
  }
}

mark_admission() {
  install -d -m0700 /run/omamobile-myron
  [ ! -L "$admission" ] || { printf '%s\n' 'omamobile-gnss: unsafe admission marker' >&2; exit 1; }
  mkdir -p "$admission"
  printf '%s\n' "$(cat /proc/sys/kernel/random/boot_id)" >"$admission/boot-id"
}

status_data() {
  if ! pgrep -x ModemManager >/dev/null 2>&1; then
    return 1
  fi
  "$mmcli" -m "$modem" --location-status --output-keyvalue 2>/dev/null
}

status() {
  data=$(status_data || true)
  installed=false
  enabled=no
  if printf '%s\n' "$data" | grep -Fq ': gps-raw' &&
     printf '%s\n' "$data" | grep -Fq ': gps-nmea'; then
    installed=true
  fi
  if printf '%s\n' "$data" | grep -Eq '^modem\.location\.enabled\.value\[[0-9]+\][[:space:]]*:[[:space:]]*gps-(raw|nmea)$'; then
    enabled=yes
  fi
  location=off
  if [ -f "$allow_marker" ] && [ ! -L "$allow_marker" ]; then
    location=on
  fi
  if [ "${1:-}" = --json ]; then
    printf '{"location":"%s","running":"%s","forced":"no","powered":"%s","agent":"on","lto_age_hours":"unknown","installed":%s}\n' \
      "$location" "$enabled" "$enabled" "$installed"
  else
    printf 'location: %s\nreceiver running: %s\nchip powered: %s\nbackend: ModemManager Qualcomm LOC\n' \
      "$location" "$enabled" "$enabled"
  fi
}

enable_receiver() {
  refuse_audio_experiment
  mark_admission
  pgrep -x ModemManager >/dev/null 2>&1 || {
    printf '%s\n' 'omamobile-gnss: ModemManager is not running' >&2
    exit 1
  }
  cleanup_enable() {
    "$mmcli" -m "$modem" \
      --location-disable-gps-raw \
      --location-disable-gps-nmea \
      --location-set-disable-signal >/dev/null 2>&1 || true
    "$mmcli" -m "$modem" --location-disable-agps-msb >/dev/null 2>&1 || true
  }
  trap cleanup_enable EXIT HUP INT TERM
  "$mmcli" -m "$modem" --location-enable-agps-msb
  "$mmcli" -m "$modem" \
    --location-enable-gps-raw \
    --location-enable-gps-nmea \
    --location-set-enable-signal
  trap - EXIT HUP INT TERM
}

prepare_receiver() {
  refuse_audio_experiment
  mark_admission
  pgrep -x ModemManager >/dev/null 2>&1 || {
    printf '%s\n' 'omamobile-gnss: ModemManager is not running' >&2
    exit 1
  }
  # GeoClue asks ModemManager for NMEA only.  Select the already-qualified
  # MSB mode before GeoClue starts so its on-demand engine does not fall back
  # to an unassisted standalone fix.  This changes the operation mode only;
  # raw/NMEA remain disabled until an application requests a location.
  "$mmcli" -m "$modem" --location-enable-agps-msb
}

disable_receiver() {
  pgrep -x ModemManager >/dev/null 2>&1 || exit 0
  "$mmcli" -m "$modem" \
    --location-disable-gps-nmea \
    --location-disable-gps-raw \
    --location-set-disable-signal >/dev/null 2>&1 || true
  "$mmcli" -m "$modem" --location-disable-agps-msb >/dev/null 2>&1 || true
  "$mmcli" -m "$modem" --location-disable-agps-msa >/dev/null 2>&1 || true
}

allow_location() {
  refuse_audio_experiment
  mark_admission
  [ ! -L "$allow_dir" ] || { printf '%s\n' 'omamobile-gnss: unsafe permission directory' >&2; exit 1; }
  [ ! -L "$allow_marker" ] || { printf '%s\n' 'omamobile-gnss: unsafe permission marker' >&2; exit 1; }
  install -d -o root -g root -m0755 "$allow_dir"
  tmp=$allow_dir/.enabled.$$
  trap 'rm -f "$tmp"' EXIT HUP INT TERM
  printf '%s\n' enabled >"$tmp"
  chown root:root "$tmp"
  chmod 0644 "$tmp"
  mv -f "$tmp" "$allow_marker"
  trap - EXIT HUP INT TERM
}

disallow_location() {
  refuse_audio_experiment
  mark_admission
  [ ! -L "$allow_dir" ] || { printf '%s\n' 'omamobile-gnss: unsafe permission directory' >&2; exit 1; }
  [ ! -L "$allow_marker" ] || { printf '%s\n' 'omamobile-gnss: unsafe permission marker' >&2; exit 1; }
  rm -f "$allow_marker"
  timeout -k 1 10 systemctl stop "$geoclue_unit" >/dev/null 2>&1 || {
    disable_receiver
    printf '%s\n' 'omamobile-gnss: GeoClue did not stop' >&2
    exit 1
  }
  if systemctl is-failed --quiet "$geoclue_unit"; then
    systemctl reset-failed "$geoclue_unit" >/dev/null 2>&1 || {
      disable_receiver
      printf '%s\n' 'omamobile-gnss: GeoClue failure state did not reset' >&2
      exit 1
    }
  fi
  prepare_state=$(systemctl show "$prepare_unit" -p LoadState --value 2>/dev/null || true)
  if [ "$prepare_state" = loaded ]; then
    timeout -k 1 10 systemctl stop "$prepare_unit" >/dev/null 2>&1 || {
      disable_receiver
      printf '%s\n' 'omamobile-gnss: assisted GNSS preparation did not stop' >&2
      exit 1
    }
    if systemctl is-failed --quiet "$prepare_unit"; then
      systemctl reset-failed "$prepare_unit" >/dev/null 2>&1 || {
        disable_receiver
        printf '%s\n' 'omamobile-gnss: assisted GNSS failure state did not reset' >&2
        exit 1
      }
    fi
  fi
  disable_receiver
}

case ${1:-} in
  on) as_root on; allow_location ;;
  off) as_root off; disallow_location ;;
  prepare) as_root prepare; prepare_receiver ;;
  force) as_root force; enable_receiver ;;
  unforce) as_root unforce; disable_receiver ;;
  status)
    refuse_audio_experiment
    status "${2:-}"
    ;;
  *) usage ;;
esac
