#!/bin/sh
# SPDX-License-Identifier: MIT
# Temporary bridge to the checksum-pinned, known-good postmarketOS radio/Wi-Fi
# bring-up. This hardware test always retains the postmarketOS root at
# /run/myron-host; a future standalone image must package a translated script.
set -eu

readonly source_script=/run/myron-host/usr/local/sbin/myron-wireless-start
readonly source_sha=a66a7b7ec66873301fc9f4d994b7fca7148e1dbc7862f49a687f8d5d1dde8271
readonly arm=/run/omamobile-myron/radio-backup-verified
readonly consumed=/run/omamobile-myron/radio-backup-verified.consumed
readonly module_dir=/usr/local/lib/myron-wireless/wlan/lib/modules

fail() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
check_asset() {
	path=$1
	expected=$2
	[ -f "$path" ] && [ ! -L "$path" ] || fail "radio-base asset is unavailable: $path"
	[ "$(sha256sum "$path" | awk '{print $1}')" = "$expected" ] ||
		fail "radio-base asset checksum mismatch: $path"
}
[ "$(id -u)" = 0 ] || fail 'radio bridge must run as root'
[ -f "$arm" ] && [ ! -L "$arm" ] || fail 'fresh calibration-backup verification is not armed'
[ "$(cat "$arm")" = 'verified-read-only-backup' ] || fail 'invalid backup-verification marker'
[ -f "$source_script" ] && [ ! -L "$source_script" ] || fail 'postmarketOS radio reference is unavailable'
[ "$(sha256sum "$source_script" | awk '{print $1}')" = "$source_sha" ] ||
	fail 'postmarketOS radio reference checksum mismatch'
[ -x /usr/local/sbin/myron-attempt79-module-dir ] || fail 'GKI module selector is unavailable'
[ -d /usr/local/lib/myron-wireless ] || fail 'wireless assets are unavailable'
[ -d /usr/local/lib/myron-stock-modules ] || fail 'stock module closure is unavailable'
[ ! -e /run/myron-wireless-ready ] || fail 'radio/Wi-Fi foundation already started this boot'
check_asset "$module_dir/rmnet_mem.ko" 45cb69314b667f2e7980464f2ad1baec18070bf02eb0e2f50ae4cfc05890a7d5
check_asset "$module_dir/gsim.ko" 3b3b276ee395f5872b6cdd40d6d3db17e79f2153ed4e7c9d5338e2053de1e918
check_asset "$module_dir/ipam.ko" b7bee9eca09a826e9837aa3ebd0be487a6f97f1fe0a29365f0c44b8136eac512

# Consume the per-boot arm before the first module or remoteproc operation.
mv "$arm" "$consumed"
exec /bin/sh "$source_script"
