#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu

log=/var/log/myron-omarchy-hardware-test.log
gpu=/usr/local/lib/myron-gpu
touch=/usr/local/lib/myron-touch
expected_notes=8ba2b05e346c638d699e16d4b782378e394bba374a12b16abacc1b905cb8d608

say() { printf '%s\n' "$*" | tee -a "$log"; }
die() { say "ERROR: $*" >&2; exit 1; }
load() {
  name=$1 path=$2
  if [ -d "/sys/module/$name" ]; then
    say "module=$name state=already-loaded"
  else
    timeout 30 insmod "$path" >>"$log" 2>&1 || die "module failed: $name"
    say "module=$name state=loaded"
  fi
}
node_from_class() {
  class_file=$1 target=$2 group=$3 mode=$4
  [ -r "$class_file" ] || die "device class file missing: $class_file"
  numbers=$(cat "$class_file")
  case "$numbers" in *:*) ;; *) die "invalid device numbers: $numbers" ;; esac
  major=${numbers%:*}
  minor=${numbers#*:}
  case "$major:$minor" in
    *[!0-9:]*|:|*:*:*) die "invalid device numbers: $numbers" ;;
  esac
  target_dir=$(dirname -- "$target")
  mkdir -p "$target_dir"
  [ ! -L "$target_dir" ] && [ -d "$target_dir" ] ||
    die "device path is not a directory: $target_dir"
  if [ -e "$target" ] && [ ! -c "$target" ]; then
    die "device path exists but is not a character device: $target"
  fi
  if [ ! -c "$target" ]; then
    mknod "$target" c "$major" "$minor"
  fi
  actual=$(stat -c '%t:%T' "$target")
  expected=$(printf '%x:%x' "$major" "$minor")
  [ "$actual" = "$expected" ] ||
    die "device numbers differ for $target: $actual, expected $expected"
  chgrp "$group" "$target"
  chmod "$mode" "$target"
}
classify_key() {
  name=$1
  event=
  for candidate in /sys/class/input/event*; do
    [ -r "$candidate/device/name" ] || continue
    [ "$(cat "$candidate/device/name")" = "$name" ] || continue
    event=$candidate
    break
  done
  [ -n "$event" ] || die "input key missing: $name"
  properties=$(udevadm info -q property -p "$event" 2>/dev/null || true)
  if ! printf '%s\n' "$properties" | grep -Fqx ID_INPUT=1 ||
     ! printf '%s\n' "$properties" | grep -Fqx ID_INPUT_KEY=1; then
    numbers=$(cat "$event/dev")
    case "$numbers" in *[!0-9:]*|:*|*::*) die "invalid input numbers: $numbers" ;; esac
    database=/run/udev/data/c$numbers
    [ -f "$database" ] || die "input udev record missing: $name"
    temporary=$(mktemp /run/udev/data/.myron-input.XXXXXX)
    awk '$0 != "E:ID_INPUT=1" && $0 != "E:ID_INPUT_KEY=1"' "$database" >"$temporary"
    printf '%s\n' E:ID_INPUT=1 E:ID_INPUT_KEY=1 >>"$temporary"
    chmod 0644 "$temporary"
    chown root:root "$temporary"
    mv -f "$temporary" "$database"
  fi
  udevadm info -q property -p "$event" | grep -Fqx ID_INPUT=1 ||
    die "input key is not classified: $name"
  udevadm info -q property -p "$event" | grep -Fqx ID_INPUT_KEY=1 ||
    die "input key is not a keyboard: $name"
  say "input=$name state=classified"
}

[ "$(id -u)" = 0 ] || die 'must run as root'
: >"$log"
notes=$(sha256sum /sys/kernel/notes | awk '{print $1}')
[ "$notes" = "$expected_notes" ] || die "kernel notes differ: $notes"
[ "$(cat /sys/class/drm/card0-DSI-1/status 2>/dev/null || true)" = connected ] ||
  die 'DSI-1 is not connected'
/usr/bin/omamobile-myron-gpu-verify verify-layout >>"$log" 2>&1 ||
  die 'isolated Mesa layout verification failed'

for name in gen80200_aqe.fw gen80200_gmu.bin gen80200_sqe.fw gen80200_zap.mbn; do
  install -Dm0644 "$gpu/firmware/$name" "/usr/lib/firmware/$name"
done
load governor_gpubw_mon "$gpu/modules/governor_gpubw_mon.ko"
load gpu_stats "$gpu/modules/gpu_stats.ko"
load msm_sysstats "$gpu/modules/msm_sysstats.ko"
load msm_kgsl "$gpu/modules/msm_kgsl.ko"

attempt=0
while [ ! -r /sys/class/kgsl/kgsl-3d0/dev ] && [ "$attempt" -lt 100 ]; do
  attempt=$((attempt + 1))
  sleep 0.1
done
[ -r /sys/class/kgsl/kgsl-3d0/dev ] || die 'KGSL class device missing'
node_from_class /sys/class/kgsl/kgsl-3d0/dev /dev/kgsl-3d0 video 0660

# This downstream kernel publishes the generic DMA heap in sysfs but does not
# create either userspace node under Arch.  Turnip/Zink needs the canonical
# node; libcamera and some Vulkan clients also use the historical DRI alias.
# Keep both nodes bound to the exact same kernel class device, matching the
# reference postmarketOS helper without loading or changing any kernel module.
attempt=0
while [ ! -r /sys/class/dma_heap/system/dev ] && [ "$attempt" -lt 100 ]; do
  attempt=$((attempt + 1))
  sleep 0.1
done
[ -r /sys/class/dma_heap/system/dev ] || die 'system DMA-heap class device missing'
install -d -m0755 /dev/dma_heap
node_from_class /sys/class/dma_heap/system/dev /dev/dma_heap/system video 0660
node_from_class /sys/class/dma_heap/system/dev /dev/dri/dmaheap-sys video 0660

load xiaomi_touch "$touch/xiaomi_touch.ko"
load focaltech_touch_3683 "$touch/focaltech_touch_3683.ko"
touch_raw_control=/sys/devices/virtual/touch/touch_dev/enable_touch_raw
attempt=0
while [ ! -w "$touch_raw_control" ] && [ "$attempt" -lt 50 ]; do
  attempt=$((attempt + 1))
  sleep 0.1
done
[ -w "$touch_raw_control" ] || die 'touch raw-mode control missing'
printf '%s\n' 0 >"$touch_raw_control"
[ "$(cat "$touch_raw_control")" = 0 ] || die 'touch raw mode remains enabled'
udevadm control --reload
udevadm trigger --action=add --subsystem-match=input >>"$log" 2>&1 || true
udevadm settle --timeout=20 >>"$log" 2>&1 || die 'input udev settle failed'
classify_key pmic_pwrkey
classify_key pmic_resin
touch_event=
for event in /sys/class/input/event*; do
  [ -r "$event/device/name" ] || continue
  [ "$(cat "$event/device/name")" = focaltech_ts ] || continue
  touch_event=/dev/input/${event##*/}
  break
done
[ -n "$touch_event" ] && [ -c "$touch_event" ] || die 'FocalTech touch node missing'

if id sddm >/dev/null 2>&1; then
  usermod -aG video,render,input sddm
fi
udevadm control --reload
udevadm trigger --action=add --subsystem-match=drm >>"$log" 2>&1 || true

# Match the proven postmarketOS hardware-control contract. These downstream
# sysfs attributes are recreated root-only on every boot, so package-time
# ownership is not enough. Keep screen brightness with the graphical `video`
# group and the physically verified rear torch with the `input` group.
backlight=/sys/class/backlight/panel0-backlight/brightness
torch=/sys/class/leds/amber:flash-2/brightness
for item in "$backlight" "$torch"; do
  attempt=0
  while [ ! -e "$item" ] && [ "$attempt" -lt 100 ]; do
    attempt=$((attempt + 1))
    sleep 0.1
  done
  [ -e "$item" ] || die "hardware control missing: $item"
done
chgrp video "$backlight"
chmod 0664 "$backlight"
chgrp input "$torch"
chmod 0664 "$torch"
[ "$(stat -c '%a:%G' "$backlight")" = 664:video ] ||
  die 'panel backlight lost the video-group contract'
[ "$(stat -c '%a:%G' "$torch")" = 664:input ] ||
  die 'rear torch lost the input-group contract'
say 'controls=ready backlight=panel0-backlight torch=amber:flash-2'

touch /run/myron-omarchy-hardware-ready
say "result=ready notes=$notes dsi=DSI-1 kgsl=/dev/kgsl-3d0 dma_heap=/dev/dma_heap/system touch=$touch_event raw_mode=disabled"
