#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

runtime=/usr/local/lib/myron-charging
expected_manifest=49defb95564adc88f2922562fe6a04a0255f8dda07047f71cdc0fa2b78aaace0

[ -d "$runtime" ] && [ ! -L "$runtime" ] || die 'charging runtime is missing or linked'
for program in linker64 batterysecret; do
  [ -f "$runtime/bin/$program" ] && [ ! -L "$runtime/bin/$program" ] &&
    [ -x "$runtime/bin/$program" ] || die "charging program is invalid: $program"
done
[ -f "$runtime/lib64/libmyron-properties.so" ] &&
  [ ! -L "$runtime/lib64/libmyron-properties.so" ] || die 'property shim is invalid'
[ -f "$runtime/SHA256SUMS" ] && [ ! -L "$runtime/SHA256SUMS" ] ||
  die 'charging integrity manifest is invalid'

actual_manifest=$(sha256sum "$runtime/SHA256SUMS" | awk '{print $1}')
[ "$actual_manifest" = "$expected_manifest" ] || die 'charging integrity manifest differs'
(cd "$runtime" && sha256sum -c SHA256SUMS >/dev/null) ||
  die 'charging runtime integrity check failed'

export LD_LIBRARY_PATH="$runtime/lib64"
export LD_PRELOAD="$runtime/lib64/libmyron-properties.so"
exec "$runtime/bin/linker64" "$runtime/bin/batterysecret"
