#!/bin/sh
# SPDX-License-Identifier: MIT
# One-shot WCN786x bring-up for the temporary Myron hardware-test boot.
set -eu
umask 077

readonly expected_kernel=6.12.23-android16-5-g5a0e85dd9db0-dirty-4k
readonly probe=/usr/local/sbin/myron-bluetooth-qca-probe
readonly probe_sha=4a9d4da29c7ef46f4dcb08385e4c5ff85b16344884d4239c40b53923c5258608
readonly btpower=/usr/local/lib/myron-audio/modules/btpower.ko
readonly btpower_sha=3280aab7f8f07f6f7b4ec032c68852951d0d76b73ed25b799728cdc55ccdb39a
readonly btpower_vermagic='6.12.23-android16-5-maybe-dirty-4k SMP preempt mod_unload modversions aarch64'
readonly patch_sha=6631fe3562dbb329e2be19f157c55ae8600e24643de3dd8feb2524e21af77b0a
readonly nvm_sha=669b8a7e03660fad976b48a58871759a8e5188f2b3b32e73419fd170710af763
readonly runtime_dir=/run/myron-bluetooth
readonly firmware_dir=/usr/local/lib/myron-bluetooth-firmware
readonly bluez_state_dir=/var/lib/bluetooth
readonly profile_file=/etc/omamobile/myron-test-profile
readonly foundation_ready=/run/myron-bluetooth-foundation-ready
readonly pidfile=$runtime_dir/btattach.pid
readonly transport_log=$runtime_dir/btattach.log
readonly scan_raw=$runtime_dir/scan.raw
readonly arm=/run/omamobile-myron/bluetooth-stage.armed
readonly consumed=/run/omamobile-myron/bluetooth-stage.armed.consumed
readonly state=/run/myron-host/var/lib/omarchy-mobile/bluetooth-stage.state
readonly log=/run/myron-host/var/log/myron-omarchy-bluetooth-stage.log
readonly disarm=/run/myron-host/var/lib/omarchy-mobile/hardware-test.disarm
readonly maximum_safe_temperature_mc=80000
readonly reviewed_kernel_notes=8ba2b05e346c638d699e16d4b782378e394bba374a12b16abacc1b905cb8d608
readonly no_reset_kernel_notes=dadfc0372f028cd5c9810415167af6c182e79fbf2954e7c555a8a1108cf33e1e
readonly address_kernel_notes=0ecd0f4eb2f6ab7c073ef2f2afd94e4185ac404b2b01a04a666188d63f029db8
boot_id=
profile_name=
module_dir=
rfkill_sha=
pwrseq_sha=
bluetooth_sha=
btbcm_sha=
btqca_sha=
hci_uart_sha=
scan_command_fifo=
scan_client_pid_file=
scan_supervisor_pid=
scan_supervisor_start=
scan_client_pid=
scan_client_start=
scan_writer_pid_file=
scan_writer_pid=
scan_writer_start=
scan_writer_child_pid=
scan_writer_child_start=
scan_before_file=
scan_after_file=
scan_new_file=
scan_filter_file=
thermal_root=/sys/class/thermal

persist() {
	mkdir -p "$(dirname "$log")"
	if [ -f "$log" ] && [ "$(wc -c <"$log")" -gt 131072 ]; then
		tail -n 200 "$log" >"$log.new"
		chmod 0600 "$log.new"
		mv -f "$log.new" "$log"
	fi
	printf '%s boot_id=%s %s\n' "$(date -u +%FT%TZ)" "${boot_id:-unknown}" "$*" >>"$log"
	sync -f "$log" 2>/dev/null || sync
}

write_state() {
	value=$1
	tmp=$state.tmp.$$
	printf '%s\n' "$value" >"$tmp"
	chmod 0600 "$tmp"
	mv -f "$tmp" "$state"
	sync -f "$state" 2>/dev/null || sync
}

read_state() { cat "$state" 2>/dev/null || true; }

fail() {
	persist "result=failed message=$*"
	printf 'ERROR: %s\n' "$*" >&2
	printf '%s\n' 'Do not retry Bluetooth in this boot. Run myron-bluetooth-stage stop.' >&2
	exit 1
}

check_hash() {
	path=$1 expected=$2
	[ -f "$path" ] && [ ! -L "$path" ] && [ -s "$path" ] || fail "missing regular asset: $path"
	[ "$(sha256sum "$path" | awk '{print $1}')" = "$expected" ] ||
		fail "asset checksum mismatch: $path"
}

check_size() {
	path=$1 expected=$2
	[ "$(stat -c %s "$path" 2>/dev/null || true)" = "$expected" ] ||
		fail "asset size mismatch: $path"
}

hottest_temperature() {
	hottest=0
	hottest_type=unknown
	valid_sensors=0
	for file in "$thermal_root"/thermal_zone*/temp; do
		[ -r "$file" ] || continue
		type=$(timeout -k 1 2 cat "${file%/temp}/type" 2>/dev/null) || continue
		[ -n "$type" ] || continue
		case "$type" in *-trip-*) continue ;; esac
		value=$(timeout -k 1 2 cat "$file" 2>/dev/null) || continue
		case "$value" in ''|*[!0-9]*) continue ;; esac
		[ "$value" -gt 0 ] && [ "$value" -lt 200000 ] || continue
		valid_sensors=$((valid_sensors + 1))
		[ "$value" -le "$hottest" ] || {
			hottest=$value
			hottest_type=$type
		}
	done
	[ "$valid_sensors" -gt 0 ] || return 1
	printf '%s %s %s\n' "$hottest" "$hottest_type" "$valid_sensors"
}

require_temperature() {
	if ! reading=$(hottest_temperature); then
		persist 'stage=temperature result=failed reason=temperature-unavailable'
		fail 'temperature sensors are unavailable'
	fi
	value=${reading%% *}
	reading=${reading#* }
	sensor=${reading%% *}
	valid_sensors=${reading#* }
	persist "stage=temperature maximum_mc=$value sensor=$sensor valid_sensors=$valid_sensors"
	[ "$value" -lt "$maximum_safe_temperature_mc" ] ||
		fail "temperature safety limit reached: $value mC"
}

ensure_char_node() {
	class_path=$1 node=$2 mode=$3 group=$4
	[ -r "$class_path/dev" ] || fail "missing device numbers: $class_path/dev"
	dev_numbers=$(cat "$class_path/dev")
	[ -c "$node" ] || mknod "$node" c "${dev_numbers%:*}" "${dev_numbers#*:}"
	chown root:"$group" "$node"
	chmod "$mode" "$node"
}

select_modules() {
	[ -x /usr/local/sbin/myron-attempt79-module-dir ] || fail 'GKI module selector is unavailable'
	notes=$(sha256sum /sys/kernel/notes | awk '{print $1}')
	case "$notes" in
		"$reviewed_kernel_notes")
			rfkill_sha=9763ae41ffbd54aee4c7ad273c079382a3caebbc9a6e02e400bbf5a67a036ec4
			pwrseq_sha=07f9444f4428f4c2b4bf5acb6e853cb19449cdf2019e93828401af037db6a037
			bluetooth_sha=873580abdd6070c26bb42611c23d3021880dfe9fe4bdc46efa73ffe9a8c09ec8
			btbcm_sha=b064c8d29a55c32f499bdb57c45bfb1372df4eda2f8af2529431fe0a8eca1194
			btqca_sha=0e40983eaaa5e2e5d9a500ecf98bbbde6ad8a304fef44b8a1452c91c9b8c0ad2
			hci_uart_sha=22b406e625966f3d1e1b3986959ad4aec05ca775d8fc29f06e643528e82c3885
			;;
		"$no_reset_kernel_notes")
			rfkill_sha=d3a6012ca3d5ed9bd4206c89f63307e3628c0bf7ec6a4984466b6acc4515062d
			pwrseq_sha=370e2aa12fd38b6d2cdd07ced278db188999db23cfaa06aeebf8242bf4221ce8
			bluetooth_sha=71c0f671766db94ff4c99192080b0ce61a4d6c19ae2b5fd00c7572230266ecc6
			btbcm_sha=65263ac496b52dcca12bf0fb7e1cf03d526364a7b240db3f671e935b155ad7bc
			btqca_sha=4fd712e0ff268b8b0e76568142addbee9673e50cd5166072fb0508128f4e2de4
			hci_uart_sha=f8cb374be40f03b504426025c45ec898dffcf7668ccb5ed8026b07d60d6596cb
			;;
		"$address_kernel_notes")
			rfkill_sha=e2f17221a319f2234a49b4cf809a84867e3e3ef14e22d9bfd393f547e290c47d
			pwrseq_sha=162ca5072e040d0690a12b863eef837f0b74a5f6d9380484f32106b883b37c12
			bluetooth_sha=5919b022e564c869fcb8eb9e00f4c6f4a2a88e9d04471396dc4b137a3145e269
			btbcm_sha=23b81995ffd03242fb12b35d9cd5d756de5aeb3851d6df27c7550ddc6f4647b6
			btqca_sha=9f6e1feeb4b74a0f1b2cbf45c5fa09feabd663d8601999b27627d5807e34e164
			hci_uart_sha=676f88f5cdf0f2cddcdc12c3d0b91748c341b74f0f195ca9c40216c8f3e515c5
			;;
		*) fail "unreviewed Bluetooth kernel notes: $notes" ;;
	esac
	module_dir=$(/usr/local/sbin/myron-attempt79-module-dir) || fail 'GKI module selection failed'
	[ -d "$module_dir" ] && [ ! -L "$module_dir" ] || fail 'selected GKI module directory is invalid'
	[ "$module_dir" = "/usr/local/lib/myron-gki-module-sets/$notes" ] ||
		fail 'GKI module selector returned a directory for different kernel notes'
}

load_module() {
	file=$1 name=$2 expected=$3
	path=$module_dir/$file
	check_hash "$path" "$expected"
	[ "$(modinfo -F vermagic "$path" | awk '{print $1}')" = "$expected_kernel" ] ||
		fail "module/kernel release mismatch: $path"
	if [ ! -d "/sys/module/$name" ]; then
		persist "stage=start module=$file action=insmod"
		insmod "$path" || fail "module insertion failed: $file"
		persist "stage=start module=$file result=loaded"
	fi
}

require_common() {
	[ "$(id -u)" = 0 ] || fail 'Bluetooth stage must run as root'
	[ "$(uname -r)" = "$expected_kernel" ] || fail "unexpected kernel release: $(uname -r)"
	[ -d /run/myron-host/var/lib/omarchy-mobile ] || fail 'postmarketOS host state is unavailable'
	profile_name=$(cat "$profile_file" 2>/dev/null || true)
	case "$profile_name" in
		bluetooth)
			[ -s "$foundation_ready" ] || fail 'minimal Bluetooth foundation is not ready'
			[ "$(cat "$foundation_ready")" = minimal-bluetooth-prerequisites ] ||
				fail 'minimal Bluetooth foundation marker is invalid'
			! systemctl --quiet is-active myron-reference-radio.service ||
				fail 'radio foundation must remain inactive in the Bluetooth boot'
			[ ! -e /run/myron-wireless-ready ] ||
				fail 'radio/Wi-Fi readiness must remain absent in the Bluetooth boot'
			[ ! -d /sys/class/net/wlan0 ] ||
				fail 'wlan0 must remain absent in the Bluetooth boot'
			for prerequisite in smem_mailbox cnss_utils; do
				[ -d "/sys/module/$prerequisite" ] ||
					fail "missing minimal Bluetooth prerequisite: $prerequisite"
			done
			;;
		*)
			[ -s /run/myron-wireless-ready ] || fail 'radio/Wi-Fi firmware foundation is not ready'
			systemctl --quiet is-active myron-reference-radio.service ||
				fail 'radio foundation service is not active'
			;;
	esac
	! pgrep -x ModemManager >/dev/null || fail 'ModemManager or GNSS must not run in the Bluetooth boot'
	! grep -q canoe-mtp-snd-card /proc/asound/cards 2>/dev/null ||
		fail 'AudioReach must not run in the Bluetooth boot'
	check_hash "$probe" "$probe_sha"
	check_hash "$btpower" "$btpower_sha"
	[ "$(modinfo -F vermagic "$btpower")" = "$btpower_vermagic" ] ||
		fail 'stock btpower module metadata mismatch'
	select_modules
}

arm_test() {
	[ ! -e /sys/class/bluetooth/hci0 ] || fail 'an HCI controller is already attached'
	! pgrep -x btattach >/dev/null || fail 'an unmanaged btattach process is running'
	! pgrep -x bluetoothd >/dev/null || fail 'an unmanaged BlueZ daemon is running'
	for module in pwrseq_core bluetooth btbcm btqca hci_uart btpower; do
		[ ! -d "/sys/module/$module" ] || fail "Bluetooth module was already loaded: $module"
	done
	systemctl --quiet is-active myron-hardware-watchdog.service ||
		fail 'the independent rollback watchdog is no longer active'
	previous=$(read_state)
	case "$previous" in
		'') ;;
		*:"$boot_id") fail 'Bluetooth test was already armed or started in this boot' ;;
		armed:*|enter:*:*|started:*|failed:*:*|qualified:*|stopped:*)
			persist "stage=arm previous_state=$previous"
			;;
		*) fail 'invalid persistent Bluetooth state' ;;
	esac
	mkdir -p "$(dirname "$arm")"
	printf '%s\n' checkpointed-bluetooth-stage >"$arm"
	chmod 0600 "$arm"
	rm -f "$consumed"
	write_state "armed:$boot_id"
	persist 'stage=arm action=remove-graphical-disarm watchdog=continued'
	rm -f "$disarm"
	sync
	[ ! -e "$disarm" ] || fail 'could not re-arm the rollback watchdog'
	if [ "$profile_name" = bluetooth ]; then
		persist 'stage=arm stabilization=minimal-foundation-begin seconds=10'
		sleep 10
		[ -s "$foundation_ready" ] || fail 'minimal Bluetooth foundation disappeared during stabilization'
		! systemctl --quiet is-active myron-reference-radio.service ||
			fail 'radio foundation started during Bluetooth stabilization'
		[ ! -e /run/myron-wireless-ready ] ||
			fail 'radio/Wi-Fi readiness appeared during Bluetooth stabilization'
		[ ! -d /sys/class/net/wlan0 ] || fail 'wlan0 appeared during Bluetooth stabilization'
		for prerequisite in smem_mailbox cnss_utils; do
			[ -d "/sys/module/$prerequisite" ] ||
				fail "minimal Bluetooth prerequisite disappeared: $prerequisite"
		done
		stable_result='foundation=minimal foundation_stable_seconds=10'
	else
		persist 'stage=arm stabilization=radio-begin seconds=20'
		sleep 20
		systemctl --quiet is-active myron-reference-radio.service ||
			fail 'radio foundation stopped during stabilization'
		[ -s /run/myron-wireless-ready ] || fail 'radio readiness disappeared during stabilization'
		[ -d /sys/class/net/wlan0 ] || fail 'wlan0 did not survive radio stabilization'
		stable_result='radio_stable_seconds=20'
	fi
	require_temperature
	persist "stage=arm result=complete watchdog=continued $stable_result"
	printf 'stage=arm result=complete watchdog=continued %s\n' "$stable_result"
}

require_firmware() {
	[ -d "$firmware_dir" ] && [ ! -L "$firmware_dir" ] ||
		fail 'private Bluetooth firmware directory is missing or linked'
	patch=$firmware_dir/gngbtfw20.mbn
	nvm=$firmware_dir/gngbtnv20.bin
	check_size "$patch" 294052
	check_size "$nvm" 14377
	check_hash "$patch" "$patch_sha"
	check_hash "$nvm" "$nvm_sha"
}

nvm_public_address() {
	nvm=$1
	# Exact pinned file: tag 2 starts at 0x50, has a 12-byte header and a
	# six-byte little-endian Bluetooth public address at offset 0x5c.
	# Intentional word splitting turns the six od octets into positional args.
	# shellcheck disable=SC2046
	set -- $(od -An -v -tx1 -j92 -N6 "$nvm")
	[ "$#" -eq 6 ] || return 1
	for octet in "$@"; do
		case "$octet" in [0-9a-f][0-9a-f]) ;; *) return 1 ;; esac
	done
	case "$1$2$3$4$5$6" in 000000000000|ffffffffffff) return 1 ;; esac
	printf '%s:%s:%s:%s:%s:%s\n' "$6" "$5" "$4" "$3" "$2" "$1"
}

mgmt_has_unconfigured_hci0() {
	LC_ALL=C timeout -k 1 3 btmgmt config 2>/dev/null |
		grep -Eq '^hci0:[[:space:]]+Unconfigured controller$'
}

mgmt_configured_address() {
	LC_ALL=C timeout -k 1 3 btmgmt --index 0 info 2>/dev/null |
		awk '$1 == "addr" && $2 ~ /^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$/ {
			print tolower($2)
			exit
		}'
}

bluez_device_paths() {
	filter_file=$1
	tree_output=$(timeout -k 1 3 busctl --system --list tree org.bluez 2>/dev/null) || return $?
	printf '%s\n' "$tree_output" |
		LC_ALL=C awk '/^\/org\/bluez\/hci0\/dev_[0-9A-Fa-f][0-9A-Fa-f]_[0-9A-Fa-f][0-9A-Fa-f]_[0-9A-Fa-f][0-9A-Fa-f]_[0-9A-Fa-f][0-9A-Fa-f]_[0-9A-Fa-f][0-9A-Fa-f]_[0-9A-Fa-f][0-9A-Fa-f]$/ { print }' \
		>"$filter_file" || return 1
	LC_ALL=C sort -u "$filter_file" || return 1
	rm -f "$filter_file" || return 1
	[ ! -e "$filter_file" ] || return 1
}

fresh_bluez_peer_count() {
	expected_peer=$1
	before_file=$2
	after_file=$3
	new_file=$4
	filter_file=$5
	bluez_device_paths "$filter_file" >"$after_file" || return 1
	LC_ALL=C comm -13 "$before_file" "$after_file" >"$new_file" || return 1
	count=0
	while IFS= read -r object_path; do
		[ -n "$object_path" ] || continue
		property=$(timeout -k 1 3 busctl --system --json=short get-property \
			org.bluez "$object_path" org.bluez.Device1 Name 2>/dev/null) || continue
		if printf '%s\n' "$property" |
			jq -e --arg peer "$expected_peer" \
			'($peer | ascii_downcase) as $needle |
			 (.type == "s" and (.data | type) == "string" and
			  (.data | ascii_downcase | contains($needle)))' >/dev/null 2>&1; then
			count=$((count + 1))
		fi
	done <"$new_file"
	printf '%s\n' "$count"
}

bluetooth_discovering() {
	show_output=$(timeout -k 1 2 bluetoothctl show 2>/dev/null) || return $?
	printf '%s\n' "$show_output" |
		LC_ALL=C awk '$1 == "Discovering:" { print $2; exit }'
}

process_start_time() {
	pid=$1
	case "$pid" in ''|*[!0-9]*) return 1 ;; esac
	[ -r "/proc/$pid/stat" ] || return 1
	awk '{ print $22 }' "/proc/$pid/stat"
}

same_process() {
	pid=$1
	expected_start=$2
	[ -n "$expected_start" ] || return 1
	actual_start=$(process_start_time "$pid" 2>/dev/null) || return 1
	[ "$actual_start" = "$expected_start" ]
}

run_bounded_scan() {
	scan_file=$1
	scan_command_fifo=$scan_file.commands.$$
	scan_client_pid_file=$scan_file.client.$$
	scan_writer_pid_file=$scan_file.writer.$$
	[ ! -e "$scan_command_fifo" ] || return 1
	[ ! -e "$scan_client_pid_file" ] || return 1
	[ ! -e "$scan_writer_pid_file" ] || return 1
	mkfifo -m 0600 "$scan_command_fifo" || return 1
	client_status=0
	writer_status=0
	timeout -k 2 35 sh -c '
		umask 077
		printf "%s\n" "$$" >"$1"
		exec bluetoothctl <"$2"
	' sh "$scan_client_pid_file" "$scan_command_fifo" >"$scan_file" 2>&1 &
	scan_supervisor_pid=$!
	if ! scan_supervisor_start=$(process_start_time "$scan_supervisor_pid"); then
		kill "$scan_supervisor_pid" 2>/dev/null || true
		wait "$scan_supervisor_pid" 2>/dev/null || true
		rm -f "$scan_command_fifo" "$scan_client_pid_file" "$scan_writer_pid_file"
		scan_command_fifo=
		scan_client_pid_file=
		scan_supervisor_pid=
		return 1
	fi
	timeout -k 1 30 sh -c '
		umask 077
		printf "%s\n" "$$" >"$1"
		exec 3>"$2"
		printf "%s\n" "scan bredr" >&3
		sleep 20
		printf "%s\n" "scan off" >&3
		sleep 1
		printf "%s\n" quit >&3
		exec 3>&-
	' sh "$scan_writer_pid_file" "$scan_command_fifo" &
	scan_writer_pid=$!
	if ! scan_writer_start=$(process_start_time "$scan_writer_pid"); then
		kill "$scan_supervisor_pid" "$scan_writer_pid" 2>/dev/null || true
		wait "$scan_supervisor_pid" 2>/dev/null || true
		wait "$scan_writer_pid" 2>/dev/null || true
		rm -f "$scan_command_fifo" "$scan_client_pid_file" "$scan_writer_pid_file"
		scan_command_fifo=
		scan_client_pid_file=
		scan_writer_pid_file=
		scan_supervisor_pid=
		scan_supervisor_start=
		scan_writer_pid=
		return 1
	fi
	tries=0
	while [ "$tries" -lt 20 ] && [ ! -s "$scan_client_pid_file" ]; do
		same_process "$scan_supervisor_pid" "$scan_supervisor_start" || break
		sleep 0.1
		tries=$((tries + 1))
	done
	if [ -s "$scan_client_pid_file" ]; then
		scan_client_pid=$(cat "$scan_client_pid_file")
		if ! scan_client_start=$(process_start_time "$scan_client_pid" 2>/dev/null); then client_status=126; fi
	else
		client_status=126
	fi
	tries=0
	while [ "$tries" -lt 20 ] && [ ! -s "$scan_writer_pid_file" ]; do
		same_process "$scan_writer_pid" "$scan_writer_start" || break
		sleep 0.1
		tries=$((tries + 1))
	done
	if [ -s "$scan_writer_pid_file" ]; then
		scan_writer_child_pid=$(cat "$scan_writer_pid_file")
		if ! scan_writer_child_start=$(process_start_time "$scan_writer_child_pid" 2>/dev/null); then writer_status=126; fi
	else
		writer_status=126
	fi
	client_wait_status=0
	wait "$scan_supervisor_pid" || client_wait_status=$?
	[ "$client_status" -ne 0 ] || client_status=$client_wait_status
	writer_wait_status=0
	wait "$scan_writer_pid" || writer_wait_status=$?
	[ "$writer_status" -ne 0 ] || writer_status=$writer_wait_status
	if same_process "$scan_client_pid" "$scan_client_start"; then client_status=125; fi
	if same_process "$scan_writer_child_pid" "$scan_writer_child_start"; then writer_status=125; fi
	scan_cleanup_status=0
	stop_scan_children || scan_cleanup_status=$?
	[ "$client_status" -eq 0 ] && [ "$writer_status" -eq 0 ] && [ "$scan_cleanup_status" -eq 0 ]
}

stop_scan_children() {
	scan_teardown_ok=1
	tracked=
	for pair in \
		"$scan_supervisor_pid:$scan_supervisor_start" \
		"$scan_client_pid:$scan_client_start" \
		"$scan_writer_pid:$scan_writer_start" \
		"$scan_writer_child_pid:$scan_writer_child_start"; do
		parent=${pair%%:*}
		start=${pair#*:}
		case "$parent:$start" in :*|*[!0-9:]*|*:) continue ;; esac
		same_process "$parent" "$start" || continue
		tracked="$tracked $parent:$start"
		children=/proc/$parent/task/$parent/children
		if [ -r "$children" ]; then
			for child in $(cat "$children"); do
				child_start=$(process_start_time "$child" 2>/dev/null || true)
				[ -n "$child_start" ] && tracked="$tracked $child:$child_start"
			done
		fi
	done
	for pair in $tracked; do
		pid=${pair%%:*}; start=${pair#*:}
		same_process "$pid" "$start" && kill "$pid" 2>/dev/null || true
	done
	count=0
	while [ "$count" -lt 20 ]; do
		alive=0
		for pair in $tracked; do
			pid=${pair%%:*}; start=${pair#*:}
			same_process "$pid" "$start" && alive=1
		done
		[ "$alive" -eq 1 ] || break
		sleep 0.1
		count=$((count + 1))
	done
	for pair in $tracked; do
		pid=${pair%%:*}; start=${pair#*:}
		same_process "$pid" "$start" && kill -9 "$pid" 2>/dev/null || true
	done
	case "$scan_supervisor_pid" in ''|*[!0-9]*) ;; *) wait "$scan_supervisor_pid" 2>/dev/null || true ;; esac
	case "$scan_writer_pid" in ''|*[!0-9]*) ;; *) wait "$scan_writer_pid" 2>/dev/null || true ;; esac
	for pair in $tracked; do
		pid=${pair%%:*}; start=${pair#*:}
		same_process "$pid" "$start" && scan_teardown_ok=0
	done
	if [ -n "$scan_command_fifo" ]; then
		if rm -f "$scan_command_fifo" && [ ! -e "$scan_command_fifo" ]; then scan_command_fifo=; else scan_teardown_ok=0; fi
	fi
	if [ -n "$scan_client_pid_file" ]; then
		if rm -f "$scan_client_pid_file" && [ ! -e "$scan_client_pid_file" ]; then scan_client_pid_file=; else scan_teardown_ok=0; fi
	fi
	if [ -n "$scan_writer_pid_file" ]; then
		if rm -f "$scan_writer_pid_file" && [ ! -e "$scan_writer_pid_file" ]; then scan_writer_pid_file=; else scan_teardown_ok=0; fi
	fi
	scan_supervisor_pid=
	scan_supervisor_start=
	scan_client_pid=
	scan_client_start=
	scan_writer_pid=
	scan_writer_start=
	scan_writer_child_pid=
	scan_writer_child_start=
	[ "$scan_teardown_ok" -eq 1 ]
}

stop_internal() {
	cleanup_ok=1
	rm -f /run/myron-bluetooth-ready || cleanup_ok=0
	if rm -f "$scan_raw" && [ ! -e "$scan_raw" ]; then :; else cleanup_ok=0; fi
	if [ -n "$scan_before_file" ]; then
		if rm -f "$scan_before_file" && [ ! -e "$scan_before_file" ]; then scan_before_file=; else cleanup_ok=0; fi
	fi
	if [ -n "$scan_after_file" ]; then
		if rm -f "$scan_after_file" && [ ! -e "$scan_after_file" ]; then scan_after_file=; else cleanup_ok=0; fi
	fi
	if [ -n "$scan_new_file" ]; then
		if rm -f "$scan_new_file" && [ ! -e "$scan_new_file" ]; then scan_new_file=; else cleanup_ok=0; fi
	fi
	if [ -n "$scan_filter_file" ]; then
		if rm -f "$scan_filter_file" && [ ! -e "$scan_filter_file" ]; then scan_filter_file=; else cleanup_ok=0; fi
	fi
	timeout -k 1 3 bluetoothctl scan off >/dev/null 2>&1 || true
	timeout -k 1 3 bluetoothctl power off >/dev/null 2>&1 || true
	# The desktop can D-Bus-activate BlueZ as soon as it stops. This one-shot
	# test never starts a second controller in the same boot, so a runtime-only
	# mask keeps cleanup stable and disappears automatically on reboot.
	timeout -k 1 3 systemctl mask --runtime bluetooth.service >/dev/null 2>&1 || cleanup_ok=0
	timeout -k 2 10 systemctl stop bluetooth.service >/dev/null 2>&1 || true
	service_status=0
	service_state=$(timeout -k 1 3 systemctl is-active bluetooth.service 2>/dev/null) || service_status=$?
	case "$service_status:$service_state" in
		3:inactive|3:failed) ;;
		*) cleanup_ok=0 ;;
	esac
	transport_stopped=0
	if [ -s "$pidfile" ]; then
		pid=
		pid_start=
		read -r pid pid_start <"$pidfile" || true
		case "$pid:$pid_start" in :*|*[!0-9:]*|*:) cleanup_ok=0 ;;
		*)
			if same_process "$pid" "$pid_start"; then
				if [ -r "/proc/$pid/comm" ] && [ "$(cat "/proc/$pid/comm")" = btattach ]; then
					kill "$pid" 2>/dev/null || true
					cleanup_count=0
					while [ "$cleanup_count" -lt 30 ] && same_process "$pid" "$pid_start"; do
						sleep 0.1
						cleanup_count=$((cleanup_count + 1))
					done
					same_process "$pid" "$pid_start" && kill -9 "$pid" 2>/dev/null || true
					cleanup_count=0
					while [ "$cleanup_count" -lt 10 ] && same_process "$pid" "$pid_start"; do
						sleep 0.1
						cleanup_count=$((cleanup_count + 1))
					done
					same_process "$pid" "$pid_start" && cleanup_ok=0 || transport_stopped=1
				else
					cleanup_ok=0
				fi
			else
				transport_stopped=1
			fi
			;;
		esac
	else
		transport_stopped=1
	fi
	if [ "$transport_stopped" -eq 1 ]; then
		if rm -f "$pidfile" && [ ! -e "$pidfile" ]; then :; else cleanup_ok=0; fi
	fi
	if [ -e /sys/module/hci_uart/parameters/qca_preinitialized ]; then
		printf 0 >/sys/module/hci_uart/parameters/qca_preinitialized || true
	fi
	if [ -c /dev/btpower ]; then
		probe_ok=1
		[ -f "$probe" ] && [ ! -L "$probe" ] &&
			[ "$(sha256sum "$probe" | awk '{print $1}')" = "$probe_sha" ] || probe_ok=0
		if [ "$probe_ok" -eq 1 ]; then
			timeout -k 1 5 "$probe" --set-power off >/dev/null 2>&1 || cleanup_ok=0
		else
			cleanup_ok=0
		fi
	fi
	if mountpoint -q "$bluez_state_dir"; then
		timeout -k 1 5 umount "$bluez_state_dir" >/dev/null 2>&1 || cleanup_ok=0
	fi
	[ "$cleanup_ok" -eq 1 ]
}

cleanup_failed_start() {
	status=$?
	trap - 0 HUP INT TERM
	[ "$status" -ne 0 ] || return 0
	scan_cleanup_status=0
	stop_scan_children || scan_cleanup_status=$?
	if stop_internal && [ "$scan_cleanup_status" -eq 0 ]; then cleanup=controller-powered-off; else cleanup=failed; fi
	write_state "failed:start:$boot_id"
	persist "stage=start result=failed cleanup=$cleanup"
	exit "$status"
}

cleanup_failed_scan() {
	status=$?
	trap - 0 HUP INT TERM
	[ "$status" -ne 0 ] || return 0
	scan_cleanup_status=0
	stop_scan_children || scan_cleanup_status=$?
	if stop_internal && [ "$scan_cleanup_status" -eq 0 ]; then cleanup=controller-powered-off; else cleanup=failed; fi
	write_state "failed:scan:$boot_id"
	persist "stage=scan result=failed cleanup=$cleanup"
	exit "$status"
}

start_test() {
	[ "$(read_state)" = "armed:$boot_id" ] || fail 'Bluetooth test is not armed for this boot'
	[ -f "$arm" ] && [ "$(cat "$arm")" = checkpointed-bluetooth-stage ] || fail 'Bluetooth arm marker is invalid'
	[ ! -e /sys/class/bluetooth/hci0 ] || fail 'an unmanaged HCI controller is already attached'
	mv "$arm" "$consumed"
	write_state "enter:start:$boot_id"
	persist 'stage=start result=entered'
	install -d -m0700 "$runtime_dir"
	trap cleanup_failed_start 0
	trap 'exit 130' HUP INT TERM
	require_temperature
	load_module rfkill.ko rfkill "$rfkill_sha"
	load_module pwrseq-core.ko pwrseq_core "$pwrseq_sha"
	load_module bluetooth.ko bluetooth "$bluetooth_sha"
	load_module btbcm.ko btbcm "$btbcm_sha"
	load_module btqca.ko btqca "$btqca_sha"
	load_module hci_uart.ko hci_uart "$hci_uart_sha"
	[ -e /sys/module/hci_uart/parameters/qca_preinitialized ] || fail 'patched hci_uart parameter is absent'
	for prerequisite in cnss_utils qcom_aoss hwid pinctrl_msm rfkill; do
		[ -d "/sys/module/$prerequisite" ] || fail "missing btpower prerequisite: $prerequisite"
	done
	if [ ! -d /sys/module/btpower ]; then
		check_hash "$btpower" "$btpower_sha"
		[ "$(modinfo -F vermagic "$btpower")" = "$btpower_vermagic" ] ||
			fail 'stock btpower module metadata mismatch'
		persist 'stage=start module=btpower.ko action=insmod'
		insmod "$btpower" || fail 'btpower module insertion failed'
		persist 'stage=start module=btpower.ko result=loaded'
	fi
	ensure_char_node /sys/class/misc/rfkill /dev/rfkill 0660 root
	ensure_char_node /sys/class/bt-dev/btpower /dev/btpower 0600 root
	ensure_char_node /sys/class/tty/ttyHS0 /dev/ttyHS0 0600 root
	require_firmware
	patch=$firmware_dir/gngbtfw20.mbn
	nvm=$firmware_dir/gngbtnv20.bin
	persist 'stage=start action=initialize-wcn786x'
	"$probe" --prepare-qca-ibs-after-nvm "$patch" "$nvm" >>"$transport_log" 2>&1 ||
		fail 'WCN786x firmware/NVM initialization failed'
	(
		exec </dev/null >>"$transport_log" 2>&1
		exec btattach -B /dev/ttyHS0 -P qca -S 115200
	) &
	btattach_pid=$!
	btattach_start=$(process_start_time "$btattach_pid" 2>/dev/null || true)
	[ -n "$btattach_start" ] || {
		kill "$btattach_pid" 2>/dev/null || true
		fail 'could not capture btattach process identity'
	}
	printf '%s %s\n' "$btattach_pid" "$btattach_start" >"$pidfile"
	count=0
	while [ "$count" -lt 100 ] && [ ! -e /sys/class/bluetooth/hci0 ]; do
		same_process "$btattach_pid" "$btattach_start" || fail 'btattach exited before creating hci0'
		sleep 0.1
		count=$((count + 1))
	done
	[ -e /sys/class/bluetooth/hci0 ] || fail 'btattach did not create hci0 within 10 seconds'
	deadline=$(( $(awk '{print int($1)}' /proc/uptime) + 15 ))
	while [ "$(awk '{print int($1)}' /proc/uptime)" -lt "$deadline" ]; do
		mgmt_has_unconfigured_hci0 && break
		sleep 0.2
	done
	mgmt_has_unconfigured_hci0 || fail 'hci0 did not reach unconfigured MGMT index state'
	public_address=$(nvm_public_address "$nvm") || fail 'could not parse public address from exact NVM tag 2'
	persist 'stage=start action=configure-public-address source=exact-nvm-tag-2 identity=not-logged'
	timeout -k 1 5 btmgmt --index 0 public-addr "$public_address" >/dev/null 2>&1 ||
		fail 'Bluetooth management API rejected NVM public address'
	deadline=$(( $(awk '{print int($1)}' /proc/uptime) + 15 ))
	while [ "$(awk '{print int($1)}' /proc/uptime)" -lt "$deadline" ]; do
		configured_address=$(mgmt_configured_address || true)
		[ "$configured_address" = "$public_address" ] && break
		sleep 0.2
	done
	configured_address=$(mgmt_configured_address || true)
	[ "$configured_address" = "$public_address" ] ||
		fail 'configured MGMT index did not publish the NVM public address'
	public_address=
	configured_address=
	printf 0 >/sys/module/hci_uart/parameters/qca_preinitialized
	persist 'stage=start result=public-address-configured identity=not-logged'
	[ ! -L "$bluez_state_dir" ] || fail 'BlueZ state directory is linked'
	install -d -m0700 "$bluez_state_dir"
	! mountpoint -q "$bluez_state_dir" || fail 'BlueZ state directory is already a mountpoint'
	mount -t tmpfs -o mode=0700,nosuid,nodev,noexec,size=1m \
		myron-bluetooth-state "$bluez_state_dir" || fail 'could not create volatile BlueZ state'
	persist 'stage=start state=bluez-volatile identities=not-persisted'
	systemctl start bluetooth.service || fail 'BlueZ service failed to start'
	# Controller initialization runs asynchronously after hci0 appears.  The
	# first hardware attempt detached it after only about five seconds, before
	# the HCI command timeout/publication boundary could be observed.  Wait on
	# monotonic uptime for up to 20 seconds, while bounding every D-Bus query.
	deadline=$(( $(awk '{print int($1)}' /proc/uptime) + 20 ))
	while [ "$(awk '{print int($1)}' /proc/uptime)" -lt "$deadline" ]; do
		timeout -k 1 3 bluetoothctl list 2>/dev/null | grep -Fq 'Controller ' && break
		sleep 0.2
	done
	timeout -k 1 3 bluetoothctl list 2>/dev/null | grep -Fq 'Controller ' || fail 'BlueZ did not publish hci0'
	power_attempt=0
	while [ "$power_attempt" -lt 15 ]; do
		if timeout -k 1 5 bluetoothctl power on >/dev/null 2>&1; then break; fi
		power_attempt=$((power_attempt + 1))
		sleep 1
	done
	[ "$power_attempt" -lt 15 ] || fail 'BlueZ could not power the controller within 15 seconds'
	timeout -k 1 3 bluetoothctl show | grep -Fq 'Powered: yes' || fail 'BlueZ did not reach powered state'
	require_temperature
	printf '%s\n' ready >/run/myron-bluetooth-ready
	write_state "started:$boot_id"
	persist 'stage=start result=complete controller=hci0 bluez=powered'
	trap - 0 HUP INT TERM
	printf '%s\n' 'stage=start result=complete controller=hci0 bluez=powered'
}

scan_test() {
	[ "$(read_state)" = "started:$boot_id" ] || fail 'Bluetooth controller was not started by this boot'
	expected_peer=${1:-}
	[ -n "$expected_peer" ] || fail 'scan requires an expected peer name substring'
	printf '%s\n' "$expected_peer" | LC_ALL=C grep -Eq '^[A-Za-z0-9._+ -]+$' ||
		fail 'expected peer name contains unsupported characters'
	trap cleanup_failed_scan 0
	trap 'exit 130' HUP INT TERM
	[ -e /sys/class/bluetooth/hci0 ] && [ -s /run/myron-bluetooth-ready ] || fail 'Bluetooth ready marker or hci0 is missing'
	require_temperature
	scan_before_file=$runtime_dir/scan.before.$$
	scan_filter_file=$runtime_dir/scan.filter.$$
	bluez_device_paths "$scan_filter_file" >"$scan_before_file" ||
		fail 'could not snapshot BlueZ device objects before scan'
	chmod 0600 "$scan_before_file"
	: >"$scan_raw"
	chmod 0600 "$scan_raw"
	status=0
	run_bounded_scan "$scan_raw" || status=$?
	[ "$status" -eq 0 ] || fail "bounded Bluetooth scan failed with status $status"
	deadline=$(( $(awk '{print int($1)}' /proc/uptime) + 5 ))
	discovering=
	while [ "$(awk '{print int($1)}' /proc/uptime)" -lt "$deadline" ]; do
		discovering=$(bluetooth_discovering || true)
		[ "$discovering" = no ] && break
		sleep 0.2
	done
	[ "$discovering" = no ] || fail 'Bluetooth discovery did not stop after scanner exit'
	scan_after_file=$runtime_dir/scan.after.$$
	scan_new_file=$runtime_dir/scan.new.$$
	count=$(fresh_bluez_peer_count "$expected_peer" "$scan_before_file" \
		"$scan_after_file" "$scan_new_file" "$scan_filter_file") ||
		fail 'could not inspect fresh BlueZ device objects'
	[ "$count" -gt 0 ] || fail 'scan produced no fresh structured D-Bus peer object'
	expected_peer=
	rm -f "$scan_raw"
	require_temperature
	stop_internal || fail 'Bluetooth cleanup failed after scan'
	write_state "qualified:$boot_id"
	persist "stage=scan result=complete discovery_objects=$count identities=not-persisted cleanup=powered-off"
	tmp=$disarm.new.$$
	printf 'bluetooth_qualified_boot=%s\ndiscovery_objects=%s\n' "$boot_id" "$count" >"$tmp"
	chmod 0600 "$tmp"
	mv -f "$tmp" "$disarm"
	sync
	trap - 0 HUP INT TERM
	printf 'stage=scan result=complete discovery_objects=%s identities=not-persisted cleanup=powered-off rollback=disarmed\n' "$count"
}

stop_test() {
	stop_internal || fail 'Bluetooth cleanup failed'
	write_state "stopped:$boot_id"
	persist 'stage=stop result=complete controller=powered-off'
	printf '%s\n' 'stage=stop result=complete controller=powered-off'
}

show_status() {
	printf 'boot_id=%s\nstate=%s\n' "$boot_id" "$(read_state)"
	if [ -e /sys/class/bluetooth/hci0 ]; then printf '%s\n' 'hci0=present'; else printf '%s\n' 'hci0=absent'; fi
	printf 'bluez=%s\n' "$(systemctl is-active bluetooth.service 2>/dev/null || true)"
	printf 'watchdog=%s\n' "$(systemctl is-active myron-hardware-watchdog.service 2>/dev/null || true)"
	tail -n 12 "$log" 2>/dev/null || true
}

boot_id=$(cat /proc/sys/kernel/random/boot_id)
command=${1:-status}
case "$command" in
	status) show_status ;;
	arm) require_common; arm_test ;;
	start) require_common; start_test ;;
	scan) require_common; scan_test "${2:-}" ;;
	stop) stop_test ;;
	*) fail 'usage: myron-bluetooth-stage {status|arm|start|scan EXPECTED-PEER|stop}' ;;
esac
