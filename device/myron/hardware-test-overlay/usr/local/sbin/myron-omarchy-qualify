#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu

log=/var/log/myron-omarchy-hardware-test.log
host_state=/run/myron-host/var/lib/omarchy-mobile
stable_seconds=90
deadline_seconds=600

say() { printf '%s\n' "$*" | tee -a "$log"; }
die() { say "ERROR: $*" >&2; exit 1; }
has_fd() {
  pid=$1 wanted=$2
  for fd in /proc/"$pid"/fd/*; do
    [ "$(readlink "$fd" 2>/dev/null || true)" = "$wanted" ] && return 0
  done
  return 1
}

[ -f /run/myron-omarchy-hardware-ready ] || die 'hardware preparation marker missing'
[ -c /dev/dma_heap/system ] || die 'canonical system DMA-heap node missing'
[ -c /dev/dri/dmaheap-sys ] || die 'system DMA-heap DRI alias missing'
[ "$(stat -c '%t:%T' /dev/dma_heap/system)" = "$(stat -c '%t:%T' /dev/dri/dmaheap-sys)" ] ||
  die 'system DMA-heap nodes refer to different devices'
[ "$(stat -c '%a:%G' /dev/dma_heap/system)" = 660:video ] ||
  die 'canonical system DMA-heap permissions differ'
[ "$(cat /sys/devices/virtual/touch/touch_dev/enable_touch_raw 2>/dev/null || true)" = 0 ] ||
  die 'touch raw mode is not disabled'
elapsed=0
pid=
while [ "$elapsed" -lt "$deadline_seconds" ]; do
  candidate=$(pgrep -xo Hyprland 2>/dev/null || true)
  if [ -n "$candidate" ] && kill -0 "$candidate" 2>/dev/null; then
    pid=$candidate
    break
  fi
  sleep 2
  elapsed=$((elapsed + 2))
done
[ -n "$pid" ] || die 'Hyprland did not start within 600 seconds'
say "hyprland_pid=$pid state=observed"
owner=$(stat -c %U "/proc/$pid")
runuser -u "$owner" -- test -r /dev/dma_heap/system ||
  die 'Hyprland user cannot read the system DMA heap'
runuser -u "$owner" -- test -w /dev/dma_heap/system ||
  die 'Hyprland user cannot write the system DMA heap'

stable=0
while [ "$stable" -lt "$stable_seconds" ]; do
  [ "$(pgrep -xo Hyprland 2>/dev/null || true)" = "$pid" ] ||
    die 'Hyprland exited or restarted during stability window'
  sleep 5
  stable=$((stable + 5))
done

[ "$(cat /sys/class/drm/card0-DSI-1/status 2>/dev/null || true)" = connected ] ||
  die 'DSI-1 disconnected'
has_fd "$pid" /dev/dri/card0 || die 'Hyprland lacks DRM card0'
has_fd "$pid" /dev/dri/renderD128 || die 'Hyprland lacks renderD128'
has_fd "$pid" /dev/kgsl-3d0 || die 'Hyprland lacks KGSL device'
grep -Fq '/usr/lib/omamobile/myron-gpu/' "/proc/$pid/maps" ||
  die 'Hyprland did not map isolated Myron Mesa'
if grep -Eqi 'llvmpipe|swrast' "/proc/$pid/maps"; then
  die 'software renderer mapped into Hyprland'
fi

runtime=$(tr '\0' '\n' <"/proc/$pid/environ" | sed -n 's/^XDG_RUNTIME_DIR=//p')
[ -n "$runtime" ] || die 'Hyprland runtime environment missing'
signature=
for instance in "$runtime"/hypr/*; do
  [ -d "$instance" ] && [ -S "$instance/.socket.sock" ] &&
    [ "$(sed -n '1p' "$instance/hyprland.lock" 2>/dev/null || true)" = "$pid" ] || continue
  signature=${instance##*/}
  break
done
[ -n "$signature" ] || die 'Hyprland IPC instance missing'
wayland=$(sed -n '2p' "$runtime/hypr/$signature/hyprland.lock" 2>/dev/null || true)
case "$wayland" in wayland-[0-9]*) ;; *) die 'Hyprland Wayland socket metadata missing' ;; esac
[ -S "$runtime/$wayland" ] || die 'Hyprland Wayland socket missing'
monitor_json=$(XDG_RUNTIME_DIR="$runtime" HYPRLAND_INSTANCE_SIGNATURE="$signature" hyprctl -j monitors 2>>"$log") ||
  die 'hyprctl monitors failed'
printf '%s\n' "$monitor_json" >>"$log"
printf '%s\n' "$monitor_json" | grep -Eq '"name"[[:space:]]*:[[:space:]]*"DSI-1"' ||
  die 'Hyprland did not publish DSI-1'
devices_json=$(XDG_RUNTIME_DIR="$runtime" HYPRLAND_INSTANCE_SIGNATURE="$signature" hyprctl -j devices 2>>"$log") ||
  die 'hyprctl devices failed'
printf '%s\n' "$devices_json" >>"$log"
printf '%s\n' "$devices_json" | grep -Eq 'focaltech|touch' ||
  die 'Hyprland did not publish a touch device'

# The compositor itself could render in r4 while native applications failed:
# Turnip had no DMA-heap node and every client swapchain allocation failed.
# Prove a separate Wayland EGL client selects the isolated Adreno stack before
# disarming rollback. Keep detailed output bounded in /run and only append the
# renderer lines to the persistent diagnostic log.
client_log=/run/myron-eglinfo.log
client_status=0
timeout 60 runuser -u "$owner" -- env \
  LD_LIBRARY_PATH=/usr/lib/omamobile/myron-gpu \
  LIBGL_DRIVERS_PATH=/usr/lib/omamobile/myron-gpu/dri \
  MESA_LOADER_DRIVER_OVERRIDE=zink \
  VK_DRIVER_FILES=/usr/lib/omamobile/myron-gpu/freedreno-kgsl.json \
  XDG_RUNTIME_DIR="$runtime" WAYLAND_DISPLAY="$wayland" EGL_PLATFORM=wayland \
  /usr/bin/eglinfo -B >"$client_log" 2>&1 || client_status=$?
case "$client_status" in
  124|137)
  tail -n 80 "$client_log" >>"$log"
  die 'native Wayland EGL client probe timed out'
  ;;
esac
client_wayland_log=/run/myron-eglinfo-wayland.log
awk '
  /^Wayland platform:$/ { capture = 1 }
  capture && /^X11 platform:$/ { exit }
  capture { print }
' "$client_log" >"$client_wayland_log"
[ -s "$client_wayland_log" ] || {
  tail -n 80 "$client_log" >>"$log"
  die 'native Wayland EGL client probe produced no Wayland section'
}
grep -Ei 'renderer|device|version' "$client_wayland_log" | tail -n 40 >>"$log" || true
grep -Eq 'Adreno.*840.*MESA_TURNIP|MESA_TURNIP.*Adreno.*840' "$client_wayland_log" ||
  die 'native Wayland EGL client did not report Adreno 840 Turnip'
if grep -Eqi 'llvmpipe|swrast' "$client_wayland_log"; then
  die 'native Wayland EGL client selected software rendering'
fi
[ "$client_status" -eq 0 ] ||
  say "client_egl_exit=$client_status state=unrelated-platform-failure-accepted"

mkdir -p "$host_state"
printf 'qualified_pid=%s\nstable_seconds=%s\n' "$pid" "$stable_seconds" \
  >"$host_state/hardware-test.disarm.new"
chmod 0600 "$host_state/hardware-test.disarm.new"
mv -f "$host_state/hardware-test.disarm.new" "$host_state/hardware-test.disarm"
sync "$host_state"
say "result=qualified dsi=DSI-1 renderer=isolated-zink-turnip client_egl=adreno840 dma_heap=ready stable_seconds=$stable_seconds rollback=disarmed"
