[Unit]
Description=Myron protected PipeWire speaker sink
After=pipewire.service pipewire-pulse.service wireplumber.service
Requires=pipewire-pulse.service wireplumber.service

[Service]
Type=simple
ExecStart=/usr/local/bin/myron-speaker-sink
Restart=on-failure
RestartSec=2
TimeoutStopSec=10

# Deliberately no [Install] section. Root bridge activation remains attended.
