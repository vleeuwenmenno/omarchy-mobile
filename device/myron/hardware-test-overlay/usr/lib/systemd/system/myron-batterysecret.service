[Unit]
Description=Authenticate the Myron battery for kernel-managed PD/PPS charging
Requires=myron-omarchy-prepare.service
After=local-fs.target myron-omarchy-prepare.service
Before=display-manager.service
ConditionPathExists=/run/myron-host/var/lib/omarchy-mobile/hardware-test.armed
ConditionPathExists=/usr/local/lib/myron-charging/SHA256SUMS

[Service]
Type=simple
ExecStart=/usr/local/sbin/myron-batterysecret-start
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
