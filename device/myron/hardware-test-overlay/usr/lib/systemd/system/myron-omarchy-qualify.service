# SPDX-License-Identifier: MIT
[Unit]
Description=Qualify native Hyprland and disarm Myron rollback watchdog
Requires=myron-omarchy-prepare.service myron-coexistence.service
After=myron-omarchy-prepare.service myron-coexistence.service display-manager.service sshd.service
ConditionPathExists=/run/myron-host/var/lib/omarchy-mobile/hardware-test.armed

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/myron-omarchy-qualify
TimeoutStartSec=12min

[Install]
WantedBy=multi-user.target
