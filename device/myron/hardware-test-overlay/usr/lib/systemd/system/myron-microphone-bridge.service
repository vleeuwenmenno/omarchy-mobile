# SPDX-License-Identifier: MIT
[Unit]
Description=Attended Myron AudioReach microphone bridge
After=myron-reference-audio-foundation.service
Conflicts=myron-speaker-bridge.service
ConditionPathExists=/usr/bin/agmcap

[Service]
Type=simple
ExecStartPre=/usr/local/sbin/myron-microphone-prepare
ExecStart=/usr/local/sbin/myron-microphone-bridge
TimeoutStopSec=10

# Deliberately no [Install] section. Microphone activation is explicit.
