[Unit]
Description=Attended Myron radio and Wi-Fi foundation test
ConditionPathExists=/run/omamobile-myron/radio-backup-verified
Requires=myron-omarchy-prepare.service myron-hardware-watchdog.service
After=local-fs.target systemd-udevd.service myron-omarchy-prepare.service myron-hardware-watchdog.service
Before=NetworkManager.service ModemManager.service display-manager.service myron-omarchy-qualify.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/myron-reference-radio-start
RemainAfterExit=yes
TimeoutStartSec=180

# Deliberately no [Install] section. Start only from attended test runbook.
