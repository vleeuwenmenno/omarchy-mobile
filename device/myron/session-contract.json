  "kind": "myron-synthetic-session-contract",
  "kit_snapshot_reverified": false,
  "limitations": [
    "synthetic input adaptation only: the fixture bytes were never read from a phone",
    "collector validation proves structure and cross-checks only, not that any value is true",
    "R2 is a synthetic projection, not a GPT binary parse",
    "R3 image summaries (every offset, size, hash and coverage range) and the R4 selection are explicit claims in this adapter, not parsed from image or device-tree bytes (no image or device-tree parser is used here)",
    "R3 coverage and hash values are unverified-source-claims: full-image coverage proves no provenance or hardware freshness, and metadata-only coverage leaves payload, padding and EOF unverified",
    "R5 order is the fixture file order, not historical load chronology",
    "R7 command line and bootconfig are deliberately narrow projections, not full parsers",
    "bytes_read is fixture accounting only: it counts consumed fixture payload bytes (the R3 summary file), never R3 coverage bytes and never hardware bytes",
    "the collector, preflight, snapshot and deployment imports are trusted version-pinned dependencies, not fully byte-pinned execution",
    "the session contract pins the session implementation bytes; the collector implementation is bound only through the capture contract",
    "each gather is an internally validated descriptor-read snapshot of the exact bytes consumed, not an atomic filesystem snapshot: the caller-owned source can diverge after any file's final observation, a writable shared mapping can change bytes without changing metadata, and a later verify against a changed source rejects",
    "a concurrent mutation first observable after payload traversal can consume bounded bytes (at most 4 MiB) before rejection; zero payload bytes is promised only for a defect detected before traversal"
  ],
  "live": false,
  "non_goals": [
    "real acquisition from a device",
    "live transport of any kind",
    "hardware evidence",
    "authorization of any read, deployment or boot",
    "closing any blocker",
    "device-format qualification: no GPT, Android boot image or device-tree parser is implemented"
  ],
  "output": {
    "accounting": {
      "bytes_read": "exact-consumed-fixture-payload-bytes",
      "excludes": [
        "reads.json",
        "verification-rereads",
        "r3-coverage-bytes",
        "hardware-bytes"
      ],
      "future_hardware_accounting": [
        "actual-returned-bytes",
        "rereads-counted-separately",
        "overreads-counted-separately"
      ],
      "hardware_transport": "none",
      "meaning": "fixture-accounting-only",
      "operation_inputs": {
        "R1-identity-and-slot": [
          "r1-source-a.json",
          "r1-source-b.json"
        ],
        "R2-gpt-and-recovery-inventory": [
          "r2-partitions.json"
        ],
        "R3-boot-image-headers": [
          "r3-header-summaries.json"
        ],
        "R4-dtb-dtbo-selection": [
          "r4-selection.json"
        ],
        "R5-module-load-order": [
          "r5-modules.tsv"
        ],
        "R6-storage-and-mount-model": [
          "r6-filesystem.json"
        ],
        "R7-kernel-identity-revalidation": [
          "r7-release.txt",
          "r7-notes.bin",
          "r7-cmdline.txt",
          "r7-bootconfig.txt"
        ]
      },
      "r3_coverage_bytes": "unverified-source-claims-not-bytes-read",
      "read_domain": "fixture"
    },
    "closure": {
      "checksums": {
        "covers": "every file except SHA256SUMS itself",
        "path": "SHA256SUMS",
        "sufficient_for_verification": false
      },
      "directories": [
        "capture",
        "capture/operations"
      ],
      "extra_entries": "reject",
      "files": [
        "SHA256SUMS",
        "capture/capture.json",
        "capture/operations/R1-identity-and-slot.json",
        "capture/operations/R2-gpt-and-recovery-inventory.json",
        "capture/operations/R3-boot-image-headers.json",
        "capture/operations/R4-dtb-dtbo-selection.json",
        "capture/operations/R5-module-load-order.json",
        "capture/operations/R6-storage-and-mount-model.json",
        "capture/operations/R7-kernel-identity-revalidation.json",
        "manifest.json",
        "rehearsal.json"
      ]
    },
    "deterministic": true,
    "kind": "myron-synthetic-rehearsal",
    "manifest_kind": "myron-synthetic-rehearsal-manifest",
    "published": "atomic-no-replace",
    "verification": "recompute-from-request-and-reads-byte-for-byte"
  },
