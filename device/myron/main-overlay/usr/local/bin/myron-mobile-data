#!/bin/sh
# SPDX-License-Identifier: MIT
# Unprivileged, read-mostly mobile-data interface of the persistent Myron main
# boot, for the quick-settings tile. It tells the truth about what the main
# boot can do today:
#
#   state   key=value lines for tile-state.sh: data=on|off|none, data_status,
#           data_enable=0|1 (a tap may start the operation), data_busy=0|1
#           (a tap does nothing now)
#   on      gate active: stops the packet-gate unit (removes the block). Bearer
#           live and ungated: no-op. Otherwise starts the one user-initiated
#           operation unit; root re-checks the attended evidence, the
#           supervisor and every gate. Allowed only when state says
#           data_enable=1 or a live bearer has the gate to remove.
#   off     live bearer: starts myron-mobile-data-block.service, which drops
#           packets on the already-active qmapmux netdev. It never disconnects,
#           reconnects or reconfigures the modem, IPA, NetworkManager or radio.
#           Already blocked or no bearer: no-op. Any unknown, stale or
#           in-transition state refuses.
#
# data_enable=1 means a tap can act now; data_busy=1 means a transition or an
# unknown state, where a tap does nothing.
#
# The modem is read only through ModemManager keys (state, registration,
# access technology): no identity field is read or printed. The operation's
# state is the supervisor's world-readable public file, and a file that is
# missing, from another boot or malformed reads as "status unavailable", never
# as "no modem" and never as permission.
set -u

public_file=/run/myron-cellular/state
boot_id_file=/proc/sys/kernel/random/boot_id
enable_unit=myron-cellular-enable.service
block_unit=myron-mobile-data-block.service
audio_experiment=/etc/omamobile/myron-audio-experiment
cellular_audio_experiment=/etc/omamobile/myron-cellular-audio-experiment
modem_prefix=/org/freedesktop/ModemManager1/Modem/

t() { timeout 2 "$@" 2>/dev/null; }

pub() { sed -n "s/^$1=//p" "$public_file" 2>/dev/null | sed -n '1p'; }

# Sets: modems (count, or unknown), registered (yes|no), tech (word).
read_modem() {
	modems=unknown registered=no tech=
	listing=$(t mmcli -L) || return 0
	paths=$(printf '%s\n' "$listing" | grep -o "${modem_prefix}[0-9][0-9]*" | sort -u)
	modems=$(printf '%s\n' "$paths" | grep -c . || true)
	[ "$modems" = 1 ] || return 0
	info=$(t mmcli -m "$(printf '%s\n' "$paths" | sed -n '1p')" -K) || { modems=unknown; return 0; }
	reg=$(printf '%s\n' "$info" | awk -F' *: *' '$1 == "modem.3gpp.registration-state" { print $2; exit }')
	[ "$reg" = home ] && registered=yes
	techs=$(printf '%s\n' "$info" | awk -F' *: *' '$1 ~ /^modem[.]generic[.]access-technologies[.]value/ { print $2 }')
	case " $techs " in
	*' 5gnr '*) tech=5G ;;
	*' lte '*) tech=LTE ;;
	esac
}

# Sets: op (idle|starting|on|restart|unknown) and evidence (valid|absent|invalid).
read_public() {
	op=unknown evidence=absent
	[ -r "$public_file" ] || return 0
	current=$(cat "$boot_id_file" 2>/dev/null || true)
	[ -n "$current" ] && [ "$(pub boot_id)" = "$current" ] || return 0
	case $(pub state) in
	idle) op=idle ;;
	starting) op=starting ;;
	on) op=on ;;
	restart) op=restart ;;
	*) return 0 ;;
	esac
	case $(pub evidence) in valid) evidence=valid ;; invalid) evidence=invalid ;; *) evidence=absent ;; esac
}

# Sets: gate (active|inactive|activating|deactivating|failed|unknown), the
# owned packet-gate service's own state; anything unexpected reads as unknown.
read_gate() {
	gate=unknown
	out=$(t systemctl show -p LoadState -p ActiveState "$block_unit") || return 0
	[ "$(printf '%s\n' "$out" | sed -n 's/^LoadState=//p')" = loaded ] || return 0
	case $(printf '%s\n' "$out" | sed -n 's/^ActiveState=//p') in
	active) gate=active ;;
	inactive) gate=inactive ;;
	activating) gate=activating ;;
	deactivating) gate=deactivating ;;
	failed) gate=failed ;;
	esac
}

compute() {
	read_modem
	read_public
	read_gate
	data=off enable=0 busy=0 note=
	if [ "$modems" = 0 ]; then
		data=none note='No modem'
		return 0
	fi
	if [ "$modems" != 1 ]; then
		busy=1 note='Modem status unavailable'
		return 0
	fi
	label=${tech:+ $tech}
	case $op in
	unknown) busy=1 note='Status unavailable'; return 0 ;;
	starting) busy=1 note='Starting'; return 0 ;;
	restart) busy=1 note='Restart to retry'; return 0 ;;
	esac
	# The supervisor's own failures above always win over the gate. From here
	# the bearer is live (on) or absent (idle).
	case $gate in
	activating | deactivating) busy=1 note='Switching'; return 0 ;;
	failed | unknown) busy=1 note='Packet gate unavailable'; return 0 ;;
	esac
	if [ "$op" = on ]; then
		if [ "$gate" = active ]; then
			note="Off${label:+ ·$label}"
		else
			data=on note="On${label:+ ·$label}"
		fi
		enable=1
		return 0
	fi
	# idle: a gate left on a bearer that is gone is stale; only a restart or
	# the operator clears it.
	if [ "$gate" = active ]; then
		busy=1 note='Packet gate stale'
	elif [ "$evidence" != valid ]; then
		note='Needs attended setup'
	elif [ "$registered" != yes ]; then
		note='Not registered'
	else
		enable=1 note="Off${label:+ ·$label}"
	fi
}

cmd_state() {
	compute
	printf 'data=%s\ndata_status=%s\ndata_enable=%s\ndata_busy=%s\n' "$data" "$note" "$enable" "$busy"
}

audio_blocked() {
	[ -e "$audio_experiment" ] || [ -L "$audio_experiment" ] ||
		[ -e "$cellular_audio_experiment" ] || [ -L "$cellular_audio_experiment" ]
}

refuse_audio() {
	printf '%s\n' 'Mobile data is blocked by the one-shot audio experiment.' >&2
	exit 1
}

case "${1:-}" in
state)
	if audio_blocked; then
		printf '%s\n' 'data=none' 'data_status=Blocked by audio experiment' 'data_enable=0' 'data_busy=1'
	else
		cmd_state
	fi
	;;
on)
	audio_blocked && refuse_audio
	compute
	if [ "$busy" = 1 ] || [ "$modems" != 1 ]; then
		printf 'Mobile data cannot be started now: %s\n' "${note:-unavailable}" >&2
		exit 1
	fi
	if [ "$op" = on ]; then
		[ "$gate" = active ] || exit 0
		exec systemctl stop "$block_unit"
	fi
	[ "$enable" = 1 ] || { printf 'Mobile data cannot be started now: %s\n' "${note:-unavailable}" >&2; exit 1; }
	exec systemctl start --no-block "$enable_unit"
	;;
off)
	audio_blocked && refuse_audio
	compute
	if [ "$busy" = 1 ] || [ "$modems" != 1 ]; then
		printf 'Mobile data cannot be stopped now: %s\n' "${note:-unavailable}" >&2
		exit 1
	fi
	# No live bearer: nothing carries data, so data is already off.
	[ "$op" = on ] || exit 0
	[ "$gate" != active ] || exit 0
	exec systemctl start "$block_unit"
	;;
*)
	printf 'usage: %s state|on|off\n' "${0##*/}" >&2
	exit 2
	;;
esac
