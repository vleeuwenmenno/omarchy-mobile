# SPDX-License-Identifier: MIT
# The user-initiated cellular data operation of the persistent main boot, for
# an image that already has valid attended evidence. The stage re-checks the
# evidence as root; this unit trusts nothing from its starter. Never enabled;
# polkit lets only active local user menno start exactly this unit.
[Unit]
Description=User-initiated main cellular data operation
After=myron-cellular.service NetworkManager.service
ConditionPathExists=/run/myron-main/boot-id
OnFailure=myron-cellular-op-failed.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/myron-cellular-stage main-run qualified
TimeoutStartSec=1100
