#!/bin/bash
# SPDX-License-Identifier: MIT
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT

bash -n PKGBUILD install || fail "scripts parse"
grep -Eq '^provides=\(omamobile-apps\)$' PKGBUILD || fail "provider is missing"
grep -Eq '^conflicts=\(omamobile-apps\)$' PKGBUILD || fail "generic app profile is not excluded"
grep -Eq '^depends=\(gnome-maps geoclue\)$' PKGBUILD || fail "safe app dependencies differ"
if grep -Eq '^[[:space:]]*(omacam|neard|libcamera|libcamera-ipa|pipewire-libcamera)([[:space:])]|$)' PKGBUILD; then
  fail "unqualified camera or NFC dependency present"
fi
pass "provider selects Maps and GeoClue without camera or NFC"

./install "$tmp/root"
printf '%s\n' \
  usr/share/doc/omamobile-apps-myron/README.md \
  usr/share/licenses/omamobile-apps-myron/LICENSE \
  usr/share/omamobile/apps-myron/version > "$tmp/expected"
(cd "$tmp/root" && find . -type f -print | sed 's#^\./##' | sort) > "$tmp/actual"
cmp -s "$tmp/expected" "$tmp/actual" || fail "package stages unexpected files"
pass "package stages inert metadata only"
