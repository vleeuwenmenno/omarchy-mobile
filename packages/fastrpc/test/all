set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
bash -n PKGBUILD
grep -Fq 'd247519650fe5cb16de6c78edaa95bcc4be25073' PKGBUILD
grep -Fq -- '--with-systemdsystemunitdir=/usr/lib/systemd/system' PKGBUILD
