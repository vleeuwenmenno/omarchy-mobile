# Derived from Arch Linux's ModemManager PKGBUILD:
# https://gitlab.archlinux.org/archlinux/packaging/packages/modemmanager
#
# Myron keeps the upstream qcom-soc plugin and layers only the downstream IPA
# and LOC behavior already qualified on postmarketOS.  The service remains
# disabled/masked by the hardware-test image until an attended test enables it.

pkgbase=modemmanager
pkgname=(
  modemmanager
  libmm-glib
)
pkgver=1.25.95.r20261005
pkgrel=2
pkgdesc="Mobile broadband modem management service (Myron downstream Qualcomm support)"
url="https://www.freedesktop.org/wiki/Software/ModemManager/"
arch=(aarch64)
license=(
  GPL-2.0-or-later
  LGPL-2.1-or-later
)
depends=(
  bash
  glib2
  glibc
  hicolor-icon-theme
  libgcc
  libgudev
  libmbim
  'libqmi>=1.38.0.r20261005'
  libqrtr-glib
  mobile-broadband-provider-info
  polkit
  ppp
  systemd-libs
)
makedepends=(
  bash-completion
  glib2-devel
  gobject-introspection
  gtk-doc
  meson
  systemd
  vala
)
checkdepends=(
  python-dbus
  python-gobject
)
_commit=d776ea38d29ca472a12323c1d45002ee19a66f57
_archive="ModemManager-$_commit"
_myron_patches=(
  0002-qmi-fix-loc-error-path-log-object.patch
  0003-qmi-serialize-pdc-config-info-requests.patch
  0004-qcom-soc-infer-rmnet-ipa-driver.patch
  0005-qcom-soc-read-rmnet-ipa-endpoints.patch
  0006-qcom-soc-propagate-rmnet-ipa-details.patch
  0007-qcom-soc-recognize-driverless-qmapmux-links.patch
  0008-qcom-soc-configure-rmnet-ipa-datapath.patch
  0009-qmi-identify-loc-client-as-afw.patch
  0010-qmi-loc-operation-mode-response.patch
  0011-netlink-fix-transaction-use-after-free.patch
)
source=(
  "$_archive.tar.gz::https://gitlab.freedesktop.org/mobile-broadband/ModemManager/-/archive/$_commit/$_archive.tar.gz"
  "${_myron_patches[@]}"
)
