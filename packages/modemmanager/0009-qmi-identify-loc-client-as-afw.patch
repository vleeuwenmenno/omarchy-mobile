+static void
+loc_location_position_report_indication_cb (QmiClientLoc                         *client,
+                                            QmiIndicationLocPositionReportOutput *output,
+                                            MMSharedQmi                          *self)
+{
+    g_autoptr(GDateTime) now = NULL;
+    g_autofree gchar    *body = NULL;
+    g_autofree gchar    *nmea = NULL;
+    QmiLocSessionStatus  status;
+    GArray              *satellites = NULL;
+    gdouble              latitude;
+    gdouble              longitude;
+    gdouble              latitude_abs;
+    gdouble              longitude_abs;
+    guint                latitude_degrees;
+    guint                longitude_degrees;
+    gdouble              latitude_minutes;
+    gdouble              longitude_minutes;
+    gfloat               altitude = 0.0f;
+    gfloat               hdop = 0.0f;
+    gboolean             altitude_known;
+    gboolean             hdop_known;
+    gchar                latitude_minutes_str[G_ASCII_DTOSTR_BUF_SIZE];
+    gchar                longitude_minutes_str[G_ASCII_DTOSTR_BUF_SIZE];
+    gchar                altitude_str[G_ASCII_DTOSTR_BUF_SIZE] = "";
+    gchar                hdop_str[G_ASCII_DTOSTR_BUF_SIZE] = "";
+    guint8               checksum = 0;
+    gsize                i;
+    Private             *priv;
+
+    if (!qmi_indication_loc_position_report_output_get_session_status (output, &status, NULL) ||
+        status != QMI_LOC_SESSION_STATUS_SUCCESS ||
+        !qmi_indication_loc_position_report_output_get_latitude (output, &latitude, NULL) ||
+        !qmi_indication_loc_position_report_output_get_longitude (output, &longitude, NULL) ||
+        !isfinite (latitude) || !isfinite (longitude) ||
+        latitude < -90.0 || latitude > 90.0 ||
+        longitude < -180.0 || longitude > 180.0)
+        return;
+
+    priv = get_private (MM_SHARED_QMI (self));
+    qmi_indication_loc_position_report_output_get_satellites_used (output, &satellites, NULL);
+    altitude_known = qmi_indication_loc_position_report_output_get_altitude_from_sealevel (output, &altitude, NULL);
+    hdop_known = qmi_indication_loc_position_report_output_get_dop (output, NULL, &hdop, NULL, NULL);
+
+    latitude_abs = fabs (latitude);
+    longitude_abs = fabs (longitude);
+    latitude_degrees = (guint) floor (latitude_abs);
+    longitude_degrees = (guint) floor (longitude_abs);
+    latitude_minutes = (latitude_abs - latitude_degrees) * 60.0;
+    longitude_minutes = (longitude_abs - longitude_degrees) * 60.0;
+
+    g_ascii_formatd (latitude_minutes_str, sizeof (latitude_minutes_str), "%09.6f", latitude_minutes);
+    g_ascii_formatd (longitude_minutes_str, sizeof (longitude_minutes_str), "%09.6f", longitude_minutes);
+    if (altitude_known)
+        g_ascii_formatd (altitude_str, sizeof (altitude_str), "%.1f", altitude);
+    if (hdop_known)
+        g_ascii_formatd (hdop_str, sizeof (hdop_str), "%.1f", hdop);
+
+    now = g_date_time_new_now_utc ();
+    body = g_strdup_printf ("GPGGA,%02d%02d%02d.00,%02u%s,%c,%03u%s,%c,1,%02u,%s,%s,M,,M,,",
+                            g_date_time_get_hour (now),
+                            g_date_time_get_minute (now),
+                            g_date_time_get_second (now),
+                            latitude_degrees,
+                            latitude_minutes_str,
+                            latitude < 0.0 ? 'S' : 'N',
+                            longitude_degrees,
+                            longitude_minutes_str,
+                            longitude < 0.0 ? 'W' : 'E',
+                            MIN (satellites ? satellites->len : 0, 99u),
+                            hdop_str,
+                            altitude_str);
+    for (i = 0; body[i]; i++)
+        checksum ^= (guint8) body[i];
+    nmea = g_strdup_printf ("$%s*%02X", body, checksum);
+
+    mm_obj_dbg (self, "LOC position report converted to GGA (%u satellites)",
+                satellites ? satellites->len : 0);
+    mm_iface_modem_location_gps_update (MM_IFACE_MODEM_LOCATION (self), nmea);
+    mm_location_cache_update_from_nmea (priv->location_cache, nmea);
+}
