From: Menno <menno@localhost>
Subject: [PATCH] qmi: serialize PDC config info requests

Some QRTR modem endpoints reset the connection when all carrier
configuration detail requests are submitted concurrently. Keep one request
in flight and refresh the progress timeout after each valid indication.

--- a/src/mm-shared-qmi.c
+++ b/src/mm-shared-qmi.c
@@ -3029,6 +3029,22 @@
 }
 
 static void
+request_next_config_info (LoadCarrierConfigContext *ctx)
+{
+    ConfigInfo                                *config;
+    g_autoptr(QmiMessagePdcGetConfigInfoInput) input = NULL;
+
+    g_assert (ctx->config_list);
+    g_assert (ctx->configs_loaded < ctx->config_list->len);
+
+    config = &g_array_index (ctx->config_list, ConfigInfo, ctx->configs_loaded);
+    input = qmi_message_pdc_get_config_info_input_new ();
+    qmi_message_pdc_get_config_info_input_set_type_with_id_v2 (input, config->config_type, config->id, NULL);
+    qmi_message_pdc_get_config_info_input_set_token (input, config->token, NULL);
+    qmi_client_pdc_get_config_info (ctx->client, input, 10, NULL, NULL, NULL); /* ignore response! */
+}
+
+static void
 get_config_info_indication (QmiClientPdc                        *client,
                             QmiIndicationPdcGetConfigInfoOutput *output,
                             GTask                               *task)
@@ -3086,9 +3102,17 @@
     current_config->description = g_strdup (description);
     ctx->configs_loaded++;
 
-    /* If not all loaded, wait for more */
-    if (ctx->configs_loaded < ctx->config_list->len)
+    /* Keep only one request in flight. Some QRTR endpoints reset when all
+     * configuration details are requested at once. */
+    if (ctx->configs_loaded < ctx->config_list->len) {
+        if (ctx->timeout_id)
+            g_source_remove (ctx->timeout_id);
+        ctx->timeout_id = g_timeout_add_seconds (LOAD_CARRIER_CONFIG_STEP_TIMEOUT_SECS,
+                                                 (GSourceFunc) load_carrier_config_timeout,
+                                                 task);
+        request_next_config_info (ctx);
         return;
+    }
 
     /* Go on */
     load_carrier_config_context_cleanup_action (ctx);
@@ -3150,7 +3174,6 @@
     for (i = 0; i < configs->len; i++) {
         ConfigInfo                                      *current_info;
         QmiIndicationPdcListConfigsOutputConfigsElement *element;
-        g_autoptr(QmiMessagePdcGetConfigInfoInput)       input = NULL;
 
         element = &g_array_index (configs, QmiIndicationPdcListConfigsOutputConfigsElement, i);
 
@@ -3158,12 +3181,9 @@
         current_info->token       = ctx->token++;
         current_info->id          = g_array_ref (element->id);
         current_info->config_type = element->config_type;
-
-        input = qmi_message_pdc_get_config_info_input_new ();
-        qmi_message_pdc_get_config_info_input_set_type_with_id_v2 (input, element->config_type, current_info->id, NULL);
-        qmi_message_pdc_get_config_info_input_set_token (input, current_info->token, NULL);
-        qmi_client_pdc_get_config_info (ctx->client, input, 10, NULL, NULL, NULL); /* ignore response! */
     }
+
+    request_next_config_info (ctx);
 }
 
 static void
