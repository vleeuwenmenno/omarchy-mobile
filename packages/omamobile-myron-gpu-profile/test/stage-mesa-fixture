#!/bin/bash
# SPDX-License-Identifier: MIT
# Stage a synthetic, structurally exact AArch64 Mesa payload for offline tests.
set -euo pipefail
root=${1:?usage: stage-mesa-fixture ROOT}
[[ $root == /* && $root != / ]] || { echo "ROOT must be an absolute staging directory" >&2; exit 1; }
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
prefix=$root/usr/lib/omamobile/myron-gpu
mkdir -p "$prefix/dri" "$root/usr/share/omamobile/myron-gpu"
python3 - "$prefix" <<'PY'
from pathlib import Path
import hashlib
import json
import sys

prefix = Path(sys.argv[1])
names = [
    "dri/libdril_dri.so",
    "libEGL.so.1.0.0",
    "libGLESv2.so.2.0.0",
    "libgallium-26.2.2.so",
    "libgbm.so.1.0.0",
    "libvulkan_freedreno.so",
]
header = bytearray(64)
header[:6] = b"\x7fELF\x02\x01"
header[18:20] = (183).to_bytes(2, "little")
for name in names:
    path = prefix / name
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(header + name.encode())
(prefix / "freedreno-kgsl.json").write_text(json.dumps({
    "ICD": {
        "api_version": "1.4.354",
        "library_arch": "64",
        "library_path": "/usr/lib/omamobile/myron-gpu/libvulkan_freedreno.so",
    },
    "file_format_version": "1.0.1",
}, indent=4, sort_keys=True) + "\n")
links = {
    "dri/zink_dri.so": "libdril_dri.so",
    "libEGL.so": "libEGL.so.1",
    "libEGL.so.1": "libEGL.so.1.0.0",
    "libGLESv2.so": "libGLESv2.so.2",
    "libGLESv2.so.2": "libGLESv2.so.2.0.0",
    "libgbm.so": "libgbm.so.1",
    "libgbm.so.1": "libgbm.so.1.0.0",
}
for name, target in links.items():
    (prefix / name).symlink_to(target)
regular = ["freedreno-kgsl.json", *names]
(prefix / "SHA256SUMS").write_text("".join(
    f"{hashlib.sha256((prefix / name).read_bytes()).hexdigest()}  {name}\n"
    for name in regular
))
PY
if [[ -f $here/../../mesa-myron-zink-turnip/reference.json ]]; then
  cp "$here/../../mesa-myron-zink-turnip/reference.json" \
    "$root/usr/share/omamobile/myron-gpu/reference.json"
else
  python3 - "$root/usr/share/omamobile/myron-gpu/reference.json" <<'PY'
from pathlib import Path
import json
import sys

Path(sys.argv[1]).write_text(json.dumps({
    "activation": {"mode": "disabled", "system_loader_registration": False},
    "build": {},
    "package": {
        "name": "mesa-myron-zink-turnip",
        "prefix": "/usr/lib/omamobile/myron-gpu",
        "version": "26.2.2",
    },
    "reference": {},
    "schema": 1,
    "source": {},
}) + "\n")
PY
fi
