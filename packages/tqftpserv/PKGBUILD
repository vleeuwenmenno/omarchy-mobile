# Maintainer: Omarchy Mobile contributors
pkgname=tqftpserv
pkgver=1.3
pkgrel=1
pkgdesc="TFTP server over Qualcomm QRTR"
arch=(aarch64)
url="https://github.com/linux-msm/tqftpserv"
license=(BSD-3-Clause)
depends=(glibc qrtr zstd)
makedepends=(meson systemd)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('87a3845e8f47b42f31d8aaad04c5e0707e391b3954d096aeff6f0a03467dc33f')

build() {
  arch-meson "$srcdir/tqftpserv-$pkgver" build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
