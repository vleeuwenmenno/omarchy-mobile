Turnip's KGSL backend cannot read the GPU persistent counter: its
device_get_gpu_timestamp hook is explicitly unimplemented. Do not advertise
the optional calibrated-timestamps extensions on KGSL. Zink then uses its
existing timestamp-query fallback instead of repeatedly calling the missing
hook and logging a misleading VK_ERROR_OUT_OF_HOST_MEMORY.

diff --git a/src/freedreno/vulkan/tu_device.cc b/src/freedreno/vulkan/tu_device.cc
index 8d1f99f..ab8f907 100644
--- a/src/freedreno/vulkan/tu_device.cc
+++ b/src/freedreno/vulkan/tu_device.cc
@@ -207,7 +207,8 @@ get_device_extensions(const struct tu_physical_device *device,
       .KHR_acceleration_structure = has_raytracing,
       .KHR_bind_memory2 = true,
       .KHR_buffer_device_address = true,
-      .KHR_calibrated_timestamps = device->info->props.has_persistent_counter,
+      .KHR_calibrated_timestamps = device->info->props.has_persistent_counter &&
+                                   !is_kgsl(device->instance),
       .KHR_compute_shader_derivatives = true,
       .KHR_copy_commands2 = true,
       // TODO workaround for https://github.com/KhronosGroup/VK-GL-CTS/issues/525
@@ -304,7 +305,8 @@ get_device_extensions(const struct tu_physical_device *device,
       .EXT_attachment_feedback_loop_dynamic_state = true,
       .EXT_attachment_feedback_loop_layout = true,
       .EXT_border_color_swizzle = true,
-      .EXT_calibrated_timestamps = device->info->props.has_persistent_counter,
+      .EXT_calibrated_timestamps = device->info->props.has_persistent_counter &&
+                                   !is_kgsl(device->instance),
       .EXT_color_write_enable = true,
       .EXT_conditional_rendering = true,
       .EXT_conservative_rasterization = device->info->chip >= 7,
