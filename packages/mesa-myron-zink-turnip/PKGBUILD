prepare() {
  cd "mesa-$pkgver"
  patch --fuzz=0 -Np1 < ../zink-sole-pdev.patch
  patch --fuzz=0 -Np1 < ../turnip-kgsl-disable-calibrated-timestamps.patch
}

build() {
  local meson_options=(
    --optimization 2
    --auto-features auto
    -D allow-kcmp=enabled
    -D b_ndebug=true
    -D build-tests=false
    -D egl=enabled
    -D expat=enabled
    -D freedreno-kmds=msm,kgsl
    -D gallium-drivers=zink
    -D gallium-va=disabled
    -D gbm=enabled
    -D gles1=enabled
    -D gles2=enabled
    -D glvnd=disabled
    -D glx=dri
    -D libunwind=disabled
    -D llvm=disabled
    -D lmsensors=disabled
    -D microsoft-clc=disabled
    -D opengl=true
    -D platforms=x11,wayland
    -D selinux=false
    -D shader-cache=enabled
    -D shared-llvm=disabled
    -D valgrind=disabled
    -D video-codecs=
    -D vulkan-drivers=freedreno
    -D vulkan-layers=
    -D xmlconfig=enabled
    -D xlib-lease=enabled
    -D zstd=enabled
  )

  arch-meson "mesa-$pkgver" build "${meson_options[@]}"
  meson compile -C build
}

check() {
  local dril
  dril=$(find build -type f -name libdril_dri.so -print -quit)
  [[ -n "$dril" ]]
  readelf --dyn-syms --wide "$dril" | grep -Fq __driDriverGetExtensions_zink
  "$startdir/test/all"
}

package() {
  local stage="$srcdir/package-stage"
  local prefix="$pkgdir/usr/lib/omamobile/myron-gpu"
  rm -rf "$stage"
  DESTDIR="$stage" meson install -C build --no-rebuild

  install -Dm755 "$stage/usr/lib/libgallium-$pkgver.so" "$prefix/libgallium-$pkgver.so"
  install -Dm755 "$stage/usr/lib/libEGL.so.1.0.0" "$prefix/libEGL.so.1.0.0"
  install -Dm755 "$stage/usr/lib/libGLESv2.so.2.0.0" "$prefix/libGLESv2.so.2.0.0"
  install -Dm755 "$stage/usr/lib/libgbm.so.1.0.0" "$prefix/libgbm.so.1.0.0"
  install -Dm755 "$stage/usr/lib/libvulkan_freedreno.so" "$prefix/libvulkan_freedreno.so"
  install -Dm755 "$stage/usr/lib/dri/libdril_dri.so" "$prefix/dri/libdril_dri.so"
  install -Dm644 "$startdir/freedreno-kgsl.json" "$prefix/freedreno-kgsl.json"

  ln -s libdril_dri.so "$prefix/dri/zink_dri.so"
  ln -s libEGL.so.1.0.0 "$prefix/libEGL.so.1"
  ln -s libEGL.so.1 "$prefix/libEGL.so"
  ln -s libGLESv2.so.2.0.0 "$prefix/libGLESv2.so.2"
  ln -s libGLESv2.so.2 "$prefix/libGLESv2.so"
  ln -s libgbm.so.1.0.0 "$prefix/libgbm.so.1"
  ln -s libgbm.so.1 "$prefix/libgbm.so"

  strip --strip-unneeded \
    "$prefix/libEGL.so.1.0.0" \
    "$prefix/libGLESv2.so.2.0.0" \
    "$prefix/libgallium-$pkgver.so" \
    "$prefix/libgbm.so.1.0.0" \
    "$prefix/dri/libdril_dri.so" \
    "$prefix/libvulkan_freedreno.so"

  (
    cd "$prefix"
    sha256sum \
      freedreno-kgsl.json \
      dri/libdril_dri.so \
      libEGL.so.1.0.0 \
      libGLESv2.so.2.0.0 \
      "libgallium-$pkgver.so" \
      libgbm.so.1.0.0 \
      libvulkan_freedreno.so > SHA256SUMS
  )

  install -Dm755 "$startdir/omamobile-myron-gpu-verify" \
    "$pkgdir/usr/bin/omamobile-myron-gpu-verify"
  install -Dm644 "$startdir/reference.json" \
    "$pkgdir/usr/share/omamobile/myron-gpu/reference.json"
  install -Dm644 "$startdir/README.md" \
    "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$startdir/BUILD-PROVENANCE.md" \
    "$pkgdir/usr/share/doc/$pkgname/BUILD-PROVENANCE.md"
  install -Dm644 "mesa-$pkgver/docs/license.rst" \
    "$pkgdir/usr/share/licenses/$pkgname/license.rst"
}

