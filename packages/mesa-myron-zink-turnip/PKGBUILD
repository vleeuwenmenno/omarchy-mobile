pkgname=mesa-myron-zink-turnip
pkgver=$(cat "${startdir:-.}/version")
pkgrel=1
pkgdesc="Isolated experimental Mesa Zink and Turnip/KGSL stack for Xiaomi myron"
arch=(aarch64)
url="https://www.mesa3d.org/"
license=("MIT AND BSD-3-Clause AND SGI-B-2.0")
depends=(
  expat
  gcc-libs
  glibc
  libdrm
  libx11
  libxcb
  libxext
  libxshmfence
  libxxf86vm
  python
  spirv-tools
  systemd-libs
  vulkan-icd-loader
  wayland
  zlib
  zstd
)
makedepends=(
  bison
  flex
  glslang
  libxdamage
  libxfixes
  libxrandr
  libxml2
  meson
  python-mako
  python-packaging
  python-ply
  python-pycparser
  python-yaml
  vulkan-headers
  wayland-protocols
  xorgproto
)
options=(!lto !strip)
source=(
  "https://archive.mesa3d.org/mesa-$pkgver.tar.xz"{,.sig}
  zink-sole-pdev.patch
  turnip-kgsl-disable-calibrated-timestamps.patch
  freedreno-kgsl.json
  reference.json
  omamobile-myron-gpu-verify
  README.md
  BUILD-PROVENANCE.md
)
validpgpkeys=(
  57551DE15B968F6341C248F68D8E31AFC32428A6 # Eric Engestrom
)
sha512sums=(
