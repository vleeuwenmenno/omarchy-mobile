#!/bin/bash
# SPDX-License-Identifier: MIT
# Phone hardware-key gestures, called by Hyprland binds (hypr/phone.lua), as
# on Android:
#   power, short       unlocked: lock and turn the screen off
#                      locked: screen off if it's on, on (PIN pad) if it's off
#                      screensaver up: lock (it wakes to the PIN pad)
#   power, held 0.6 s  unlocked: Omarchy's system menu, while still held
#                      locked: screen on
#   power + volume down together: screenshot (Omarchy's, full screen)
#   volume down alone   lowers the volume after a 0.15 s wait for power
#   volume up           raises the volume
#   either volume key while the Camera app (omacam) is in front and the phone
#                       is unlocked: take a photo (omacam --remote shutter),
#                       as Android's camera does; held keys take one photo
# Hyprland can't bind a chord of two plain keys or a long press that fires
# while held, so each key reports here and the gesture is worked out from
# when the keys went down. Hyprland cancels power's release bind once another
# key goes down, so the chord acts on its own, not on release.
set -u

state="${XDG_RUNTIME_DIR:-/tmp}/omamobile-keys"
mkdir -p "$state"

now() { date +%s%3N; }

# Keys count as pressed together within this many milliseconds.
window=500
# A press held this long is a long press.
hold=0.6
# Volume down waits this long for power before it lowers the volume.
volume_wait=0.15

recent() {
  [[ -f $state/$1 ]] && (($(now) - $(<"$state/$1") <= window))
}

locked() {
  [[ $(omarchy-shell lock isLocked 2>/dev/null) == "true" ]]
}

# The Camera app is the focused window of an unlocked phone. omacam decides
# itself whether its "volume keys take photos" setting is on.
camera_in_front() {
  command -v omacam >/dev/null || return 1
  [[ $(hyprctl activewindow -j 2>/dev/null | python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("class", ""))
except Exception: print("")') == omacam ]] && ! locked
}

screensaver_up() {
  pgrep -f '[o]rg.omarchy.screensaver' >/dev/null
}

# The panel is off when its backlight's bl_power says so (4); without one,
# ask Hyprland whether the display is powered.
# Light the locked display like a touch on the lock screen would, so its
# blank timer runs again (patches/omarchy/0009); plain "on" otherwise.
wake_locked() {
  if command -v omamobile-display >/dev/null && omamobile-display configured; then
    # Authorize only the physical power-key path. Wake directly before asking
    # the lock to re-arm: an unrelated rejected wake may still be finishing.
    omamobile-display authorize-wake || return
    omarchy-brightness-display on || return
  fi
  [[ $(omarchy-shell lock wake 2>/dev/null) == "ok" ]] || omarchy-brightness-display on
}

screen_off() {
  local device
  device=$(omarchy-hw-display 2>/dev/null)
  if [[ -n $device && -r /sys/class/backlight/$device/bl_power ]]; then
    [[ $(</sys/class/backlight/"$device"/bl_power) != 0 ]]
  else
    ! hyprctl monitors -j 2>/dev/null | jq -e 'all(.dpmsStatus)' >/dev/null
  fi
}

# The chord marker is cleared on power's release, but Hyprland drops that
# release once another key went down, so a marker older than this is stale.
in_chord() {
  [[ -f $state/chord ]] && (($(now) - $(stat -c %Y "$state/chord") * 1000 < 3000))
}

chord() {
  touch "$state/chord"
  # Power's release bind won't fire after the second key, so forget it now:
  # a later volume press on its own must not count as a chord.
  rm -f "$state/power"
  # A moment for the fingers to leave the keys, then Omarchy's screenshot:
  # saved, copied, and a notification with a thumbnail to edit.
  (sleep 0.4; omamobile-pocket active 2>/dev/null || omarchy-capture-screenshot fullscreen) >/dev/null 2>&1 &
}

long_press() {
  omamobile-pocket active 2>/dev/null && return
  touch "$state/long"
  if screen_off || locked; then
    wake_locked
  else
    omarchy-menu toggle system
  fi
}

short_press() {
  if [[ -e $state/pocket-consumed ]]; then
    rm -f "$state/pocket-consumed"
    return
  fi
  if screensaver_up; then
    omarchy-system-lock
    wake_locked
  elif screen_off; then
    wake_locked
  elif locked; then
    if screen_off; then
      wake_locked
    else
      omarchy-brightness-display off
    fi
  else
    # Dark at once, as on Android, but only by the backlight: Omarchy's lock
    # waits for a working screen ("screen-stabilizing"), so powering the panel
    # off first made the lock light it again for a moment. Lock behind the dark
    # panel, then power it off and put the brightness back for the next wake.
    local device level= managed_blackout=0
    device=$(omarchy-hw-display 2>/dev/null)
    if command -v omamobile-display >/dev/null && omamobile-display blackout; then
      managed_blackout=1
    elif [[ -n $device ]]; then
      level=$(brightnessctl -d "$device" get 2>/dev/null)
      brightnessctl -q -d "$device" set 0
    fi
    omarchy-system-lock
    for _ in $(seq 30); do
      omarchy-shell lock status 2>/dev/null | grep -q '"secure":true' && break
      sleep 0.1
    done
    omarchy-brightness-display off
    if (( managed_blackout )); then
      # Keep the panel dark. The coordinated wake precheck supplies its next
      # level; a delayed restore here could overwrite a concurrent wake.
      omamobile-display end-blackout
    else
      [[ -n $level ]] && brightnessctl -q -d "$device" set "$level"
    fi
  fi
}

case "${1:-}" in
  power-down)
    rm -f "$state/chord" "$state/long" "$state/pocket-consumed"
    press=$(now)
    echo "$press" >"$state/power"
    if recent volume-down; then
      chord
    else
      # Long press: still the same press, still held, no chord in between.
      (
        sleep "$hold"
        [[ $(cat "$state/power" 2>/dev/null) == "$press" && ! -f $state/chord ]] && long_press
      ) >/dev/null 2>&1 &
    fi
    ;;
  volume-up)
    press=$(now)
    previous=$(cat "$state/volume-up" 2>/dev/null || echo 0)
    echo "$press" >"$state/volume-up"
    if camera_in_front; then
      # One photo per press: key repeat while held takes no more.
      ((press - previous < 700)) || omacam --remote shutter
    else
      omarchy-audio-output-volume raise
    fi
    ;;
  volume-down)
    press=$(now)
    previous=$(cat "$state/volume-down" 2>/dev/null || echo 0)
    echo "$press" >"$state/volume-down"
    # Power still held, or pressed just before: the screenshot chord.
    if [[ -f $state/power ]]; then
      chord
    # The Camera app in front: a photo, once per press.
    elif camera_in_front; then
      ((press - previous < 700)) || omacam --remote shutter
    # Part of a chord that's still held: no volume change.
    elif in_chord; then
      :
    # Key repeat while held (or a quick second press): lower right away.
    elif ((press - previous < 700)); then
      omarchy-audio-output-volume lower
    # A fresh press: give power a moment to join, then lower the volume.
    else
      (
        sleep "$volume_wait"
        [[ -f $state/power ]] || in_chord || omamobile-pocket active 2>/dev/null || omarchy-audio-output-volume lower
      ) >/dev/null 2>&1 &
    fi
    ;;
  power-up)
    if [[ -f $state/chord ]]; then
      rm -f "$state/chord"
    elif [[ -f $state/long ]]; then
      rm -f "$state/long"
    else
      short_press
    fi
    rm -f "$state/power"
    ;;
  *)
    echo "Usage: omamobile-keys power-down|power-up|volume-down|volume-up" >&2
    exit 1
    ;;
esac
