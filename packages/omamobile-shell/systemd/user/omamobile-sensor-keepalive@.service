# SPDX-License-Identifier: MIT
[Unit]
Description=Continuous %i sensor claim for an opted-in phone
PartOf=graphical-session.target
After=graphical-session.target
ConditionPathExists=/etc/omamobile/sensors-keepalive

[Service]
ExecStart=/usr/bin/omamobile-sensor-keepalive %i
Restart=on-failure
RestartSec=10
TimeoutStopSec=2

[Install]
WantedBy=graphical-session.target
