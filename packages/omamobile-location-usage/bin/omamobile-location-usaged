#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
# omamobile-location-usaged: the location-use observer (lib/daemon.py). Runs
# from the package tree and from a staged tree.
import os
import sys
import warnings

here = os.path.dirname(os.path.realpath(__file__))
for d in (os.path.join(here, "..", "lib"), "/usr/lib/omamobile-location-usage"):
    if os.path.exists(os.path.join(d, "usage_daemon.py")):
        sys.path.insert(0, d)
        break
warnings.filterwarnings("ignore", category=DeprecationWarning)
import usage_daemon  # noqa: E402

sys.exit(usage_daemon.main())
