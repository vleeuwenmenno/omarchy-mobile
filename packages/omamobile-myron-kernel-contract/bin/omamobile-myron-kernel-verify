#!/usr/bin/env python3
"""Verify exact external Myron kernel, module, and runtime-asset inputs."""

from __future__ import annotations

import argparse
import csv
import hashlib
import heapq
import io
import json
import os
from pathlib import Path, PurePosixPath
import re
import stat
import struct
import sys
import tarfile
from typing import NamedTuple


HEX256 = re.compile(r"[0-9a-f]{64}")
FEATURE = re.compile(r"[a-z0-9][a-z0-9-]*")
MODULE = re.compile(r"[a-z0-9][a-z0-9_-]*")
MAX_ARCHIVE_BYTES = 256 * 1024 * 1024
MAX_MANIFEST_BYTES = 4 * 1024 * 1024
MAX_REFERENCE_BYTES = 1024 * 1024
MAX_STAGE_CONTRACT_BYTES = 1024 * 1024
MAX_SCAN_ENTRIES = 200_000
MAX_SCAN_DEPTH = 40
MAX_DIRECTORY_ENTRIES = 10_000
MODULE_SET_ROOT = "/usr/local/lib/myron-gki-module-sets"
STAGE_ANCESTORS = ["/usr", "/usr/local", "/usr/local/lib", "/usr/local/sbin"]
STAGE_SELECTOR_DESTINATION = "/usr/local/sbin/myron-attempt79-module-dir"
STAGE_FORBIDDEN_ABSENT = [
    "/boot", "/efi", "/odm", "/vendor",
    "/usr/lib/firmware", "/usr/local/lib/myron-gpu",
    "/etc/systemd/system", "/usr/lib/systemd/system",
    "/etc/modprobe.d", "/usr/lib/modprobe.d",
    "/etc/modules-load.d", "/usr/lib/modules-load.d",
    "/etc/udev/rules.d", "/usr/lib/udev/rules.d",
    "/etc/pacman.d/hooks", "/usr/share/libalpm/hooks",
    "/etc/vulkan", "/usr/share/vulkan",
]
STAGE_EMPTY_ONLY = ["/usr/lib/modules"]
MODULE_NAME_SUFFIX = re.compile(r"\.ko(\.(gz|xz|zst))?$")


class ContractError(Exception):
    """An input differs from the reviewed contract."""


def strict_json(data: str | bytes, label: str) -> dict:
    def object_pairs(pairs):
        result = {}
        for key, value in pairs:
            if key in result:
                raise ContractError(f"{label} contains duplicate JSON key: {key}")
            result[key] = value
        return result

    try:
        value = json.loads(data, object_pairs_hook=object_pairs)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise ContractError(f"{label} is invalid JSON") from error
    if not isinstance(value, dict):
        raise ContractError(f"{label} must be a JSON object")
    return value


def open_regular(path: Path | str, label: str, *, directory_fd: int | None = None) -> int:
    if not hasattr(os, "O_PATH") or not hasattr(os, "O_NOFOLLOW"):
        raise ContractError("safe regular-file inspection needs O_PATH and O_NOFOLLOW")
    pinned = descriptor = -1
    try:
        pinned = os.open(path, os.O_PATH | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=directory_fd)
        metadata = os.fstat(pinned)
    except OSError as error:
        if pinned >= 0:
            os.close(pinned)
        raise ContractError(f"{label} is unavailable: {path}: {error.strerror}") from error
    if not stat.S_ISREG(metadata.st_mode):
        os.close(pinned)
        raise ContractError(f"{label} is not a regular file: {path}")
    try:
        descriptor = os.open(
            f"/proc/self/fd/{pinned}", os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK
        )
        opened = os.fstat(descriptor)
        if not stat.S_ISREG(opened.st_mode) or (opened.st_dev, opened.st_ino) != (
            metadata.st_dev,
            metadata.st_ino,
        ):
            raise ContractError(f"{label} changed while being opened: {path}")
        return descriptor
    except OSError as error:
        if descriptor >= 0:
            os.close(descriptor)
        raise ContractError(f"{label} cannot be opened safely: {path}: {error.strerror}") from error
    except BaseException:
        if descriptor >= 0:
            os.close(descriptor)
        raise
    finally:
        os.close(pinned)


def sha256_descriptor(
    descriptor: int, label: str, *, expected_size: int | None = None
) -> str:
    digest = hashlib.sha256()
    try:
        size = os.fstat(descriptor).st_size
    except OSError as error:
        os.close(descriptor)
        raise ContractError(f"{label} metadata is unavailable: {error.strerror}") from error
    if expected_size is not None and size != expected_size:
        os.close(descriptor)
        raise ContractError(f"{label} changed size before being read")
    with os.fdopen(descriptor, "rb") as stream:
        remaining = size if expected_size is None else expected_size
        while remaining:
            block = stream.read(min(1024 * 1024, remaining))
            if not block:
                raise ContractError(f"{label} changed size while being read")
            digest.update(block)
            remaining -= len(block)
        if stream.read(1):
            raise ContractError(f"{label} changed size while being read")
    return digest.hexdigest()


def sha256_regular(path: Path, label: str) -> str:
    return sha256_descriptor(open_regular(path, label), label)


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def read_limited_regular(path: Path, label: str, limit: int) -> bytes:
    descriptor = open_regular(path, label)
    with os.fdopen(descriptor, "rb") as stream:
        metadata = os.fstat(stream.fileno())
        if metadata.st_size > limit:
            raise ContractError(f"{label} exceeds the {limit}-byte safety limit")
        data = stream.read(limit + 1)
    if len(data) > limit:
        raise ContractError(f"{label} exceeds the {limit}-byte safety limit")
    return data


def require_hash(path: Path, expected: str, label: str) -> None:
    actual = sha256_regular(path, label)
    if actual != expected:
        raise ContractError(f"{label} SHA-256 differs: expected {expected}, got {actual}")


def safe_member(name: str) -> bool:
    path = PurePosixPath(name)
    return bool(name) and not path.is_absolute() and ".." not in path.parts and "\x00" not in name


def expected_asset_members(reference: dict) -> set[str]:
    assets = reference["module_assets"]
    root = assets["root"]
    fixed = {
        f"{root}/SHA256SUMS",
        f"{root}/candidate-module-dir.sh",
        f"{root}/kernel-notes.bin",
        f"{root}/manifest.json",
        f"{root}/previous-module-dir.sh",
    }
    return fixed | {f"{root}/modules/{name}.ko" for name in assets["modules"]}


def parse_sums(data: bytes) -> dict[str, str]:
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError as error:
        raise ContractError("module SHA256SUMS is not UTF-8") from error
    result: dict[str, str] = {}
    for number, line in enumerate(text.splitlines(), 1):
        if "  " not in line:
            raise ContractError(f"invalid SHA256SUMS line {number}")
        digest, name = line.split("  ", 1)
        if not HEX256.fullmatch(digest) or not safe_member(name) or name in result:
            raise ContractError(f"invalid SHA256SUMS entry on line {number}")
        result[name] = digest
    return result


def validate_reference(reference: dict) -> None:
    expected_top = {
        "schema", "device", "kernel", "source", "module_assets", "runtime_assets",
        "activation", "payload", "provenance",
    }
    if set(reference) != expected_top:
        raise ContractError("reference top-level fields differ")
    if reference.get("schema") != 1:
        raise ContractError("unsupported reference schema")
    if reference.get("device") != {
        "codename": "myron",
        "compatible": "qcom,canoe-mtp",
        "soc": "sm8850",
        "model_contains": "Myron",
        "boot_method": "external-android",
    }:
        raise ContractError("reference does not identify the reviewed Myron target")
    if reference.get("activation") != {
        "mode": "disabled",
        "source_lock_reproduction": "not_verified",
        "device_qualification": "reference_evidence_only",
    }:
        raise ContractError("reference activation must remain disabled")
    if reference.get("payload") != {"kind": "metadata-only"}:
        raise ContractError("reference payload is not metadata-only")
    expected_fields = {
        "kernel": {
            "release", "gki_source_revision", "image_sha256", "notes_sha256",
            "config_sha256", "vmlinux_symvers_sha256", "module_symvers_sha256",
        },
        "module_assets": {
            "archive_sha256", "root", "module_directory",
            "candidate_selector_sha256", "previous_selector_sha256",
            "forbidden_modules", "modules",
        },
        "runtime_assets": {"manifest_sha256"},
        "source": {"lock_sha256", "manifest_sha256", "patches"},
        "provenance": {
            "reference_repository_base_commit", "reference_worktree_state",
            "qualification", "status",
        },
    }
    for section, fields in expected_fields.items():
        if not isinstance(reference.get(section), dict) or set(reference[section]) != fields:
            raise ContractError(f"reference {section} fields differ")
    if not re.fullmatch(r"[0-9a-f]{40}", str(reference["kernel"]["gki_source_revision"])):
        raise ContractError("reference has invalid GKI source revision")
    if not re.fullmatch(r"[0-9a-f]{40}", str(reference["provenance"]["reference_repository_base_commit"])):
        raise ContractError("reference has invalid repository commit")
    source = reference["source"]
    if (
        not HEX256.fullmatch(str(source["lock_sha256"]))
        or not HEX256.fullmatch(str(source["manifest_sha256"]))
        or not isinstance(source["patches"], dict)
        or not source["patches"]
        or any(
            not isinstance(name, str)
            or not re.fullmatch(r"[0-9]{4}-[a-z0-9_-]+\.patch", name)
            or not HEX256.fullmatch(str(digest))
            for name, digest in source["patches"].items()
        )
    ):
        raise ContractError("reference source provenance differs")
    modules = reference["module_assets"]["modules"]
    forbidden = reference["module_assets"]["forbidden_modules"]
    if (
        not isinstance(modules, list)
        or not modules
        or any(not isinstance(name, str) for name in modules)
        or len(modules) != len(set(modules))
        or any(not MODULE.fullmatch(name) for name in modules)
        or not isinstance(forbidden, list)
        or forbidden != ["rmnet_core"]
        or set(modules) & set(forbidden)
    ):
        raise ContractError("reference module allowlist or conflict set differs")
    kernel = reference["kernel"]
    assets = reference["module_assets"]
    if (
        not isinstance(kernel["release"], str)
        or not re.fullmatch(r"[0-9A-Za-z._+-]+", kernel["release"])
        or not isinstance(assets["root"], str)
        or not re.fullmatch(r"[a-z0-9][a-z0-9-]*", assets["root"])
        or assets["module_directory"]
        != f"/usr/local/lib/myron-gki-module-sets/{kernel['notes_sha256']}"
    ):
        raise ContractError("reference release or module-set path differs")
    for section, names in {
        "kernel": (
            "image_sha256",
            "notes_sha256",
            "config_sha256",
            "vmlinux_symvers_sha256",
            "module_symvers_sha256",
        ),
        "module_assets": (
            "archive_sha256",
            "candidate_selector_sha256",
            "previous_selector_sha256",
        ),
        "runtime_assets": ("manifest_sha256",),
    }.items():
        values = reference.get(section)
        if not isinstance(values, dict):
            raise ContractError(f"reference lacks {section}")
        for name in names:
            if not HEX256.fullmatch(str(values.get(name, ""))):
                raise ContractError(f"reference has invalid {section}.{name}")


def read_module_payload_bytes(
    reference: dict, archive_data: bytes, selector_destination: str | None = None
) -> dict[str, bytes]:
    assets = reference["module_assets"]
    kernel = reference["kernel"]
    if not isinstance(archive_data, bytes) or len(archive_data) > MAX_ARCHIVE_BYTES:
        raise ContractError("module asset archive bytes exceed the safety limit")
    actual_archive_hash = sha256_bytes(archive_data)
    if actual_archive_hash != assets["archive_sha256"]:
        raise ContractError(
            "module asset archive SHA-256 differs: "
            f"expected {assets['archive_sha256']}, got {actual_archive_hash}"
        )
    expected = expected_asset_members(reference)
    try:
        with tarfile.open(fileobj=io.BytesIO(archive_data), mode="r:gz") as archive:
            members = archive.getmembers()
            names = [member.name for member in members]
            if len(names) != len(set(names)) or set(names) != expected:
                raise ContractError("module asset archive member set differs")
            if any(not member.isfile() or not safe_member(member.name) for member in members):
                raise ContractError("module asset archive contains a non-file or unsafe member")
            if sum(member.size for member in members) > MAX_ARCHIVE_BYTES:
                raise ContractError("module asset archive expands beyond the safety limit")
            payload: dict[str, bytes] = {}
            root = assets["root"] + "/"
            for member in members:
                stream = archive.extractfile(member)
                if stream is None:
                    raise ContractError(f"cannot read module asset member: {member.name}")
                payload[member.name[len(root):]] = stream.read()
    except (OSError, tarfile.TarError) as error:
        raise ContractError(f"cannot read module asset archive: {error}") from error

    sums = parse_sums(payload["SHA256SUMS"])
    summed_names = set(payload) - {"SHA256SUMS"}
    manifest_names = summed_names - {"manifest.json"}
    if set(sums) != summed_names:
        raise ContractError("module SHA256SUMS member set differs")
    for name, expected_hash in sums.items():
        if sha256_bytes(payload[name]) != expected_hash:
            raise ContractError(f"module asset member hash differs: {name}")

    manifest = strict_json(payload["manifest.json"], "module asset manifest")
    required_manifest = {
        "phase": "inactive-staging-payload-only",
        "candidate_image_sha256": kernel["image_sha256"],
        "candidate_config_sha256": kernel["config_sha256"],
        "candidate_notes_sha256": kernel["notes_sha256"],
        "module_directory": assets["module_directory"],
    }
    for key, value in required_manifest.items():
        if manifest.get(key) != value:
            raise ContractError(f"module asset manifest differs at {key}")
    if manifest.get("files") != {name: sha256_bytes(payload[name]) for name in sorted(manifest_names)}:
        raise ContractError("module asset manifest file hashes differ")
    if sha256_bytes(payload["kernel-notes.bin"]) != kernel["notes_sha256"]:
        raise ContractError("module asset kernel notes differ")
    if sha256_bytes(payload["candidate-module-dir.sh"]) != assets["candidate_selector_sha256"]:
        raise ContractError("candidate module selector differs")
    if sha256_bytes(payload["previous-module-dir.sh"]) != assets["previous_selector_sha256"]:
        raise ContractError("previous module selector differs")
    consumed = manifest.get("selector_destination")
    if selector_destination is not None and (
        not isinstance(consumed, str) or consumed != selector_destination
    ):
        raise ContractError("module asset manifest selector_destination is missing or differs from the stage contract")
    release_marker = b"vermagic=" + kernel["release"].encode("ascii")
    for name in assets["modules"]:
        module = payload[f"modules/{name}.ko"]
        if release_marker + b" " not in module and release_marker + b"\0" not in module:
            raise ContractError(f"module does not carry the exact kernel release: {name}")
    return payload


def read_module_payload(
    reference: dict, archive_path: Path, selector_destination: str | None = None
) -> dict[str, bytes]:
    archive_data = read_limited_regular(
        archive_path, "module asset archive", MAX_ARCHIVE_BYTES
    )
    return read_module_payload_bytes(reference, archive_data, selector_destination)


def verify_module_archive(
    reference: dict, archive_path: Path, selector_destination: str | None = None
) -> dict[str, str]:
    payload = read_module_payload(reference, archive_path, selector_destination)
    return {
        name: sha256_bytes(payload[f"modules/{name}.ko"])
        for name in reference["module_assets"]["modules"]
    }


def verify_kernel_inputs(reference: dict, paths: dict[str, Path]) -> dict:
    validate_reference(reference)
    kernel = reference["kernel"]
    for key, label, expected_key in (
        ("image", "kernel Image", "image_sha256"),
        ("notes", "kernel notes", "notes_sha256"),
        ("config", "kernel configuration", "config_sha256"),
        ("vmlinux_symvers", "vmlinux.symvers", "vmlinux_symvers_sha256"),
        ("module_symvers", "kernel_aarch64_Module.symvers", "module_symvers_sha256"),
    ):
        require_hash(paths[key], kernel[expected_key], label)
    module_hashes = verify_module_archive(reference, paths["assets"])
    return {
        "status": "verified",
        "activation_mode": reference["activation"]["mode"],
        "device": reference["device"]["codename"],
        "kernel_release": kernel["release"],
        "kernel_notes_sha256": kernel["notes_sha256"],
        "module_count": len(module_hashes),
    }


def parse_runtime_manifest(path: Path, expected_hash: str) -> list[dict[str, str]]:
    try:
        data = read_limited_regular(path, "runtime asset manifest", MAX_MANIFEST_BYTES)
        actual_hash = sha256_bytes(data)
        if actual_hash != expected_hash:
            raise ContractError(
                f"runtime asset manifest SHA-256 differs: expected {expected_hash}, got {actual_hash}"
            )
        stream = io.StringIO(data.decode("utf-8"), newline="")
        reader = csv.DictReader(stream, delimiter="\t")
        expected_fields = ["target", "sha256", "provenance", "redistribution", "feature"]
        if reader.fieldnames != expected_fields:
            raise ContractError("runtime asset manifest header differs")
        rows = list(reader)
    except (OSError, UnicodeDecodeError, csv.Error) as error:
        raise ContractError(f"cannot read runtime asset manifest: {error}") from error
    if not rows:
        raise ContractError("runtime asset manifest is empty")
    seen: set[str] = set()
    for number, row in enumerate(rows, 2):
        if set(row) != set(expected_fields) or any(value is None for value in row.values()):
            raise ContractError(f"runtime asset column count differs on line {number}")
        target = row["target"]
        target_path = PurePosixPath(target)
        if (
            not target_path.is_absolute()
            or ".." in target_path.parts
            or target in seen
            or not target.startswith(("/usr/lib/", "/usr/local/", "/usr/sbin/"))
        ):
            raise ContractError(f"unsafe or duplicate runtime target on line {number}")
        if not HEX256.fullmatch(row["sha256"]):
            raise ContractError(f"invalid runtime hash on line {number}")
        if not FEATURE.fullmatch(row["feature"]):
            raise ContractError(f"invalid runtime feature on line {number}")
        if row["provenance"] not in {"stock-extracted", "source-built", "repo-generated"}:
            raise ContractError(f"invalid runtime provenance on line {number}")
        allowed_pair = {
            "stock-extracted": "extract-only",
            "source-built": "build-output",
            "repo-generated": "source",
        }
        if row["redistribution"] != allowed_pair[row["provenance"]]:
            raise ContractError(f"invalid redistribution policy on line {number}")
        seen.add(target)
    return rows


def verify_runtime_assets(reference: dict, manifest_path: Path, root: Path, features: set[str]) -> dict:
    validate_reference(reference)
    rows = parse_runtime_manifest(manifest_path, reference["runtime_assets"]["manifest_sha256"])
    try:
        root = root.resolve(strict=True)
        root_flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK | os.O_DIRECTORY
        if hasattr(os, "O_NOFOLLOW"):
            root_flags |= os.O_NOFOLLOW
        root_descriptor = os.open(root, root_flags)
        if not stat.S_ISDIR(os.fstat(root_descriptor).st_mode):
            os.close(root_descriptor)
            raise ContractError(f"runtime root is not a directory: {root}")
    except OSError as error:
        raise ContractError(f"runtime root is unavailable: {root}: {error.strerror}") from error
    try:
        available = {row["feature"] for row in rows}
        unknown = features - available
        if unknown:
            raise ContractError(f"runtime manifest has no requested feature: {', '.join(sorted(unknown))}")
        selected = rows if not features else [row for row in rows if row["feature"] in features]
        for row in selected:
            parts = PurePosixPath(row["target"]).parts[1:]
            current = os.dup(root_descriptor)
            try:
                directory_flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK | os.O_DIRECTORY
                if hasattr(os, "O_NOFOLLOW"):
                    directory_flags |= os.O_NOFOLLOW
                for part in parts[:-1]:
                    next_descriptor = os.open(part, directory_flags, dir_fd=current)
                    os.close(current)
                    current = next_descriptor
                descriptor = open_regular(
                    parts[-1], f"runtime asset {row['target']}", directory_fd=current
                )
                actual = sha256_descriptor(descriptor, f"runtime asset {row['target']}")
            except OSError as error:
                raise ContractError(
                    f"runtime asset is unavailable or crosses a symlink: {row['target']}: {error.strerror}"
                ) from error
            finally:
                os.close(current)
            if actual != row["sha256"]:
                raise ContractError(f"runtime asset SHA-256 differs: {row['target']}")
    finally:
        os.close(root_descriptor)
    return {
        "status": "verified",
        "activation_mode": reference["activation"]["mode"],
        "device": reference["device"]["codename"],
        "asset_count": len(selected),
        "features": sorted(features or available),
    }


class Contracts(NamedTuple):
    reference: dict
    reference_sha256: str
    stage: dict
    stage_sha256: str


def strict_equal(left, right) -> bool:
    """JSON equality that never treats true/1 or 1.0/1 as the same value."""
    if type(left) is not type(right):
        return False
    if isinstance(left, dict):
        return set(left) == set(right) and all(strict_equal(left[key], right[key]) for key in left)
    if isinstance(left, list):
        return len(left) == len(right) and all(strict_equal(a, b) for a, b in zip(left, right))
    return left == right


def expected_stage_contract(reference: dict, reference_sha256: str) -> dict:
    """Return the only stage contract this reference admits; module data comes from it."""
    assets = reference["module_assets"]
    directory = assets["module_directory"]
    return {
        "schema": 1,
        "reference_sha256": reference_sha256,
        "device": dict(reference["device"]),
        "stage": {
            "kind": "external-kernel-module-stage",
            "mutability": "immutable",
            "activation": "disabled",
            "boot_payload": False,
            "image": False,
            "payload": "metadata-only",
        },
        "layout": {
            "ancestor_directories": list(STAGE_ANCESTORS),
            "module_set_root": MODULE_SET_ROOT,
            "module_directory": directory,
            "owned_directories": [MODULE_SET_ROOT, directory],
            "selector": {
                "archive_member": "candidate-module-dir.sh",
                "destination": STAGE_SELECTOR_DESTINATION,
                "mode": "0755",
            },
            "module_file": {
                "archive_member": "modules/{name}.ko",
                "destination": f"{directory}/{{name}}.ko",
                "mode": "0644",
            },
            "directory_mode": "0755",
        },
        "forbidden": {
            "absent": list(STAGE_FORBIDDEN_ABSENT),
            "empty_or_absent_directories": list(STAGE_EMPTY_ONLY),
            "module_suffixes_outside_owned_files": [".ko", ".ko.gz", ".ko.xz", ".ko.zst"],
        },
    }


def validate_stage_contract(stage: dict, reference: dict, reference_sha256: str) -> None:
    validate_reference(reference)
    if not HEX256.fullmatch(reference_sha256):
        raise ContractError("reference SHA-256 is invalid")
    if stage.get("reference_sha256") != reference_sha256:
        raise ContractError("stage contract is not bound to this reference.json")
    expected = expected_stage_contract(reference, reference_sha256)
    if set(stage) != set(expected):
        raise ContractError("stage contract top-level fields differ")
    for key, value in expected.items():
        if not strict_equal(stage[key], value):
            raise ContractError(f"stage contract differs at {key}")


def build_stage_plan_bytes(contracts: Contracts, archive_data: bytes) -> dict:
    reference, stage = contracts.reference, contracts.stage
    validate_stage_contract(stage, reference, contracts.reference_sha256)
    layout = stage["layout"]
    selector = layout["selector"]
    payload = read_module_payload_bytes(reference, archive_data, selector["destination"])
    template = layout["module_file"]
    sources = [(selector["archive_member"], selector["destination"], selector["mode"])]
    sources += [
        (
            template["archive_member"].format(name=name),
            template["destination"].format(name=name),
            template["mode"],
        )
        for name in reference["module_assets"]["modules"]
    ]
    files = sorted(
        (
            {
                "destination": destination,
                "mode": mode,
                "sha256": sha256_bytes(payload[member]),
                "size": len(payload[member]),
            }
            for member, destination, mode in sources
        ),
        key=lambda entry: entry["destination"],
    )
    return {
        "schema": 1,
        "status": "planned",
        "activation_mode": reference["activation"]["mode"],
        "device": reference["device"]["codename"],
        "kernel_release": reference["kernel"]["release"],
        "reference_sha256": contracts.reference_sha256,
        "stage_contract_sha256": contracts.stage_sha256,
        "archive_sha256": reference["module_assets"]["archive_sha256"],
        "ancestor_directories": list(layout["ancestor_directories"]),
        "directories": [
            {"destination": path, "mode": layout["directory_mode"]}
            for path in layout["owned_directories"]
        ],
        "files": files,
        "forbidden": stage["forbidden"],
    }


def build_stage_plan(contracts: Contracts, archive_path: Path) -> dict:
    archive_data = read_limited_regular(
        archive_path, "module asset archive", MAX_ARCHIVE_BYTES
    )
    return build_stage_plan_bytes(contracts, archive_data)


def stage_flags(*, directory: bool) -> int:
    if not hasattr(os, "O_NOFOLLOW"):
        raise ContractError("stage verification needs O_NOFOLLOW")
    flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK
    return flags | os.O_DIRECTORY if directory else flags


def lstat_at(directory_fd: int, name: str, label: str):
    try:
        return os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
    except FileNotFoundError:
        return None
    except OSError as error:
        raise ContractError(f"{label} is unavailable: {error.strerror}") from error


def mount_id_for_fd(descriptor: int, label: str) -> int:
    """Return Linux mount identity for an open descriptor, or fail closed."""
    try:
        with open(f"/proc/self/fdinfo/{descriptor}", encoding="ascii") as stream:
            for line in stream:
                if line.startswith("mnt_id:"):
                    value = line.split(":", 1)[1].strip()
                    if value.isdecimal() and int(value) > 0:
                        return int(value)
                    break
    except (OSError, UnicodeError) as error:
        raise ContractError(f"{label} mount identity is unavailable: {error}") from error
    raise ContractError(f"{label} mount identity is unavailable")


def require_mount_id(descriptor: int, expected: int, label: str) -> None:
    if mount_id_for_fd(descriptor, label) != expected:
        raise ContractError(f"stage tree crosses a mount point: {label}")


def open_directory_at(
    directory_fd: int, name: str, label: str, *, expected_mount_id: int | None = None
) -> int:
    metadata = lstat_at(directory_fd, name, label)
    if metadata is None:
        raise ContractError(f"{label} is missing")
    if stat.S_ISLNK(metadata.st_mode):
        raise ContractError(f"{label} is a symlink")
    if not stat.S_ISDIR(metadata.st_mode):
        raise ContractError(f"{label} is not a directory")
    try:
        descriptor = os.open(name, stage_flags(directory=True), dir_fd=directory_fd)
    except OSError as error:
        raise ContractError(f"{label} cannot be opened safely: {error.strerror}") from error
    try:
        opened = os.fstat(descriptor)
        if (opened.st_dev, opened.st_ino) != (metadata.st_dev, metadata.st_ino):
            raise ContractError(f"{label} changed while being opened")
        if expected_mount_id is not None:
            require_mount_id(descriptor, expected_mount_id, label)
        return descriptor
    except BaseException:
        os.close(descriptor)
        raise


def open_stage_root(root: str) -> int:
    if not root or "\x00" in root:
        raise ContractError("stage root path is invalid")
    if not os.path.isabs(root):
        raise ContractError("stage root must be an absolute path")
    if root == "/":
        raise ContractError("stage root must not be /")
    components = root.split("/")
    if any(part in (".", "..") for part in components):
        raise ContractError("stage root must not contain . or .. components")
    if any(not part for part in components[1:]):
        raise ContractError("stage root must be a canonical absolute path")
    try:
        current = os.open("/", stage_flags(directory=True))
    except OSError as error:
        raise ContractError(f"cannot open /: {error.strerror}") from error
    walked = ""
    try:
        for part in components[1:]:
            walked += "/" + part
            following = open_directory_at(current, part, f"stage root component {walked}")
            os.close(current)
            current = following
        metadata, top = os.fstat(current), os.stat("/")
        if (metadata.st_dev, metadata.st_ino) == (top.st_dev, top.st_ino):
            raise ContractError("stage root must not be /")
        return current
    except BaseException:
        os.close(current)
        raise


def list_names(directory_fd: int, label: str) -> list[str]:
    names: list[str] = []
    try:
        with os.scandir(directory_fd) as entries:
            for entry in entries:
                names.append(entry.name)
                if len(names) > MAX_DIRECTORY_ENTRIES:
                    raise ContractError(f"{label} has too many entries")
    except OSError as error:
        raise ContractError(f"{label} cannot be listed: {error.strerror}") from error
    return sorted(names)


def check_absent(
    root_fd: int, path: str, *, empty_directory_ok: bool, expected_mount_id: int
) -> None:
    current = os.dup(root_fd)
    parts = PurePosixPath(path).parts[1:]
    try:
        for number, part in enumerate(parts):
            metadata = lstat_at(current, part, f"forbidden path {path}")
            if metadata is None:
                return
            last = number == len(parts) - 1
            if stat.S_ISLNK(metadata.st_mode):
                raise ContractError(f"forbidden or unsafe symlink at {path}")
            if not last:
                if not stat.S_ISDIR(metadata.st_mode):
                    raise ContractError(f"forbidden path crosses a non-directory: {path}")
                following = open_directory_at(
                    current,
                    part,
                    f"forbidden path {path}",
                    expected_mount_id=expected_mount_id,
                )
                os.close(current)
                current = following
                continue
            if not empty_directory_ok:
                raise ContractError(f"forbidden path exists: {path}")
            if not stat.S_ISDIR(metadata.st_mode):
                raise ContractError(f"forbidden path is not an empty directory: {path}")
            leaf = open_directory_at(
                current,
                part,
                f"forbidden path {path}",
                expected_mount_id=expected_mount_id,
            )
            try:
                if list_names(leaf, f"forbidden path {path}"):
                    raise ContractError(f"forbidden path is not empty: {path}")
            finally:
                os.close(leaf)
    finally:
        os.close(current)


def hash_regular_at(
    directory_fd: int, name: str, label: str, entry: dict, expected_mount_id: int
) -> None:
    metadata = lstat_at(directory_fd, name, label)
    if metadata is None:
        raise ContractError(f"{label} is missing")
    if not stat.S_ISREG(metadata.st_mode):
        raise ContractError(f"{label} is not a regular file")
    descriptor = open_regular(name, label, directory_fd=directory_fd)
    try:
        opened = os.fstat(descriptor)
        if (
            not stat.S_ISREG(opened.st_mode)
            or (opened.st_dev, opened.st_ino) != (metadata.st_dev, metadata.st_ino)
        ):
            raise ContractError(f"{label} changed while being opened")
        require_mount_id(descriptor, expected_mount_id, label)
        if stat.S_IMODE(opened.st_mode) != int(entry["mode"], 8):
            raise ContractError(f"{label} has mode {stat.S_IMODE(opened.st_mode):04o}, expected {entry['mode']}")
        if opened.st_nlink != 1:
            raise ContractError(f"{label} has additional hard links")
        if opened.st_size != entry["size"]:
            raise ContractError(f"{label} size differs")
    except BaseException:
        os.close(descriptor)
        raise
    actual = sha256_descriptor(descriptor, label, expected_size=entry["size"])
    if actual != entry["sha256"]:
        raise ContractError(f"{label} SHA-256 differs: expected {entry['sha256']}, got {actual}")


def scan_stage_tree(
    root_fd: int,
    file_entries: dict[str, dict],
    allowed_directories: set[str],
    required_directories: set[str],
    directory_modes: dict[str, str],
    expected_mount_id: int,
) -> int:
    stack = [(os.dup(root_fd), "", 0)]
    count = 0
    seen_files: set[str] = set()
    seen_directories: set[str] = set()
    try:
        while stack:
            directory_fd, prefix, depth = stack.pop()
            try:
                with os.scandir(directory_fd) as entries:
                    for entry in entries:
                        count += 1
                        if count > MAX_SCAN_ENTRIES:
                            raise ContractError("stage tree exceeds the scan bound")
                        relative = prefix + entry.name
                        path = "/" + relative
                        if MODULE_NAME_SUFFIX.search(entry.name) and path not in file_entries:
                            raise ContractError(f"extra kernel module path: /{relative}")
                        if path not in file_entries and path not in allowed_directories:
                            raise ContractError(f"unexpected stage path: {path}")
                        is_directory = entry.is_dir(follow_symlinks=False)
                        if path in allowed_directories and not is_directory:
                            raise ContractError(f"stage directory is not a real directory: {path}")
                        if path in file_entries:
                            hash_regular_at(
                                directory_fd,
                                entry.name,
                                f"owned file {path}",
                                file_entries[path],
                                expected_mount_id,
                            )
                            seen_files.add(path)
                            continue
                        if depth + 1 > MAX_SCAN_DEPTH:
                            raise ContractError("stage tree exceeds the depth bound")
                        child = open_directory_at(
                            directory_fd,
                            entry.name,
                            f"/{relative}",
                            expected_mount_id=expected_mount_id,
                        )
                        try:
                            expected_mode = directory_modes.get(path)
                            actual_mode = stat.S_IMODE(os.fstat(child).st_mode)
                            if expected_mode is not None and actual_mode != int(expected_mode, 8):
                                raise ContractError(
                                    f"owned directory {path} has mode {actual_mode:04o}, expected {expected_mode}"
                                )
                            seen_directories.add(path)
                            stack.append((child, relative + "/", depth + 1))
                            child = -1
                        finally:
                            if child >= 0:
                                os.close(child)
            except OSError as error:
                raise ContractError(f"stage tree scan failed: {error.strerror}") from error
            finally:
                os.close(directory_fd)
    finally:
        for directory_fd, _, _ in stack:
            os.close(directory_fd)
    missing_files = sorted(set(file_entries) - seen_files)
    if missing_files:
        raise ContractError(f"stage tree is missing owned files: {missing_files}")
    missing_directories = sorted(required_directories - seen_directories)
    if missing_directories:
        raise ContractError(f"stage tree is missing required directories: {missing_directories}")
    return count


def verify_stage_tree(plan: dict, root: str) -> dict:
    root_fd = open_stage_root(root)
    try:
        root_mount_id = mount_id_for_fd(root_fd, "stage root")
        for path in plan["forbidden"]["absent"]:
            check_absent(
                root_fd, path, empty_directory_ok=False, expected_mount_id=root_mount_id
            )
        for path in plan["forbidden"]["empty_or_absent_directories"]:
            check_absent(
                root_fd, path, empty_directory_ok=True, expected_mount_id=root_mount_id
            )
        file_entries = {entry["destination"]: entry for entry in plan["files"]}
        required_directories = {
            *plan["ancestor_directories"],
            *(entry["destination"] for entry in plan["directories"]),
        }
        directory_modes = {
            entry["destination"]: entry["mode"] for entry in plan["directories"]
        }
        allowed_directories = {
            *required_directories,
            *plan["forbidden"]["empty_or_absent_directories"],
        }
        for path in tuple(set(file_entries) | allowed_directories):
            parent = PurePosixPath(path).parent
            while str(parent) != "/":
                allowed_directories.add(str(parent))
                parent = parent.parent
        scan_stage_tree(
            root_fd,
            file_entries,
            allowed_directories,
            required_directories,
            directory_modes,
            root_mount_id,
        )
    except OSError as error:
        raise ContractError(f"stage verification failed: {error.strerror}") from error
    finally:
        os.close(root_fd)
    return {
        "status": "verified",
        "activation_mode": plan["activation_mode"],
        "device": plan["device"],
        "kernel_release": plan["kernel_release"],
        "directory_count": len(plan["directories"]),
        "file_count": len(plan["files"]),
        "module_directory": plan["directories"][1]["destination"],
    }


def load_contracts() -> Contracts:
    reference_path = locate_reference()
    reference_bytes = read_limited_regular(reference_path, "kernel contract reference", MAX_REFERENCE_BYTES)
    reference = strict_json(reference_bytes, "kernel contract reference")
    validate_reference(reference)
    stage_bytes = read_limited_regular(
        reference_path.with_name("stage-contract.json"), "stage contract", MAX_STAGE_CONTRACT_BYTES
    )
    stage = strict_json(stage_bytes, "stage contract")
    reference_sha256 = sha256_bytes(reference_bytes)
    validate_stage_contract(stage, reference, reference_sha256)
    return Contracts(reference, reference_sha256, stage, sha256_bytes(stage_bytes))


def locate_reference() -> Path:
    prefix = Path(__file__).resolve().parent.parent
    candidates = (
        prefix / "reference.json",
        prefix / "share/omamobile/myron-kernel-contract/reference.json",
        Path("/usr/share/omamobile/myron-kernel-contract/reference.json"),
    )
    for path in candidates:
        if path.exists() or path.is_symlink():
            return path
    raise ContractError("kernel contract reference is unavailable")


def load_reference() -> dict:
    path = locate_reference()
    try:
        data = read_limited_regular(path, "kernel contract reference", MAX_REFERENCE_BYTES)
        reference = strict_json(data, "kernel contract reference")
    except UnicodeDecodeError as error:
        raise ContractError(f"cannot read kernel contract reference: {error}") from error
    validate_reference(reference)
    return reference


# --- staged-set-only module ABI, import and load-order verification ----------
#
# Offline and metadata-only. The ELF reader below recognizes standard Linux
# AArch64/GKI relocatable-module layouts, but those layouts are covered only by
# synthetic fixtures. It has not been qualified against a real vendor or GKI
# module: an unsupported layout fails instead of being guessed at.

MAX_SYMVERS_BYTES = 32 * 1024 * 1024
MAX_SYMVERS_ROWS = 400_000
MAX_SYMVERS_LINE = 1024
MAX_MODULE_BYTES = 16 * 1024 * 1024
MAX_ELF_SECTIONS = 128
MAX_ELF_SYMBOLS = 100_000
MAX_ELF_STRTAB_BYTES = 4 * 1024 * 1024
MAX_MODINFO_BYTES = 64 * 1024
MAX_MODINFO_ENTRIES = 512
MAX_VERSIONS_ENTRIES = 16_384
MAX_VERSION_NAMES_BYTES = MAX_VERSIONS_ENTRIES * 512
MAX_ELF_RELOCATIONS = 1_000_000
ELF_HEADER_SIZE = 64
ELF_SECTION_SIZE = 64
ELF_SYMBOL_SIZE = 24
MODVERSION_ENTRY_SIZE = 64
MODVERSION_NAME_SIZE = 56
MODULE_LAYOUT = "module_layout"
EM_AARCH64 = 183
ET_REL = 1
SHT_NULL, SHT_PROGBITS, SHT_SYMTAB, SHT_STRTAB = 0, 1, 2, 3
SHT_RELA, SHT_NOBITS, SHT_REL = 4, 8, 9
SHF_ALLOC, SHF_INFO_LINK, SHF_COMPRESSED = 0x2, 0x40, 0x800
# 8 is the legacy two-PREL32-field representation retained for older inputs;
# current ELF64 uses either three PREL32 fields (12) or three pointers (24).
KSYMTAB_ENTRY_SIZES = (8, 12, 24)
KCRC_ENTRY_SIZE = 4
REL_ENTRY_SIZE, RELA_ENTRY_SIZE = 16, 24
SHN_UNDEF, SHN_LORESERVE, SHN_ABS = 0, 0xFF00, 0xFFF1
SYMBOL_NAME = re.compile(r"[A-Za-z_][A-Za-z0-9_.]{0,510}")
LOCAL_SYMBOL_NAME = re.compile(r"[\x21-\x7e]{1,511}")
SYMVERS_CRC = re.compile(r"0x[0-9a-f]{8}")
SYMVERS_PROVIDER = re.compile(r"[A-Za-z0-9_./+-]{1,255}")
SYMVERS_NAMESPACE = re.compile(r"[A-Za-z0-9_.-]{0,255}")
SYMVERS_TYPES = {
    "EXPORT_SYMBOL", "EXPORT_SYMBOL_GPL",
    "EXPORT_UNUSED_SYMBOL", "EXPORT_UNUSED_SYMBOL_GPL",
}
GPL_COMPATIBLE_LICENSES = {
    "GPL",
    "GPL v2",
    "GPL and additional rights",
    "Dual BSD/GPL",
    "Dual MIT/GPL",
    "Dual MPL/GPL",
}
KSYMTAB_SECTIONS = {
    "___ksymtab": "EXPORT_SYMBOL",
    "___ksymtab_gpl": "EXPORT_SYMBOL_GPL",
    "___ksymtab_unused": "EXPORT_UNUSED_SYMBOL",
    "___ksymtab_unused_gpl": "EXPORT_UNUSED_SYMBOL_GPL",
}
KCRCTAB_SECTIONS = {
    "___kcrctab": "EXPORT_SYMBOL",
    "___kcrctab_gpl": "EXPORT_SYMBOL_GPL",
    "___kcrctab_unused": "EXPORT_UNUSED_SYMBOL",
    "___kcrctab_unused_gpl": "EXPORT_UNUSED_SYMBOL_GPL",
}
MERGED_KSYMTAB_SECTIONS = {
    name.replace("___", "__", 1): export_type
    for name, export_type in KSYMTAB_SECTIONS.items()
}
MERGED_KCRCTAB_SECTIONS = {
    name.replace("___", "__", 1): export_type
    for name, export_type in KCRCTAB_SECTIONS.items()
}
# Relocations accepted by the Android 16 AArch64 module loader. Values map to
# (bytes written, required offset alignment). R_AARCH64_NONE writes nothing.
AARCH64_RELOCATION_SHAPES = {
    0: (0, 1), 256: (0, 1),
    257: (8, 1), 258: (4, 1), 259: (2, 1),
    260: (8, 1), 261: (4, 1), 262: (2, 1),
    **{number: (4, 4) for number in (*range(263, 281), *range(282, 294), 299)},
}
LITERAL_METADATA_SECTIONS = {
    ".modinfo", "__versions", "__version_ext_names", "__version_ext_crcs",
    "__ksymtab_strings",
}
MODINFO_KEY = re.compile(r"[a-z][a-z0-9_]{0,31}")
MODINFO_NAME = re.compile(r"[A-Za-z0-9_]{1,55}")
VERMAGIC_TOKEN = re.compile(r"[\x21-\x7e]+")


class SymverRow(NamedTuple):
    crc: int
    provider: str
    export_type: str
    namespace: str


class ModuleElf(NamedTuple):
    name: str
    vermagic: str
    license: str | None
    import_namespaces: tuple
    imports: dict      # symbol -> "global" | "weak"
    exports: dict      # symbol -> (export type, CRC or None, runtime namespace)
    versions: dict | None  # imported symbol -> CRC, None without version metadata
    module_layout_crc: int | None
    versions_format: str   # absent | basic | extended | basic+extended


class ElfSection(NamedTuple):
    name: str
    kind: int
    flags: int
    offset: int
    size: int
    link: int
    info: int
    entsize: int


class ElfRelocation(NamedTuple):
    offset: int
    relocation_type: int
    symbol_index: int
    width: int
    # RELA carries an explicit signed addend. REL stores the addend in the
    # target field, so None means that it must be decoded from target bytes.
    addend: int | None


def normalize_module_name(name: str) -> str:
    """The kernel treats '-' and '_' in module names as the same character."""
    return name.replace("-", "_")


def read_canonical_regular(path: str, label: str, limit: int) -> bytes:
    """Read one regular file: canonical absolute path, no symlink on any component."""
    if not isinstance(path, str) or not path or "\x00" in path:
        raise ContractError(f"{label} path is invalid")
    if not os.path.isabs(path) or path == "/":
        raise ContractError(f"{label} must be a canonical absolute path")
    components = path.split("/")
    if any(part in (".", "..") for part in components) or any(not part for part in components[1:]):
        raise ContractError(f"{label} must be a canonical absolute path")
    try:
        current = os.open("/", stage_flags(directory=True))
    except OSError as error:
        raise ContractError(f"cannot open /: {error.strerror}") from error
    try:
        walked = ""
        for part in components[1:-1]:
            walked += "/" + part
            following = open_directory_at(current, part, f"{label} component {walked}")
            os.close(current)
            current = following
        descriptor = open_regular(components[-1], label, directory_fd=current)
    finally:
        os.close(current)
    with os.fdopen(descriptor, "rb") as stream:
        size = os.fstat(stream.fileno()).st_size
        if size > limit:
            raise ContractError(f"{label} exceeds the {limit}-byte safety limit")
        data = stream.read(limit + 1)
    if len(data) != size:
        raise ContractError(f"{label} changed size while being read")
    return data


def parse_symvers(data: bytes, label: str, *, kernel: bool) -> dict[str, SymverRow]:
    if len(data) > MAX_SYMVERS_BYTES:
        raise ContractError(f"{label} exceeds the {MAX_SYMVERS_BYTES}-byte safety limit")
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError as error:
        raise ContractError(f"{label} is not UTF-8") from error
    if not text or not text.endswith("\n") or "\x00" in text or "\r" in text:
        raise ContractError(f"{label} must be non-empty LF-terminated text without NUL or CR")
    lines = text[:-1].split("\n")
    if len(lines) > MAX_SYMVERS_ROWS:
        raise ContractError(f"{label} has more than {MAX_SYMVERS_ROWS} rows")
    rows: dict[str, SymverRow] = {}
    for number, line in enumerate(lines, 1):
        if len(line) > MAX_SYMVERS_LINE:
            raise ContractError(f"{label} line {number} is too long")
        fields = line.split("\t")
        if len(fields) != 5:
            raise ContractError(f"{label} line {number} does not have five tab-separated fields")
        crc, symbol, provider, export_type, namespace = fields
        if not SYMVERS_CRC.fullmatch(crc):
            raise ContractError(f"{label} line {number} has an invalid CRC")
        if not SYMBOL_NAME.fullmatch(symbol):
            raise ContractError(f"{label} line {number} has an invalid symbol")
        if not SYMVERS_PROVIDER.fullmatch(provider):
            raise ContractError(f"{label} line {number} has an invalid provider")
        if kernel and provider != "vmlinux":
            raise ContractError(f"{label} line {number} has a provider other than vmlinux")
        if export_type not in SYMVERS_TYPES:
            raise ContractError(f"{label} line {number} has an invalid export type")
        if not SYMVERS_NAMESPACE.fullmatch(namespace):
            raise ContractError(f"{label} line {number} has an invalid namespace")
        row = SymverRow(int(crc, 16), provider, export_type, namespace)
        previous = rows.get(symbol)
        if previous is not None:
            kind = "duplicate" if previous == row else "conflicting"
            raise ContractError(f"{label} line {number} has a {kind} record for {symbol}")
        rows[symbol] = row
    return rows


def elf_cstring(table: bytes, index: int, what: str) -> str:
    if index >= len(table):
        raise ContractError(f"{what} string index is out of bounds")
    end = table.find(b"\x00", index)
    if end < 0:
        raise ContractError(f"{what} string is not terminated")
    try:
        return table[index:end].decode("ascii")
    except UnicodeDecodeError as error:
        raise ContractError(f"{what} string is not ASCII") from error


def parse_modinfo(data: bytes) -> tuple[str, str, str | None, tuple]:
    if not data or len(data) > MAX_MODINFO_BYTES or data[-1] != 0:
        raise ContractError(".modinfo is empty, oversized or not NUL-terminated")
    entries = data[:-1].split(b"\x00")
    if len(entries) > MAX_MODINFO_ENTRIES:
        raise ContractError(".modinfo has too many entries")
    single: dict[str, str] = {}
    namespaces: list[str] = []
    for raw in entries:
        try:
            entry = raw.decode("ascii")
        except UnicodeDecodeError as error:
            raise ContractError(".modinfo entry is not ASCII") from error
        key, separator, value = entry.partition("=")
        if (
            not separator or not MODINFO_KEY.fullmatch(key) or len(value) > 1024
            or any(not 0x20 <= ord(char) <= 0x7E for char in value)
        ):
            raise ContractError(".modinfo has a malformed entry")
        if key == "import_ns":
            if not SYMVERS_NAMESPACE.fullmatch(value) or not value or value in namespaces:
                raise ContractError(".modinfo has an invalid or duplicate import_ns")
            namespaces.append(value)
        elif key in ("name", "vermagic", "license"):
            if key in single:
                raise ContractError(f".modinfo has duplicate {key}")
            single[key] = value
    for key in ("name", "vermagic"):
        if key not in single:
            raise ContractError(f".modinfo lacks {key}")
    if not MODINFO_NAME.fullmatch(single["name"]):
        raise ContractError(".modinfo name is invalid")
    return single["name"], single["vermagic"], single.get("license"), tuple(sorted(namespaces))


def parse_versions(data: bytes) -> dict[str, int]:
    if not data or len(data) % MODVERSION_ENTRY_SIZE:
        raise ContractError("__versions size is not a positive multiple of 64")
    if len(data) // MODVERSION_ENTRY_SIZE > MAX_VERSIONS_ENTRIES:
        raise ContractError("__versions has too many entries")
    result: dict[str, int] = {}
    for crc, raw in struct.iter_unpack(f"<Q{MODVERSION_NAME_SIZE}s", data):
        end = raw.find(b"\x00")
        if end < 1 or any(raw[end:]) or crc > 0xFFFFFFFF:
            raise ContractError("__versions has a malformed entry")
        try:
            name = raw[:end].decode("ascii")
        except UnicodeDecodeError as error:
            raise ContractError("__versions name is not ASCII") from error
        if not SYMBOL_NAME.fullmatch(name) or name in result:
            raise ContractError("__versions has an invalid or duplicate name")
        result[name] = crc
    return result


def parse_extended_versions(names_data: bytes, crcs_data: bytes) -> dict[str, int]:
    if not names_data or len(names_data) > MAX_VERSION_NAMES_BYTES or names_data[-1] != 0:
        raise ContractError("__version_ext_names is empty, oversized or not NUL-terminated")
    if not crcs_data or len(crcs_data) % 4:
        raise ContractError("__version_ext_crcs size is not a positive multiple of 4")
    count = len(crcs_data) // 4
    if count > MAX_VERSIONS_ENTRIES:
        raise ContractError("extended modversions has too many entries")
    raw_names = []
    position = 0
    for _ in range(count):
        end = names_data.find(b"\x00", position)
        if end < 0:
            raise ContractError("extended modversions names and CRC counts differ")
        raw_names.append(names_data[position:end])
        position = end + 1
    # modpost emits explicit NULs inside concatenated C string literals. The
    # compiler adds one final terminator to the resulting character array.
    if names_data[position:] != b"\x00":
        raise ContractError("extended modversions names and CRC counts differ or have trailing data")
    result: dict[str, int] = {}
    crcs = struct.iter_unpack("<I", crcs_data)
    for raw, (crc,) in zip(raw_names, crcs):
        if not raw:
            raise ContractError("__version_ext_names has an empty name")
        try:
            name = raw.decode("ascii")
        except UnicodeDecodeError as error:
            raise ContractError("__version_ext_names name is not ASCII") from error
        if not SYMBOL_NAME.fullmatch(name) or name in result:
            raise ContractError("__version_ext_names has an invalid or duplicate name")
        result[name] = crc
    return result


def parse_module_elf(data: bytes) -> ModuleElf:
    size = len(data)
    if size > MAX_MODULE_BYTES:
        raise ContractError(f"module exceeds the {MAX_MODULE_BYTES}-byte safety limit")
    if size < ELF_HEADER_SIZE or data[:4] != b"\x7fELF":
        raise ContractError("module is not an ELF file")
    if data[4] != 2:
        raise ContractError("module is not ELFCLASS64")
    if data[5] != 1:
        raise ContractError("module is not little-endian")
    if data[6] != 1 or data[7] != 0 or data[8] != 0 or any(data[9:16]):
        raise ContractError("module ELF identification is unsupported")
    (e_type, e_machine, e_version, e_entry, e_phoff, e_shoff, e_flags, e_ehsize,
     e_phentsize, e_phnum, e_shentsize, e_shnum, e_shstrndx) = struct.unpack_from(
        "<HHIQQQIHHHHHH", data, 16)
    if e_type != ET_REL:
        raise ContractError("module is not ET_REL")
    if e_machine != EM_AARCH64:
        raise ContractError("module is not AArch64")
    if (
        e_version != 1 or e_entry or e_phoff or e_phnum or e_flags
        or e_ehsize != ELF_HEADER_SIZE or e_phentsize not in (0, 56)
    ):
        raise ContractError("module ELF header fields are unsupported")
    if e_shentsize != ELF_SECTION_SIZE or not 1 <= e_shnum <= MAX_ELF_SECTIONS:
        raise ContractError("module section header table is unsupported")
    if e_shstrndx == 0 or e_shstrndx >= e_shnum:
        raise ContractError("module section name table index is invalid")
    table_end = e_shoff + e_shnum * ELF_SECTION_SIZE
    if e_shoff < ELF_HEADER_SIZE or table_end > size:
        raise ContractError("module section header table is out of bounds")
    raw_sections = [
        struct.unpack_from("<IIQQQQIIQQ", data, e_shoff + index * ELF_SECTION_SIZE)
        for index in range(e_shnum)
    ]
    if any(raw_sections[0]):
        raise ContractError("module section 0 is not the null section")
    ranges = [(e_shoff, table_end, "section header table")]
    for index, (_, kind, flags, _, offset, length, *_rest) in enumerate(raw_sections):
        if flags & SHF_COMPRESSED:
            raise ContractError(f"module section {index} is compressed")
        if kind in (SHT_NULL, SHT_NOBITS) or length == 0:
            continue
        if offset < ELF_HEADER_SIZE or offset + length > size:
            raise ContractError(f"module section {index} is out of bounds")
        ranges.append((offset, offset + length, f"section {index}"))
    ranges.sort()
    for (_, end, _), (start, _, what) in zip(ranges, ranges[1:]):
        if start < end:
            raise ContractError(f"module {what} overlaps another region")

    def contents(section: ElfSection) -> bytes:
        return data[section.offset:section.offset + section.size]

    shstr = raw_sections[e_shstrndx]
    if shstr[1] != SHT_STRTAB or shstr[5] == 0 or shstr[5] > MAX_ELF_STRTAB_BYTES:
        raise ContractError("module section name table is invalid")
    names = data[shstr[4]:shstr[4] + shstr[5]]
    if names[0] != 0 or names[-1] != 0:
        raise ContractError("module section name table is malformed")
    sections = [
        ElfSection(elf_cstring(names, raw[0], "section name"), raw[1], raw[2],
                   raw[4], raw[5], raw[6], raw[7], raw[9])
        for raw in raw_sections
    ]
    by_name: dict[str, list[int]] = {}
    for index, section in enumerate(sections):
        by_name.setdefault(section.name, []).append(index)
    # section index -> (required symbol for a per-symbol input section, export
    # type, possible entry sizes). Final module links merge the input sections,
    # so merged tables use None for the required symbol.
    export_sections: dict[int, tuple[str | None, str, tuple[int, ...]]] = {}
    crc_sections: dict[int, tuple[str | None, str]] = {}
    merged_export_sections: dict[str, int] = {}
    merged_crc_sections: dict[str, int] = {}
    for index, section in enumerate(sections):
        if section.name in MERGED_KSYMTAB_SECTIONS:
            export_type = MERGED_KSYMTAB_SECTIONS[section.name]
            candidates = tuple(
                entry_size for entry_size in KSYMTAB_ENTRY_SIZES
                if section.size > 0
                and section.size % entry_size == 0
                and section.entsize in (0, entry_size)
            )
            if (
                section.kind != SHT_PROGBITS
                or not section.flags & SHF_ALLOC
                or not candidates
            ):
                raise ContractError(f"module has an unsupported export section: {section.name}")
            if export_type in merged_export_sections:
                raise ContractError(f"module has a duplicate merged export section: {section.name}")
            merged_export_sections[export_type] = index
            export_sections[index] = (None, export_type, candidates)
        elif section.name.startswith("___ksymtab"):
            prefix, plus, symbol = section.name.partition("+")
            if (
                not plus
                or prefix not in KSYMTAB_SECTIONS
                or not SYMBOL_NAME.fullmatch(symbol)
                or section.kind != SHT_PROGBITS
                or not section.flags & SHF_ALLOC
                or section.size not in KSYMTAB_ENTRY_SIZES
                or section.entsize not in (0, section.size)
            ):
                raise ContractError(f"module has an unsupported export section: {section.name}")
            export_sections[index] = (
                symbol, KSYMTAB_SECTIONS[prefix], (section.size,)
            )
        elif section.name in MERGED_KCRCTAB_SECTIONS:
            crc_type = MERGED_KCRCTAB_SECTIONS[section.name]
            if (
                section.kind != SHT_PROGBITS
                or not section.flags & SHF_ALLOC
                or section.size == 0
                or section.size % KCRC_ENTRY_SIZE
                or section.entsize not in (0, KCRC_ENTRY_SIZE)
            ):
                raise ContractError(f"module has an unsupported CRC section: {section.name}")
            if crc_type in merged_crc_sections:
                raise ContractError(f"module has a duplicate merged CRC section: {section.name}")
            merged_crc_sections[crc_type] = index
            crc_sections[index] = (None, crc_type)
        elif section.name.startswith("___kcrctab"):
            prefix, plus, symbol = section.name.partition("+")
            if (
                not plus
                or prefix not in KCRCTAB_SECTIONS
                or not SYMBOL_NAME.fullmatch(symbol)
                or section.kind != SHT_PROGBITS
                or not section.flags & SHF_ALLOC
                or section.size != KCRC_ENTRY_SIZE
                or section.entsize not in (0, KCRC_ENTRY_SIZE)
            ):
                raise ContractError(f"module has an unsupported CRC section: {section.name}")
            crc_sections[index] = (symbol, KCRCTAB_SECTIONS[prefix])
        elif section.name.startswith("___kflagstab"):
            raise ContractError("module uses unsupported export flags sections")
    fixed_export_sizes = {
        candidates[0]
        for required, _export_type, candidates in export_sections.values()
        if required is not None
    }
    if len(fixed_export_sizes) > 1:
        raise ContractError("module mixes classic and PREL32 export layouts")
    for special in (
        ".modinfo", ".symtab", "__versions",
        "__version_ext_names", "__version_ext_crcs",
    ):
        if len(by_name.get(special, ())) > 1:
            raise ContractError(f"module has duplicate {special}")
    if ".modinfo" not in by_name:
        raise ContractError("module lacks .modinfo")
    if ".symtab" not in by_name:
        raise ContractError("module lacks .symtab")
    symtabs = [index for index, section in enumerate(sections) if section.kind == SHT_SYMTAB]
    if symtabs != [by_name[".symtab"][0]]:
        raise ContractError("module must contain exactly one SHT_SYMTAB named .symtab")
    modinfo = sections[by_name[".modinfo"][0]]
    if modinfo.kind != SHT_PROGBITS:
        raise ContractError(".modinfo is not PROGBITS")
    name, vermagic, license_name, namespaces = parse_modinfo(contents(modinfo))

    symtab = sections[by_name[".symtab"][0]]
    if (
        symtab.kind != SHT_SYMTAB or symtab.entsize != ELF_SYMBOL_SIZE
        or symtab.size == 0 or symtab.size % ELF_SYMBOL_SIZE
        or symtab.link in (0, e_shstrndx) or symtab.link >= e_shnum
        or sections[symtab.link].kind != SHT_STRTAB
        or not 0 < sections[symtab.link].size <= MAX_ELF_STRTAB_BYTES
    ):
        raise ContractError(".symtab is malformed")
    count = symtab.size // ELF_SYMBOL_SIZE
    if count > MAX_ELF_SYMBOLS or not 1 <= symtab.info <= count:
        raise ContractError(".symtab symbol count or first-global index is invalid")
    strtab = contents(sections[symtab.link])
    if strtab[0] != 0 or strtab[-1] != 0:
        raise ContractError("symbol string table is malformed")

    relocation_count = 0
    relocations_by_target: dict[int, list[ElfRelocation]] = {}
    symtab_index = by_name[".symtab"][0]
    for index, section in enumerate(sections):
        if section.kind not in (SHT_REL, SHT_RELA):
            continue
        entry_size = REL_ENTRY_SIZE if section.kind == SHT_REL else RELA_ENTRY_SIZE
        if (
            not section.flags & SHF_INFO_LINK
            or section.entsize != entry_size
            or section.size == 0
            or section.size % entry_size
            or section.link != symtab_index
            or section.info == 0
            or section.info >= e_shnum
        ):
            raise ContractError(f"module relocation section {index} is malformed")
        target = sections[section.info]
        if target.kind in (SHT_NULL, SHT_SYMTAB, SHT_STRTAB, SHT_REL, SHT_RELA):
            raise ContractError(f"module relocation section {index} has an invalid target")
        if section.info in crc_sections or target.name in LITERAL_METADATA_SECTIONS:
            raise ContractError(
                f"module relocation section {index} targets literal metadata: {target.name}"
            )
        records = section.size // entry_size
        relocation_count += records
        if relocation_count > MAX_ELF_RELOCATIONS:
            raise ContractError("module has too many relocation records")
        layout = "<QQ" if section.kind == SHT_REL else "<QQq"
        for record in struct.iter_unpack(layout, contents(section)):
            r_offset, r_info = record[:2]
            if r_info >> 32 >= count:
                raise ContractError(f"module relocation section {index} has a bad symbol index")
            relocation_type = r_info & 0xFFFFFFFF
            shape = AARCH64_RELOCATION_SHAPES.get(relocation_type)
            if shape is None:
                raise ContractError(
                    f"module relocation section {index} uses unsupported AArch64 type "
                    f"{relocation_type}"
                )
            width, alignment = shape
            if r_offset >= target.size or r_offset + width > target.size:
                raise ContractError(f"module relocation section {index} has an out-of-range offset")
            if r_offset % alignment:
                raise ContractError(f"module relocation section {index} has an unaligned offset")
            relocations_by_target.setdefault(section.info, []).append(ElfRelocation(
                r_offset, relocation_type, r_info >> 32, width,
                None if section.kind == SHT_REL else record[2],
            ))
        # Android 16 AArch64 selects RELA. Its REL handler returns -ENOEXEC;
        # accepting an allocated REL target would therefore validate a module
        # the runtime loader rejects. Non-allocated debug relocations are not
        # applied by the loader and remain structurally checked above.
        if section.kind == SHT_REL and target.flags & SHF_ALLOC:
            raise ContractError("module has REL relocations for an allocated section")

    imports: dict[str, str] = {}
    export_symbols: dict[str, tuple[str, int, str]] = {}
    export_crcs: dict[str, int] = {}
    export_records: dict[int, list[tuple[str, int, int, int, int]]] = {
        index: [] for index in export_sections
    }
    crc_records: dict[int, list[tuple[str, int, int, int, int]]] = {
        index: [] for index in crc_sections
    }
    seen_exports: set[str] = set()
    seen_crcs: set[str] = set()
    crc_layouts: set[str] = set()
    symbol_records: list[tuple[str, int, int, int, int, int] | None] = [None] * count
    for index, (st_name, st_info, st_other, st_shndx, st_value, st_size) in enumerate(
        struct.iter_unpack("<IBBHQQ", contents(symtab))
    ):
        bind, kind = st_info >> 4, st_info & 15
        if index == 0:
            if (st_name, st_info, st_other, st_shndx, st_value, st_size) != (0,) * 6:
                raise ContractError("symbol 0 is not the null symbol")
            symbol_records[index] = ("", 0, 0, 0, 0, 0)
            continue
        if kind > 4 or bind > 2:
            raise ContractError("module has an unsupported symbol type or binding")
        if st_other != 0:
            raise ContractError("module has unsupported symbol visibility")
        if (bind == 0) != (index < symtab.info):
            raise ContractError(".symtab local/global symbol ordering is invalid")
        symbol = elf_cstring(strtab, st_name, "symbol name")
        if symbol and not LOCAL_SYMBOL_NAME.fullmatch(symbol):
            raise ContractError("module has an invalid symbol name")
        if not symbol and kind not in (3, 4):
            raise ContractError("module has an unnamed symbol")
        if st_shndx == 0xFFFF or SHN_LORESERVE <= st_shndx < SHN_ABS or st_shndx > SHN_ABS:
            raise ContractError("module has an unsupported symbol section index")
        if st_shndx < SHN_LORESERVE and st_shndx >= e_shnum:
            raise ContractError("module symbol section index is out of bounds")
        symbol_records[index] = (symbol, bind, kind, st_shndx, st_value, st_size)
        if st_shndx == SHN_UNDEF:
            if bind == 0:
                raise ContractError("module has an undefined local symbol")
            if kind in (3, 4):
                raise ContractError("module has an undefined section or file symbol")
            if not SYMBOL_NAME.fullmatch(symbol):
                raise ContractError(f"module import has an invalid name: {symbol}")
            if kind != 0 or st_value != 0 or st_size != 0:
                raise ContractError(f"module import has an unsupported symbol record: {symbol}")
            if symbol == MODULE_LAYOUT:
                raise ContractError("module_layout is version metadata, not an undefined import")
            if symbol in imports:
                raise ContractError(f"module has duplicate import: {symbol}")
            imports[symbol] = "weak" if bind == 2 else "global"
        elif symbol.startswith("__ksymtab_"):
            exported = symbol[len("__ksymtab_"):]
            if not SYMBOL_NAME.fullmatch(exported) or st_shndx == SHN_ABS:
                raise ContractError(f"module has an invalid export record: {symbol}")
            export_section = export_sections.get(st_shndx)
            if export_section is None or (
                export_section[0] is not None and export_section[0] != exported
            ):
                raise ContractError(f"module export {exported} is not in its ___ksymtab section")
            if (
                bind not in (0, 1)
                or kind not in (0, 1)
                or st_size not in (0, *export_section[2])
                or st_value >= sections[st_shndx].size
            ):
                raise ContractError(f"module export {exported} has an invalid ___ksymtab record")
            if exported in seen_exports:
                raise ContractError(f"module has duplicate export: {exported}")
            seen_exports.add(exported)
            export_records[st_shndx].append((exported, bind, kind, st_value, st_size))
        elif symbol.startswith("__crc_"):
            exported = symbol[len("__crc_"):]
            if not SYMBOL_NAME.fullmatch(exported) or exported in seen_crcs:
                raise ContractError(f"module has an invalid CRC record: {symbol}")
            seen_crcs.add(exported)
            if st_shndx == SHN_ABS:
                if bind not in (0, 1) or kind != 0 or st_size != 0 or st_value > 0xFFFFFFFF:
                    raise ContractError(f"module has an invalid CRC record: {symbol}")
                crc_layouts.add("absolute")
                export_crcs[exported] = st_value
            else:
                crc_section = crc_sections.get(st_shndx)
                if (
                    crc_section is None
                    or (crc_section[0] is not None and crc_section[0] != exported)
                    or bind not in (0, 1)
                    or kind not in (0, 1)
                    or st_size not in (0, KCRC_ENTRY_SIZE)
                    or st_value >= sections[st_shndx].size
                ):
                    raise ContractError(f"module has an invalid CRC record: {symbol}")
                crc_layouts.add("section")
                crc_records[st_shndx].append((exported, bind, kind, st_value, st_size))

    def resolve_runtime_export_string(
        section_index: int, field_offset: int, relocation_type: int,
        exported: str, symbol_prefix: str, field_name: str,
    ) -> str:
        field_width = AARCH64_RELOCATION_SHAPES[relocation_type][0]
        field_end = field_offset + field_width
        matches = [
            record for record in relocations_by_target.get(section_index, ())
            if record.width
            and record.offset < field_end
            and record.offset + record.width > field_offset
        ]
        if (
            len(matches) != 1
            or matches[0].offset != field_offset
            or matches[0].relocation_type != relocation_type
            or matches[0].width != field_width
        ):
            raise ContractError(
                f"module export {exported} has no unambiguous {field_name} relocation"
            )
        relocation = matches[0]
        target = symbol_records[relocation.symbol_index]
        if target is None:
            raise ContractError(f"module export {exported} has an invalid {field_name} symbol")
        target_name, bind, kind, shndx, value, target_size = target
        named_target = (
            target_name == f"{symbol_prefix}{exported}"
            and bind in (0, 1)
            and kind in (0, 1)
        )
        section_target = (
            not target_name and bind == 0 and kind == 3
            and value == 0 and target_size == 0
        )
        if (
            not (named_target or section_target)
            or shndx in (SHN_UNDEF, SHN_ABS)
            or shndx >= e_shnum
        ):
            raise ContractError(f"module export {exported} has an invalid {field_name} symbol")
        string_section = sections[shndx]
        if (
            string_section.name != "__ksymtab_strings"
            or string_section.kind != SHT_PROGBITS
            or not string_section.flags & SHF_ALLOC
        ):
            raise ContractError(f"module export {exported} has an invalid {field_name} section")
        if relocation.addend is None:
            addend_format = "<q" if relocation_type == 257 else "<i"
            addend = struct.unpack_from(
                addend_format, contents(sections[section_index]), field_offset
            )[0]
        else:
            addend = relocation.addend
        runtime_string_offset = value + addend
        if runtime_string_offset < 0 or runtime_string_offset >= string_section.size:
            raise ContractError(f"module export {exported} has an invalid {field_name} offset")
        return elf_cstring(
            contents(string_section), runtime_string_offset,
            f"export {field_name}",
        )

    def validate_runtime_export_metadata(
        section_index: int, entry_offset: int, entry_size: int, exported: str
    ) -> str:
        name_delta, relocation_type = (
            (8, 257) if entry_size == 24 else (4, 261)
        )
        runtime_name = resolve_runtime_export_string(
            section_index, entry_offset + name_delta, relocation_type,
            exported, "__kstrtab_", "runtime-name",
        )
        if runtime_name != exported:
            raise ContractError(
                f"module export label and runtime name differ: {exported} != {runtime_name}"
            )
        if entry_size == 8:
            return ""
        namespace_delta = 16 if entry_size == 24 else 8
        namespace = resolve_runtime_export_string(
            section_index, entry_offset + namespace_delta, relocation_type,
            exported, "__kstrtabns_", "runtime-namespace",
        )
        if not SYMVERS_NAMESPACE.fullmatch(namespace):
            raise ContractError(f"module export {exported} has an invalid runtime namespace")
        return namespace

    export_sizes: set[int] = set()
    for section_index, (required, export_type, candidates) in export_sections.items():
        section = sections[section_index]
        records = export_records[section_index]
        if not records or (required is not None and len(records) != 1):
            raise ContractError("module has an export section without exactly one export symbol")
        layouts = [
            entry_size for entry_size in candidates
            if len(records) * entry_size == section.size
            and sorted(record[3] for record in records) == list(
                range(0, section.size, entry_size)
            )
            and all(record[4] in (0, entry_size) for record in records)
        ]
        if len(layouts) != 1:
            raise ContractError("module export has an invalid ___ksymtab record")
        entry_size = layouts[0]
        export_sizes.add(entry_size)
        ordered_records = sorted(records, key=lambda item: item[3])
        runtime_namespaces = {record[0]: "" for record in ordered_records}
        if required is None or entry_size in (12, 24):
            for exported, _bind, _kind, value, _size in ordered_records:
                runtime_namespaces[exported] = validate_runtime_export_metadata(
                    section_index, value, entry_size, exported
                )
        if required is None:
            ordered_names = [record[0] for record in ordered_records]
            if ordered_names != sorted(ordered_names):
                raise ContractError(
                    f"module merged export table is not sorted by name: {export_type}"
                )
        for exported, _bind, _kind, _value, _size in ordered_records:
            export_symbols[exported] = (
                export_type, entry_size, runtime_namespaces[exported]
            )
    if len(export_sizes) > 1:
        raise ContractError("module mixes classic and PREL32 export layouts")

    for section_index, (required, crc_type) in crc_sections.items():
        section = sections[section_index]
        records = crc_records[section_index]
        if not records or (required is not None and len(records) != 1):
            raise ContractError("module has a CRC section without exactly one CRC symbol")
        if (
            len(records) * KCRC_ENTRY_SIZE != section.size
            or sorted(record[3] for record in records)
            != list(range(0, section.size, KCRC_ENTRY_SIZE))
            or any(record[4] not in (0, KCRC_ENTRY_SIZE) for record in records)
        ):
            raise ContractError("module has an invalid CRC record")
        section_data = contents(section)
        for exported, _bind, _kind, value, _size in records:
            export_crcs[exported] = struct.unpack_from("<I", section_data, value)[0]
            if exported in export_symbols and crc_type != export_symbols[exported][0]:
                raise ContractError(
                    f"module CRC section type differs from export type: {exported}"
                )
    for export_type, crc_index in merged_crc_sections.items():
        export_index = merged_export_sections.get(export_type)
        if export_index is None:
            raise ContractError("module has a merged CRC table without its export table")
        export_order = [
            record[0] for record in sorted(export_records[export_index], key=lambda item: item[3])
        ]
        crc_order = [
            record[0] for record in sorted(crc_records[crc_index], key=lambda item: item[3])
        ]
        if crc_order != export_order:
            raise ContractError(
                f"module merged CRC table does not match export-table order: {export_type}"
            )
    if len(crc_layouts) > 1:
        raise ContractError("module mixes absolute and section-backed CRC layouts")
    if set(export_crcs) - set(export_symbols):
        raise ContractError("module has a CRC record without an export")
    exports = {
        symbol: (record[0], export_crcs.get(symbol), record[2])
        for symbol, record in export_symbols.items()
    }
    if set(exports) & set(imports):
        raise ContractError("module imports a symbol it exports")

    versions = None
    module_layout_crc = None
    versions_format = "absent"
    basic = "__versions" in by_name
    extended_names = "__version_ext_names" in by_name
    extended_crcs = "__version_ext_crcs" in by_name
    if extended_names != extended_crcs:
        raise ContractError("module has only one extended modversions section")
    basic_versions = None
    extended_versions = None
    if basic:
        section = sections[by_name["__versions"][0]]
        if section.kind != SHT_PROGBITS or not section.flags & SHF_ALLOC:
            raise ContractError("__versions is not allocated PROGBITS")
        basic_versions = parse_versions(contents(section))
        versions = basic_versions
        versions_format = "basic"
    if extended_names:
        names_section = sections[by_name["__version_ext_names"][0]]
        crcs_section = sections[by_name["__version_ext_crcs"][0]]
        if (
            names_section.kind != SHT_PROGBITS
            or crcs_section.kind != SHT_PROGBITS
            or not names_section.flags & SHF_ALLOC
            or not crcs_section.flags & SHF_ALLOC
        ):
            raise ContractError("extended modversions sections are not allocated PROGBITS")
        extended_versions = parse_extended_versions(contents(names_section), contents(crcs_section))
        extended_imports = set(extended_versions) - {MODULE_LAYOUT}
        if extended_imports != set(imports):
            raise ContractError("extended modversions entries differ from the undefined imports")
        if basic_versions is None:
            versions = dict(extended_versions)
            versions_format = "extended"
        else:
            for symbol in sorted(basic_versions):
                if symbol not in extended_versions:
                    raise ContractError(
                        f"basic modversions entry is absent from extended metadata: {symbol}"
                    )
                if basic_versions[symbol] != extended_versions[symbol]:
                    raise ContractError(f"basic and extended modversions disagree for {symbol}")
            versions = dict(extended_versions)
            versions_format = "basic+extended"
    if versions is not None:
        module_layout_crc = versions.pop(MODULE_LAYOUT, None)
        if set(versions) != set(imports):
            raise ContractError("modversions entries differ from the undefined imports")
    if imports and "modversions" in vermagic.split() and versions is None:
        raise ContractError("module enables modversions but has imports without version metadata")
    return ModuleElf(
        name, vermagic, license_name, namespaces, imports, exports, versions,
        module_layout_crc, versions_format,
    )


def verify_abi_bytes(
    contracts: Contracts, archive_data: bytes, vmlinux_data: bytes, module_data: bytes
) -> dict:
    reference = contracts.reference
    validate_stage_contract(contracts.stage, reference, contracts.reference_sha256)
    kernel_ref = reference["kernel"]
    assets = reference["module_assets"]
    for label, data, key in (
        ("vmlinux.symvers", vmlinux_data, "vmlinux_symvers_sha256"),
        ("kernel_aarch64_Module.symvers", module_data, "module_symvers_sha256"),
    ):
        actual = sha256_bytes(data)
        if actual != kernel_ref[key]:
            raise ContractError(f"{label} SHA-256 differs: expected {kernel_ref[key]}, got {actual}")
    payload = read_module_payload_bytes(
        reference, archive_data, contracts.stage["layout"]["selector"]["destination"]
    )
    declared = list(assets["modules"])
    forbidden = {normalize_module_name(name) for name in assets["forbidden_modules"]}
    stems = [normalize_module_name(name) for name in declared]
    if len(set(stems)) != len(stems):
        raise ContractError("staged module names collide after normalization")
    if forbidden & set(stems):
        raise ContractError("a forbidden module is staged")
    staged_files = {name[len("modules/"):-len(".ko")] for name in payload if name.startswith("modules/")}
    if staged_files != set(declared):
        raise ContractError("staged module set differs from the declared modules")

    kernel_rows = parse_symvers(vmlinux_data, "vmlinux.symvers", kernel=True)
    all_rows = parse_symvers(module_data, "Module.symvers", kernel=False)
    staged_rows: dict[str, dict[str, SymverRow]] = {stem: {} for stem in stems}
    outside: dict[str, str] = {}
    for symbol, row in all_rows.items():
        if row.provider == "vmlinux":
            if kernel_rows.get(symbol) != row:
                raise ContractError(f"Module.symvers conflicts with vmlinux.symvers for {symbol}")
            continue
        if symbol in kernel_rows:
            raise ContractError(f"duplicate provider for {symbol}: vmlinux and {row.provider}")
        stem = normalize_module_name(row.provider.rsplit("/", 1)[-1])
        if stem in staged_rows:
            staged_rows[stem][symbol] = row
        else:
            outside[symbol] = stem

    parsed: dict[str, ModuleElf] = {}
    for name, stem in zip(declared, stems):
        member = f"modules/{name}.ko"
        try:
            module = parse_module_elf(payload[member])
        except ContractError as error:
            raise ContractError(f"{member}: {error}") from error
        if normalize_module_name(module.name) != stem:
            raise ContractError(f"{member}: .modinfo name {module.name} differs from the file name")
        if module.name in forbidden:
            raise ContractError(f"{member}: forbidden module {module.name}")
        tokens = module.vermagic.split(" ")
        if (
            tokens[0] != kernel_ref["release"]
            or any(not VERMAGIC_TOKEN.fullmatch(token) for token in tokens)
        ):
            raise ContractError(f"{member}: vermagic does not start with the kernel release")
        parsed[name] = module
    vermagics = {module.vermagic for module in parsed.values()}
    if len(vermagics) != 1:
        raise ContractError("staged modules disagree on vermagic")
    for name, module in parsed.items():
        if module.module_layout_crc is None:
            continue
        row = kernel_rows.get(MODULE_LAYOUT)
        if row is None:
            raise ContractError(f"{name} declares module_layout but vmlinux.symvers lacks it")
        if module.module_layout_crc != row.crc:
            raise ContractError(f"{name} module_layout has a CRC mismatch")

    providers: dict[str, str] = {}
    for name, stem in zip(declared, stems):
        module = parsed[name]
        rows = staged_rows[stem]
        for symbol in sorted(module.exports):
            export_type, crc, runtime_namespace = module.exports[symbol]
            if symbol in kernel_rows:
                raise ContractError(f"duplicate provider for {symbol}: vmlinux and {name}")
            if symbol in providers:
                raise ContractError(f"duplicate provider for {symbol}: {providers[symbol]} and {name}")
            providers[symbol] = name
            row = rows.get(symbol)
            if row is None:
                raise ContractError(f"export {symbol} of {name} has no Module.symvers record")
            if row.export_type != export_type:
                raise ContractError(f"export {symbol} of {name} has a different export type")
            if crc is not None and crc != row.crc:
                raise ContractError(f"export {symbol} of {name} has a different CRC")
            if row.namespace != runtime_namespace:
                raise ContractError(
                    f"export {symbol} of {name} has a different runtime namespace"
                )
        for symbol in sorted(set(rows) - set(module.exports)):
            raise ContractError(f"Module.symvers lists {symbol} for {name} but the module does not export it")

    report = []
    edges: dict[str, set[str]] = {name: set() for name in declared}
    for name in declared:
        module = parsed[name]
        imports = []
        for symbol in sorted(module.imports):
            if symbol in kernel_rows:
                row, provider = kernel_rows[symbol], "kernel"
            elif symbol in providers:
                provider = providers[symbol]
                row = staged_rows[normalize_module_name(provider)][symbol]
                edges[name].add(provider)
                provider = f"module:{provider}"
            elif symbol in outside:
                if outside[symbol] in forbidden:
                    raise ContractError(f"{name} imports {symbol} from forbidden module {outside[symbol]}")
                raise ContractError(
                    f"{name} imports {symbol} from {outside[symbol]}, outside the staged set"
                )
            else:
                raise ContractError(f"{name} has an unresolved import: {symbol}")
            if row.namespace and row.namespace not in module.import_namespaces:
                raise ContractError(f"{name} imports {symbol} without import_ns {row.namespace}")
            if row.export_type.endswith("_GPL") and module.license not in GPL_COMPATIBLE_LICENSES:
                shown = module.license if module.license is not None else "missing"
                raise ContractError(
                    f"{name} imports GPL-only symbol {symbol} with incompatible license {shown}"
                )
            if module.versions is None:
                crc_status = "unversioned"
            elif module.versions[symbol] != row.crc:
                raise ContractError(f"{name} import {symbol} has a CRC mismatch")
            else:
                crc_status = "match"
            imports.append({
                "bind": module.imports[symbol],
                "crc_status": crc_status,
                "namespace": row.namespace,
                "provider": provider,
                "provider_crc": f"0x{row.crc:08x}",
                "symbol": symbol,
            })
        exports = [
            {
                "crc": None if module.exports[symbol][1] is None else f"0x{module.exports[symbol][1]:08x}",
                "crc_status": "module-matches-symvers" if module.exports[symbol][1] is not None else "module-has-no-crc",
                "export_type": module.exports[symbol][0],
                "namespace": module.exports[symbol][2],
                "symbol": symbol,
            }
            for symbol in sorted(module.exports)
        ]
        report.append({
            "depends_on": sorted(edges[name]),
            "exports": exports,
            "imports": imports,
            "member": f"modules/{name}.ko",
            "license": module.license,
            "modinfo_name": module.name,
            "name": name,
            "sha256": sha256_bytes(payload[f"modules/{name}.ko"]),
            "module_layout": (
                "absent" if module.module_layout_crc is None else "kernel-crc-match"
            ),
            "versions": module.versions_format,
        })

    position = {name: index for index, name in enumerate(declared)}
    remaining = {name: set(edges[name]) for name in declared}
    ready = [position[name] for name in declared if not remaining[name]]
    heapq.heapify(ready)
    resolved: list[str] = []
    while ready:
        current = declared[heapq.heappop(ready)]
        resolved.append(current)
        for name in declared:
            if current in remaining[name]:
                remaining[name].discard(current)
                if not remaining[name]:
                    heapq.heappush(ready, position[name])
    if len(resolved) != len(declared):
        raise ContractError(
            "dependency cycle among: " + ", ".join(sorted(name for name in declared if name not in resolved))
        )
    for name in declared:
        for provider in sorted(edges[name]):
            if position[provider] > position[name]:
                raise ContractError(f"declared order loads {name} before its provider {provider}")
    return {
        "schema": 1,
        "status": "staged-set-consistent",
        "scope": "staged-set-only",
        "vendor_modules": "not-verified",
        "activation": reference["activation"]["mode"],
        "parser": "linux-gki-layouts-offline-unqualified-on-real-modules",
        "deployment_blocker": "unchanged",
        "device": reference["device"]["codename"],
        "kernel_release": kernel_ref["release"],
        "vermagic": next(iter(vermagics)),
        "reference_sha256": contracts.reference_sha256,
        "stage_contract_sha256": contracts.stage_sha256,
        "archive_sha256": assets["archive_sha256"],
        "vmlinux_symvers_sha256": kernel_ref["vmlinux_symvers_sha256"],
        "module_symvers_sha256": kernel_ref["module_symvers_sha256"],
        "declared_order": declared,
        "resolved_order": resolved,
        "modules": report,
    }


def verify_abi_paths(contracts: Contracts, archive: str, vmlinux: str, module_symvers: str) -> dict:
    archive_data = read_canonical_regular(archive, "module asset archive", MAX_ARCHIVE_BYTES)
    vmlinux_data = read_canonical_regular(vmlinux, "vmlinux.symvers", MAX_SYMVERS_BYTES)
    module_data = read_canonical_regular(
        module_symvers, "kernel_aarch64_Module.symvers", MAX_SYMVERS_BYTES
    )
    return verify_abi_bytes(contracts, archive_data, vmlinux_data, module_data)


def parser() -> argparse.ArgumentParser:
    command = argparse.ArgumentParser(description=__doc__)
    subcommands = command.add_subparsers(dest="command", required=True)
    subcommands.add_parser("show", help="print reviewed metadata; no files are changed")
    kernel = subcommands.add_parser("verify-kernel", help="verify an external qualified kernel/module set")
    kernel.add_argument("--image", type=Path, required=True)
    kernel.add_argument("--notes", type=Path, required=True)
    kernel.add_argument("--config", type=Path, required=True)
    kernel.add_argument("--vmlinux-symvers", type=Path, required=True)
    kernel.add_argument("--module-symvers", type=Path, required=True)
    kernel.add_argument("--assets", type=Path, required=True)
    subcommands.add_parser("show-stage", help="print the reviewed stage contract; no files are changed")
    plan = subcommands.add_parser("plan-stage", help="print the exact stage plan for an archive; no files are changed")
    plan.add_argument("--assets", type=Path, required=True)
    stage = subcommands.add_parser("verify-stage", help="verify an external stage tree read-only")
    stage.add_argument("--assets", type=Path, required=True)
    stage.add_argument("--root", required=True)
    abi = subcommands.add_parser(
        "verify-abi", help="verify the staged modules' ABI, imports and load order offline"
    )
    abi.add_argument("--assets", required=True)
    abi.add_argument("--vmlinux-symvers", required=True)
    abi.add_argument("--module-symvers", required=True)
    runtime = subcommands.add_parser("verify-runtime", help="verify private runtime assets read-only")
    runtime.add_argument("--manifest", type=Path, required=True)
    runtime.add_argument("--root", type=Path, required=True)
    runtime.add_argument("--features", default="", help="comma-separated feature names; default: all")
    return command


def main() -> int:
    args = parser().parse_args()
    try:
        if args.command == "show-stage":
            print(json.dumps(load_contracts().stage, indent=2, sort_keys=True))
            return 0
        if args.command in ("plan-stage", "verify-stage"):
            plan = build_stage_plan(load_contracts(), args.assets)
            print(json.dumps(
                plan if args.command == "plan-stage" else verify_stage_tree(plan, args.root),
                indent=2, sort_keys=True,
            ))
            return 0
        if args.command == "verify-abi":
            print(json.dumps(
                verify_abi_paths(
                    load_contracts(), args.assets, args.vmlinux_symvers, args.module_symvers
                ),
                indent=2, sort_keys=True,
            ))
            return 0
        reference = load_reference()
        if args.command == "show":
            print(json.dumps(reference, indent=2, sort_keys=True))
            return 0
        if args.command == "verify-kernel":
            result = verify_kernel_inputs(reference, {
                "image": args.image,
                "notes": args.notes,
                "config": args.config,
                "vmlinux_symvers": args.vmlinux_symvers,
                "module_symvers": args.module_symvers,
                "assets": args.assets,
            })
        else:
            features = set()
            if args.features:
                parts = args.features.split(",")
                if any(not FEATURE.fullmatch(part) for part in parts) or len(parts) != len(set(parts)):
                    raise ContractError("--features must contain unique comma-separated feature names")
                features = set(parts)
            result = verify_runtime_assets(reference, args.manifest, args.root, features)
        print(json.dumps(result, sort_keys=True))
        return 0
    except ContractError as error:
        print(f"ERROR: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
