# stage-contract mutations
def rejects_contract(label, change):
    stage = json.loads(json.dumps(contracts.stage))
    change(stage)
    try:
        module.build_stage_plan(
            module.Contracts(contracts.reference, contracts.reference_sha256, stage, "0" * 64),
            archive,
        )
    except module.ContractError:
        return
    raise AssertionError(f"{label}: accepted")
rejects_contract("unknown field", lambda s: s.update(extra=True))
rejects_contract("missing field", lambda s: s.pop("forbidden"))
rejects_contract("wrong binding", lambda s: s.update(reference_sha256="9" * 64))
rejects_contract("bool as int", lambda s: s["stage"].update(boot_payload=0))
rejects_contract("image true", lambda s: s["stage"].update(image=True))
rejects_contract("boot payload true", lambda s: s["stage"].update(boot_payload=True))
rejects_contract("activation", lambda s: s["stage"].update(activation="enabled"))
rejects_contract("mutable", lambda s: s["stage"].update(mutability="mutable"))
rejects_contract("payload", lambda s: s["stage"].update(payload="binary"))
rejects_contract("schema", lambda s: s.update(schema=True))
rejects_contract("device", lambda s: s["device"].update(soc="other"))
rejects_contract("owned file", lambda s: s["layout"].update(owned_files=[]))
rejects_contract("selector mode", lambda s: s["layout"]["selector"].update(mode="0644"))
rejects_contract("module mode", lambda s: s["layout"]["module_file"].update(mode="0755"))
rejects_contract("module subdirectory", lambda s: s["layout"]["module_file"].update(destination=s["layout"]["module_directory"] + "/modules/{name}.ko"))
rejects_contract("global file mode", lambda s: s["layout"].update(file_mode="0644"))
rejects_contract("owned dir", lambda s: s["layout"]["owned_directories"].append("/usr/lib/modules"))
rejects_contract("selector destination", lambda s: s["layout"]["selector"].update(destination="/usr/local/bin/x"))
rejects_contract("forbidden shrunk", lambda s: s["forbidden"]["absent"].remove("/boot"))
rejects_contract("module suffix list", lambda s: s["forbidden"]["module_suffixes_outside_owned_files"].pop())

