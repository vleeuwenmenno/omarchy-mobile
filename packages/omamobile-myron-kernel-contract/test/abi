def swapped_merged_crc_order(spec):
    spec["modules"]["alpha"].update(
        exports=[("alpha_fn", "EXPORT_SYMBOL", 0x11110001),
                 ("alpha_extra", "EXPORT_SYMBOL", 0x11110002)],
        ksymtab_size=12, export_symbols="local-label", crc_layout="section",
        merged_exports=True, real_export_names=True,
        crc_symbol_offsets={"alpha_fn": 0, "alpha_extra": 4})
    spec["extra_module_rows"] = [
        row(0x11110002, "alpha_fn", "drivers/x/alpha")
        if "\talpha_fn\t" in entry else entry
        for entry in spec["extra_module_rows"]
    ]
    spec["extra_module_rows"].append(
        row(0x11110001, "alpha_extra", "drivers/x/alpha"))
    spec["modules"]["beta"]["versions"][0] = ("alpha_fn", 0x11110002)
rejects_spec("merged CRC order differs from export order",
             "merged CRC table does not match export-table order",
             swapped_merged_crc_order)

