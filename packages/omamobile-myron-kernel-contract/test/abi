def cycle(spec):
    spec["modules"]["alpha"].update(
        imports=[("beta_fn", "global")], versions=[("beta_fn", 0x22220001)])
    spec["modules"]["beta"].update(
        imports=[("alpha_fn", "global")], versions=[("alpha_fn", 0x11110001)])
rejects_spec("dependency cycle", "dependency cycle among: alpha, beta", cycle)
def wrong_order(spec):
    spec["declared"] = ["beta", "alpha", "gamma-mod"]
rejects_spec("wrong order", "declared order loads beta before its provider alpha", wrong_order)
def forbidden_staged(spec):
    spec["declared"].append("rmnet_core")
    spec["modules"]["rmnet_core"] = dict(imports=[], versions=None, exports=[])
rejects_spec("forbidden module staged",
