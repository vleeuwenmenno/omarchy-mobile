def unterminate(field_name):
    def apply(buf):
        p, f = shdr(buf, section_index(buf, field_name), "offset")
        q, g = shdr(buf, section_index(buf, field_name), "size")
        offset = struct.unpack_from(f, buf, p)[0]
        size = struct.unpack_from(g, buf, q)[0]
        buf[offset + size - 1] = ord("x")
    return apply
