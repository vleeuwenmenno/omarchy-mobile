    spec["declared"].append("rmnet_core")
    spec["modules"]["rmnet_core"] = dict(imports=[], versions=None, exports=[])
rejects_spec("forbidden module staged",
             ("reference module allowlist or conflict set differs", "forbidden module is staged"),
