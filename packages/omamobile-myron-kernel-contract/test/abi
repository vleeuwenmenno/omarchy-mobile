changed_stage = copy.deepcopy(good.contracts.stage)
changed_stage["stage"]["activation"] = "enabled"
try:
    module.verify_abi_bytes(
        module.Contracts(good.contracts.reference, good.contracts.reference_sha256,
                         changed_stage, good.contracts.stage_sha256),
        good.archive, good.vm, good.mod)
except module.ContractError as error:
    assert "stage contract differs" in str(error)
else:
    raise AssertionError("ABI verification accepted a changed stage contract")

# ---- paths: determinism, read-only, no external process --------------------
paths = {}
for key, data in (("assets", good.archive), ("vm", good.vm), ("mod", good.mod)):
    path = work / key
    path.write_bytes(data)
    path.chmod(0o444)
    paths[key] = str(path)
def snapshot():
    return {name: (p.read_bytes(), p.stat().st_mode, p.stat().st_mtime_ns)
            for name, p in ((k, Path(v)) for k, v in paths.items())} | {
        "dir": sorted(os.listdir(work))}
before = snapshot()
opened_flags = []
real_open = os.open
def spy_open(path, flags, *a, **k):
    opened_flags.append(flags)
    return real_open(path, flags, *a, **k)
def blocked(*a, **k):
    raise AssertionError("external process or write primitive used")
saved = {}
for owner, attr in ((subprocess, "Popen"), (subprocess, "run"), (os, "system"), (os, "fork"),
                    (os, "posix_spawn"), (os, "execv"), (os, "execve"), (os, "popen"),
                    (os, "mkdir"), (os, "rename"), (os, "unlink"), (os, "chmod"), (os, "write")):
    saved[(owner, attr)] = getattr(owner, attr)
    setattr(owner, attr, blocked)
os.open = spy_open
try:
    first = module.verify_abi_paths(good.contracts, paths["assets"], paths["vm"], paths["mod"])
    second = module.verify_abi_paths(good.contracts, paths["assets"], paths["vm"], paths["mod"])
finally:
    os.open = real_open
    for (owner, attr), value in saved.items():
        setattr(owner, attr, value)
assert json.dumps(first, sort_keys=True) == json.dumps(second, sort_keys=True) == json.dumps(result, sort_keys=True)
write_bits = os.O_WRONLY | os.O_RDWR | os.O_CREAT | os.O_TRUNC | os.O_APPEND
assert opened_flags and all(not flags & write_bits for flags in opened_flags)
assert snapshot() == before
source = bin_path.read_text()
for token in ("import subprocess", "os.system", "os.popen", "mmap", "ctypes", "os.fork", "posix_spawn"):
    assert token not in source, token

# ---- path handling -------------------------------------------------------------
def path_rejects(expected, *args):
    try:
        module.verify_abi_paths(good.contracts, *args)
    except module.ContractError as error:
        assert expected in str(error), str(error)
    else:
        raise AssertionError(f"accepted {args}")
path_rejects("canonical absolute path", "assets", paths["vm"], paths["mod"])
path_rejects("canonical absolute path", paths["assets"], paths["vm"] + "/../vm", paths["mod"])
path_rejects("canonical absolute path", paths["assets"], paths["vm"] + "/", paths["mod"])
link = work / "link"
link.symlink_to(paths["vm"])
path_rejects("link", paths["assets"], str(link), paths["mod"])
(work / "dirlink").symlink_to(work, target_is_directory=True)
path_rejects("symlink", paths["assets"], str(work / "dirlink" / "vm"), paths["mod"])
fifo = work / "fifo"
os.mkfifo(fifo)
path_rejects("not a regular file", paths["assets"], str(fifo), paths["mod"])
path_rejects("unavailable", paths["assets"], str(work / "absent"), paths["mod"])
big = work / "big"
with big.open("wb") as stream:
    stream.truncate(module.MAX_SYMVERS_BYTES + 1)
path_rejects("safety limit", paths["assets"], str(big), paths["mod"])
Path(paths["vm"]).chmod(0o644)
Path(paths["vm"]).write_bytes(good.vm + b"x")
path_rejects("vmlinux.symvers SHA-256 differs", paths["assets"], paths["vm"], paths["mod"])
Path(paths["vm"]).write_bytes(good.vm)

# ---- exact input binding --------------------------------------------------------
rejects("wrong vmlinux symvers hash", "vmlinux.symvers SHA-256 differs", vm=good.vm + b"\n")
rejects("wrong Module.symvers hash", "kernel_aarch64_Module.symvers SHA-256 differs",
        mod=good.mod + b"\n")
tampered = bytearray(good.archive)
tampered[-12] ^= 1
rejects("changed archive", "archive SHA-256 differs", archive=bytes(tampered))
rejects("changed archive hash", "archive SHA-256 differs", archive=good.archive + b"\0")
rejects("missing module member", "member set differs",
        make(drop_member="modules/beta.ko"))
rejects("extra module member", "member set differs", make(extra_member="modules/extra.ko"))

# ---- ELF structure -----------------------------------------------------------------
def elf_case(label, expected, **options):
    def mutate(spec):
        mod = spec["modules"]["alpha"]
        fix = options.pop("fix", None)
        if fix:
            spec["elf_fix"]["alpha"] = fix
        mod.update(options)
    rejects_spec(label, expected, mutate)

elf_case("not ELF", "not an ELF file", fix=raw(0, b"\x7fELG"))
elf_case("class 32", "ELFCLASS64", ei_class=1)
elf_case("big endian", "little-endian", ei_data=2)
elf_case("wrong machine", "not AArch64", machine=62)
elf_case("wrong type", "ET_REL", e_type=2)
elf_case("bad ident version", "identification", fix=raw(6, b"\x02"))
elf_case("bad osabi", "identification", fix=raw(7, b"\x03"))
elf_case("e_version", "header fields", fix=raw(20, struct.pack("<I", 2)))
elf_case("program headers", "header fields", fix=raw(32, struct.pack("<Q", 64)))
elf_case("shentsize", "section header table", fix=raw(58, struct.pack("<H", 32)))
elf_case("zero sections", "section header table", fix=raw(60, struct.pack("<H", 0)))
elf_case("too many sections", "section header table", fix=raw(60, struct.pack("<H", 5000)))
elf_case("shstrndx range", "name table index", fix=raw(62, struct.pack("<H", 60)))
elf_case("shoff out of bounds", "out of bounds", fix=raw(40, struct.pack("<Q", 1 << 40)))
elf_case("shoff in header", "out of bounds", fix=raw(40, struct.pack("<Q", 8)))
elf_case("shoff beyond file", "out of bounds", fix=lambda b: b.__delitem__(slice(-70, None)))
elf_case("section offset OOB", "out of bounds", fix=patch_named(".modinfo", "offset", 1 << 40))
elf_case("section size OOB", "out of bounds", fix=patch_named(".modinfo", "size", 1 << 40))
elf_case("section offset overflow", "out of bounds",
         fix=patch_named(".modinfo", "offset", (1 << 64) - 8))
def overlap(buf):
    p, f = shdr(buf, section_index(buf, ".symtab"), "offset")
    patch_named(".strtab", "offset", struct.unpack_from(f, buf, p)[0])(buf)
elf_case("overlap", "overlaps", fix=overlap)
elf_case("compressed section", "compressed", fix=patch_named(".modinfo", "flags", 0x802))
elf_case("malformed RELA section", "relocation section 3 is malformed",
         extra_sections=[(".rela.bad", 4, 0, b"x", 999, 999, 24)])
elf_case("RELA without INFO_LINK", "relocation section 3 is malformed",
         extra_sections=[(".rela.___ksymtab+alpha_fn", 4, 0, bytes(24), 5, 2, 24)])

def relocation_spec(kind="rela", records=None):
    records = records or ([(0, 0, 257, 0), (4, 0, 261, 0), (8, 0, 261, 0)] if kind == "rela"
                          else [(0, 0, 257), (4, 0, 261), (8, 0, 261)])
    return [(f".{kind}.___ksymtab+alpha_fn", "___ksymtab+alpha_fn", kind, records)]

def real_layout(spec, kind="rela"):
    spec["modules"]["alpha"].update(
        ksymtab_size=12, export_symbols="local-label", crc_layout="section",
        real_export_names=True, runtime_name_relocation_kind=kind)

rejects_spec("allocated AArch64 REL relocation", "REL relocations for an allocated section",
             lambda s: real_layout(s, "rel"))
