for export_entry_size in (12, 24):
    rejects_spec(
        f"{export_entry_size}-byte export runtime-name addend changes target",
        "export label and runtime name differ",
        lambda s, size=export_entry_size: s["modules"]["alpha"].update(
            ksymtab_size=size, export_symbols="local-label", crc_layout="section",
            merged_exports=True, real_export_names=True,
            runtime_name_addends={"alpha_fn": 1}),
