# ---- symvers format ------------------------------------------------------------------------------------
def symvers_case(label, expected, text, where="vm"):
    kwargs = {"vm_text": text} if where == "vm" else {"mod_text": text}
    rejects(label, expected, make(**kwargs))
good_row = row(0xAAAA0001, "printk", "vmlinux")
for where in ("vm", "mod"):
    symvers_case("four fields", "five tab-separated", "0xaaaa0001\tprintk\tvmlinux\tEXPORT_SYMBOL\n", where)
    symvers_case("six fields", "five tab-separated", good_row[:-1] + "\tx\n", where)
    symvers_case("no newline", "LF-terminated", good_row[:-1], where)
    symvers_case("empty", "LF-terminated", "", where)
    symvers_case("blank line", "five tab-separated", good_row + "\n", where)
    symvers_case("crlf", "LF-terminated", good_row[:-1] + "\r\n", where)
    symvers_case("uppercase crc", "invalid CRC", row(0xABCDEF01, "printk", "vmlinux").replace("0xabcdef01", "0xABCDEF01"), where)
    symvers_case("short crc", "invalid CRC", "0x1\tprintk\tvmlinux\tEXPORT_SYMBOL\t\n", where)
    symvers_case("bad symbol", "invalid symbol", "0x00000001\t1bad\tvmlinux\tEXPORT_SYMBOL\t\n", where)
    symvers_case("long symbol", "invalid symbol", row(1, "a" * 56, "vmlinux"), where)
    symvers_case("bad type", "invalid export type", "0x00000001\tx\tvmlinux\tEXPORT\t\n", where)
    symvers_case("bad namespace", "invalid namespace", "0x00000001\tx\tvmlinux\tEXPORT_SYMBOL\tn s\n", where)
    symvers_case("bad provider", "invalid provider", "0x00000001\tx\t\tEXPORT_SYMBOL\t\n", where)
    symvers_case("duplicate row", "duplicate record for printk", good_row + good_row, where)
    symvers_case("conflicting row", "conflicting record for printk",
                 good_row + row(0xAAAA0009, "printk", "vmlinux"), where)
    symvers_case("NUL byte", "NUL or CR", good_row[:-1] + "\0\n", where)
rejects("non-UTF8", "is not UTF-8", make(vm_text=b"\xff\xfe\n"))
rejects("non-UTF8 module symvers", "is not UTF-8", make(mod_text=b"\xff\xfe\n"))
