# ---- paths: determinism, read-only, no external process --------------------
paths = {}
for key, data in (("assets", good.archive), ("vm", good.vm), ("mod", good.mod)):
    path = work / key
    path.write_bytes(data)
    path.chmod(0o444)
    paths[key] = str(path)
def snapshot():
    return {name: (p.read_bytes(), p.stat().st_mode, p.stat().st_mtime_ns)
            for name, p in ((k, Path(v)) for k, v in paths.items())} | {
        "dir": sorted(os.listdir(work))}
before = snapshot()
opened_flags = []
real_open = os.open
def spy_open(path, flags, *a, **k):
    opened_flags.append(flags)
    return real_open(path, flags, *a, **k)
def blocked(*a, **k):
    raise AssertionError("external process or write primitive used")
saved = {}
for owner, attr in ((subprocess, "Popen"), (subprocess, "run"), (os, "system"), (os, "fork"),
                    (os, "posix_spawn"), (os, "execv"), (os, "execve"), (os, "popen"),
                    (os, "mkdir"), (os, "rename"), (os, "unlink"), (os, "chmod"), (os, "write")):
    saved[(owner, attr)] = getattr(owner, attr)
    setattr(owner, attr, blocked)
os.open = spy_open
try:
    first = module.verify_abi_paths(good.contracts, paths["assets"], paths["vm"], paths["mod"])
    second = module.verify_abi_paths(good.contracts, paths["assets"], paths["vm"], paths["mod"])
finally:
    os.open = real_open
    for (owner, attr), value in saved.items():
        setattr(owner, attr, value)
assert json.dumps(first, sort_keys=True) == json.dumps(second, sort_keys=True) == json.dumps(result, sort_keys=True)
write_bits = os.O_WRONLY | os.O_RDWR | os.O_CREAT | os.O_TRUNC | os.O_APPEND
