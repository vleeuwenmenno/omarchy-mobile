def shdr(buf, index, field):
    shoff = struct.unpack_from("<Q", buf, 40)[0]
    layout = {"name": (0, "<I"), "type": (4, "<I"), "flags": (8, "<Q"), "offset": (24, "<Q"),
              "size": (32, "<Q"), "link": (40, "<I"), "info": (44, "<I"), "entsize": (56, "<Q")}
    delta, fmt = layout[field]
    return shoff + 64 * index + delta, fmt

def patch(index, field, value):
    def apply(buf):
        position, fmt = shdr(buf, index, field)
        struct.pack_into(fmt, buf, position, value)
    return apply

def section_index(buf, wanted):
    shnum = struct.unpack_from("<H", buf, 60)[0]
    shstrndx = struct.unpack_from("<H", buf, 62)[0]
    p, f = shdr(buf, shstrndx, "offset")
    names = struct.unpack_from(f, buf, p)[0]
    for index in range(1, shnum):
        p, f = shdr(buf, index, "name")
        start = names + struct.unpack_from(f, buf, p)[0]
        if buf[start:buf.index(0, start)].decode() == wanted:
            return index
    raise KeyError(wanted)

def patch_named(wanted, field, value):
    def apply(buf):
        patch(section_index(buf, wanted), field, value)(buf)
    return apply

def patch_symbol(index, field, value):
    def apply(buf):
        position, fmt = shdr(buf, section_index(buf, ".symtab"), "offset")
        base = struct.unpack_from(fmt, buf, position)[0] + index * 24
        delta, value_fmt = {
            "info": (4, "<B"), "other": (5, "<B"),
            "value": (8, "<Q"), "size": (16, "<Q"),
        }[field]
        struct.pack_into(value_fmt, buf, base + delta, value)
    return apply

def raw(offset, data):
    def apply(buf):
        buf[offset:offset + len(data)] = data
    return apply

# ---- fixture generator -------------------------------------------------------
def row(crc, symbol, provider, kind="EXPORT_SYMBOL", namespace=""):
    return f"0x{crc:08x}\t{symbol}\t{provider}\t{kind}\t{namespace}\n"

def default_spec():
    return {
        "declared": ["alpha", "beta", "gamma-mod"],
        "modules": {
            "alpha": dict(imports=[("printk", "global")], versions=[("printk", 0xAAAA0001)],
                          exports=[("alpha_fn", "EXPORT_SYMBOL", 0x11110001)]),
            "beta": dict(imports=[("alpha_fn", "global"), ("kernel_fn", "weak")],
                         versions=[("alpha_fn", 0x11110001), ("kernel_fn", 0xAAAA0002)],
                         exports=[("beta_fn", "EXPORT_SYMBOL_GPL", None)]),
            "gamma-mod": dict(imports=[("beta_fn", "global"), ("ns_sym", "global")],
                              versions=[("beta_fn", 0x22220001), ("ns_sym", 0xAAAA0003)],
                              modinfo=["name=gamma_mod", f"vermagic={VERMAGIC}",
                                       "license=GPL", "import_ns=MYNS"],
                              exports=[]),
        },
        "kernel_rows": [row(0xAAAA0001, "printk", "vmlinux"),
                        row(0xAAAA0002, "kernel_fn", "vmlinux", "EXPORT_SYMBOL_GPL"),
                        row(0xAAAA0003, "ns_sym", "vmlinux", "EXPORT_SYMBOL_GPL", "MYNS")],
        "extra_module_rows": [
            row(0xAAAA0001, "printk", "vmlinux"),
            row(0x11110001, "alpha_fn", "drivers/x/alpha"),
            row(0x22220001, "beta_fn", "drivers/x/beta", "EXPORT_SYMBOL_GPL"),
            row(0x33330001, "other_sym", "drivers/o/other"),
            row(0x44440001, "rmnet_sym", "drivers/net/rmnet_core"),
        ],
        "elf_fix": {},
        "forbidden_staged": False,
    }

counter = [0]
class Fixture:
    pass

def make(spec=None, *, drop_member=None, extra_member=None, vm_text=None, mod_text=None,
         payload_override=None):
    spec = spec or default_spec()
    counter[0] += 1
    fx = Fixture()
    fx.spec = spec
    notes = b"synthetic-notes\n"
    directory = f"/usr/local/lib/myron-gki-module-sets/{sha(notes)}"
    modules = {}
    for name in spec["declared"]:
        options = dict(spec["modules"][name])
        options["fix"] = spec["elf_fix"].get(name)
        modules[name] = build_elf(name.replace("-", "_"), **options)
    payload = {
        "candidate-module-dir.sh": b"#!/bin/sh\nexit 0\n",
        "previous-module-dir.sh": b"#!/bin/sh\nexit 1\n",
        "kernel-notes.bin": notes,
        **{f"modules/{n}.ko": data for n, data in modules.items()},
    }
    if drop_member:
        del payload[drop_member]
    if extra_member:
        payload[extra_member] = b"extra"
    payload.update(payload_override or {})
    manifest = {
        "phase": "inactive-staging-payload-only",
        "candidate_image_sha256": sha(b"image"), "candidate_config_sha256": sha(b"config"),
        "candidate_notes_sha256": sha(notes), "module_directory": directory,
        "files": {n: sha(d) for n, d in sorted(payload.items())},
        "selector_destination": SELECTOR,
    }
    payload["manifest.json"] = (json.dumps(manifest, sort_keys=True) + "\n").encode()
    payload["SHA256SUMS"] = "".join(f"{sha(d)}  {n}\n" for n, d in sorted(payload.items())).encode()
    buffer = io.BytesIO()
    with gzip.GzipFile(filename="", mode="wb", fileobj=buffer, mtime=0) as zipped:
        with tarfile.open(fileobj=zipped, mode="w") as tar:
            for n, d in sorted(payload.items()):
                info = tarfile.TarInfo("fixture/" + n)
                info.size, info.mode = len(d), 0o644
                tar.addfile(info, io.BytesIO(d))
    fx.archive = buffer.getvalue()
    if vm_text is None:
        vm_text = "".join(spec["kernel_rows"])
    fx.vm = vm_text if isinstance(vm_text, bytes) else vm_text.encode()
    mod_rows = "".join(spec["extra_module_rows"])
    if mod_text is None:
        mod_text = mod_rows
    fx.mod = mod_text if isinstance(mod_text, bytes) else mod_text.encode()
    stage_modules = list(spec["declared"])
    reference = {
        "schema": 1,
        "device": {"codename": "myron", "compatible": "qcom,canoe-mtp", "soc": "sm8850",
                   "model_contains": "Myron", "boot_method": "external-android"},
        "kernel": {"release": RELEASE, "gki_source_revision": "0" * 40,
                   "image_sha256": sha(b"image"), "notes_sha256": sha(notes),
                   "config_sha256": sha(b"config"),
                   "vmlinux_symvers_sha256": sha(fx.vm), "module_symvers_sha256": sha(fx.mod)},
        "source": {"lock_sha256": "2" * 64, "manifest_sha256": "3" * 64,
                   "patches": {"0001-test.patch": "4" * 64}},
        "module_assets": {
            "archive_sha256": sha(fx.archive), "root": "fixture", "module_directory": directory,
            "candidate_selector_sha256": sha(payload["candidate-module-dir.sh"]),
            "previous_selector_sha256": sha(payload["previous-module-dir.sh"]),
            "forbidden_modules": ["rmnet_core"], "modules": stage_modules},
        "runtime_assets": {"manifest_sha256": "7" * 64},
        "activation": {"mode": "disabled", "source_lock_reproduction": "not_verified",
                       "device_qualification": "reference_evidence_only"},
        "payload": {"kind": "metadata-only"},
        "provenance": {"reference_repository_base_commit": "1" * 40,
                       "reference_worktree_state": "synthetic fixture",
                       "qualification": "test", "status": "metadata-only"},
    }
    reference_bytes = (json.dumps(reference, indent=2) + "\n").encode()
    stage = module.expected_stage_contract(reference, sha(reference_bytes))
    stage_bytes = (json.dumps(stage, indent=2) + "\n").encode()
    fx.contracts = module.Contracts(reference, sha(reference_bytes), stage, sha(stage_bytes))
    return fx

def run(fx, archive=None, vm=None, mod=None):
    return module.verify_abi_bytes(
        fx.contracts, fx.archive if archive is None else archive,
        fx.vm if vm is None else vm, fx.mod if mod is None else mod)

def rejects(label, expected, fx=None, **overrides):
    fx = fx or make()
    try:
        run(fx, **overrides)
    except module.ContractError as error:
        options = (expected,) if isinstance(expected, str) else expected
        assert any(item in str(error) for item in options), f"{label}: wrong error: {error}"
    else:
        raise AssertionError(f"{label}: was accepted")

def rejects_spec(label, expected, mutate, **kwargs):
    spec = default_spec()
    mutate(spec)
    rejects(label, expected, make(spec, **kwargs))

# ---- good set ---------------------------------------------------------------
good = make()
result = run(good)
assert result["scope"] == "staged-set-only" and result["vendor_modules"] == "not-verified"
assert result["activation"] == "disabled" and result["status"] == "staged-set-consistent"
assert result["archive_sha256"] == sha(good.archive)
assert result["vmlinux_symvers_sha256"] == sha(good.vm)
assert result["module_symvers_sha256"] == sha(good.mod)
assert result["declared_order"] == ["alpha", "beta", "gamma-mod"] == result["resolved_order"]
assert result["deployment_blocker"] == "unchanged" and "unqualified" in result["parser"]
