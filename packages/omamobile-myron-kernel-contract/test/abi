real_alpha = next(row for row in real_result["modules"] if row["name"] == "alpha")
assert real_alpha["exports"][0]["crc_status"] == "module-matches-symvers"

spec = default_spec()
spec["modules"]["alpha"].update(
    exports=[("alpha_fn", "EXPORT_SYMBOL", 0x11110001),
             ("alpha_extra", "EXPORT_SYMBOL", 0x11110002)],
