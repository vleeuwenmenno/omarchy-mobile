# CLI: wrong inputs fail closed with no output and no external tool.
cli=(python3 -I bin/omamobile-myron-kernel-verify)
printf 'x\n' > "$tmp/a"; printf 'y\n' > "$tmp/b"; printf 'z\n' > "$tmp/c"
mkdir "$tmp/fakes"; : > "$tmp/calls"
for command in ssh scp adb fastboot docker mount tar pacman depmod modprobe systemctl; do
  printf '#!/bin/sh\nprintf "%%s\\n" "%s $*" >> "$CALLS"\nexit 97\n' "$command" > "$tmp/fakes/$command"
  chmod +x "$tmp/fakes/$command"
done
for args in "--assets $tmp/c --vmlinux-symvers $tmp/a --module-symvers $tmp/b" \
            "--assets rel --vmlinux-symvers $tmp/a --module-symvers $tmp/b"; do
  # shellcheck disable=SC2086
  if CALLS="$tmp/calls" PATH="$tmp/fakes:$PATH" "${cli[@]}" verify-abi $args > "$tmp/out" 2> "$tmp/err"; then
    fail "verify-abi accepted wrong inputs"
  fi
  [[ ! -s $tmp/out ]] || fail "verify-abi printed output for a rejected input"
  grep -q '^ERROR: ' "$tmp/err" || fail "verify-abi error is not a deterministic ERROR line"
done
[[ ! -s $tmp/calls ]] || fail "verify-abi invoked an external system tool"
"${cli[@]}" verify-abi --assets "$tmp/c" 2> "$tmp/err1" && fail "missing args accepted"
"${cli[@]}" verify-kernel --help >/dev/null || fail "verify-kernel parser changed"
"${cli[@]}" verify-abi --help | grep -q -- '--vmlinux-symvers' || fail "verify-abi help"
pass "verify-abi CLI fails closed, prints nothing on error and runs no external tool"

