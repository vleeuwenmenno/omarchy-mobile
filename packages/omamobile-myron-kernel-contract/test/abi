        imports=[("beta_fn", "global")], versions=[("beta_fn", 0x22220001)])
    spec["modules"]["beta"].update(
        imports=[("alpha_fn", "global")], versions=[("alpha_fn", 0x11110001)])
rejects_spec("dependency cycle", "dependency cycle among: alpha, beta", cycle)
def wrong_order(spec):
    spec["declared"] = ["beta", "alpha", "gamma-mod"]
