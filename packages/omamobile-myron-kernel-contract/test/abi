for forbidden in ("deployment_authorized", "bootable", "flashable", "image_ready", "image-ready"):
    assert forbidden not in text, forbidden
by_name = {m["name"]: m for m in result["modules"]}
assert by_name["alpha"]["imports"][0]["provider"] == "kernel"
assert by_name["alpha"]["imports"][0]["crc_status"] == "match"
