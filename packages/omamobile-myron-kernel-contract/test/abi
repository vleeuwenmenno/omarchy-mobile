def strip_nul(buf):
    p, f = shdr(buf, section_index(buf, ".modinfo"), "offset")
    q, g = shdr(buf, section_index(buf, ".modinfo"), "size")
    offset, size = struct.unpack_from(f, buf, p)[0], struct.unpack_from(g, buf, q)[0]
    buf[offset + size - 1] = ord("x")
rejects_spec("modinfo unterminated", "not NUL-terminated", lambda s: s["elf_fix"].update(alpha=strip_nul))

