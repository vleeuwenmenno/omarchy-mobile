rejects("symvers long line", "is too long", make(vm_text=row(1, "a", "p" * 2000)))

# ---- limits ---------------------------------------------------------------------------------------------
try:
    module.parse_module_elf(b"\x7fELF" + bytes(module.MAX_MODULE_BYTES))
except module.ContractError as error:
    assert "safety limit" in str(error)
else:
    raise AssertionError("oversized module accepted")
try:
    module.parse_symvers(b"x" * (module.MAX_SYMVERS_BYTES + 1), "x", kernel=True)
except module.ContractError as error:
    assert "safety limit" in str(error)
else:
    raise AssertionError("oversized symvers accepted")
