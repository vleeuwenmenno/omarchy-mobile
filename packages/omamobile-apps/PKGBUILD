# Maintainer: Derek Ross <derekross@gmail.com>
#
# The apps a phone needs that a desktop Omarchy doesn't ship. An app joins
# `depends` once the hardware behind it works on Omarchy Mobile; until then it
# waits in `optdepends` with the reason, so the default install never shows
# an app that can't work yet.
pkgname=omamobile-apps
pkgver=$(cat "${startdir:-.}/version")
pkgrel=1
pkgdesc="Omarchy Mobile's default mobile apps (camera, maps and location, NFC tags)"
arch=(any)
url="https://github.com/derekross/omarchy-mobile"
license=(MIT)
depends=(
  gnome-maps   # location through GeoClue (omamobile-gnss feeds it the GPS)
  geoclue
  neard        # NFC tags; omamobile-shell's omamobile-nfc-open opens their web links
  omacam       # "Camera": all four cameras on libcamera, zoom across lenses (docs/CAMERA-APP-PLAN.md)
  pipewire-libcamera  # the cameras for browsers and video calls, through the camera portal
  xdg-desktop-portal-gnome  # the file chooser (hyprland-portals.conf)
  xdg-desktop-portal-gtk    # its fallback
)
backup=(etc/xdg/xdg-desktop-portal/hyprland-portals.conf)
optdepends=(
  'snapshot: a second camera app (GNOME Snapshot, shown as "Snapshot"), with video, until omacam records video'
  'gnome-calls: phone calls (waits for the modem, MODEM-PLAN M4, and a client for its RIL)'
  'chatty: SMS (waits for the modem, as gnome-calls)'
)
install=omamobile-apps.install
source=(omamobile-snapshot-name omamobile-snapshot-name.hook
        hyprland-portals.conf xdg-desktop-portal-gnome-omamobile.conf)
sha256sums=(SKIP SKIP SKIP SKIP)

package() {
  install -Dm755 omamobile-snapshot-name "$pkgdir/usr/lib/omamobile/omamobile-snapshot-name"
  install -Dm644 omamobile-snapshot-name.hook "$pkgdir/usr/share/libalpm/hooks/omamobile-snapshot-name.hook"
  install -Dm644 hyprland-portals.conf "$pkgdir/etc/xdg/xdg-desktop-portal/hyprland-portals.conf"
  install -Dm644 xdg-desktop-portal-gnome-omamobile.conf \
    "$pkgdir/usr/lib/systemd/user/xdg-desktop-portal-gnome.service.d/omamobile.conf"
}
