#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Trusted loader for the Myron external kernel-source bundle verifier.

This file is deliberately small. It opens tools/lib/myron-kernel-source-impl.py once,
without following symlinks, reads the exact bytes, then compiles and executes those
same bytes in this module's namespace, so the implementation path is never opened a
second time. The loader is reviewed in git, not pinned by the contract. Offline: no
process, no network. Every failure is one fixed, value-free line."""

import os
import sys

sys.dont_write_bytecode = True

if __name__ == "__main__":
    _here = os.path.dirname(os.path.realpath(__file__))
    sys.path[:] = [p for p in sys.path if p and os.path.realpath(p) != _here]

import hashlib
import stat

IMPLEMENTATION_PATH = "tools/lib/myron-kernel-source-impl.py"
IMPLEMENTATION_MAX_BYTES = 1024 * 1024
FAILURE = "myron-kernel-source: E_REFUSED"


def capture_implementation(root: str) -> bytes:
    """The implementation's bytes, read once from one no-follow descriptor chain."""
    parts = IMPLEMENTATION_PATH.split("/")
    flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW
    chain = [os.open(root, flags | os.O_DIRECTORY)]
    try:
        for part in parts[:-1]:
            chain.append(os.open(part, flags | os.O_DIRECTORY, dir_fd=chain[-1]))
        file = os.open(parts[-1], flags | os.O_NONBLOCK, dir_fd=chain[-1])
    finally:
        for descriptor in chain:
            os.close(descriptor)
    try:
        info = os.fstat(file)
        if not stat.S_ISREG(info.st_mode):
            raise ImportError("implementation is not a regular file")
        if info.st_uid != os.geteuid() or info.st_mode & 0o022:
            raise ImportError("implementation ownership or mode is unsafe")
        data = b""
        while len(data) <= IMPLEMENTATION_MAX_BYTES:
            block = os.read(file, IMPLEMENTATION_MAX_BYTES + 1 - len(data))
            if not block:
                break
            data += block
    finally:
        os.close(file)
    if len(data) > IMPLEMENTATION_MAX_BYTES:
        raise ImportError("implementation exceeds its byte bound")
    return data


def _load() -> None:
    root = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    try:
        data = capture_implementation(root)
    except OSError as error:
        raise ImportError("implementation cannot be read") from error
    global CAPTURED_IMPLEMENTATION_SHA256
    CAPTURED_IMPLEMENTATION_SHA256 = hashlib.sha256(data).hexdigest()
    code = compile(data, os.path.join(root, IMPLEMENTATION_PATH), "exec", dont_inherit=True)
    exec(code, globals())


if __name__ == "__main__":
    try:
        _load()
    except Exception:
        sys.stderr.write(FAILURE + "\n")
        raise SystemExit(1)
else:
    _load()
