def load_preflight_contract(
    contracts_root: Path, contracts, snapshot_contract_sha256: str
) -> tuple[dict, bytes, str]:
    d = deploy()
    data = d.read_file(
        f"{contracts_root}/{PREFLIGHT_CONTRACT_PATH}",
        "preflight contract",
        d.MAX_SMALL_BYTES,
    )
    value = d.strict_json(data, "preflight contract")
    expected = expected_preflight_contract(contracts, snapshot_contract_sha256)
    if not d.kernel().strict_equal(value, expected):
        raise PreflightError("preflight contract differs from its derived form")
    if data != d.render_json(expected):
        raise PreflightError("preflight contract is not canonical")
    return value, data, d.sha256_bytes(data)


