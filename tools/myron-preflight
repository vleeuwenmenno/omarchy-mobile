def require_hash(value, label: str, *, nullable: bool = False) -> None:
    if nullable and value is None:
        return
    if type(value) is not str or not HEX256.fullmatch(value):
        raise PreflightError(f"{label} is not a SHA-256 digest")


def snapshot_artifact_identity(
    path: str,
    contract_bytes: bytes,
    expected_document: dict,
    expected_identity: tuple[int, int],
) -> str:
    d = deploy()
    descriptor, identity = d.open_trusted_artifact(path, "snapshot identity")
    try:
        tree = d.walk_tree(
            descriptor,
            d.STAGE_LIMITS,
            allow_symlinks=False,
            keep_data=True,
            trusted_ownership=True,
            label="snapshot identity",
        )
    finally:
        os.close(descriptor)
    if identity != expected_identity:
        raise PreflightError("snapshot identity changed after verification")
    d.diff_entries(
        tree.entries,
        d.spec_entries(snapshot().snapshot_spec(contract_bytes, expected_document)),
        "snapshot identity",
    )
    sums = tree.data.get("SHA256SUMS")
    document_bytes = tree.data.get("snapshot.json")
    if sums is None or document_bytes is None:
        raise PreflightError("snapshot identity files are missing")
    document = d.strict_json(document_bytes, "snapshot identity document")
    if not d.kernel().strict_equal(document, expected_document):
        raise PreflightError("snapshot document changed after verification")
    d.recheck_trusted_artifact(path, identity, "snapshot identity")
    return d.sha256_bytes(sums)


