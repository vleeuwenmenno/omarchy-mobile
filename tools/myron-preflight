class PreflightError(Exception):
    """Preflight input or evidence differs from the reviewed refusal contract."""


_snapshot = None


def snapshot():
    global _snapshot
    if _snapshot is None:
        try:
            loader = importlib.machinery.SourceFileLoader("myron_snapshot", str(SNAPSHOT_TOOL))
            spec = importlib.util.spec_from_loader(loader.name, loader)
            module = importlib.util.module_from_spec(spec)
            loader.exec_module(module)
        except (OSError, SyntaxError) as error:
            raise PreflightError(f"cannot load the snapshot verifier: {error}") from error
        if module.VERSION != "0.1.0" or module.deploy().VERSION != "0.3.0":
            raise PreflightError("unsupported snapshot or deployment verifier version")
        _snapshot = module
    return _snapshot


def deploy():
    return snapshot().deploy()


def authority() -> dict:
    return {flag: False for flag in AUTHORITY_FLAGS}


