    return validate_request_document(document, contracts, contract_sha256)


def validate_request_document(value, contracts, contract_sha256: str) -> dict:
    d = deploy()
    s = snapshot()
    if type(value) is not dict or set(value) != {
        "schema", "kind", "format_version", "contract_sha256", "artifacts", "decision",
        "execution", "evidence", "requested_reads", "forbidden_operations", "redaction",
        "status",
    }:
        raise PreflightError("preflight request fields differ")
    if type(value["schema"]) is not int or value["schema"] != 1:
        raise PreflightError("preflight request schema differs")
    if value["kind"] != REQUEST_KIND or value["format_version"] != VERSION:
        raise PreflightError("preflight request identity differs")
    if value["contract_sha256"] != contract_sha256:
        raise PreflightError("preflight request contract hash differs")
    artifacts = value["artifacts"]
    if type(artifacts) is not dict or set(artifacts) != {"deployment_kit", "snapshot"}:
        raise PreflightError("preflight artifact bindings differ")
    kit = artifacts["deployment_kit"]
    if type(kit) is not dict or set(kit) != {"format_version", "sha256"}:
        raise PreflightError("preflight kit binding fields differ")
    if kit["format_version"] != d.VERSION:
        raise PreflightError("preflight kit format differs")
    require_hash(kit["sha256"], "preflight kit hash")
    snap = artifacts["snapshot"]
    expected_snapshot_fields = {
        "format_version", "sha256", "rootfs_digest", "rootfs_manifest_sha256",
        "archive_sha256", "runtime_status", "runtime_asset_count", "runtime_digest",
        "abi_status", "abi_scope", "abi_module_count", "abi_digest",
    }
    if type(snap) is not dict or set(snap) != expected_snapshot_fields:
        raise PreflightError("preflight snapshot binding fields differ")
    if snap["format_version"] != s.VERSION:
        raise PreflightError("preflight snapshot format differs")
    for name in ("sha256", "rootfs_digest", "rootfs_manifest_sha256", "archive_sha256"):
        require_hash(snap[name], f"preflight snapshot {name}")
    if snap["archive_sha256"] != contracts.reference["module_assets"]["archive_sha256"]:
        raise PreflightError("preflight archive identity differs from the contract")
    if snap["runtime_status"] not in ("not-bound", "verified"):
        raise PreflightError("preflight runtime status differs")
    if type(snap["runtime_asset_count"]) is not int or snap["runtime_asset_count"] < 0:
        raise PreflightError("preflight runtime asset count differs")
    require_hash(snap["runtime_digest"], "preflight runtime digest", nullable=True)
    if snap["abi_status"] not in ("not-bound", "staged-set-consistent"):
        raise PreflightError("preflight ABI status differs")
    if snap["abi_scope"] != d.ABI_SCOPE:
        raise PreflightError("preflight ABI scope differs")
    if type(snap["abi_module_count"]) is not int or snap["abi_module_count"] < 0:
        raise PreflightError("preflight ABI module count differs")
    require_hash(snap["abi_digest"], "preflight ABI digest", nullable=True)
    expected_decision = {
        "status": DECISION,
        "reason": "all-seven-blockers-open",
        "human_approval_required": True,
        "hardware_read_authorized": False,
        "deployment_authorized": False,
    }
    if not d.kernel().strict_equal(value["decision"], expected_decision):
        raise PreflightError("preflight decision differs")
    if not d.kernel().strict_equal(
        value["execution"], {"operations": [], "evidence_collected": []}
    ):
        raise PreflightError("preflight execution must remain empty")
    for actual, expected, label in (
        (value["evidence"], evidence_plan(), "evidence plan"),
        (value["requested_reads"], requested_reads(), "requested reads"),
        (value["forbidden_operations"], FORBIDDEN_OPERATIONS, "forbidden operations"),
        (value["redaction"], redaction_policy(), "redaction policy"),
        (value["status"], status_document(), "status"),
    ):
        if not d.kernel().strict_equal(actual, expected):
            raise PreflightError(f"preflight {label} differs")
    return value


def request_spec(contract_bytes: bytes, document: dict) -> list:
    d = deploy()
    files = {
        "contracts/preflight-contract.json": contract_bytes,
        "request.json": d.render_json(document),
        "status.json": d.render_json(status_document()),
        "STATUS.txt": STATUS_TEXT,
    }
    files["SHA256SUMS"] = "".join(
        f"{d.sha256_bytes(files[path])}  {path}\n" for path in sorted(files)
    ).encode("ascii")
    spec = [("contracts", "dir", 0o755, None)]
    spec += [(path, "file", 0o644, data) for path, data in files.items()]
    spec.sort(key=lambda item: item[0].encode("utf-8"))
    return spec


def read_request(path: str, contracts, contract_bytes: bytes, contract_sha256: str):
    d = deploy()
    descriptor, identity = d.open_trusted_artifact(path, "preflight request")
    try:
        tree = d.walk_tree(
            descriptor,
            d.STAGE_LIMITS,
            allow_symlinks=False,
            keep_data=True,
            trusted_ownership=True,
            label="preflight request",
        )
    finally:
        os.close(descriptor)
    raw = tree.data.get("request.json")
    if raw is None:
        raise PreflightError("preflight request has no request.json")
    document = d.strict_json(raw, "request.json")
    if raw != d.render_json(document):
        raise PreflightError("request.json is not canonical")
    validate_request_document(document, contracts, contract_sha256)
    d.diff_entries(tree.entries, d.spec_entries(request_spec(contract_bytes, document)), "preflight request")
    d.recheck_trusted_artifact(path, identity, "preflight request")
    return document, tree.directory_ids, identity


def assess_inputs(
    contracts,
    snapshot_contract_bytes: bytes,
    snapshot_contract_sha256: str,
    contract_sha256: str,
    args,
):
    s = snapshot()
    verified = s.command_verify(
        contracts, snapshot_contract_bytes, snapshot_contract_sha256, args
    )
    if verified.get("status") != "verified" or verified.get("deployment_authorized") is not False:
        raise PreflightError("snapshot did not produce refusal-preserving verified evidence")
    report = s.verify_deployment(contracts, args)
    expected_snapshot = s.snapshot_document(
        contracts, snapshot_contract_sha256, report, args.kit
    )
    snap_document, snap_ids, snap_identity = s.read_snapshot(
        args.snapshot, contracts, snapshot_contract_bytes, snapshot_contract_sha256
    )
    if not deploy().kernel().strict_equal(snap_document, expected_snapshot):
        raise PreflightError("snapshot changed after verification")
    snap_sha256 = snapshot_artifact_identity(
        args.snapshot, snapshot_contract_bytes, snap_document, snap_identity
    )
    document = request_document(contracts, contract_sha256, snap_document, snap_sha256)
    if document["artifacts"]["deployment_kit"]["sha256"] != verified["kit_sha256"]:
        raise PreflightError("verified kit identity differs from the snapshot binding")
    if document["artifacts"]["snapshot"]["rootfs_digest"] != verified["rootfs_digest"]:
        raise PreflightError("verified rootfs digest differs from the snapshot binding")
    return document, snap_ids


def command_assess(
    contracts,
    snapshot_contract_bytes: bytes,
    snapshot_contract_sha256: str,
    contract_bytes: bytes,
    contract_sha256: str,
    args,
) -> dict:
    d = deploy()
    s = snapshot()
    document, snap_ids = assess_inputs(
        contracts, snapshot_contract_bytes, snapshot_contract_sha256, contract_sha256, args
    )
    spec = request_spec(contract_bytes, document)
    expected = d.spec_entries(spec)
    protected, input_ids = s.protected_inputs(args)
    protected = [*protected, args.snapshot]
    protected_ids = frozenset(set(input_ids) | set(snap_ids))

    def verify_built(temporary_path: str, descriptor: int) -> None:
        tree = d.walk_tree(
            descriptor, d.STAGE_LIMITS, allow_symlinks=False, label="preflight request"
        )
        d.diff_entries(tree.entries, expected, "preflight request")

    d.publish(args.out, protected, protected_ids, spec, verify_built)
    sums = next(data for path, kind, mode, data in spec if path == "SHA256SUMS")
    return {
        "status": "assessed",
        "decision": DECISION,
        "request_sha256": d.sha256_bytes(sums),
        "kit_sha256": document["artifacts"]["deployment_kit"]["sha256"],
        "snapshot_sha256": document["artifacts"]["snapshot"]["sha256"],
        "blocker_count": len(d.BLOCKERS),
        "requested_read_count": len(document["requested_reads"]),
        **authority(),
    }


def command_verify(
    contracts,
    snapshot_contract_bytes: bytes,
    snapshot_contract_sha256: str,
    contract_bytes: bytes,
    contract_sha256: str,
    args,
) -> dict:
    d = deploy()
    s = snapshot()
    expected, snap_ids = assess_inputs(
        contracts, snapshot_contract_bytes, snapshot_contract_sha256, contract_sha256, args
    )
    document, request_ids, identity = read_request(
        args.request, contracts, contract_bytes, contract_sha256
    )
    if not d.kernel().strict_equal(document, expected):
        raise PreflightError("preflight request differs from re-verified inputs")
    protected, input_ids = s.protected_inputs(args)
    if any(d.paths_overlap(args.request, path) for path in [*protected, args.snapshot]):
        raise PreflightError("preflight request overlaps an input")
    if set(request_ids) & (set(input_ids) | set(snap_ids)):
        raise PreflightError("preflight request aliases an input tree")
    d.recheck_trusted_artifact(args.request, identity, "preflight request")
    return {
        "status": "verified",
        "decision": DECISION,
        "kit_sha256": document["artifacts"]["deployment_kit"]["sha256"],
        "snapshot_sha256": document["artifacts"]["snapshot"]["sha256"],
        "blocker_count": len(d.BLOCKERS),
        "requested_read_count": len(document["requested_reads"]),
        **authority(),
    }


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("show", help="print the offline refusal contract")
    assess = commands.add_parser("assess", help="write a refusal-only hardware-read request")
    snapshot().add_deployment_arguments(assess)
    assess.add_argument("--snapshot", required=True)
    assess.add_argument("--out", required=True)
    verify = commands.add_parser("verify", help="recompute every preflight request binding")
    snapshot().add_deployment_arguments(verify)
    verify.add_argument("--snapshot", required=True)
    verify.add_argument("--request", required=True)
    return parser


def main(argv: list[str] | None = None, contracts_root: Path | None = None) -> int:
    args = build_parser().parse_args(argv)
    d = deploy()
    s = snapshot()
    root = contracts_root or REPO
    try:
        contracts = d.load_contracts(root)
        snapshot_contract, snapshot_contract_bytes, snapshot_contract_sha256 = (
            s.load_snapshot_contract(root, contracts)
        )
        contract, contract_bytes, contract_sha256 = load_preflight_contract(
            root, contracts, snapshot_contract_sha256
        )
        if args.command == "show":
            result = contract
        else:
            args.rootfs_manifest = args.rootfs_manifest or args.rootfs_stage + ".MANIFEST"
            if args.command == "assess":
                result = command_assess(
                    contracts, snapshot_contract_bytes, snapshot_contract_sha256,
                    contract_bytes, contract_sha256, args,
                )
            else:
                result = command_verify(
                    contracts, snapshot_contract_bytes, snapshot_contract_sha256,
                    contract_bytes, contract_sha256, args,
                )
    except (PreflightError, s.SnapshotError, *d.handled_errors()) as error:
        print(f"ERROR: {error}", file=sys.stderr)
        return 1
    print(json.dumps(result, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
