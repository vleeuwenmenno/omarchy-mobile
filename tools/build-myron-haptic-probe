#!/bin/sh
# SPDX-License-Identifier: MIT
# Build on the host for checks, or on Myron for an attended hardware pulse.
set -eu
[ "$#" = 1 ] || { echo 'usage: build-myron-haptic-probe OUTPUT' >&2; exit 2; }
exec "${CC:-cc}" -std=c11 -D_POSIX_C_SOURCE=200809L -Wall -Wextra -Werror -O2 \
  "$(dirname "$0")/myron-haptic-probe.c" -o "$1"
