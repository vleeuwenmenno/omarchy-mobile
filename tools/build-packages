#!/bin/bash
# SPDX-License-Identifier: MIT
# Build Omarchy Mobile's packages for aarch64 on this laptop, without a phone:
# makepkg in an Arch Linux ARM container (Docker + qemu-user, tools/lib/alarm.sh),
# then sign them and the database with the key in keys/, into the
# [omamobile] repository at out/repo/aarch64 (as tools/repo-build does with
# the phone as the builder). tools/build-rootfs puts that repository into the
# root image; tools/repo-push still copies it to a running phone.
#
#   tools/build-packages [options] [packages/<name>...]
#     (no names)     every package in packages/ except the slow ones below
#     --all          every package, the slow ones too
#     --force        rebuild even when out/repo has this version already
#     --nocheck      skip the package tests
#     --check-in-container
#                    run the PKGBUILDs' check() under emulation instead of the
#                    package's test/all natively on this laptop (the default:
#                    the tests are the same, and some time out under qemu)
#     --import DIR   copy prebuilt *.pkg.tar.{zst,xz} from DIR into the repository
#                    (for example Mesa from an earlier build), then sign it
#     --list         print what would be built and what is up to date
#     --dev-unsigned DEVELOPMENT ONLY, not a release: build into the separate,
#                    unsigned repository out/dev-unsigned/repo/aarch64 (marked
#                    inside, never out/repo), index it without any signature,
#                    and let the build containers trust it as
#                    SigLevel = Optional TrustedOnly. Refuses to run where
#                    keys/fingerprint or keys/gnupg exist. Only this flag
#                    selects the mode; no environment variable does.
#                    docs/myron/DEV-UNSIGNED.md has the Myron command.
#
# Mesa, Hyprland and libcamera are large C/C++ builds: under qemu-user on a
# laptop they take hours (Mesa the longest). They're built only when named or
# with --all, and only once per version, since out/repo keeps them.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
ROOT=$PWD
source tools/lib/alarm.sh
source tools/lib/dev-repo.sh

SLOW=(mesa mesa-myron-zink-turnip hyprland libcamera)
dev=0
all=0 force=0 nocheck=0 container_check=0 list=0 imports=() dirs=()
while (($#)); do
  case $1 in
    --all) all=1 ;;
    --force) force=1 ;;
    --nocheck) nocheck=1 ;;
    --check-in-container) container_check=1 ;;
    --list) list=1 ;;
    --dev-unsigned) dev=1 ;;
    --import) imports+=("${2:?--import needs a directory}"); shift ;;
    -h|--help) sed -n '3,30p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) alarm_die "unknown option $1" ;;
    *) dirs+=("${1%/}") ;;
  esac
  shift
done

# Default order: dependencies of our own packages first (check() of a later
# package can then install an earlier one from the repository being built).
ORDER=(omamobile-keyring qrtr libqmi modemmanager rmtfs tqftpserv audioreach-kernel-headers tinyalsa audioreach-graphservices audioreach-conf audioreach-graphmgr fastrpc libfprint neard omacam omamobile-apps omamobile-apps-myron omamobile-device-cheetah omamobile-device-felix omamobile-myron-kernel-contract omamobile-device-myron omamobile-audio
       omamobile-sensors omamobile-gnss omamobile-fingerprint omamobile-mirror omamobile-omarchy omamobile-owl-widgets omamobile-shell
       omamobile-modem omamobile-modem-sit omamobile-mmd omamobile-speaker-tuning omamobile-waydroid
       omamobile-firstboot mesa mesa-myron-zink-turnip omamobile-myron-gpu-profile hyprland libcamera)
if ((${#dirs[@]} == 0)) && ((${#imports[@]} == 0)); then
  for name in "${ORDER[@]}"; do
    [[ -d packages/$name ]] || continue
    ((all)) || [[ " ${SLOW[*]} " != *" $name "* ]] || continue
    dirs+=("packages/$name")
  done
  for d in packages/*/; do
    name=$(basename "$d")
    [[ " ${ORDER[*]} " == *" $name "* ]] || dirs+=("packages/$name")
  done
fi
for d in "${dirs[@]}"; do [[ -f $d/PKGBUILD ]] || alarm_die "no PKGBUILD in $d"; done

# The two repositories never mix: the signed one refuses the development
# marker, the development one refuses a machine that can sign.
if ((dev)); then
  repo=$DEV_REPO_DIR
  devrepo_refuse_signing_material
  # A pre-existing signed repository may coexist, but it may not alias a dev
  # artifact. Otherwise replacing that dev artifact changes signed bytes while
  # leaving the old signature untouched.
  devrepo_reject_signed_repo "$SIGNED_REPO_DIR"
  stanza_sed=$(devrepo_stanza_sed dev)
  alarm_say "DEVELOPMENT ONLY: unsigned repository $repo (not a release, no deployment authority)"
  if ((!list)); then
    msg=$(devrepo_dirs create 2>&1) || alarm_die "$msg"
  fi
else
  repo=$SIGNED_REPO_DIR
  devrepo_reject_signed_repo "$repo"
  stanza_sed=$(devrepo_stanza_sed)
  mkdir -p "$repo"
fi
if ((!list)); then
  # One writer at a time, and never beside a rootfs build reading the repository
  devrepo_lock repo_lock_fd "$(dirname "$repo")/.repo.lock" ex
  if ((dev)); then
    devrepo_ensure_marker "$repo"
    devrepo_scan_signatures "$repo"
    devrepo_validate_contents "$repo"
    devrepo_reject_signed_repo "$SIGNED_REPO_DIR"
  else
    devrepo_reject_signed_repo "$repo"
  fi
fi
if ((!dev)); then
  export GNUPGHOME=$ROOT/keys/gnupg
  [[ -f keys/fingerprint && -d $GNUPGHOME ]] || alarm_die "no signing key in keys/ (maintainer only; see docs/RELEASES.md §10)"
  key=$(cat keys/fingerprint)
fi

# The version makepkg will produce, from the PKGBUILD's own fields. Our
# PKGBUILDs read pkgver from a version file through $startdir.
pkg_version() {
  (
    cd "$1"
    startdir=$PWD
    # shellcheck disable=SC1091
    source ./PKGBUILD >/dev/null 2>&1
    echo "${epoch:+$epoch:}$pkgver-$pkgrel"
  )
}
pkg_names() { ( cd "$1"; startdir=$PWD; source ./PKGBUILD >/dev/null 2>&1; echo "${pkgname[@]}" ); }
up_to_date() {
  local dir=$1 want name f
  want=$(pkg_version "$dir")
  for name in $(pkg_names "$dir"); do
    f=$(ls "$repo/$name-$want"-*.pkg.tar.* 2>/dev/null | grep -v '\.sig$' | head -1)
    [[ -n $f ]] || return 1
  done
}

if ((list)); then
  for d in "${dirs[@]}"; do
    if up_to_date "$d"; then echo "up to date  $d $(pkg_version "$d")"; else echo "to build    $d $(pkg_version "$d")"; fi
  done
  for name in "${SLOW[@]}"; do
    [[ " ${dirs[*]} " == *" packages/$name "* ]] && continue
    up_to_date "packages/$name" || echo "missing     packages/$name $(pkg_version "packages/$name") (slow: name it or use --all, or --import a build)"
  done
  exit 0
fi

# Development publication prepares one complete generation (marker, every
# package, the database) beside the live aarch64 directory, validates it against
# the staged inputs, and commits it with a single atomic directory exchange. The
# old generation stays in place until the exchange succeeds, so any failure
# leaves the published repository byte for byte as it was.
dev_cleanup() { # uses stage and gen dynamically scoped by dev_add_to_repo
  trap - EXIT INT TERM
  [[ -z ${stage:-} ]] || rm -rf -- "$stage"
  [[ -z ${gen:-} ]] || rm -rf -- "$gen"
  stage="" gen=""
}
dev_abort() { # MESSAGE
  local message=$*
  dev_cleanup
  alarm_die "$message"
}
dev_add_to_repo() {
  local stage="" gen="" index package base name version arch identity msg count=0
  local incoming_bases=() links=()
  declare -A replacing=() seen_bases=()
  trap dev_cleanup EXIT
  trap 'dev_cleanup; exit 130' INT
  trap 'dev_cleanup; exit 143' TERM
  devrepo_validate_contents "$repo"
  stage=$(mktemp -d -- "$DEV_REPO_ROOT/.transaction.XXXXXXXX") || alarm_die "cannot create development transaction"
  gen=$(mktemp -d -- "$(dirname -- "$repo")/.generation.XXXXXXXX") || dev_abort "cannot create the next development generation"
  chmod 755 "$gen" || dev_abort "cannot set permissions on the next development generation"
  index=$stage/index
  mkdir "$stage/packages" "$index" || dev_abort "cannot prepare development transaction"

  # Stable copies of the inputs; identity comes only from these copies.
  for package; do
    base=${package##*/}
    case $base in *.pkg.tar.zst|*.pkg.tar.xz) ;; *) dev_abort "$base is not a package archive" ;; esac
    [[ -z ${seen_bases[$base]:-} ]] || dev_abort "duplicate incoming package filename $base"
    seen_bases[$base]=1
    cp -- "$package" "$stage/packages/$base" || dev_abort "cannot stage $base"
    chmod 644 "$stage/packages/$base" || dev_abort "cannot set permissions on staged package $base"
    identity=$(devrepo_pkginfo_identity "$stage/packages/$base" 2>&1) || dev_abort "$identity"
    IFS=$'\t' read -r name version arch <<<"$identity"
    [[ -z ${replacing[$name]:-} ]] || dev_abort "more than one incoming package provides $name"
    replacing[$name]=1
    incoming_bases+=("$base")
    printf '%s\t%s\t%s\t%s\n' "$base" "$name" "$version" "$arch" >>"$stage/expected" ||
      dev_abort "cannot record staged package $base"
  done

  # Retained published packages (their own copies, validated the same way),
  # minus the names being replaced.
  for package in "$repo"/*.pkg.tar.*; do
    [[ -e $package || -L $package ]] || continue
    [[ -f $package && ! -L $package ]] || dev_abort "$package is not a regular package file"
    base=${package##*/}
    cp --reflink=auto -- "$package" "$gen/$base" || dev_abort "cannot stage existing package $base"
    identity=$(devrepo_pkginfo_identity "$gen/$base" 2>&1) || dev_abort "$identity"
    IFS=$'\t' read -r name version arch <<<"$identity"
    if [[ -n ${replacing[$name]:-} ]]; then
      rm -f -- "$gen/$base" || dev_abort "cannot remove replaced package $base from the next generation"
      continue
    fi
    printf '%s\t%s\t%s\t%s\n' "$base" "$name" "$version" "$arch" >>"$stage/expected" ||
      dev_abort "cannot record retained package $base"
    count=$((count + 1))
  done
  for base in "${incoming_bases[@]}"; do
    [[ ! -e $gen/$base && ! -L $gen/$base ]] || dev_abort "incoming $base collides with a retained package of another name"
    mv -T -- "$stage/packages/$base" "$gen/$base" || dev_abort "cannot stage incoming package $base"
    count=$((count + 1))
  done
  ((count)) || dev_abort "no packages in development transaction"
  [[ $(wc -l <"$stage/expected") == "$count" ]] || dev_abort "staged package bookkeeping is inconsistent"

  printf '%s' "$DEV_REPO_MARKER_TEXT" >"$gen/$DEV_REPO_MARKER_NAME" || dev_abort "cannot write the development marker"
  chmod 644 "$gen/$DEV_REPO_MARKER_NAME" || dev_abort "cannot set permissions on the development marker"
  for package in "$gen"/*.pkg.tar.*; do
    ln -s -- "$ROOT/$package" "$index/${package##*/}" || dev_abort "cannot index ${package##*/}"
    links+=("$index/${package##*/}")
  done
  repo-add --quiet "$index/omamobile.db.tar.gz" "${links[@]}" || dev_abort "repo-add failed"
  for package in "${links[@]}"; do
    rm -f -- "$package" || dev_abort "cannot remove index link ${package##*/}"
  done
  msg=$(devrepo_publish_index "$index" "$gen" "$count" 2>&1) || dev_abort "$msg"
  msg=$(devrepo_scan_signatures "$gen" 2>&1) || dev_abort "$msg"
  msg=$(devrepo_validate_contents "$gen" 2>&1) || dev_abort "$msg"
  msg=$(devrepo_verify_database "$gen" "$stage/expected" 2>&1) || dev_abort "$msg"

  # The one commit point. Parent components must still be real directories.
  msg=$(devrepo_dirs check 2>&1) || dev_abort "$msg"
  msg=$(devrepo_exchange_generation "$gen" "$repo" 2>&1) || dev_abort "$msg"
  # $gen now holds the previous generation; it goes only after the exchange.
  dev_cleanup
  for base in "${incoming_bases[@]}"; do echo "    $base"; done
  devrepo_validate_contents "$repo"
}

# A package's .PKGINFO: bsdtar where installed (Arch), GNU tar otherwise
# (Debian), which detects the compression itself but needs the zstd
# program for .pkg.tar.zst.
command -v bsdtar >/dev/null || command -v zstd >/dev/null ||
  alarm_die "reading packages needs bsdtar, or GNU tar and zstd"
pkginfo() {
  if command -v bsdtar >/dev/null; then bsdtar -xOf "$1" .PKGINFO; else tar -xOf "$1" .PKGINFO; fi
}

# Put package files in the repository, replacing older files of the same name.
add_to_repo() {
  local file name base
  if ((dev)); then dev_add_to_repo "$@"; return; fi
  for file; do
    base=${file##*/}
    name=$(pkginfo "$file" | sed -n 's/^pkgname = //p')
    [[ -n $name ]] || alarm_die "$base: no .PKGINFO"
    for old in "$repo/$name"-*.pkg.tar.*; do
      [[ -e $old && $old != *.sig ]] || continue
      [[ $(pkginfo "$old" | sed -n 's/^pkgname = //p') == "$name" ]] || continue
      [[ ${old##*/} == "$base" ]] || rm -f "$old" "$old.sig"
    done
    cp -f "$file" "$repo/$base"
    rm -f "$repo/$base.sig"
    echo "    $base"
  done
}

import_files=()
for dir in "${imports[@]}"; do
  alarm_say "Importing prebuilt packages from $dir"
  files=()
  for f in "$dir"/*.pkg.tar.*; do [[ $f == *.sig ]] || files+=("$f"); done
  ((${#files[@]})) || alarm_die "no packages in $dir"
  for f in "${files[@]}"; do
    # Development mode validates the arch of the staged copy inside dev_add_to_repo.
    ((dev)) || [[ $(pkginfo "$f" | sed -n 's/^arch = //p') =~ ^(aarch64|any)$ ]] || alarm_die "$f is not an aarch64 package"
  done
  import_files+=("${files[@]}")
done
# Validate the complete import transaction before publishing its first package.
# A rejected later --import directory must not leave earlier replacements
# unindexed in the repository.
((${#import_files[@]} == 0)) || add_to_repo "${import_files[@]}"

build=()
for d in "${dirs[@]}"; do
  if ((force == 0)) && up_to_date "$d"; then
    echo "up to date: $d $(pkg_version "$d")"
  else
    build+=("$d")
  fi
done

# The tarball is also where repo-add comes from on a host without it, even
# when the run only imports packages
if ((${#build[@]})) || ! command -v repo-add >/dev/null; then
  alarm_fetch
fi
if ((${#build[@]})); then
  image=$(alarm_build_image "$ROOT")
fi

# Development packages are indexed by the atomic generation transaction in
# dev_add_to_repo. Re-check that the published database still describes every
# package exactly; never rewrite database files piecemeal after the exchange.
dev_index() {
  local expected package base name version arch identity count=0 msg
  devrepo_require_dev_repo "$repo"
  expected=$(mktemp -- "$DEV_REPO_ROOT/.expected.XXXXXXXX") || alarm_die "cannot stage the development database check"
  for package in "$repo"/*.pkg.tar.*; do
    [[ -e $package || -L $package ]] || continue
    [[ -f $package && ! -L $package ]] || { rm -f -- "$expected"; alarm_die "$package is not a regular package file"; }
    base=${package##*/}
    identity=$(devrepo_pkginfo_identity "$package" 2>&1) || { rm -f -- "$expected"; alarm_die "$identity"; }
    IFS=$'\t' read -r name version arch <<<"$identity"
    printf '%s\t%s\t%s\t%s\n' "$base" "$name" "$version" "$arch" >>"$expected"
    count=$((count + 1))
  done
  ((count)) || { rm -f -- "$expected"; alarm_die "no packages in $repo to verify"; }
  msg=$(devrepo_verify_database "$repo" "$expected" 2>&1) || { rm -f -- "$expected"; alarm_die "$msg"; }
  rm -f -- "$expected"
}

sign_and_index() {
  local package
  if ((dev)); then dev_index; return; fi
  for package in "$repo"/*.pkg.tar.*; do
    [[ -e $package && $package != *.sig ]] || continue
    [[ -f $package.sig ]] || gpg --batch --yes --local-user "$key" --detach-sign "$package"
  done
  rm -f "$repo"/omamobile.db* "$repo"/omamobile.files*
  local packages=() f
  for f in "$repo"/*.pkg.tar.*; do [[ $f == *.sig ]] || packages+=("${f##*/}"); done
  if command -v repo-add >/dev/null; then
    (cd "$repo" && repo-add --quiet --sign --key "$key" omamobile.db.tar.gz "${packages[@]}")
  else
    # Not an Arch machine: pacman's repo-add from the Arch Linux ARM image,
    # as this user, with the same key.
    docker run --rm --platform linux/arm64 "${ALARM_DOCKER_QEMU_ARGS[@]}" -u "$(id -u):$(id -g)" \
      -v "$ROOT/$repo:/repo" -v "$GNUPGHOME:/gnupg" -e GNUPGHOME=/gnupg -e HOME=/tmp -w /repo \
      "$(alarm_base_image)" repo-add --quiet --sign --key "$key" omamobile.db.tar.gz "${packages[@]}"
  fi
}

for dir in "${build[@]}"; do
  name=$(basename "$dir")
  alarm_say "$name $(pkg_version "$dir")"
  work=$(mktemp -d)
  # The package directory as it is (including gitignored prebuilt files the
  # PKGBUILDs install), minus makepkg's work directories and old packages.
  tar cf - --exclude="./$name/pkg" --exclude="./$name/src/build" --exclude='*.pkg.tar.*' \
    -C "$(dirname "$dir")" "./$name" | tar xf - -C "$work"
  out=$work/out && mkdir -p "$out"
  incheck=0
  if ((nocheck == 0)); then
    if ((container_check)) || [[ ! -x $dir/test/all ]]; then
      incheck=1
    else
      "$dir/test/all" > "$work/test.log" 2>&1 || { tail -20 "$work/test.log"; rm -rf "$work"; alarm_die "$name: test/all failed"; }
      echo "    test/all passed ($(grep -c '^ok' "$work/test.log") checks, natively)"
    fi
  fi
  # The upstream signers a PKGBUILD names (validpgpkeys), fetched here on the
  # host (cached) so makepkg in the container can verify .sig sources
  pgp=$work/pgp.asc
  : > "$pgp"
  keys=$(sed -n '/^validpgpkeys=(/,/)/p' "$dir/PKGBUILD" | grep -oE '[0-9A-F]{40}' || true)
  if [[ -n $keys ]]; then
    kr=$ALARM_CACHE/pgp && mkdir -p "$kr" && chmod 700 "$kr"
    for k in $keys; do
      GNUPGHOME=$kr gpg -q --batch --list-keys "$k" >/dev/null 2>&1 ||
        GNUPGHOME=$kr gpg -q --batch --keyserver "$ALARM_KEYSERVER" --recv-keys "$k" ||
        echo "    warning: could not fetch upstream key $k"
    done
    GNUPGHOME=$kr gpg -q --batch --armor --export $keys > "$pgp" 2>/dev/null || true
  fi
  # Our own earlier packages resolve from the repository being built
  have_repo=0
  [[ -f $repo/omamobile.db ]] && have_repo=1
  start=$(date +%s)
  docker run --rm --platform linux/arm64 "${ALARM_DOCKER_QEMU_ARGS[@]}" \
    -v "$work:/work" -v "$ROOT/$repo:/repo/aarch64:ro" \
    -v "$ALARM_CACHE/pkg:/var/cache/pacman/pkg" -v "$ALARM_CACHE/src:/srcdest" \
    -e NAME="$name" -e HAVE_REPO="$have_repo" -e INCHECK="$incheck" -e STANZA_SED="$stanza_sed" \
    "$image" bash -c '
      set -euo pipefail
      trap "chown -R builder: /var/cache/pacman/pkg /srcdest" EXIT
      if [[ $HAVE_REPO == 1 ]]; then
        sed -i "$STANZA_SED" /etc/pacman.conf
      fi
      pacman -Sy >/dev/null
      chown -R builder: /work /srcdest
      cd /work/$NAME
      info=$(su builder -c "makepkg --printsrcinfo")
      # Every dependency a repository can provide goes in (the build-time
      # ones always; runtime ones so check() can run). Ours that are not
      # built yet are left out: makepkg runs with --nodeps.
      wanted=$(awk "\$1 ~ /^(depends|makedepends|checkdepends)\$/ {print \$3}" <<<"$info" | sed "s/[<>=].*//" | sort -u)
      install=()
      for dep in $wanted; do
        pacman -Sp --print-format %n "$dep" >/dev/null 2>&1 && install+=("$dep")
      done
      ((${#install[@]})) && pacman -S --noconfirm --needed --asdeps --overwrite "/usr/share/pacman/keyrings/*" "${install[@]}" >/dev/null
      [[ -s /work/pgp.asc ]] && su builder -c "gpg -q --batch --import /work/pgp.asc"
      flags=(-f --nodeps --noconfirm)
      [[ $INCHECK == 1 ]] || flags+=(--nocheck)
      su builder -c "SRCDEST=/srcdest PKGDEST=/work/out PKGEXT=.pkg.tar.zst makepkg ${flags[*]}" 2>&1 | tail -25
      ls /work/out/*.pkg.tar.zst >/dev/null
    ' || { rm -rf "$work"; alarm_die "$name: build failed"; }
  add_to_repo "$out"/*.pkg.tar.zst
  rm -rf "$work"
  echo "    built in $(( ($(date +%s) - start) / 60 )) min"
  # Index after each package, so the next one can depend on it
  sign_and_index
done

if ((dev)); then alarm_say "Indexing $repo (unsigned, development only)"; else alarm_say "Signing and indexing $repo"; fi
sign_and_index
ls -1 "$repo" | grep -E '\.pkg\.tar\.zst$'
