#!/bin/bash
# SPDX-License-Identifier: MIT
# Compose a private, non-release Myron hardware-test payload from an
# ownership-preserving development ext4 image. This only writes OUT.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
ROOT=$PWD
source tools/lib/alarm.sh

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
usage() {
  cat <<'EOF'
Usage: tools/myron-dev-image-compose \
  [--profile coexistence|cellular] \
  --base-image ABSOLUTE_RAW_EXT4 \
  --module-stage ABSOLUTE_DIR \
  --runtime-stage ABSOLUTE_DIR \
  --bluetooth-probe ABSOLUTE_FILE \
  --speaker-reference-repo ABSOLUTE_DIR \
  --firstboot-conf ABSOLUTE_FILE \
  --ssh-key ABSOLUTE_PUBLIC_KEY \
  --out ABSOLUTE_RAW_EXT4

Writes a new private ext4 payload. It never contacts a phone and never writes a
partition. The input must be the unsigned development payload from
tools/build-rootfs --dev-payload-image. Runtime scope is GPU, Wi-Fi, touch,
radio-base, AudioReach microphone bring-up and battery authentication. Radio
and audio activation remain disabled until an attended, separately gated test.
EOF
}

profile=coexistence
base= modules= runtime= bluetooth_probe= speaker_reference= firstboot= ssh_key= out=
while (($#)); do
  case $1 in
    --profile) profile=${2:?}; shift 2 ;;
    --base-image) base=${2:?}; shift 2 ;;
    --module-stage) modules=${2:?}; shift 2 ;;
    --runtime-stage) runtime=${2:?}; shift 2 ;;
    --bluetooth-probe) bluetooth_probe=${2:?}; shift 2 ;;
    --speaker-reference-repo) speaker_reference=${2:?}; shift 2 ;;
    --firstboot-conf) firstboot=${2:?}; shift 2 ;;
    --ssh-key) ssh_key=${2:?}; shift 2 ;;
    --out) out=${2:?}; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done
case $profile in
  coexistence|cellular) ;;
  *) die "unsupported hardware-test profile: $profile" ;;
esac
for value in base modules runtime bluetooth_probe speaker_reference firstboot ssh_key out; do
  [[ -n ${!value} ]] || die "--${value//_/-} is required"
done
for path in "$base" "$modules" "$runtime" "$bluetooth_probe" "$speaker_reference" "$firstboot" "$ssh_key"; do
  [[ $path == /* && $path != *'/../'* && $path != */.. && $path != *'/./'* ]] ||
    die "input paths must be canonical absolute paths: $path"
  [[ -e $path && ! -L $path ]] || die "missing or linked input: $path"
done
[[ -f $base && -f $bluetooth_probe && -f $firstboot && -f $ssh_key ]] ||
  die 'base image, Bluetooth probe, firstboot config and SSH key must be regular files'
[[ -d $modules && -d $runtime && -d $speaker_reference ]] ||
  die 'module, runtime and speaker-reference inputs must be directories'
[[ $out == /* && $out != / && $out != *'/../'* && $out != */.. && $out != *'/./'* ]] ||
  die '--out must be a canonical absolute path'
[[ ! -e $out && ! -L $out ]] || die "refusing to replace $out"
out_parent=$(dirname -- "$out")
[[ -d $out_parent && ! -L $out_parent ]] || die "output parent is missing or linked: $out_parent"
[[ $(stat -c %u "$out_parent") == $(id -u) ]] || die 'output parent is not owned by this user'
(( (8#$(stat -c %a "$out_parent") & 0022) == 0 )) || die 'output parent is group/world writable'

packages/omamobile-myron-kernel-contract/bin/omamobile-myron-kernel-verify verify-stage \
  --assets /home/menno/Work/myron-postmarketos/artifacts/live/systemd-vt-device-assets.tar.gz \
  --root "$modules" >/dev/null
packages/omamobile-myron-kernel-contract/bin/omamobile-myron-kernel-verify verify-runtime \
  --manifest /home/menno/Work/myron-postmarketos/config/myron-runtime-assets.tsv \
  --root "$runtime" --features gpu,wifi,touch,radio-base,audio-microphone,charging >/dev/null
[[ $(sha256sum <"$bluetooth_probe" | cut -d' ' -f1) == \
  4a9d4da29c7ef46f4dcb08385e4c5ff85b16344884d4239c40b53923c5258608 ]] ||
  die 'Bluetooth probe is not the reviewed Attempt 71 source'
grep -Fq -- '--prepare-qca-ibs-after-nvm' "$bluetooth_probe" ||
  die 'Bluetooth probe lacks the reviewed QCA IBS preparation mode'
declare -A speaker_files=(
  [experiments/speaker-pipewire-bridge/bridge.py]=9b788529fe4c0fd2b20d4f73fca24b4e532c9ab364fd67a10bd89b9577daafbc
  [experiments/speaker-oem-miplay-graph/probe.py]=e5b99216ae3f3a6a97d03cef599803e9e80e85ca5b0903b4986f0582ca5d5cd0
  [scripts/attempt78-tfa-hostless.py]=440329d141cd2b51ac728dfd70861b55947f8865e219431113d277b63be62750
  [scripts/attempt78-tfa-calibration.py]=61965d4902719f410e904d383cad492bd4b6d43d81e6a42663e0274f0ebc2e6e
  [scripts/myron-speaker-watchdog.py]=1ca8692482522147802bde26d153cc307006a87dca91ac48eca63e93b4aeadcf
)
for file in "${!speaker_files[@]}"; do
  [[ -f $speaker_reference/$file && ! -L $speaker_reference/$file ]] ||
    die "missing regular speaker bridge source: $file"
  [[ $(sha256sum <"$speaker_reference/$file" | cut -d' ' -f1) == ${speaker_files[$file]} ]] ||
    die "speaker bridge checksum mismatch: $file"
done
grep -Fxq 'USERNAME=menno' "$firstboot" || die 'firstboot config must create menno'
grep -Eq '^PASSWORD_HASH=\$6\$' "$firstboot" || die 'firstboot config lacks a SHA-512 password hash'
[[ $(grep -c '^SSH_KEY=' "$firstboot") == 1 ]] || die 'firstboot config must have exactly one SSH key'
[[ $(wc -l <"$ssh_key") == 1 ]] || die 'SSH public-key file must contain exactly one line'
grep -Eq '^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)) ' "$ssh_key" ||
  die 'SSH key is not a supported public key'

e2fsck -fn "$base" >/dev/null
label=$(dumpe2fs -h "$base" 2>/dev/null | sed -n 's/^Filesystem volume name:[[:space:]]*//p')
case $label in omarchy-myron-de|myron-oma-dev) ;; *) die "unexpected base label: $label" ;; esac
debugfs -R 'cat /var/lib/omamobile/repo/aarch64/.omamobile-dev-unsigned' "$base" 2>/dev/null |
  grep -Fxq 'development-only: unsigned package repository' ||
  die 'base image is not the unsigned development payload'

# Copy to a new inode before the privileged container sees it. The source is
# never mounted and a failed composition leaves only the explicitly named OUT.
cp --reflink=auto --sparse=always -- "$base" "$out"
chmod 0600 "$out"

alarm_fetch package
image=$(alarm_build_image "$ROOT")
docker run --rm --privileged --platform linux/arm64 \
  -e MYRON_TEST_PROFILE="$profile" \
  -v "$out:/payload.img" \
  -v "$modules:/module-stage:ro" \
  -v "$runtime:/runtime-stage:ro" \
  -v "$bluetooth_probe:/bluetooth-probe.py:ro" \
  -v "$speaker_reference:/speaker-reference:ro" \
  -v "$ROOT/packages/omamobile-shell:/shell-source:ro" \
  -v "$ROOT/tools/myron-networkmanager-keyfile-audit:/keyfile-audit:ro" \
  -v "$ROOT/device/myron/hardware-test-overlay:/test-overlay:ro" \
  -v "$firstboot:/firstboot.conf:ro" \
  -v "$ssh_key:/owner.pub:ro" \
  "$image" bash -euo pipefail -c '
    mkdir -p /mnt/payload
    loop=
    cleanup() {
      sync
      umount /mnt/payload 2>/dev/null || true
      [[ -z $loop ]] || losetup -d "$loop" 2>/dev/null || true
    }
    trap cleanup EXIT
    loop=$(losetup --find --show /payload.img)
    mount -o rw "$loop" /mnt/payload
    root=/mnt/payload
    grep -Fxq "ID=omarchy" "$root/etc/os-release"
    test ! -e "$root/usr/local/lib/myron-gpu"
    cp -a /module-stage/. "$root/"
    cp -a /runtime-stage/. "$root/"
    tar -C /test-overlay -cf - . | tar --no-same-owner -C "$root" -xf -
    install -d -m0755 "$root/etc/omamobile"
    # The empty in-tree-rmnet selection marker must arrive as a regular file.
    test -f "$root/etc/myron/use-in-tree-rmnet" -a ! -L "$root/etc/myron/use-in-tree-rmnet" -a \
      ! -s "$root/etc/myron/use-in-tree-rmnet"
    chown 0:0 "$root/etc/myron" "$root/etc/myron/use-in-tree-rmnet"
    chmod 0755 "$root/etc/myron"
    chmod 0644 "$root/etc/myron/use-in-tree-rmnet"
    printf "%s\n" "$MYRON_TEST_PROFILE" >"$root/etc/omamobile/myron-test-profile"
    chown 0:0 "$root/etc/omamobile/myron-test-profile"
    chmod 0644 "$root/etc/omamobile/myron-test-profile"
    # The three inputs are host bind mounts.  Their directory entries carry
    # the invoking developer uid, and both cp(1) and tar(1) may apply that
    # metadata to pre-existing directories such as / and /usr.  Normalize
    # only paths represented by these test inputs; never recursively chown the
    # base image because it contains legitimate system-account ownership.
    for source in /module-stage /runtime-stage /test-overlay; do
      while IFS= read -r -d "" path; do
        relative=${path#"$source"}
        chown -h 0:0 "$root$relative"
        if [[ -d $path && ! -L $path ]]; then
          chmod 0755 "$root$relative"
        fi
      done < <(find "$source" -mindepth 0 -print0)
    done
    chown -R 0:0 \
      "$root/usr/local/lib/myron-gki-module-sets" \
      "$root/usr/local/lib/myron-gpu" \
      "$root/usr/local/lib/myron-stock-modules" \
      "$root/usr/local/lib/myron-touch" \
      "$root/usr/local/lib/myron-wireless" \
      "$root/usr/local/lib/myron-audio" \
      "$root/usr/local/lib/myron-charging"
    find "$root/usr/local/lib/myron-gpu" "$root/usr/local/lib/myron-stock-modules" \
      "$root/usr/local/lib/myron-touch" "$root/usr/local/lib/myron-wireless" \
      "$root/usr/local/lib/myron-audio" "$root/usr/local/lib/myron-charging" \
      -type d -exec chmod 0755 {} +
    find "$root/usr/local/lib/myron-gpu" "$root/usr/local/lib/myron-stock-modules" \
      "$root/usr/local/lib/myron-touch" "$root/usr/local/lib/myron-wireless" \
      "$root/usr/local/lib/myron-audio" "$root/usr/local/lib/myron-charging" \
      -type f -exec chmod 0644 {} +
    chmod 0755 "$root/usr/local/lib/myron-charging/bin/linker64" \
      "$root/usr/local/lib/myron-charging/bin/batterysecret"
    # AudioReach tools use the canonical system ACDB path. The runtime stage
    # keeps the exact reference calibration under its isolated asset root;
    # publish that verified file without replacing the other base configs.
    install -Dm0644 "$root/usr/local/lib/myron-audio/config/acdb_cal.acdb" \
      "$root/etc/acdbdata/acdb_cal.acdb"
    install -m0644 "$root/usr/local/lib/myron-audio/config/backend_conf.xml" \
      "$root/etc/backend_conf.xml"
    install -m0644 "$root/usr/local/lib/myron-audio/config/card-defs.xml" \
      "$root/etc/card-defs.xml"
    install -Dm0755 /bluetooth-probe.py \
      "$root/usr/local/sbin/myron-bluetooth-qca-probe"
    install -Dm0755 /speaker-reference/experiments/speaker-pipewire-bridge/bridge.py \
      "$root/usr/local/libexec/myron-speaker/bridge.py"
    install -Dm0755 /speaker-reference/experiments/speaker-oem-miplay-graph/probe.py \
      "$root/usr/local/libexec/myron-speaker/probe.py"
    install -Dm0755 /speaker-reference/scripts/attempt78-tfa-hostless.py \
      "$root/usr/local/libexec/myron-speaker/attempt78-tfa-hostless.py"
    install -Dm0755 /speaker-reference/scripts/attempt78-tfa-calibration.py \
      "$root/usr/local/libexec/myron-speaker/attempt78-tfa-calibration.py"
    install -Dm0755 /speaker-reference/scripts/myron-speaker-watchdog.py \
      "$root/usr/local/libexec/myron-speaker/watchdog.py"
    # Carry the live-qualified temporary shell fixes into this test payload.
    # Proper package promotion follows after hardware coexistence is proven.
    install -Dm0644 /shell-source/plugins/omamobile.quicksettings/QuickSettings.qml \
      "$root/usr/share/omamobile/shell/plugins/omamobile.quicksettings/QuickSettings.qml"
    install -Dm0755 /shell-source/plugins/omamobile.quicksettings/tile-action.sh \
      "$root/usr/share/omamobile/shell/plugins/omamobile.quicksettings/tile-action.sh"
    install -Dm0755 /shell-source/plugins/omamobile.quicksettings/tile-state.sh \
      "$root/usr/share/omamobile/shell/plugins/omamobile.quicksettings/tile-state.sh"
    install -Dm0644 /shell-source/plugins/omamobile.switcher/Switcher.qml \
      "$root/usr/share/omamobile/shell/plugins/omamobile.switcher/Switcher.qml"
    chown -R 0:0 "$root/usr/local/sbin/myron-attempt79-module-dir"
    chmod 0755 "$root/usr/local/sbin/myron-attempt79-module-dir"
    install -Dm0600 /firstboot.conf "$root/etc/omamobile/firstboot.conf"
    install -d -m0700 "$root/root/.ssh"
    install -m0600 /owner.pub "$root/root/.ssh/authorized_keys"
    chown -R 0:0 "$root/root/.ssh" "$root/etc/omamobile/firstboot.conf"
    chmod 0755 "$root/usr/local/bin/myron-start-omarchy" \
      "$root/usr/local/bin/myron-omarchy-setup-user" \
      "$root/usr/local/bin/myron-speaker-sink" \
      "$root/usr/local/bin/myron-microphone-source" \
      "$root/usr/local/bin/omamobile-microphone" \
      "$root/usr/local/libexec/myron-shell-bin/quickshell" \
      "$root/usr/local/sbin/myron-reference-radio-start" \
      "$root/usr/local/sbin/myron-reference-wifi-import" \
      "$root/usr/local/sbin/myron-cellular-start" \
      "$root/usr/local/sbin/myron-cellular-stage" \
      "$root/usr/local/sbin/myron-ipa-guard" \
      "$root/usr/local/sbin/myron-modemmanager-start" \
      "$root/usr/local/sbin/myron-reference-audio-start" \
      "$root/usr/local/sbin/myron-coexistence-start" \
      "$root/usr/local/sbin/myron-audio-stage" \
      "$root/usr/local/sbin/myron-speaker-dsp-stage" \
      "$root/usr/local/sbin/myron-speaker-prepare" \
      "$root/usr/local/sbin/myron-speaker-powerdown" \
      "$root/usr/local/sbin/myron-microphone-prepare" \
      "$root/usr/local/sbin/myron-microphone-bridge" \
      "$root/usr/local/sbin/myron-bluetooth-stage" \
      "$root/usr/local/sbin/myron-input-stage" \
      "$root/usr/local/sbin/myron-batterysecret-start" \
      "$root/usr/local/sbin/myron-battery-stage" \
      "$root/usr/local/sbin/myron-peripheral-audit" \
      "$root/usr/local/sbin/myron-audio-devnodes" \
      "$root/usr/local/sbin/myron-omarchy-prepare" \
      "$root/usr/local/sbin/myron-omarchy-qualify"
    systemctl --root="$root" enable myron-hardware-watchdog.service \
      myron-reference-wifi-import.service \
      myron-batterysecret.service \
      myron-omarchy-prepare.service \
      myron-omarchy-qualify.service sshd.service \
      systemd-networkd.service >/dev/null
    # No cellular profile may ship in any supported NetworkManager keyfile
    # store. The parser also rejects links, special files and malformed input.
    /keyfile-audit "$root"
    # D-Bus activation names the ModemManager alias; where it exists it must be
    # the canonical unit (so the one-start drop-in applies), never a copy.
    mm_alias="$root/etc/systemd/system/dbus-org.freedesktop.ModemManager1.service"
    if test -e "$mm_alias" || test -L "$mm_alias"; then
      case "$(readlink "$mm_alias" 2>/dev/null || true)" in
        /usr/lib/systemd/system/ModemManager.service|/lib/systemd/system/ModemManager.service) ;;
        *) echo "ModemManager D-Bus alias is not the canonical unit" >&2; exit 1 ;;
      esac
    fi
    # Omarchy Mobile has its own non-interactive first-boot service.  Arch
    # stock prompt otherwise blocks sysinit.target behind Plymouth forever.
    systemctl --root="$root" mask systemd-firstboot.service >/dev/null
    case $MYRON_TEST_PROFILE in
      coexistence)
        systemctl --root="$root" enable myron-coexistence.service >/dev/null
        systemctl --root="$root" mask ModemManager.service >/dev/null
        ;;
      cellular)
        systemctl --root="$root" disable myron-coexistence.service >/dev/null 2>&1 || true
        systemctl --root="$root" unmask ModemManager.service >/dev/null
        systemctl --root="$root" disable ModemManager.service >/dev/null 2>&1 || true
        systemctl --root="$root" enable myron-cellular.service >/dev/null
        ;;
    esac
    sync
    umount /mnt/payload
    losetup -d "$loop"
    loop=
    trap - EXIT
  '

e2fsck -fn "$out" >/dev/null
for path in / /usr /usr/local /etc/shadow /usr/bin/sudo /etc/omamobile/firstboot.conf \
  /usr/local/bin/myron-omarchy-setup-user /usr/local/libexec/myron-shell-bin/quickshell \
  /usr/local/sbin/myron-omarchy-prepare /etc/myron/use-in-tree-rmnet \
  /usr/local/sbin/myron-ipa-guard /usr/lib/systemd/system/myron-ipa-guard.service \
  /usr/local/sbin/myron-modemmanager-start /etc/NetworkManager/conf.d/20-myron-cellular-unmanaged.conf \
  /etc/systemd/system/ModemManager.service.d/20-myron-radio.conf \
  /usr/local/lib/myron-gpu/modules/msm_kgsl.ko \
  /usr/local/lib/myron-audio /usr/local/lib/myron-charging \
  /usr/local/lib/myron-charging/bin/batterysecret \
  /usr/local/sbin/myron-batterysecret-start /etc/acdbdata/acdb_cal.acdb \
  /usr/local/sbin/myron-bluetooth-qca-probe \
  /usr/local/libexec/myron-speaker/bridge.py /usr/local/bin/myron-speaker-sink \
  /usr/local/bin/myron-microphone-source /usr/local/sbin/myron-microphone-bridge \
  /usr/share/omamobile/shell/plugins/omamobile.quicksettings/QuickSettings.qml \
  /usr/share/omamobile/shell/plugins/omamobile.switcher/Switcher.qml \
  /etc/backend_conf.xml /etc/card-defs.xml; do
  debugfs -R "stat $path" "$out" 2>/dev/null | grep -q '^User:[[:space:]]*0[[:space:]]*Group:[[:space:]]*0' ||
    die "root ownership missing: $path"
done
debugfs -R 'stat /etc/myron/use-in-tree-rmnet' "$out" 2>/dev/null |
  grep -Eq '^Inode:.*Type:[[:space:]]*regular' || die 'in-tree rmnet marker is not a regular file'
debugfs -R 'stat /etc/myron/use-in-tree-rmnet' "$out" 2>/dev/null |
  grep -Eq 'Size:[[:space:]]*0([[:space:]]|$)' || die 'in-tree rmnet marker is not empty'
debugfs -R 'stat /etc/systemd/system/systemd-firstboot.service' "$out" 2>/dev/null |
  grep -Fq 'Fast link dest: "/dev/null"' || die 'stock interactive systemd-firstboot is not masked'
debugfs -R 'stat /etc/systemd/system/sysinit.target.wants/myron-hardware-watchdog.service' \
  "$out" 2>/dev/null | grep -Fq 'Fast link dest:' || die 'hardware watchdog is not enabled'
case $profile in
  coexistence)
    debugfs -R 'stat /etc/systemd/system/multi-user.target.wants/myron-coexistence.service' \
      "$out" 2>/dev/null | grep -Fq 'Fast link dest:' || die 'coexistence bring-up is not enabled'
    ;;
  cellular)
    debugfs -R 'stat /etc/systemd/system/multi-user.target.wants/myron-cellular.service' \
      "$out" 2>/dev/null | grep -Fq 'Fast link dest:' || die 'guarded cellular transaction is not enabled'
    debugfs -R 'stat /etc/systemd/system/multi-user.target.wants/myron-reference-radio.service' \
      "$out" 2>&1 | grep -Fq 'File not found' || die 'radio foundation is enabled outside the guarded cellular transaction'
    debugfs -R 'stat /etc/systemd/system/multi-user.target.wants/ModemManager.service' \
      "$out" 2>&1 | grep -Fq 'File not found' || die 'ModemManager is enabled outside the guarded cellular transaction'
    debugfs -R 'stat /etc/systemd/system/multi-user.target.wants/myron-ipa-guard.service' \
      "$out" 2>&1 | grep -Fq 'File not found' || die 'IPA guard is enabled outside the guarded cellular transaction'
    ;;
esac
hash=$(sha256sum <"$out" | cut -d" " -f1)
printf '%s  %s\n' "$hash" "$(basename -- "$out")" >"$out.sha256"
chmod 0600 "$out.sha256"
printf 'status=composed\nimage=%s\nsha256=%s\nprofile=%s\nactivation=temporary-hardware-test\ndeployment_authorized=false\n' \
  "$out" "$hash" "$profile"
