# --- loading the reviewed verifiers (source import; nothing is executed) -------

_modules: dict = {}


def _load(name: str, path: Path):
    if name not in _modules:
        try:
            loader = importlib.machinery.SourceFileLoader(f"myron_{name}", str(path))
            spec = importlib.util.spec_from_loader(loader.name, loader)
            module = importlib.util.module_from_spec(spec)
            loader.exec_module(module)
        except (OSError, SyntaxError) as error:
            raise DeploymentError(f"cannot load the {name} verifier: {error}") from error
        _modules[name] = module
    return _modules[name]


def kernel():
    return _load("kernel", KERNEL_VERIFIER)


def gpu():
    return _load("gpu", GPU_VERIFIER)


def handled_errors() -> tuple:
    try:
        return (DeploymentError, kernel().ContractError, gpu().ProfileError, OSError, ValueError)
    except DeploymentError:
        return (DeploymentError, OSError, ValueError)


# --- strict JSON and canonical rendering ---------------------------------------


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def strict_json(data: bytes, label: str) -> dict:
    def pairs(items):
        result = {}
        for key, value in items:
            if key in result:
                raise DeploymentError(f"{label} contains duplicate JSON key: {key}")
            result[key] = value
        return result

    def constant(name):
        raise DeploymentError(f"{label} contains non-finite number {name}")

    try:
        value = json.loads(data.decode("utf-8"), object_pairs_hook=pairs, parse_constant=constant)
    except (UnicodeDecodeError, json.JSONDecodeError, RecursionError) as error:
        raise DeploymentError(f"{label} is invalid JSON") from error
    if not isinstance(value, dict):
        raise DeploymentError(f"{label} must be a JSON object")
    return value


def render_json(value) -> bytes:
    return (json.dumps(value, indent=2, sort_keys=True) + "\n").encode("ascii")


# --- canonical paths and descriptor-relative I/O --------------------------------

DIR_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC


def check_name(name: str, where: str) -> None:
    try:
        raw = name.encode("utf-8")
    except UnicodeEncodeError as error:
        raise DeploymentError(f"non-UTF-8 name under {where}") from error
    if not raw or len(raw) > 255 or any(byte < 0x20 or byte == 0x7F for byte in raw):
        raise DeploymentError(f"unsafe name under {where}")


def split_canonical(path: str, label: str) -> list[str]:
    if not isinstance(path, str) or not path or "\0" in path:
        raise DeploymentError(f"{label} is not a valid path")
    if not path.startswith("/"):
        raise DeploymentError(f"{label} must be an absolute path")
    if path == "/":
        raise DeploymentError(f"{label} must not be /")
    parts = path.split("/")[1:]
    if any(part == "" for part in parts):
        raise DeploymentError(f"{label} must be a canonical absolute path (no empty components)")
    if any(part in (".", "..") for part in parts):
        raise DeploymentError(f"{label} must not contain . or .. components")
    for part in parts:
        check_name(part, label)
    return parts


def open_dir_components(parts: list[str], label: str) -> int:
    if not hasattr(os, "O_NOFOLLOW"):
        raise DeploymentError("safe inspection needs O_NOFOLLOW")
    try:
        current = os.open("/", DIR_FLAGS)
    except OSError as error:
        raise DeploymentError(f"cannot open /: {error.strerror}") from error
    try:
        for part in parts:
            following = os.open(part, DIR_FLAGS, dir_fd=current)
            os.close(current)
            current = following
        return current
    except OSError as error:
        os.close(current)
        raise DeploymentError(
            f"{label} is unavailable, a symlink, or crosses a non-directory: {error.strerror}"
        ) from error


def open_canonical_dir(path: str, label: str) -> int:
    return open_dir_components(split_canonical(path, label), label)


def open_pinned_regular_at(directory_fd: int, name: str, label: str) -> tuple[int, int, os.stat_result]:
    """Validate through O_PATH before any data-open, then reopen that inode."""
    if not hasattr(os, "O_PATH") or not hasattr(os, "O_NOFOLLOW"):
        raise DeploymentError("safe regular-file inspection needs O_PATH and O_NOFOLLOW")
    pinned = descriptor = -1
    try:
        pinned = os.open(
            name, os.O_PATH | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=directory_fd
        )
        metadata = os.fstat(pinned)
        if not stat.S_ISREG(metadata.st_mode):
            raise DeploymentError(f"{label} is not a regular file")
        descriptor = os.open(
            f"/proc/self/fd/{pinned}", os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC
        )
        opened = os.fstat(descriptor)
        if not stat.S_ISREG(opened.st_mode) or (opened.st_dev, opened.st_ino) != (
            metadata.st_dev,
            metadata.st_ino,
        ):
            raise DeploymentError(f"{label} changed while being opened")
        return pinned, descriptor, opened
    except OSError as error:
        if descriptor >= 0:
            os.close(descriptor)
        if pinned >= 0:
            os.close(pinned)
        raise DeploymentError(f"{label} cannot be opened safely: {error.strerror}") from error
    except BaseException:
        if descriptor >= 0:
            os.close(descriptor)
        if pinned >= 0:
            os.close(pinned)
        raise


def open_trusted_output_parent(parts: list[str], label: str) -> int:
    """Open an output parent whose ancestry cannot be renamed by other users."""
    current = os.open("/", DIR_FLAGS)
    try:
        for component in parts:
            following = -1
            try:
                following = os.open(component, DIR_FLAGS, dir_fd=current)
                parent = os.fstat(current)
                child = os.fstat(following)
                trusted_owner = parent.st_uid in {0, os.geteuid()}
                writable_by_others = bool(stat.S_IMODE(parent.st_mode) & 0o022)
                sticky_protection = bool(parent.st_mode & stat.S_ISVTX) and child.st_uid == os.geteuid()
                if not trusted_owner or (writable_by_others and not sticky_protection):
                    raise DeploymentError(
                        f"{label} ancestry is writable or controlled by another user"
                    )
            except BaseException:
                if following >= 0:
                    os.close(following)
                raise
            os.close(current)
            current = following
        return current
    except OSError as error:
        os.close(current)
        raise DeploymentError(f"{label} is unavailable: {error.strerror}") from error
    except BaseException:
        os.close(current)
        raise


def trusted_parent_entry(parent_fd: int, child_metadata, label: str) -> None:
    parent = os.fstat(parent_fd)
    trusted_owner = parent.st_uid in {0, os.geteuid()}
    writable_by_others = bool(stat.S_IMODE(parent.st_mode) & 0o022)
    sticky_protection = bool(parent.st_mode & stat.S_ISVTX) and child_metadata.st_uid == os.geteuid()
    if not trusted_owner or (writable_by_others and not sticky_protection):
        raise DeploymentError(f"{label} parent is writable or controlled by another user")


def open_trusted_artifact(path: str, label: str) -> tuple[int, tuple[int, int]]:
    parts = split_canonical(path, label)
    parent_fd = open_trusted_output_parent(parts[:-1], f"{label} parent")
    descriptor = -1
    try:
        descriptor = os.open(parts[-1], DIR_FLAGS, dir_fd=parent_fd)
        metadata = os.fstat(descriptor)
        trusted_parent_entry(parent_fd, metadata, label)
        if metadata.st_uid not in {0, os.geteuid()} or stat.S_IMODE(metadata.st_mode) & 0o022:
            raise DeploymentError(f"{label} is writable or controlled by another user")
        return descriptor, (metadata.st_dev, metadata.st_ino)
    except OSError as error:
        if descriptor >= 0:
            os.close(descriptor)
        raise DeploymentError(f"{label} is unavailable: {error.strerror}") from error
    except BaseException:
        if descriptor >= 0:
            os.close(descriptor)
        raise
    finally:
        os.close(parent_fd)


def recheck_trusted_artifact(path: str, identity: tuple[int, int], label: str) -> None:
    descriptor, current = open_trusted_artifact(path, label)
    os.close(descriptor)
    if current != identity:
        raise DeploymentError(f"{label} changed during verification")


def read_file(path: str, label: str, limit: int) -> bytes:
    parts = split_canonical(path, label)
    parent = open_dir_components(parts[:-1], label)
    pinned = descriptor = -1
    try:
        pinned, descriptor, before = open_pinned_regular_at(
            parent, parts[-1], f"{label}: {path}"
        )
        parent_mount = kernel().mount_id_for_fd(parent, f"{label} parent")
        if kernel().mount_id_for_fd(pinned, label) != parent_mount:
            raise DeploymentError(f"{label} crosses a file mount point: {path}")
        if before.st_size > limit:
            raise DeploymentError(f"{label} exceeds the {limit}-byte safety limit")
        chunks, remaining = [], before.st_size
        while remaining:
            block = os.read(descriptor, min(1024 * 1024, remaining))
            if not block:
                raise DeploymentError(f"{label} changed size while being read")
            chunks.append(block)
            remaining -= len(block)
        if os.read(descriptor, 1):
            raise DeploymentError(f"{label} changed size while being read")
        after = os.fstat(descriptor)
        if (before.st_size, before.st_mtime_ns, before.st_ctime_ns) != (
            after.st_size, after.st_mtime_ns, after.st_ctime_ns
        ):
            raise DeploymentError(f"{label} changed while being read")
        return b"".join(chunks)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        if pinned >= 0:
            os.close(pinned)
        os.close(parent)


def fingerprint(value) -> tuple:
    return (
        value.st_dev, value.st_ino, value.st_nlink, value.st_mode, value.st_uid, value.st_gid,
        value.st_size, value.st_mtime_ns, value.st_ctime_ns,
    )


def untrusted_owner_or_mode(value) -> bool:
    return value.st_uid not in {0, os.geteuid()} or bool(stat.S_IMODE(value.st_mode) & 0o022)


def identity_fields(value) -> tuple:
    """What a preliminary lstat and the opened descriptor must agree on."""
    return (value.st_dev, value.st_ino, value.st_mode, value.st_uid, value.st_gid, value.st_nlink)


def walk_tree(
    root_fd: int, limits: Limits, *, allow_symlinks: bool, keep_data: bool = False,
    capture=None, capture_total_bytes: int = 0, trusted_ownership: bool = False,
    label: str = "tree",
) -> Tree:
    """Read a tree exactly: no symlink follow, no hardlinks, no special files,
    no mount or device crossing, bounded, and stable while it is read."""
    k = kernel()
    root_stat = os.fstat(root_fd)
    root_mount = k.mount_id_for_fd(root_fd, f"{label} root")
    entries = [Entry(".", "dir", stat.S_IMODE(root_stat.st_mode), 0, "", "")]
    data: dict = {}
    state = {"count": 0, "bytes": 0, "captured": 0}
    directory_ids = {(root_stat.st_dev, root_stat.st_ino)}

    def visit(directory: int, prefix: str, depth: int, opened_snapshot) -> None:
        if depth > limits.depth:
            raise DeploymentError(f"{label} exceeds the depth bound")
        before = os.fstat(directory)
        if fingerprint(before) != fingerprint(opened_snapshot):
            raise DeploymentError(f"{label} directory changed before traversal: /{prefix}")
        if trusted_ownership and untrusted_owner_or_mode(before):
            raise DeploymentError(
                f"{label} entry is writable or controlled by another user: /{prefix}"
            )
        try:
            names = []
            with os.scandir(directory) as children:
                for child in children:
                    state["count"] += 1
                    if state["count"] > limits.entries:
                        raise DeploymentError(f"{label} exceeds the entry bound")
                    names.append(child.name)
            names.sort()
        except OSError as error:
            raise DeploymentError(f"{label} cannot be listed at /{prefix}: {error.strerror}") from error
        for name in names:
            check_name(name, f"{label} /{prefix}")
            relative = prefix + name
            try:
                metadata = os.stat(name, dir_fd=directory, follow_symlinks=False)
            except OSError as error:
                raise DeploymentError(f"{label} entry /{relative} is unavailable: {error.strerror}") from error
            if metadata.st_dev != root_stat.st_dev:
                raise DeploymentError(f"{label} crosses a device boundary at /{relative}")
            mode = metadata.st_mode
            if stat.S_ISLNK(mode):
                if not allow_symlinks:
                    raise DeploymentError(f"{label} contains a symlink: /{relative}")
                try:
                    target = os.readlink(name, dir_fd=directory)
                except OSError as error:
                    raise DeploymentError(f"{label} symlink /{relative} is unreadable") from error
                if "\0" in target or len(target) > 4096:
                    raise DeploymentError(f"{label} symlink /{relative} has an unsafe target")
                try:
                    target.encode("utf-8")
                except UnicodeEncodeError as error:
                    raise DeploymentError(f"{label} symlink /{relative} has a non-UTF-8 target") from error
                entries.append(Entry(relative, "symlink", stat.S_IMODE(mode), 0, "", target))
            elif stat.S_ISDIR(mode):
                if trusted_ownership and untrusted_owner_or_mode(metadata):
                    raise DeploymentError(
                        f"{label} entry is writable or controlled by another user: /{relative}"
                    )
                try:
                    child = os.open(name, DIR_FLAGS, dir_fd=directory)
                except OSError as error:
                    raise DeploymentError(f"{label} directory /{relative} cannot be opened safely") from error
                try:
                    opened = os.fstat(child)
                    if identity_fields(opened) != identity_fields(metadata):
                        raise DeploymentError(f"{label} directory /{relative} changed while being opened")
                    if trusted_ownership and untrusted_owner_or_mode(opened):
                        raise DeploymentError(
                            f"{label} entry is writable or controlled by another user: /{relative}"
                        )
                    if k.mount_id_for_fd(child, f"{label} /{relative}") != root_mount:
                        raise DeploymentError(f"{label} crosses a mount point at /{relative}")
                    directory_ids.add((opened.st_dev, opened.st_ino))
                    entries.append(Entry(relative, "dir", stat.S_IMODE(opened.st_mode), 0, "", ""))
                    visit(child, relative + "/", depth + 1, opened)
                finally:
                    os.close(child)
            elif stat.S_ISREG(mode):
                if trusted_ownership and untrusted_owner_or_mode(metadata):
                    raise DeploymentError(
                        f"{label} entry is writable or controlled by another user: /{relative}"
                    )
                read_member(directory, name, relative, metadata)
            else:
                raise DeploymentError(f"{label} contains a special file: /{relative}")
        after = os.fstat(directory)
        if fingerprint(before) != fingerprint(after):
            raise DeploymentError(f"{label} directory changed while being read: /{prefix}")

    def read_member(directory: int, name: str, relative: str, metadata) -> None:
        pinned = descriptor = -1
        try:
            pinned, descriptor, opened = open_pinned_regular_at(
                directory, name, f"{label} file /{relative}"
            )
            if identity_fields(opened) != identity_fields(metadata):
                raise DeploymentError(f"{label} file /{relative} changed while being opened")
            if trusted_ownership and untrusted_owner_or_mode(opened):
                raise DeploymentError(
                    f"{label} entry is writable or controlled by another user: /{relative}"
                )
            if opened.st_nlink != 1:
                raise DeploymentError(f"{label} file /{relative} has additional hard links")
            if k.mount_id_for_fd(pinned, f"{label} /{relative}") != root_mount:
                raise DeploymentError(f"{label} crosses a mount point at /{relative}")
            if opened.st_size > limits.file_bytes:
                raise DeploymentError(f"{label} file /{relative} exceeds the size bound")
            state["bytes"] += opened.st_size
            if state["bytes"] > limits.total_bytes:
                raise DeploymentError(f"{label} exceeds the byte bound")
            capture_selected = keep_data
            capture_bytes = opened.st_size if keep_data else 0
            if capture is not None and not keep_data:
                requested = capture(relative, opened.st_size)
                if requested is not None:
                    if type(requested) is not int or not 0 <= requested <= opened.st_size:
                        raise DeploymentError(f"{label} capture policy is invalid for /{relative}")
                    capture_selected = True
                    capture_bytes = requested
            state["captured"] += capture_bytes
            if capture_total_bytes and state["captured"] > capture_total_bytes:
                raise DeploymentError(f"{label} exceeds the captured-byte bound")
            digest, remaining, chunks, captured = hashlib.sha256(), opened.st_size, [], 0
            while remaining:
                block = os.read(descriptor, min(1024 * 1024, remaining))
                if not block:
                    raise DeploymentError(f"{label} file /{relative} changed size while being read")
                digest.update(block)
                if captured < capture_bytes:
                    piece = block[: capture_bytes - captured]
                    chunks.append(piece)
                    captured += len(piece)
                remaining -= len(block)
            if os.read(descriptor, 1):
                raise DeploymentError(f"{label} file /{relative} grew while being read")
            closing = os.fstat(descriptor)
            if fingerprint(opened) != fingerprint(closing):
                raise DeploymentError(f"{label} file /{relative} changed while being read")
        finally:
            if descriptor >= 0:
                os.close(descriptor)
            if pinned >= 0:
                os.close(pinned)
        entries.append(Entry(
            relative, "file", stat.S_IMODE(opened.st_mode), opened.st_size, digest.hexdigest(), ""
        ))
        if capture_selected:
            data[relative] = b"".join(chunks)

    try:
        visit(root_fd, "", 0, root_stat)
    except OSError as error:
        raise DeploymentError(f"{label} scan failed: {error.strerror}") from error
    entries.sort(key=lambda entry: (entry.path != ".", entry.path.encode("utf-8")))
    return Tree(entries, data, state["bytes"], frozenset(directory_ids))


def diff_entries(actual: list, expected: list, label: str) -> None:
    have = {entry.path: entry for entry in actual}
    want = {entry.path: entry for entry in expected}
    extra = sorted(set(have) - set(want))
    if extra:
        raise DeploymentError(f"{label} has unexpected paths: {extra}")
    missing = sorted(set(want) - set(have))
    if missing:
        raise DeploymentError(f"{label} is missing paths: {missing}")
    for path in sorted(want):
        if have[path] != want[path]:
            raise DeploymentError(f"{label} differs at {path}")


def tree_digest(entries: list) -> str:
    digest = hashlib.sha256(ROOTFS_DIGEST_ALGORITHM.encode("ascii") + b"\n")
    for entry in entries:
        if entry.kind == "file":
            detail = entry.sha256
        elif entry.kind == "symlink":
            detail = json.dumps(entry.target)
        else:
            detail = "-"
        line = f"{entry.kind}\t{entry.mode:04o}\t{entry.size}\t{detail}\t{json.dumps(entry.path)}\n"
        digest.update(line.encode("ascii"))
    return digest.hexdigest()


# --- contracts ------------------------------------------------------------------


class Contracts(NamedTuple):
    reference: dict
    reference_bytes: bytes
    reference_sha256: str
    stage: dict
    stage_bytes: bytes
    stage_sha256: str
    gpu: dict
    gpu_bytes: bytes
    gpu_sha256: str
    deployment: dict
    deployment_bytes: bytes
    deployment_sha256: str


def expected_deployment_contract(reference: dict, reference_sha256: str, stage_sha256: str, gpu_sha256: str) -> dict:
    assets = reference["module_assets"]
    stage_destination = "/usr/local/sbin/myron-attempt79-module-dir"
    reference_order = (
        list(REFERENCE_MODULE_ORDER)
        if set(assets["modules"]) == set(REFERENCE_MODULE_ORDER)
        else list(assets["modules"])
    )
    return {
        "schema": 1,
        "kind": CONTRACT_KIND,
        "components": {
            "kernel_reference": {"path": KERNEL_REFERENCE_PATH, "sha256": reference_sha256},
            "stage_contract": {"path": STAGE_CONTRACT_PATH, "sha256": stage_sha256},
            "gpu_profile_reference": {"path": GPU_REFERENCE_PATH, "sha256": gpu_sha256},
        },
        "device": dict(reference["device"]),
        "rootfs": {
            "external": True,
            "copied_into_kit": False,
            "digest_algorithm": ROOTFS_DIGEST_ALGORITHM,
            "digest_scope": "path, type, mode, size, content sha256 and symlink target of every entry, sorted by path; no owner, time or hardlink identity",
            "symlinks": "recorded in the digest and never followed",
            "hardlinks": "rejected",
            "stage_marker": ROOTFS_MARKER,
            "device_lines": list(ROOTFS_DEVICE_LINES),
            "manifest_lines": list(ROOTFS_MANIFEST_LINES),
            "required_files": list(ROOTFS_REQUIRED_FILES),
            "bound_files": {
                ROOTFS_KERNEL_REFERENCE: reference_sha256,
                ROOTFS_STAGE_CONTRACT: stage_sha256,
                ROOTFS_GPU_REFERENCE: gpu_sha256,
            },
        },
        "modules": {
            "archive_sha256": assets["archive_sha256"],
            "module_directory": assets["module_directory"],
            "selector_destination": stage_destination,
            "file_count": 1 + len(assets["modules"]),
            "module_count": len(assets["modules"]),
            "order": {
                "source": "public myron-postmarketOS Attempt79/VT staging order; load semantics unverified",
                "status": "unverified",
                "modules": reference_order,
            },
        },
        "runtime": {
            "manifest_sha256": reference["runtime_assets"]["manifest_sha256"],
            "required_features": list(RUNTIME_FEATURES),
            "bytes": "external-private",
            "copied_into_kit": False,
        },
        "blockers": list(BLOCKERS),
        "deployment_authorized": False,
        "bootable": False,
        "flashable": False,
        "image_ready": False,
    }


def load_contracts(root: Path) -> Contracts:
    k, g = kernel(), gpu()
    base = str(root)

    def read(relative: str, label: str) -> bytes:
        return read_file(f"{base}/{relative}", label, MAX_SMALL_BYTES)

    reference_bytes = read(KERNEL_REFERENCE_PATH, "kernel contract reference")
    reference = strict_json(reference_bytes, "kernel contract reference")
    k.validate_reference(reference)
    reference_sha256 = sha256_bytes(reference_bytes)
    stage_bytes = read(STAGE_CONTRACT_PATH, "stage contract")
    stage = strict_json(stage_bytes, "stage contract")
    k.validate_stage_contract(stage, reference, reference_sha256)
    stage_sha256 = sha256_bytes(stage_bytes)
    gpu_bytes = read(GPU_REFERENCE_PATH, "GPU profile reference")
    gpu_reference = g.validate_reference(gpu_bytes)
    gpu_sha256 = sha256_bytes(gpu_bytes)
    deployment_bytes = read(DEPLOYMENT_CONTRACT_PATH, "deployment contract")
    deployment = strict_json(deployment_bytes, "deployment contract")
    expected = expected_deployment_contract(reference, reference_sha256, stage_sha256, gpu_sha256)
    if set(deployment) != set(expected):
        raise DeploymentError("deployment contract top-level fields differ")
    for key, value in expected.items():
        if not k.strict_equal(deployment[key], value):
            raise DeploymentError(f"deployment contract differs at {key}")
    if deployment_bytes != render_json(expected):
        raise DeploymentError("deployment contract is not in canonical form")
    return Contracts(
        reference, reference_bytes, reference_sha256, stage, stage_bytes, stage_sha256,
        gpu_reference, gpu_bytes, gpu_sha256, deployment, deployment_bytes, sha256_bytes(deployment_bytes),
    )


def kernel_contracts(contracts: Contracts):
    return kernel().Contracts(
        contracts.reference, contracts.reference_sha256, contracts.stage, contracts.stage_sha256
    )


# --- module archive and stage plan ----------------------------------------------


def load_archive(contracts: Contracts, assets: str):
    """Return (stage plan, {destination: bytes}) for the qualified archive."""
    return archive_contents(contracts, read_archive(assets))


def read_archive(assets: str) -> bytes:
    return read_file(assets, "module asset archive", kernel().MAX_ARCHIVE_BYTES)


def archive_contents(contracts: Contracts, data: bytes):
    k = kernel()
    selector = contracts.stage["layout"]["selector"]
    plan = k.build_stage_plan_bytes(kernel_contracts(contracts), data)
    payload = k.read_module_payload_bytes(
        contracts.reference, data, selector["destination"]
    )
    template = contracts.stage["layout"]["module_file"]
    members = {selector["destination"]: selector["archive_member"]}
    for name in contracts.reference["module_assets"]["modules"]:
        members[template["destination"].format(name=name)] = template["archive_member"].format(name=name)
    contents = {destination: payload[member] for destination, member in members.items()}
    if sorted(contents) != [entry["destination"] for entry in plan["files"]]:
        raise DeploymentError("stage plan and archive members differ")
    return plan, contents


def module_layout(contracts: Contracts) -> tuple[dict, dict]:
    layout = contracts.stage["layout"]
    mode = int(layout["directory_mode"], 8)
    directories = {
        path.lstrip("/"): mode
        for path in (*layout["ancestor_directories"], *layout["owned_directories"])
    }
    selector = layout["selector"]
    template = layout["module_file"]
    files = {selector["destination"].lstrip("/"): int(selector["mode"], 8)}
    for name in contracts.reference["module_assets"]["modules"]:
        files[template["destination"].format(name=name).lstrip("/")] = int(template["mode"], 8)
    return directories, files


def check_module_shape(tree: Tree, contracts: Contracts) -> list[dict]:
    """The module stage is exactly the contract's directories, selector and modules."""
    directories, files = module_layout(contracts)
    mode = int(contracts.stage["layout"]["directory_mode"], 8)
    actual_dirs = {e.path: e for e in tree.entries if e.kind == "dir"}
    actual_files = {e.path: e for e in tree.entries if e.kind == "file"}
    if set(actual_dirs) != {".", *directories}:
        raise DeploymentError("module stage directory set differs from the stage contract")
    if set(actual_files) != set(files):
        raise DeploymentError("module stage file set differs from the stage contract")
    if any(entry.mode != mode for entry in actual_dirs.values()):
        raise DeploymentError("module stage directory mode differs from the stage contract")
    for path, expected_mode in files.items():
        if actual_files[path].mode != expected_mode:
            raise DeploymentError(f"module stage file mode differs: /{path}")
    selector = contracts.stage["layout"]["selector"]["destination"].lstrip("/")
    if actual_files[selector].sha256 != contracts.reference["module_assets"]["candidate_selector_sha256"]:
        raise DeploymentError("module stage selector is not the qualified candidate selector")
    marker = b"vermagic=" + contracts.reference["kernel"]["release"].encode("ascii")
    template = contracts.stage["layout"]["module_file"]
    for name in contracts.reference["module_assets"]["modules"]:
        path = template["destination"].format(name=name).lstrip("/")
        body = tree.data[path]
        if marker + b" " not in body and marker + b"\0" not in body:
            raise DeploymentError(f"module does not carry the exact kernel release: {name}")
    return [
        {"destination": "/" + path, "mode": f"{actual_files[path].mode:04o}",
         "size": actual_files[path].size, "sha256": actual_files[path].sha256}
        for path in sorted(files)
    ]


def check_against_plan(module_files: list[dict], plan: dict) -> None:
    if module_files != plan["files"]:
        raise DeploymentError("module stage differs from the qualified archive plan")


def read_module_stage(contracts: Contracts, path: str, label: str) -> tuple[Tree, list[dict]]:
    descriptor = open_canonical_dir(path, label)
    try:
        tree = walk_tree(descriptor, STAGE_LIMITS, allow_symlinks=False, keep_data=True, label=label)
    finally:
        os.close(descriptor)
    return tree, check_module_shape(tree, contracts)


# --- rootfs stage -------------------------------------------------------------


def rootfs_absent(index: dict, relative: str) -> None:
    parts = relative.split("/")
    for number in range(len(parts)):
        entry = index.get("/".join(parts[: number + 1]))
        if entry is None:
            return
        if number == len(parts) - 1:
            raise DeploymentError(f"proprietary, vendor or activation path present: {relative}")
        if entry.kind != "dir":
            raise DeploymentError(f"unsafe ancestor for {relative}")


def full_snapshot_file(tree: Tree, index: dict, path: str, limit: int, label: str) -> bytes:
    entry = index.get(path)
    data = tree.data.get(path)
    if entry is None or entry.kind != "file" or entry.size > limit or data is None or len(data) != entry.size:
        raise DeploymentError(f"{label} is missing, unsafe, or exceeds its snapshot bound")
    return data


def validate_gpu_snapshot(tree: Tree, index: dict, contracts: Contracts) -> None:
    """Validate GPU/profile bytes captured by the same pass that made the digest."""
    g = gpu()
    reference_data = full_snapshot_file(
        tree, index, ROOTFS_GPU_REFERENCE, MAX_SMALL_BYTES, "GPU profile reference"
    )
    reference = g.validate_reference(reference_data)
    if sha256_bytes(reference_data) != contracts.gpu_sha256:
        raise DeploymentError("rootfs GPU profile reference differs from the contract")

    for absolute, expected in reference["assets"].items():
        relative = absolute.lstrip("/")
        entry = index.get(relative)
        if entry is None or entry.kind != "file" or entry.sha256 != expected:
            raise DeploymentError(f"GPU profile asset differs from its snapshot contract: {absolute}")

    mesa_reference_path = reference["mesa"]["reference"].lstrip("/")
    g.validate_mesa_reference(
        full_snapshot_file(tree, index, mesa_reference_path, MAX_SMALL_BYTES, "Mesa reference"),
        reference,
    )

    prefix = g.MESA_PREFIX.as_posix()
    expected = {"dri": "dir", "SHA256SUMS": "file"}
    expected.update({name: "file" for name in g.MESA_REGULAR_FILES})
    expected.update({name: "symlink" for name in g.MESA_SYMLINKS})
    actual = {}
    for entry in tree.entries:
        if entry.path.startswith(prefix + "/"):
            actual[entry.path[len(prefix) + 1:]] = entry.kind
    if actual != expected:
        raise DeploymentError("Mesa snapshot layout differs from the isolated GPU contract")

    manifest_path = prefix + "/SHA256SUMS"
    manifest = g.parse_mesa_manifest(
        full_snapshot_file(tree, index, manifest_path, MAX_SMALL_BYTES, "Mesa manifest")
    )
    for name, expected_hash in manifest.items():
        path = prefix + "/" + name
        entry = index.get(path)
        if (
            entry is None
            or entry.kind != "file"
            or entry.size > g.MAX_MESA_FILE_BYTES
            or entry.sha256 != expected_hash
        ):
            raise DeploymentError(f"Mesa snapshot payload SHA-256 differs: {name}")
        if name != "freedreno-kgsl.json":
            header = tree.data.get(path, b"")
            if (
                len(header) != 20
                or header[:4] != b"\x7fELF"
                or header[4] != 2
                or header[5] != 1
                or int.from_bytes(header[18:20], "little") != 183
            ):
                raise DeploymentError(f"Mesa snapshot payload is not little-endian AArch64 ELF64: {name}")
    for name, target in g.MESA_SYMLINKS.items():
        entry = index.get(prefix + "/" + name)
        if entry is None or entry.kind != "symlink" or entry.target != target:
            raise DeploymentError(f"Mesa snapshot symlink differs: {name}")

    icd_path = prefix + "/freedreno-kgsl.json"
    icd = g.strict_json(
        full_snapshot_file(tree, index, icd_path, MAX_SMALL_BYTES, "Mesa ICD manifest"),
        "Mesa ICD manifest",
    )
    if not isinstance(icd.get("ICD"), dict) or icd["ICD"].get("library_path") != (
        "/usr/lib/omamobile/myron-gpu/libvulkan_freedreno.so"
    ):
        raise DeploymentError("Mesa snapshot ICD does not point to isolated Turnip")

    for scope_name in g.GLOBAL_ACTIVATION_PATHS:
        parts = Path(scope_name).parts
        for number in range(1, len(parts)):
            ancestor = "/".join(parts[:number])
            entry = index.get(ancestor)
            if entry is None:
                break
            if entry.kind != "dir":
                raise DeploymentError(
                    f"global activation path has a non-directory ancestor: {scope_name}"
                )

    activation_entries = [
        entry for entry in tree.entries
        if entry.path != "." and g.in_activation_scope(Path(entry.path))
    ]
    if len(activation_entries) > g.MAX_SCAN_FILES:
        raise DeploymentError("global activation snapshot exceeds entry safety limit")
    total = 0
    hits = []
    for entry in activation_entries:
        if entry.kind == "dir":
            path = Path(entry.path)
            depths = [
                len(path.parts) - len(Path(scope).parts)
                for scope in g.GLOBAL_ACTIVATION_PATHS
                if path == Path(scope) or Path(scope) in path.parents
            ]
            if depths and max(depths) > g.MAX_SCAN_DEPTH:
                raise DeploymentError("global activation snapshot exceeds depth safety limit")
            continue
        if entry.kind == "file":
            if entry.size > g.MAX_FILE_BYTES:
                raise DeploymentError(f"global activation candidate is too large: /{entry.path}")
            body = tree.data.get(entry.path)
            if body is None or len(body) != entry.size:
                raise DeploymentError(f"global activation candidate lacks snapshot bytes: /{entry.path}")
            total += len(body)
            if g.marker_in(body):
                hits.append("/" + entry.path)
        else:
            encoded = entry.target.encode()
            total += len(encoded)
            link = Path(entry.path)
            if g.marker_in(encoded):
                hits.append("/" + entry.path)
                continue
            target = g.normalize_symlink_target(link, entry.target)
            if target != Path("dev/null"):
                target_name = target.as_posix()
                if target == link or not g.in_activation_scope(target) or target_name not in index:
                    raise DeploymentError(f"unsafe global activation symlink: /{entry.path}")
        if total > g.MAX_SCAN_BYTES:
            raise DeploymentError("global activation snapshot exceeds byte safety limit")
    if hits:
        raise DeploymentError("private GPU stack is selected by global path: " + ", ".join(hits))


def check_rootfs(root: str, manifest_path: str, contracts: Contracts) -> tuple[dict, dict, frozenset]:
    """Fail-closed equivalent of tests/rootfs-stage; return binding, index, directory IDs."""
    g = gpu()
    gpu_full_paths = {
        ROOTFS_REQUIRED_FILES[0],
        ROOTFS_GPU_REFERENCE,
        *(path.lstrip("/") for path in contracts.gpu["assets"]),
        contracts.gpu["mesa"]["reference"].lstrip("/"),
        g.MESA_PREFIX.as_posix() + "/SHA256SUMS",
        g.MESA_PREFIX.as_posix() + "/freedreno-kgsl.json",
    }

    def capture(path: str, size: int) -> int | None:
        if path in gpu_full_paths or g.in_activation_scope(Path(path)):
            return size
        if path.startswith(g.MESA_PREFIX.as_posix() + "/"):
            return min(size, 20)
        return None

    descriptor = open_canonical_dir(root, "rootfs stage")
    try:
        tree = walk_tree(
            descriptor,
            ROOTFS_LIMITS,
            allow_symlinks=True,
            capture=capture,
            capture_total_bytes=g.MAX_SCAN_BYTES + 8 * MAX_SMALL_BYTES,
            label="rootfs stage",
        )
    finally:
        os.close(descriptor)
    index = {entry.path: entry for entry in tree.entries}

    for relative in ROOTFS_REQUIRED_FILES:
        entry = index.get(relative)
        if entry is None or entry.kind != "file":
            raise DeploymentError(f"missing or unsafe Myron metadata/contract: {relative}")
        if entry.size > MAX_SMALL_BYTES:
            raise DeploymentError(f"Myron metadata/contract is too large: {relative}")
    for relative, expected in contracts.deployment["rootfs"]["bound_files"].items():
        entry = index.get(relative)
        if entry is None or entry.kind != "file":
            raise DeploymentError(f"missing or unsafe bound contract: {relative}")
        if entry.sha256 != expected:
            raise DeploymentError(f"rootfs contract differs from the deployment contract: {relative}")

    device_path = ROOTFS_REQUIRED_FILES[0]
    device_bytes = full_snapshot_file(
        tree, index, device_path, MAX_SMALL_BYTES, "device contract"
    )
    try:
        device_lines = set(device_bytes.decode("utf-8").splitlines())
    except UnicodeDecodeError as error:
        raise DeploymentError("device contract is not UTF-8") from error
    for expected in ROOTFS_DEVICE_LINES:
        if expected not in device_lines:
            raise DeploymentError(f"device.conf lacks {expected}")

    manifest_bytes = read_file(manifest_path, "rootfs MANIFEST", MAX_SMALL_BYTES)
    try:
        manifest_text = manifest_bytes.decode("utf-8")
    except UnicodeDecodeError as error:
        raise DeploymentError("rootfs MANIFEST is not UTF-8") from error
    if not manifest_text.startswith(ROOTFS_MARKER):
        raise DeploymentError("MANIFEST lacks the non-bootable stage marker")
    manifest_lines = set(manifest_text.splitlines())
    for expected in ROOTFS_MANIFEST_LINES:
        if expected not in manifest_lines:
            raise DeploymentError(f"MANIFEST lacks {expected}")

    firmware = index.get("usr/lib/firmware")
    if firmware is None or firmware.kind != "dir":
        raise DeploymentError("firmware directory is not a real directory")
    names = set()
    for entry in tree.entries:
        if entry.path.startswith("usr/lib/firmware/"):
            rest = entry.path[len("usr/lib/firmware/"):]
            if "/" in rest or entry.kind != "file":
                raise DeploymentError(f"firmware entry is not a regular file: {rest}")
            names.add(rest)
    if names != {"regulatory.db", "regulatory.db.p7s"}:
        raise DeploymentError("firmware directory differs from regulatory database allowlist")

    alias = index.get("lib")
    if alias is not None and (alias.kind != "symlink" or alias.target != "usr/lib"):
        raise DeploymentError("system library alias differs from the usr-merged symlink: lib")
    modules = index.get("usr/lib/modules")
    if modules is not None:
        if modules.kind != "dir":
            raise DeploymentError("kernel modules path is not a real directory: usr/lib/modules")
        if any(entry.path.startswith("usr/lib/modules/") for entry in tree.entries):
            raise DeploymentError("kernel modules in the stage")
    for relative in ROOTFS_ABSENT:
        rootfs_absent(index, relative)
    for entry in tree.entries:
        name = entry.path.rsplit("/", 1)[-1]
        if entry.path != "." and any(fnmatch.fnmatchcase(name, pattern) for pattern in ROOTFS_PAYLOAD_NAMES):
            raise DeploymentError(f"kernel, module, or boot payload: {entry.path}")

    check_collisions(index, contracts)

    validate_gpu_snapshot(tree, index, contracts)

    binding = {
        "digest_algorithm": ROOTFS_DIGEST_ALGORITHM,
        "digest": tree_digest(tree.entries),
        "entry_count": len(tree.entries),
        "file_bytes": tree.file_bytes,
        "manifest_sha256": sha256_bytes(manifest_bytes),
        "manifest_size": len(manifest_bytes),
        "copied_into_kit": False,
    }
    return binding, index, tree.directory_ids


def check_collisions(index: dict, contracts: Contracts) -> None:
    layout = contracts.stage["layout"]
    owned = [layout["selector"]["destination"], *layout["owned_directories"]]
    for destination in owned:
        if destination.lstrip("/") in index:
            raise DeploymentError(f"module overlay destination collides with the rootfs: {destination}")
    for ancestor in layout["ancestor_directories"]:
        entry = index.get(ancestor.lstrip("/"))
        if entry is not None and entry.kind != "dir":
            raise DeploymentError(f"rootfs ancestor of the module overlay is not a real directory: {ancestor}")


# --- private runtime-asset binding (hashes only) -----------------------------------


def runtime_input(assets: str, manifest: str | None) -> RuntimeInput:
    if assets == RUNTIME_NONE:
        if manifest is not None:
            raise DeploymentError("--runtime-manifest is only valid with a --runtime-assets directory")
        return RuntimeInput(None, None)
    split_canonical(assets, "runtime assets root")
    if manifest is None:
        raise DeploymentError("--runtime-assets DIR requires --runtime-manifest")
    split_canonical(manifest, "runtime manifest")
    return RuntimeInput(assets, manifest)


def paths_overlap(first: str, second: str) -> bool:
    return first == second or first.startswith(second + "/") or second.startswith(first + "/")


def check_runtime_scope(runtime: RuntimeInput, others: dict) -> None:
    """The runtime root and manifest must not nest in or equal any other path."""
    if runtime.root is None:
        return
    if paths_overlap(runtime.root, runtime.manifest):
        raise DeploymentError("runtime asset manifest overlaps the runtime asset root")
    for label, path in others.items():
        for name, own in (("root", runtime.root), ("manifest", runtime.manifest)):
            if own is not None and paths_overlap(own, path):
                raise DeploymentError(f"runtime asset {name} overlaps the {label}")


def check_runtime_alias(
    runtime_ids: frozenset, manifest_parent_ids: frozenset, others: frozenset
) -> None:
    if runtime_ids & others:
        raise DeploymentError("runtime asset root aliases a directory of another input or output tree")
    if manifest_parent_ids & (runtime_ids | others):
        raise DeploymentError("runtime asset manifest parent aliases a directory of another input tree")


def runtime_digest(manifest_sha256: str, features: list, files: list) -> str:
    digest = hashlib.sha256(RUNTIME_DIGEST_ALGORITHM.encode("ascii") + b"\n")
    digest.update(f"manifest\t{manifest_sha256}\n".encode("ascii"))
    digest.update(f"features\t{','.join(features)}\n".encode("ascii"))
    for row in files:
        line = (
            f"file\t{row['mode']}\t{row['size']}\t{row['sha256']}\t{row['feature']}"
            f"\t{row['provenance']}\t{json.dumps(row['target'])}\n"
        )
        digest.update(line.encode("ascii"))
    return digest.hexdigest()


def runtime_identity(contracts: Contracts) -> dict:
    runtime = contracts.deployment["runtime"]
    return {
        "algorithm": RUNTIME_DIGEST_ALGORITHM,
        "manifest_sha256": runtime["manifest_sha256"],
        "required_features": list(runtime["required_features"]),
        "bytes_copied_into_kit": False,
    }


def runtime_evidence_none(contracts: Contracts) -> dict:
    return {**runtime_identity(contracts), "status": "not-bound", "asset_count": 0, "files": [], "digest": None}


def open_trusted_file(
    path: str, label: str, short: str
) -> tuple[int, int, os.stat_result, tuple[int, int]]:
    """Open a file through trusted no-follow ancestry and pin its inode."""
    parts = split_canonical(path, short)
    parent = open_trusted_output_parent(parts[:-1], f"{short} parent")
    pinned = descriptor = -1
    try:
        pinned, descriptor, opened = open_pinned_regular_at(parent, parts[-1], f"{label}: {path}")
        pinned_metadata = os.fstat(pinned)
        if identity_fields(pinned_metadata) != identity_fields(opened):
            raise DeploymentError(f"{label} changed while being opened")
        trusted_parent_entry(parent, opened, label)
        if untrusted_owner_or_mode(opened):
            raise DeploymentError(f"{label} is writable or controlled by another user")
        if opened.st_nlink != 1:
            raise DeploymentError(f"{label} has additional hard links")
        parent_mount = kernel().mount_id_for_fd(parent, f"{short} parent")
        if kernel().mount_id_for_fd(pinned, short) != parent_mount:
            raise DeploymentError(f"{label} crosses a file mount point")
        parent_metadata = os.fstat(parent)
        return pinned, descriptor, opened, (parent_metadata.st_dev, parent_metadata.st_ino)
    except BaseException:
        if descriptor >= 0:
            os.close(descriptor)
        if pinned >= 0:
            os.close(pinned)
        raise
    finally:
        os.close(parent)


def capture_trusted_file(path: str, label: str, short: str, limit: int) -> tuple[bytes, ManifestHandle]:
    """One bounded, stable read of a trusted file; the pinned inode stays open."""
    pinned, descriptor, before, parent_identity = open_trusted_file(path, label, short)
    try:
        if before.st_size > limit:
            raise DeploymentError(f"{label} exceeds the {limit}-byte safety limit")
        chunks, remaining = [], before.st_size
        while remaining:
            block = os.read(descriptor, min(1024 * 1024, remaining))
            if not block:
                raise DeploymentError(f"{label} changed size while being read")
            chunks.append(block)
            remaining -= len(block)
        if os.read(descriptor, 1):
            raise DeploymentError(f"{label} changed size while being read")
        after = os.fstat(descriptor)
        if fingerprint(before) != fingerprint(after):
            raise DeploymentError(f"{label} changed while being read")
        return b"".join(chunks), ManifestHandle(pinned, fingerprint(before), parent_identity)
    except BaseException:
        os.close(pinned)
        raise
    finally:
        os.close(descriptor)


def recheck_trusted_file(path: str, handle: ManifestHandle, label: str, short: str) -> None:
    if fingerprint(os.fstat(handle.pinned)) != handle.identity:
        raise DeploymentError(f"{label} changed during verification")
    pinned = descriptor = -1
    try:
        pinned, descriptor, current, parent_identity = open_trusted_file(path, label, short)
        if fingerprint(current) != handle.identity or parent_identity != handle.parent_identity:
            raise DeploymentError(f"{label} changed during verification")
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        if pinned >= 0:
            os.close(pinned)


def parse_runtime_manifest_bytes(data: bytes, expected_hash: str) -> list[dict[str, str]]:
    """Parse the kernel contract's TSV schema from one captured byte string."""
    actual_hash = sha256_bytes(data)
    if actual_hash != expected_hash:
        raise DeploymentError(
            f"runtime asset manifest SHA-256 differs: expected {expected_hash}, got {actual_hash}"
        )
    try:
        stream = io.StringIO(data.decode("utf-8"), newline="")
        reader = csv.DictReader(stream, delimiter="\t")
        if reader.fieldnames != MANIFEST_FIELDS:
            raise DeploymentError("runtime asset manifest header differs")
        rows = list(reader)
    except (UnicodeDecodeError, csv.Error) as error:
        raise DeploymentError(f"cannot read runtime asset manifest: {error}") from error
    if not rows:
        raise DeploymentError("runtime asset manifest is empty")
    seen: set[str] = set()
    for number, row in enumerate(rows, 2):
        if set(row) != set(MANIFEST_FIELDS) or any(value is None for value in row.values()):
            raise DeploymentError(f"runtime asset column count differs on line {number}")
        target = row["target"]
        target_path = PurePosixPath(target)
        if (
            not target_path.is_absolute()
            or ".." in target_path.parts
            or target in seen
            or not target.startswith(("/usr/lib/", "/usr/local/", "/usr/sbin/"))
        ):
            raise DeploymentError(f"unsafe or duplicate runtime target on line {number}")
        if not HEX256.fullmatch(row["sha256"]):
            raise DeploymentError(f"invalid runtime hash on line {number}")
        if not MANIFEST_FEATURE.fullmatch(row["feature"]):
            raise DeploymentError(f"invalid runtime feature on line {number}")
        if row["provenance"] not in MANIFEST_POLICY:
            raise DeploymentError(f"invalid runtime provenance on line {number}")
        if row["redistribution"] != MANIFEST_POLICY[row["provenance"]]:
            raise DeploymentError(f"invalid redistribution policy on line {number}")
        seen.add(target)
    return rows


def capture_runtime_manifest(path: str, expected_hash: str) -> tuple[list[dict[str, str]], ManifestHandle]:
    data, handle = capture_trusted_file(
        path, "runtime asset manifest", "runtime manifest", MAX_MANIFEST_BYTES
    )
    try:
        return parse_runtime_manifest_bytes(data, expected_hash), handle
    except BaseException:
        os.close(handle.pinned)
        raise


def recheck_runtime_manifest(path: str, handle: ManifestHandle) -> None:
    recheck_trusted_file(path, handle, "runtime asset manifest", "runtime manifest")


def runtime_selection(
    contracts: Contracts, manifest_path: str
) -> tuple[list[dict], ManifestHandle]:
    """The pinned manifest's rows of every required feature, fail closed."""
    runtime = contracts.deployment["runtime"]
    rows, handle = capture_runtime_manifest(manifest_path, runtime["manifest_sha256"])
    features = runtime["required_features"]
    try:
        for feature in features:
            if not any(row["feature"] == feature for row in rows):
                raise DeploymentError(f"runtime manifest has no row for required feature: {feature}")
        selected = [row for row in rows if row["feature"] in features]
        for row in selected:
            split_canonical(row["target"], "runtime target")
            if not row["target"].startswith(RUNTIME_TARGET_PREFIX):
                raise DeploymentError(
                    f"required runtime target is outside {RUNTIME_TARGET_PREFIX}*: {row['target']}"
                )
            if row["provenance"] != "stock-extracted" or row["redistribution"] != "extract-only":
                raise DeploymentError(
                    f"required runtime row is not stock-extracted and extract-only: {row['target']}"
                )
        targets = sorted(row["target"] for row in selected)
        for target in targets:
            if any(other.startswith(target + "/") for other in targets):
                raise DeploymentError(f"required runtime target is an ancestor of another: {target}")
        return selected, handle
    except BaseException:
        os.close(handle.pinned)
        raise


def inspect_runtime(
    contracts: Contracts, runtime: RuntimeInput
) -> tuple[dict, frozenset, frozenset]:
    """Evidence for the required closure, derived from one captured walk.

    Hashes and sizes come only from the walk of the pinned root; nothing is
    reopened per file and no byte is retained."""
    selected, manifest_handle = runtime_selection(contracts, runtime.manifest)
    try:
        wanted = {row["target"].lstrip("/"): row for row in selected}
        ancestors = {"."}
        for path in wanted:
            parts = path.split("/")
            ancestors.update("/".join(parts[:number]) for number in range(1, len(parts)))
        descriptor, identity = open_trusted_artifact(runtime.root, "runtime assets root")
        try:
            tree = walk_tree(
                descriptor, RUNTIME_LIMITS, allow_symlinks=False, trusted_ownership=True,
                label="runtime assets",
            )
        finally:
            os.close(descriptor)
        files = {entry.path: entry for entry in tree.entries if entry.kind == "file"}
        dirs = {entry.path for entry in tree.entries if entry.kind == "dir"}
        extra = sorted(set(files) - set(wanted))
        if extra:
            raise DeploymentError(f"runtime assets contain unlisted or optional files: {extra}")
        missing = sorted(set(wanted) - set(files))
        if missing:
            raise DeploymentError(f"runtime assets are missing required files: {missing}")
        if dirs != ancestors:
            raise DeploymentError("runtime assets directory set differs from the required closure")
        rows = []
        for path in sorted(wanted, key=lambda item: item.encode("utf-8")):
            entry, row = files[path], wanted[path]
            if entry.sha256 != row["sha256"]:
                raise DeploymentError(f"runtime asset SHA-256 differs: {row['target']}")
            rows.append({
                "target": row["target"], "sha256": entry.sha256, "size": entry.size,
                "mode": f"{entry.mode:04o}", "feature": row["feature"],
                "provenance": row["provenance"],
            })
        recheck_trusted_artifact(runtime.root, identity, "runtime assets root")
        recheck_runtime_manifest(runtime.manifest, manifest_handle)
    finally:
        os.close(manifest_handle.pinned)
    features = list(contracts.deployment["runtime"]["required_features"])
    manifest_sha256 = contracts.deployment["runtime"]["manifest_sha256"]
    evidence = {
        **runtime_identity(contracts), "status": "verified", "asset_count": len(rows), "files": rows,
        "digest": runtime_digest(manifest_sha256, features, rows),
    }
    return evidence, tree.directory_ids, frozenset({manifest_handle.parent_identity})


def bind_runtime(
    contracts: Contracts, runtime: RuntimeInput
) -> tuple[dict, frozenset, frozenset]:
    if runtime.root is None:
        return runtime_evidence_none(contracts), frozenset(), frozenset()
    return inspect_runtime(contracts, runtime)


def validate_runtime_evidence(value, contracts: Contracts) -> dict:
    """Strictly validate recorded runtime_assets evidence; return it unchanged."""
    k = kernel()
    identity = runtime_identity(contracts)
    keys = {*identity, "status", "asset_count", "files", "digest"}
    if type(value) is not dict:
        raise DeploymentError("kit runtime_assets fields differ")
    for flag in AUTHORITY_FLAGS:
        if flag in value and value[flag] is not False:
            raise DeploymentError(f"kit claims {flag}; deployment authorization is refused")
    if set(value) != keys:
        raise DeploymentError("kit runtime_assets fields differ")
    if value["bytes_copied_into_kit"] is not False:
        raise DeploymentError("kit runtime_assets bytes_copied_into_kit must be false")
    for key, expected in identity.items():
        if not k.strict_equal(value[key], expected):
            raise DeploymentError(f"kit runtime_assets differs at {key}")
    count, files = value["asset_count"], value["files"]
    if type(count) is not int or type(files) is not list or count != len(files):
        raise DeploymentError("kit runtime_assets count differs from its files")
    if value["status"] == "not-bound":
        if count != 0 or value["digest"] is not None:
            raise DeploymentError("kit runtime_assets not-bound evidence must be empty")
        return value
    if value["status"] != "verified" or count < 1:
        raise DeploymentError("kit runtime_assets status differs")
    features = identity["required_features"]
    row_keys = {"target", "sha256", "size", "mode", "feature", "provenance"}
    previous = None
    for row in files:
        if type(row) is not dict or set(row) != row_keys:
            raise DeploymentError("kit runtime_assets file fields differ")
        target = row["target"]
        if type(target) is not str or not target.startswith(RUNTIME_TARGET_PREFIX):
            raise DeploymentError("kit runtime_assets file target differs")
        split_canonical(target, "recorded runtime target")
        if previous is not None and target.encode("utf-8") <= previous:
            raise DeploymentError("kit runtime_assets files are not sorted and unique")
        previous = target.encode("utf-8")
        if type(row["sha256"]) is not str or not HEX256.fullmatch(row["sha256"]):
            raise DeploymentError("kit runtime_assets file hash differs")
        if type(row["size"]) is not int or row["size"] < 0:
            raise DeploymentError("kit runtime_assets file size differs")
        if type(row["mode"]) is not str or not MODE_TEXT.fullmatch(row["mode"]):
            raise DeploymentError("kit runtime_assets file mode differs")
        if row["feature"] not in features or row["provenance"] != "stock-extracted":
            raise DeploymentError("kit runtime_assets file feature or provenance differs")
    if value["digest"] != runtime_digest(identity["manifest_sha256"], features, files):
        raise DeploymentError("kit runtime_assets digest differs from its files")
    return value


def runtime_report(evidence: dict) -> dict:
    return {
        "runtime_status": evidence["status"],
        "runtime_asset_count": evidence["asset_count"],
        "runtime_digest": evidence["digest"],
    }


# --- staged-set ABI evidence (hashes and a report summary only) ------------------


def abi_input(vmlinux: str, module: str) -> AbiInput:
    if vmlinux == ABI_NONE and module == ABI_NONE:
        return AbiInput(None, None)
    if ABI_NONE in (vmlinux, module):
        raise DeploymentError(
            "--vmlinux-symvers and --module-symvers must both be 'none' or both be files"
        )
    split_canonical(vmlinux, "vmlinux.symvers")
    split_canonical(module, "kernel_aarch64_Module.symvers")
    if vmlinux == module:
        raise DeploymentError("vmlinux.symvers and kernel_aarch64_Module.symvers are the same path")
    return AbiInput(vmlinux, module)


def check_abi_scope(abi: AbiInput, others: dict) -> None:
    """Neither symvers file may equal or nest in any other path."""
    if abi.vmlinux is None:
        return
    for label, path in others.items():
        for name, own in (("vmlinux.symvers", abi.vmlinux), ("Module.symvers", abi.module)):
            if paths_overlap(own, path):
                raise DeploymentError(f"{name} input overlaps the {label}")


def check_abi_alias(abi_parent_ids: frozenset, others: frozenset) -> None:
    if abi_parent_ids & others:
        raise DeploymentError("ABI symvers parent aliases a directory of another input or output tree")


def abi_identity(contracts: Contracts) -> dict:
    kernel_reference = contracts.reference["kernel"]
    return {
        "algorithm": ABI_DIGEST_ALGORITHM,
        "scope": ABI_SCOPE,
        "vendor_modules": "not-verified",
        "parser": ABI_PARSER,
        "activation": contracts.reference["activation"]["mode"],
        "deployment_blocker": "unchanged",
        "blocker": ABI_BLOCKER,
        "symvers_bytes_copied_into_kit": False,
        "kernel_release": kernel_reference["release"],
        "reference_sha256": contracts.reference_sha256,
        "stage_contract_sha256": contracts.stage_sha256,
        "archive_sha256": contracts.reference["module_assets"]["archive_sha256"],
        "vmlinux_symvers_sha256": kernel_reference["vmlinux_symvers_sha256"],
        "module_symvers_sha256": kernel_reference["module_symvers_sha256"],
    }


def abi_evidence_none(contracts: Contracts) -> dict:
    return {
        **abi_identity(contracts), "status": "not-bound", "vermagic": None,
        "declared_order": list(contracts.reference["module_assets"]["modules"]),
        "resolved_order": None, "module_count": 0, "modules": [], "report_sha256": None,
        "digest": None,
    }


def abi_digest(evidence: dict) -> str:
    digest = hashlib.sha256(ABI_DIGEST_ALGORITHM.encode("ascii") + b"\n")
    for key in (
        "scope", "vendor_modules", "parser", "activation", "deployment_blocker", "blocker",
        "kernel_release", "reference_sha256", "stage_contract_sha256", "archive_sha256",
        "vmlinux_symvers_sha256", "module_symvers_sha256", "vermagic", "report_sha256",
    ):
        digest.update(f"{key}\t{json.dumps(evidence[key])}\n".encode("ascii"))
    for key in ("declared_order", "resolved_order"):
        digest.update(f"{key}\t{','.join(evidence[key])}\n".encode("ascii"))
    for row in evidence["modules"]:
        digest.update((
            f"module\t{row['name']}\t{row['sha256']}\t{','.join(row['depends_on'])}"
            f"\t{row['import_count']}\t{row['export_count']}\n"
        ).encode("ascii"))
    return digest.hexdigest()


def abi_evidence_from_report(contracts: Contracts, report: dict) -> dict:
    """Fixed summary of the kernel verifier's report; the whole report is hashed."""
    identity = abi_identity(contracts)
    k = kernel()
    for key, expected in (
        ("schema", 1), ("status", "staged-set-consistent"), ("scope", ABI_SCOPE),
        ("vendor_modules", "not-verified"), ("activation", identity["activation"]),
        ("parser", ABI_PARSER), ("deployment_blocker", "unchanged"),
        ("kernel_release", identity["kernel_release"]),
        ("reference_sha256", identity["reference_sha256"]),
        ("stage_contract_sha256", identity["stage_contract_sha256"]),
        ("archive_sha256", identity["archive_sha256"]),
        ("vmlinux_symvers_sha256", identity["vmlinux_symvers_sha256"]),
        ("module_symvers_sha256", identity["module_symvers_sha256"]),
    ):
        if key not in report or not k.strict_equal(report[key], expected):
            raise DeploymentError(f"kernel ABI report differs at {key}")
    rows = [
        {
            "name": module["name"], "sha256": module["sha256"],
            "depends_on": list(module["depends_on"]),
            "import_count": len(module["imports"]), "export_count": len(module["exports"]),
        }
        for module in report["modules"]
    ]
    canonical = json.dumps(report, sort_keys=True, separators=(",", ":")).encode("ascii")
    evidence = {
        **identity, "status": "staged-set-consistent", "vermagic": report["vermagic"],
        "declared_order": list(report["declared_order"]),
        "resolved_order": list(report["resolved_order"]), "module_count": len(rows),
        "modules": rows, "report_sha256": sha256_bytes(canonical),
    }
    evidence["digest"] = abi_digest(evidence)
    return evidence


def bind_abi(contracts: Contracts, abi: AbiInput, archive_data: bytes) -> tuple[dict, frozenset]:
    """Run the kernel verifier in process over the proven archive bytes and one
    stable capture of each symvers file. No symvers byte is retained."""
    if abi.vmlinux is None:
        return abi_evidence_none(contracts), frozenset()
    k = kernel()
    vmlinux_label, module_label = "vmlinux.symvers", "kernel_aarch64_Module.symvers"
    vmlinux_data, vmlinux_handle = capture_trusted_file(
        abi.vmlinux, vmlinux_label, vmlinux_label, k.MAX_SYMVERS_BYTES
    )
    try:
        module_data, module_handle = capture_trusted_file(
            abi.module, module_label, module_label, k.MAX_SYMVERS_BYTES
        )
        try:
            if vmlinux_handle.identity[:2] == module_handle.identity[:2]:
                raise DeploymentError("vmlinux.symvers and Module.symvers are the same file")
            report = k.verify_abi_bytes(
                kernel_contracts(contracts), archive_data, vmlinux_data, module_data
            )
            evidence = abi_evidence_from_report(contracts, report)
            recheck_trusted_file(abi.vmlinux, vmlinux_handle, vmlinux_label, vmlinux_label)
            recheck_trusted_file(abi.module, module_handle, module_label, module_label)
            parents = frozenset({vmlinux_handle.parent_identity, module_handle.parent_identity})
        finally:
            os.close(module_handle.pinned)
    finally:
        os.close(vmlinux_handle.pinned)
    return evidence, parents


def validate_abi_evidence(value, contracts: Contracts) -> dict:
    """Strictly validate recorded abi evidence; return it unchanged."""
    k = kernel()
    identity = abi_identity(contracts)
    keys = {
        *identity, "status", "vermagic", "declared_order", "resolved_order", "module_count",
        "modules", "report_sha256", "digest",
    }
    if type(value) is not dict:
        raise DeploymentError("kit abi fields differ")
    for flag in AUTHORITY_FLAGS:
        if flag in value and value[flag] is not False:
            raise DeploymentError(f"kit claims {flag}; deployment authorization is refused")
    if set(value) != keys:
        raise DeploymentError("kit abi fields differ")
    if value["symvers_bytes_copied_into_kit"] is not False:
        raise DeploymentError("kit abi symvers_bytes_copied_into_kit must be false")
    for key, expected in identity.items():
        if not k.strict_equal(value[key], expected):
            raise DeploymentError(f"kit abi differs at {key}")
    declared = list(contracts.reference["module_assets"]["modules"])
    if not k.strict_equal(value["declared_order"], declared):
        raise DeploymentError("kit abi differs at declared_order")
    if value["status"] == "not-bound":
        if not k.strict_equal(value, abi_evidence_none(contracts)):
            raise DeploymentError("kit abi not-bound evidence must be empty")
        return value
    if value["status"] != "staged-set-consistent":
        raise DeploymentError("kit abi status differs")
    release = identity["kernel_release"]
    vermagic, resolved, rows = value["vermagic"], value["resolved_order"], value["modules"]
    if type(vermagic) is not str or vermagic.split(" ")[0] != release:
        raise DeploymentError("kit abi vermagic differs")
    if type(resolved) is not list or sorted(resolved, key=str) != sorted(declared):
        raise DeploymentError("kit abi resolved_order differs")
    if type(rows) is not list or type(value["module_count"]) is not int or value["module_count"] != len(rows):
        raise DeploymentError("kit abi module count differs from its modules")
    row_keys = {"name", "sha256", "depends_on", "import_count", "export_count"}
    for name, row in zip(declared, rows):
        if type(row) is not dict or set(row) != row_keys or row["name"] != name:
            raise DeploymentError("kit abi module fields differ")
        if type(row["sha256"]) is not str or not HEX256.fullmatch(row["sha256"]):
            raise DeploymentError("kit abi module hash differs")
        depends = row["depends_on"]
        if type(depends) is not list or any(
            type(item) is not str or item not in declared or item == name for item in depends
        ):
            raise DeploymentError("kit abi module dependencies differ")
        if depends != sorted(depends):
            raise DeploymentError("kit abi module dependencies are not sorted")
        for count in ("import_count", "export_count"):
            if type(row[count]) is not int or row[count] < 0:
                raise DeploymentError("kit abi module counts differ")
    if len(rows) != len(declared):
        raise DeploymentError("kit abi module count differs from its modules")
    if type(value["report_sha256"]) is not str or not HEX256.fullmatch(value["report_sha256"]):
        raise DeploymentError("kit abi report hash differs")
    if value["digest"] != abi_digest(value):
        raise DeploymentError("kit abi digest differs from its fields")
    return value


def abi_report(evidence: dict) -> dict:
    return {
        "abi_status": evidence["status"],
        "abi_scope": evidence["scope"],
        "abi_module_count": evidence["module_count"],
        "abi_digest": evidence["digest"],
    }


