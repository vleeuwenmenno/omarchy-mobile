def status_document() -> dict:
    return {
        "artifact": KIT_KIND,
        "blockers": list(BLOCKERS),
        **{flag: False for flag in AUTHORITY_FLAGS},
    }


STATUS_TEXT = (
    "Omarchy Mobile Myron deployment-candidate kit (laptop-only)\n"
    "\n"
    "deployment_authorized: false\n"
    "This kit is NOT bootable, NOT flashable, NOT image-ready, NOT an atomic\n"
    "snapshot proof, NOT hardware-qualified and NOT a deployment authorization.\n"
    "It binds identities; it activates nothing. Permanent blockers are listed in\n"
    "status.json. Private runtime assets and the rootfs stay outside the kit.\n"
).encode("ascii")


def kit_spec(contracts: Contracts, module_files: list[dict], overlay: dict, binding: dict) -> list:
    """The exact kit as (path, kind, mode, bytes-or-None), parents first."""
    files = {
        "contracts/deployment-contract.json": contracts.deployment_bytes,
        "contracts/gpu-profile-reference.json": contracts.gpu_bytes,
        "contracts/kernel-contract.json": contracts.reference_bytes,
        "contracts/stage-contract.json": contracts.stage_bytes,
        "STATUS.txt": STATUS_TEXT,
        "status.json": render_json(status_document()),
    }
    directories, _ = module_layout(contracts)
    document = {
        "schema": 1,
        "kind": KIT_KIND,
        "format_version": VERSION,
        "contracts": {
            "deployment": {"path": "contracts/deployment-contract.json", "sha256": contracts.deployment_sha256},
            "gpu_profile_reference": {"path": "contracts/gpu-profile-reference.json", "sha256": contracts.gpu_sha256},
            "kernel_reference": {"path": "contracts/kernel-contract.json", "sha256": contracts.reference_sha256},
            "stage_contract": {"path": "contracts/stage-contract.json", "sha256": contracts.stage_sha256},
        },
        "overlay": {
            "root": "overlay",
            "archive_sha256": contracts.reference["module_assets"]["archive_sha256"],
            "module_directory": contracts.reference["module_assets"]["module_directory"],
            "module_order_status": "unverified",
            "files": module_files,
        },
        "rootfs": binding,
        "runtime": contracts.deployment["runtime"],
        "status": status_document(),
    }
    files["kit.json"] = render_json(document)
    modes = {path: 0o644 for path in files}
    for entry in module_files:
        relative = "overlay" + entry["destination"]
        files[relative] = overlay[entry["destination"]]
        modes[relative] = int(entry["mode"], 8)
    sums = "".join(f"{sha256_bytes(files[path])}  {path}\n" for path in sorted(files)).encode("ascii")
    files["SHA256SUMS"] = sums
    modes["SHA256SUMS"] = 0o644
    dirs = {"contracts", "overlay", *("overlay/" + path for path in directories)}
    spec = [(path, "dir", int(contracts.stage["layout"]["directory_mode"], 8), None) for path in dirs]
    spec += [(path, "file", modes[path], files[path]) for path in files]
    spec.sort(key=lambda item: item[0].encode("utf-8"))
    return spec


def spec_entries(spec: list, root_mode: int = 0o755) -> list[Entry]:
    entries = [Entry(".", "dir", root_mode, 0, "", "")]
    for path, kind, mode, data in spec:
        if kind == "dir":
            entries.append(Entry(path, "dir", mode, 0, "", ""))
        else:
            entries.append(Entry(path, "file", mode, len(data), sha256_bytes(data), ""))
    entries.sort(key=lambda entry: (entry.path != ".", entry.path.encode("utf-8")))
    return entries


def open_created_parent(root_fd: int, path: str) -> tuple[int, str]:
    parent, _, name = path.rpartition("/")
    descriptor = os.dup(root_fd)
    try:
        for component in parent.split("/") if parent else ():
            following = os.open(component, DIR_FLAGS, dir_fd=descriptor)
            os.close(descriptor)
            descriptor = following
        return descriptor, name
    except BaseException:
        os.close(descriptor)
        raise


def cleanup_created(root_fd: int, created: list[CreatedEntry]) -> None:
    """Remove only inodes atomically recorded as created by this run."""
    for entry in reversed(created):
        parent_fd = -1
        try:
            parent_fd, name = open_created_parent(root_fd, entry.path)
            metadata = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
            if (metadata.st_dev, metadata.st_ino) != (entry.device, entry.inode):
                continue
            if entry.kind == "dir":
                os.rmdir(name, dir_fd=parent_fd)
            else:
                os.unlink(name, dir_fd=parent_fd)
        except OSError:
            pass
        finally:
            if parent_fd >= 0:
                os.close(parent_fd)


def write_spec(root_fd: int, spec: list, created: list[CreatedEntry] | None = None) -> None:
    if created is None:
        created = []
    directories = {".": root_fd}
    try:
        for path, kind, mode, data in spec:
            parent, _, name = path.rpartition("/")
            parent_fd = directories[parent or "."]
            if kind == "dir":
                os.mkdir(name, 0o700, dir_fd=parent_fd)
                try:
                    named = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
                except OSError:
                    try:
                        os.rmdir(name, dir_fd=parent_fd)
                    except OSError:
                        pass
                    raise
                if not stat.S_ISDIR(named.st_mode):
                    raise DeploymentError(f"output directory is not a directory: {path}")
                created.append(CreatedEntry(path, "dir", named.st_dev, named.st_ino))
                os.chmod(name, 0o700, dir_fd=parent_fd, follow_symlinks=False)
                normalized = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
                if (normalized.st_dev, normalized.st_ino) != (named.st_dev, named.st_ino):
                    raise DeploymentError(f"output directory changed while setting mode: {path}")
                descriptor = os.open(name, DIR_FLAGS, dir_fd=parent_fd)
                directories[path] = descriptor
                metadata = os.fstat(descriptor)
                if (metadata.st_dev, metadata.st_ino) != (named.st_dev, named.st_ino):
                    raise DeploymentError(f"output directory changed while being opened: {path}")
                os.fchmod(descriptor, mode)
                continue
            descriptor = os.open(
                name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                0o600, dir_fd=parent_fd,
            )
            try:
                try:
                    named = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
                except OSError:
                    try:
                        os.unlink(name, dir_fd=parent_fd)
                    except OSError:
                        pass
                    raise
                if not stat.S_ISREG(named.st_mode):
                    raise DeploymentError(f"output file is not regular: {path}")
                created.append(CreatedEntry(path, "file", named.st_dev, named.st_ino))
                metadata = os.fstat(descriptor)
                if (metadata.st_dev, metadata.st_ino) != (named.st_dev, named.st_ino):
                    raise DeploymentError(f"output file changed while being opened: {path}")
                view = memoryview(data)
                while view:
                    view = view[os.write(descriptor, view):]
                os.fchmod(descriptor, mode)
                os.fsync(descriptor)
            finally:
                os.close(descriptor)
        for path, descriptor in directories.items():
            if path != ".":
                os.fsync(descriptor)
    except OSError as error:
        cleanup_created(root_fd, created)
        created.clear()
        raise DeploymentError(f"cannot write the output tree: {error.strerror}") from error
    finally:
        for path, descriptor in directories.items():
            if path != ".":
                os.close(descriptor)


# --- publication ----------------------------------------------------------------


def rename_noreplace(parent_fd: int, old: str, new: str) -> None:
    libc = ctypes.CDLL(None, use_errno=True)
    function = getattr(libc, "renameat2", None)
    if function is None:
        raise DeploymentError("atomic no-replace publication (renameat2) is unavailable")
    function.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
    function.restype = ctypes.c_int
    if function(parent_fd, os.fsencode(old), parent_fd, os.fsencode(new), 1) != 0:
        raise DeploymentError(f"cannot publish the output atomically: {os.strerror(ctypes.get_errno())}")


def remove_owned(
    parent_fd: int,
    name: str,
    owned: tuple,
    descriptor: int,
    created: list[CreatedEntry],
) -> None:
    """Remove only recorded output inodes, never unrelated directory contents."""
    try:
        opened = os.fstat(descriptor)
        if (opened.st_dev, opened.st_ino) != owned[:2]:
            return
        if kernel().mount_id_for_fd(descriptor, "cleanup root") == owned[2]:
            cleanup_created(descriptor, created)
    except Exception:
        # Cleanup must never mask the original failure.
        pass
    try:
        named = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
    except OSError:
        return
    if not stat.S_ISDIR(named.st_mode) or (named.st_dev, named.st_ino) != owned[:2]:
        return
    try:
        os.rmdir(name, dir_fd=parent_fd)
    except OSError:
        pass


def reject_protected_directory_alias(
    output_parent_fd: int, protected_directory_ids: frozenset[tuple[int, int]]
) -> None:
    """Reject output parents inside any protected tree, including bind aliases."""
    if not protected_directory_ids:
        return
    current = os.dup(output_parent_fd)
    seen: set[tuple[int, int]] = set()
    try:
        for _ in range(4096):
            metadata = os.fstat(current)
            identity = (metadata.st_dev, metadata.st_ino)
            if identity in protected_directory_ids:
                raise DeploymentError("output parent aliases a directory inside an input tree")
            if identity in seen:
                raise DeploymentError("output parent ancestry contains a directory loop")
            seen.add(identity)
            following = -1
            try:
                following = os.open("..", DIR_FLAGS, dir_fd=current)
                parent = os.fstat(following)
                parent_identity = (parent.st_dev, parent.st_ino)
            except BaseException:
                if following >= 0:
                    os.close(following)
                raise
            os.close(current)
            current = following
            if parent_identity == identity:
                return
        raise DeploymentError("output parent ancestry exceeds the safety bound")
    finally:
        os.close(current)


def publish(
    out: str,
    protected: list[str],
    protected_directory_ids: frozenset[tuple[int, int]],
    spec: list,
    verify_built,
) -> None:
    """Write SPEC under a private same-parent temp directory, verify it, and
    atomically publish it to the nonexistent canonical absolute OUT."""
    parts = split_canonical(out, "output path")
    for path in protected:
        if out == path or out.startswith(path + "/"):
            raise DeploymentError("output path lies inside an input tree")
    name = parts[-1]
    if len(name.encode("utf-8")) > 200:
        raise DeploymentError("output name is too long")
    parent_fd = open_trusted_output_parent(parts[:-1], "output parent")
    try:
        parent_metadata = os.fstat(parent_fd)
        if parent_metadata.st_uid != os.geteuid() or stat.S_IMODE(parent_metadata.st_mode) & 0o022:
            raise DeploymentError(
                "output parent must be owned by the invoking user and not group/world-writable"
            )
        reject_protected_directory_alias(parent_fd, protected_directory_ids)
        parent_mount_id = kernel().mount_id_for_fd(parent_fd, "output parent")
        try:
            os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
        except FileNotFoundError:
            pass
        except OSError as error:
            raise DeploymentError(f"output path is unavailable: {error.strerror}") from error
        else:
            raise DeploymentError(f"output path already exists: {out}")
        temporary = None
        for _ in range(8):
            candidate = f".{name}.tmp-{os.urandom(6).hex()}"
            try:
                os.mkdir(candidate, 0o700, dir_fd=parent_fd)
            except FileExistsError:
                continue
            except OSError as error:
                raise DeploymentError(f"cannot create a private temp directory: {error.strerror}") from error
            temporary = candidate
            break
        if temporary is None:
            raise DeploymentError("cannot create a unique private temp directory")
        created = None
        try:
            os.chmod(temporary, 0o700, dir_fd=parent_fd, follow_symlinks=False)
            created = os.stat(temporary, dir_fd=parent_fd, follow_symlinks=False)
        except OSError as error:
            try:
                os.rmdir(temporary, dir_fd=parent_fd)
            except OSError:
                pass
            raise DeploymentError(f"cannot inspect the private temp directory: {error.strerror}") from error
        if (
            not stat.S_ISDIR(created.st_mode)
            or created.st_uid != os.geteuid()
            or stat.S_IMODE(created.st_mode) != 0o700
        ):
            raise DeploymentError("private temp directory identity is unsafe")
        owned = (created.st_dev, created.st_ino, parent_mount_id)
        published = False
        renamed = False
        descriptor = -1
        created_entries: list[CreatedEntry] = []
        try:
            descriptor = os.open(temporary, DIR_FLAGS, dir_fd=parent_fd)
            opened = os.fstat(descriptor)
            if (opened.st_dev, opened.st_ino) != owned[:2]:
                raise DeploymentError("temp directory changed while being opened")
            if kernel().mount_id_for_fd(descriptor, "temp directory") != owned[2]:
                raise DeploymentError("temp directory crossed a mount point")
            if os.listdir(descriptor):
                raise DeploymentError("private temp directory was not empty")
            write_spec(descriptor, spec, created_entries)
            os.fchmod(descriptor, 0o755)
            os.fsync(descriptor)
            temporary_path = "/" + "/".join([*parts[:-1], temporary])
            verify_built(temporary_path, descriptor)
            named = os.stat(temporary, dir_fd=parent_fd, follow_symlinks=False)
            if not stat.S_ISDIR(named.st_mode) or (named.st_dev, named.st_ino) != owned[:2]:
                raise DeploymentError("temp directory changed before publication")
            rename_noreplace(parent_fd, temporary, name)
            renamed = True
            published_descriptor = os.open(name, DIR_FLAGS, dir_fd=parent_fd)
            try:
                opened = os.fstat(published_descriptor)
                if (opened.st_dev, opened.st_ino) != owned[:2]:
                    raise DeploymentError("published output identity differs from verified temp")
                if kernel().mount_id_for_fd(published_descriptor, "published output") != owned[2]:
                    raise DeploymentError("published output crossed a mount point")
                published_path = "/" + "/".join(parts)
                verify_built(published_path, published_descriptor)
            finally:
                os.close(published_descriptor)
            named = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
            if not stat.S_ISDIR(named.st_mode) or (named.st_dev, named.st_ino) != owned[:2]:
                raise DeploymentError("published output changed after verification")
            canonical_parent = open_trusted_output_parent(parts[:-1], "published output parent")
            try:
                canonical_metadata = os.fstat(canonical_parent)
                if (canonical_metadata.st_dev, canonical_metadata.st_ino) != (
                    parent_metadata.st_dev,
                    parent_metadata.st_ino,
                ):
                    raise DeploymentError("published output ancestry changed during publication")
                canonical_named = os.stat(name, dir_fd=canonical_parent, follow_symlinks=False)
                if (
                    not stat.S_ISDIR(canonical_named.st_mode)
                    or (canonical_named.st_dev, canonical_named.st_ino) != owned[:2]
                ):
                    raise DeploymentError("canonical published output differs from verified output")
            finally:
                os.close(canonical_parent)
            published = True
        except BaseException:
            if not published:
                if descriptor >= 0:
                    remove_owned(
                        parent_fd,
                        name if renamed else temporary,
                        owned,
                        descriptor,
                        created_entries,
                    )
                else:
                    # No pinned inode exists. Remove only an empty name whose
                    # identity still matches the directory created above.
                    try:
                        named = os.stat(temporary, dir_fd=parent_fd, follow_symlinks=False)
                        if stat.S_ISDIR(named.st_mode) and (named.st_dev, named.st_ino) == owned[:2]:
                            os.rmdir(temporary, dir_fd=parent_fd)
                    except OSError:
                        pass
            raise
        finally:
            if descriptor >= 0:
                os.close(descriptor)
        try:
            os.fsync(parent_fd)
        except OSError:
            pass
    finally:
        os.close(parent_fd)


# --- commands -------------------------------------------------------------------


def command_show(contracts: Contracts) -> dict:
    return contracts.deployment


def command_stage_modules(contracts: Contracts, assets: str, out: str) -> dict:
    plan, contents = load_archive(contracts, assets)
    directories, files = module_layout(contracts)
    mode = int(contracts.stage["layout"]["directory_mode"], 8)
    spec = [(path, "dir", mode, None) for path in directories]
    spec += [(path, "file", files[path], contents["/" + path]) for path in files]
    spec.sort(key=lambda item: item[0].encode("utf-8"))
    expected = spec_entries(spec)

    def verify_built(temporary_path: str, descriptor: int) -> None:
        tree = walk_tree(descriptor, STAGE_LIMITS, allow_symlinks=False, keep_data=True, label="module stage")
        diff_entries(tree.entries, expected, "module stage")
        check_against_plan(check_module_shape(tree, contracts), plan)
        kernel().verify_stage_tree(plan, temporary_path)

    publish(out, [], frozenset(), spec, verify_built)
    return {
        "status": "staged",
        "file_count": len(plan["files"]),
        "module_count": len(contracts.reference["module_assets"]["modules"]),
        "archive_sha256": plan["archive_sha256"],
        "deployment_authorized": False,
    }


def require_archive_plan(contracts: Contracts, assets: str, module_files: list[dict]) -> None:
    plan, _ = load_archive(contracts, assets)
    check_against_plan(module_files, plan)


def command_assemble(
    contracts: Contracts, rootfs: str, manifest: str, module_stage: str, out: str, assets: str
) -> dict:
    binding, _, rootfs_directory_ids = check_rootfs(rootfs, manifest, contracts)
    tree, module_files = read_module_stage(contracts, module_stage, "module stage")
    require_archive_plan(contracts, assets, module_files)
    overlay = {"/" + path: data for path, data in tree.data.items()}
    spec = kit_spec(contracts, module_files, overlay, binding)
    expected = spec_entries(spec)

    def verify_built(temporary_path: str, descriptor: int) -> None:
        built = walk_tree(descriptor, STAGE_LIMITS, allow_symlinks=False, label="kit")
        diff_entries(built.entries, expected, "kit")

    publish(
        out,
        [rootfs, module_stage],
        frozenset(set(rootfs_directory_ids) | set(tree.directory_ids)),
        spec,
        verify_built,
    )
    sums = [data for path, kind, mode, data in spec if path == "SHA256SUMS"][0]
    return {
        "status": "assembled",
        "kit_sha256": sha256_bytes(sums),
        "module_files": len(module_files),
        "rootfs_digest": binding["digest"],
        "archive_proven": True,
        "deployment_authorized": False,
    }


def reject_authority_claims(tree: Tree) -> None:
    for relative in ("status.json", "kit.json"):
        if relative not in tree.data:
            continue
        document = strict_json(tree.data[relative], relative)
        status = document.get("status") if relative == "kit.json" else document
        if not isinstance(status, dict):
            raise DeploymentError(f"{relative} has no status section")
        for flag in AUTHORITY_FLAGS:
            if flag in status and status[flag] is not False:
                raise DeploymentError(f"kit claims {flag}; deployment authorization is refused")
        if status.get("blockers") != BLOCKERS:
            raise DeploymentError(f"{relative} blocker list differs from the permanent blockers")
        if set(status) != {"artifact", "blockers", *AUTHORITY_FLAGS}:
            raise DeploymentError(f"{relative} status fields differ")


def command_verify(contracts: Contracts, kit: str, rootfs: str, manifest: str, assets: str) -> dict:
    binding, _, _ = check_rootfs(rootfs, manifest, contracts)
    descriptor, kit_identity = open_trusted_artifact(kit, "kit")
    try:
        tree = walk_tree(
            descriptor,
            STAGE_LIMITS,
            allow_symlinks=False,
            keep_data=True,
            trusted_ownership=True,
            label="kit",
        )
    finally:
        os.close(descriptor)
    reject_authority_claims(tree)
    overlay_entries = []
    for entry in tree.entries:
        if entry.path == "overlay":
            overlay_entries.append(entry._replace(path="."))
        elif entry.path.startswith("overlay/"):
            overlay_entries.append(entry._replace(path=entry.path[len("overlay/"):]))
    overlay_data = {
        path[len("overlay/"):]: data for path, data in tree.data.items() if path.startswith("overlay/")
    }
    overlay_entries.sort(key=lambda entry: (entry.path != ".", entry.path.encode("utf-8")))
    module_files = check_module_shape(
        Tree(overlay_entries, overlay_data, 0, frozenset()), contracts
    )
    require_archive_plan(contracts, assets, module_files)
    overlay = {"/" + path: data for path, data in overlay_data.items()}
    spec = kit_spec(contracts, module_files, overlay, binding)
    diff_entries(tree.entries, spec_entries(spec), "kit")
    recheck_trusted_artifact(kit, kit_identity, "kit")
    return {
        "status": "verified",
        "kit_sha256": sha256_bytes(tree.data["SHA256SUMS"]),
        "module_files": len(module_files),
        "rootfs_digest": binding["digest"],
        "archive_proven": True,
        "deployment_authorized": False,
    }


def command_gate(contracts: Contracts, kit: str, rootfs: str, manifest: str, assets: str) -> dict:
    verified = command_verify(contracts, kit, rootfs, manifest, assets)
    return {
        "artifact_verified": True,
        "deployment_authorized": False,
        "bootable": False,
        "flashable": False,
        "image_ready": False,
        "decision": "refused",
        "blockers": list(BLOCKERS),
        "kit_sha256": verified["kit_sha256"],
        "archive_proven": True,
    }


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("show", help="print the deployment contract; changes nothing")
    stage = commands.add_parser("stage-modules", help="stage the qualified module overlay into a new directory")
    stage.add_argument("--assets", required=True)
    stage.add_argument("--out", required=True)
    assemble = commands.add_parser("assemble", help="bind rootfs, overlay and contracts into a new kit")
    assemble.add_argument("--rootfs-stage", required=True)
    assemble.add_argument("--rootfs-manifest", required=True)
    assemble.add_argument("--module-stage", required=True)
    assemble.add_argument("--assets", required=True, help="qualified module archive")
    assemble.add_argument("--out", required=True)
    for name, text in (("verify", "recompute every binding of a kit"), ("gate", "verify, then refuse deployment")):
        sub = commands.add_parser(name, help=text)
        sub.add_argument("--kit", required=True)
        sub.add_argument("--rootfs-stage", required=True)
        sub.add_argument("--rootfs-manifest", help="default: <rootfs-stage>.MANIFEST")
        sub.add_argument("--assets", required=True, help="qualified module archive")
    return parser


def main(argv: list[str] | None = None, contracts_root: Path | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        contracts = load_contracts(contracts_root or REPO)
        if args.command == "show":
            result = command_show(contracts)
        elif args.command == "stage-modules":
            result = command_stage_modules(contracts, args.assets, args.out)
        elif args.command == "assemble":
            result = command_assemble(
                contracts, args.rootfs_stage, args.rootfs_manifest, args.module_stage, args.out, args.assets
            )
        else:
            manifest = args.rootfs_manifest or args.rootfs_stage + ".MANIFEST"
            runner = command_verify if args.command == "verify" else command_gate
            result = runner(contracts, args.kit, args.rootfs_stage, manifest, args.assets)
    except handled_errors() as error:
        print(f"ERROR: {error}", file=sys.stderr)
        return 1
    print(json.dumps(result, indent=2, sort_keys=True))
    if args.command == "gate":
        print("deployment refused: the kit is verified but not authorized", file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
