#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Trusted loader for the Myron synthetic GPT-to-R2, image-to-R3 and selection-to-R4 offline parsers.

This file is the trust root of the bootchain parser and is deliberately small. It opens
tools/lib/myron-bootchain-impl.py once, without following symlinks, reads the exact
bytes, hashes them, then compiles and executes those same bytes in this module's
namespace. The digest the contract and the plan bind is the digest of the bytes
that run: the implementation path is never opened a second time, so restoring or
replacing the file after the capture cannot change what the pin says. The loader
itself is reviewed in git, not pinned by the contract. Offline: no process, no
network."""

import os
import sys

if __name__ == "__main__":
    _here = os.path.dirname(os.path.realpath(__file__))
    sys.path[:] = [p for p in sys.path if p and os.path.realpath(p) != _here]

import hashlib
import stat

sys.dont_write_bytecode = True

IMPLEMENTATION_PATH = "tools/lib/myron-bootchain-impl.py"
IMPLEMENTATION_ALGORITHM = "sha256-of-captured-implementation-bytes"
IMPLEMENTATION_MAX_BYTES = 1024 * 1024


def capture_implementation(root: str) -> bytes:
    """The implementation's bytes, read once from one no-follow descriptor chain."""
    parts = IMPLEMENTATION_PATH.split("/")
    flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW
    chain = [os.open(root, flags | os.O_DIRECTORY)]
    try:
        for part in parts[:-1]:
            chain.append(os.open(part, flags | os.O_DIRECTORY, dir_fd=chain[-1]))
        file = os.open(parts[-1], flags | os.O_NONBLOCK, dir_fd=chain[-1])
    finally:
        for descriptor in chain:
            os.close(descriptor)
    try:
        info = os.fstat(file)
        if not stat.S_ISREG(info.st_mode):
            raise ImportError("bootchain implementation is not a regular file")
        if info.st_uid != os.geteuid() or info.st_mode & 0o022:
            raise ImportError("bootchain implementation is not owned by the caller or is writable by others")
        if info.st_size > IMPLEMENTATION_MAX_BYTES:
            raise ImportError("bootchain implementation exceeds its byte bound")
        data = b""
        while len(data) <= IMPLEMENTATION_MAX_BYTES:
            block = os.read(file, IMPLEMENTATION_MAX_BYTES + 1 - len(data))
            if not block:
                break
            data += block
    finally:
        os.close(file)
    if len(data) > IMPLEMENTATION_MAX_BYTES:
        raise ImportError("bootchain implementation exceeds its byte bound")
    return data


LOADER_REJECTED = "bootchain implementation could not be loaded (code loader-rejected)"


def _load() -> None:
    """Capture, compile and run the implementation. Any failure, including an ImportError
    the implementation itself raises while running, is one fixed text: the checkout path,
    errno text and source lines never leave. SystemExit and KeyboardInterrupt pass through,
    so the implementation's own final SystemExit(main()) keeps its status."""
    global CAPTURED_IMPLEMENTATION_SHA256
    try:
        root = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
        data = capture_implementation(root)
        CAPTURED_IMPLEMENTATION_SHA256 = hashlib.sha256(data).hexdigest()
        code = compile(data, os.path.join(root, IMPLEMENTATION_PATH), "exec", dont_inherit=True)
        exec(code, globals())
    except Exception:
        raise ImportError(LOADER_REJECTED) from None


if __name__ == "__main__":
    try:
        _load()
    except ImportError as error:
        raise SystemExit(f"ERROR: {error}") from None
else:
    _load()
