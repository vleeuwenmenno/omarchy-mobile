#!/bin/bash
# SPDX-License-Identifier: MIT
# Copy the [omamobile] repository (out/repo, from tools/repo-build) to the
# phone's /var/lib/omamobile/repo, where pacman reads it while the project is
# private. Then `omarchy update` on the phone installs whatever is new.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
# The development-only unsigned repository never goes through this signed,
# phone-facing path: refuse its marker before any change or phone contact
source tools/lib/dev-repo.sh
devrepo_reject_signed_repo "$SIGNED_REPO_DIR"

[[ -f out/repo/aarch64/omamobile.db ]] || { echo "Run tools/repo-build first" >&2; exit 1; }
# Shared lock: no writer changes the packages while they are sent
devrepo_lock repo_lock_fd out/repo/.repo.lock sh
devrepo_reject_signed_repo "$SIGNED_REPO_DIR"
tar cf - -C out/repo aarch64 | tools/phone-ssh '
  set -e
  rm -rf /var/lib/omamobile/repo.new && mkdir -p /var/lib/omamobile/repo.new
  tar xf - -C /var/lib/omamobile/repo.new --no-same-owner
  rm -rf /var/lib/omamobile/repo.old
  [ -d /var/lib/omamobile/repo ] && mv /var/lib/omamobile/repo /var/lib/omamobile/repo.old
  mv /var/lib/omamobile/repo.new /var/lib/omamobile/repo
  rm -rf /var/lib/omamobile/repo.old
  ls /var/lib/omamobile/repo/aarch64 | grep -c "pkg.tar.*[^g]$"'
